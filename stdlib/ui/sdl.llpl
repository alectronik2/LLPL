const LAYOUT_COLUMN: i64 = 1
const LAYOUT_ROW: i64 = 2
const LAYOUT_WRAP: i64 = 3
const WIDGET_GENERIC: i64 = 0
const WIDGET_WINDOW: i64 = 1
const WIDGET_COLUMN: i64 = 2
const WIDGET_ROW: i64 = 3
