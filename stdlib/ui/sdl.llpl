const DARK_SELECTION: u32 = 0x6652C7B2 as u32

func color_r(color: u32) -> char {
    return ((color >> 16) & 255) as char
}

func color_g(color: u32) -> char {
    return ((color >> 8) & 255) as char
}

func color_b(color: u32) -> char {
    return (color & 255) as char
}

func color_a(color: u32) -> char {
    return ((color >> 24) & 255) as char
}

func mix_channel(a: char, b: char, amount: i64) -> char {
    let av: i64 = a as i64
    let bv: i64 = b as i64
    return (av + ((bv - av) * amount) / 100) as char
}

func mix_color(a: u32, b: u32, amount: i64) -> u32 {
    let aa: u32 = mix_channel(color_a(a), color_a(b), amount) as u32
    let rr: u32 = mix_channel(color_r(a), color_r(b), amount) as u32
    let gg: u32 = mix_channel(color_g(a), color_g(b), amount) as u32
    let bb: u32 = mix_channel(color_b(a), color_b(b), amount) as u32
    return (aa << 24) | (rr << 16) | (gg << 8) | bb
}

func clamp_i64(value: i64, min_value: i64, max_value: i64) -> i64 {
    if value < min_value {
        return min_value
    }
    if value > max_value {
        return max_value
    }
    return value
}

func text_len(text: string) -> i64 {
    let n: i64 = 0
    while text[n] != 0 {
        n = n + 1
    }
    return n
}

func set_color(renderer: std.sdl.Renderer, color: u32) {
    renderer.set_draw_color(color_r(color), color_g(color), color_b(color), color_a(color))
}

func draw_rect(renderer: std.sdl.Renderer, x: i64, y: i64, w: i64, h: i64, color: u32) {
    set_color(renderer, color)
    let rect: SDL_Rect = new SDL_Rect(x as i32, y as i32, w as i32, h as i32)
    renderer.fill_rect(rect)
}

func draw_outline(renderer: std.sdl.Renderer, x: i64, y: i64, w: i64, h: i64, color: u32) {
    set_color(renderer, color)
    let rect: SDL_Rect = new SDL_Rect(x as i32, y as i32, w as i32, h as i32)
    renderer.draw_rect(rect)
}

func draw_file_icon(renderer: std.sdl.Renderer, x: i64, y: i64, color: u32, accent: u32) {
    draw_rect(renderer, x + 3, y + 2, 12, 15, color)
    draw_rect(renderer, x + 11, y + 2, 4, 4, accent)
    draw_outline(renderer, x + 3, y + 2, 12, 15, accent)
}

func draw_folder_icon(renderer: std.sdl.Renderer, x: i64, y: i64, color: u32, accent: u32) {
    draw_rect(renderer, x + 2, y + 6, 17, 11, color)
    draw_rect(renderer, x + 4, y + 3, 7, 5, color)
    draw_outline(renderer, x + 2, y + 6, 17, 11, accent)
}

func draw_image_icon(renderer: std.sdl.Renderer, x: i64, y: i64, color: u32, accent: u32) {
    draw_rect(renderer, x + 2, y + 3, 16, 14, color)
    draw_rect(renderer, x + 5, y + 6, 3, 3, accent)
    draw_rect(renderer, x + 9, y + 11, 7, 4, accent)
    draw_outline(renderer, x + 2, y + 3, 16, 14, accent)
}

func draw_check_icon(renderer: std.sdl.Renderer, x: i64, y: i64, color: u32) {
    draw_rect(renderer, x + 4, y + 10, 4, 4, color)
    draw_rect(renderer, x + 8, y + 7, 4, 4, color)
    draw_rect(renderer, x + 12, y + 4, 4, 4, color)
}

func draw_widget_icon(renderer: std.sdl.Renderer, icon: i64, x: i64, y: i64, color: u32, accent: u32) {
    if icon == LIST_ICON_FOLDER {
        draw_folder_icon(renderer, x, y, color, accent)
    } else if icon == LIST_ICON_IMAGE {
        draw_image_icon(renderer, x, y, color, accent)
    } else if icon == LIST_ICON_CHECK {
        draw_check_icon(renderer, x, y, accent)
    } else if icon != LIST_ICON_NONE {
        draw_file_icon(renderer, x, y, color, accent)
    }
}

func draw_msgbox_icon(renderer: std.sdl.Renderer, icon: i64, x: i64, y: i64, color: u32, accent: u32) {
    if icon == MSGBOX_ICON_WARNING {
        draw_rect(renderer, x + 10, y + 2, 12, 20, accent)
        draw_rect(renderer, x + 8, y + 22, 16, 4, accent)
        draw_rect(renderer, x + 14, y + 8, 4, 9, color)
        draw_rect(renderer, x + 14, y + 20, 4, 3, color)
    } else if icon == MSGBOX_ICON_ERROR {
        draw_rect(renderer, x + 5, y + 5, 22, 22, accent)
        draw_rect(renderer, x + 10, y + 13, 12, 4, color)
        draw_rect(renderer, x + 14, y + 9, 4, 12, color)
    } else if icon == MSGBOX_ICON_QUESTION {
        draw_rect(renderer, x + 5, y + 5, 22, 22, accent)
        draw_rect(renderer, x + 13, y + 10, 6, 4, color)
        draw_rect(renderer, x + 17, y + 14, 4, 5, color)
        draw_rect(renderer, x + 13, y + 20, 4, 3, color)
    } else if icon != MSGBOX_ICON_NONE {
        draw_rect(renderer, x + 5, y + 5, 22, 22, accent)
        draw_rect(renderer, x + 14, y + 12, 4, 11, color)
        draw_rect(renderer, x + 14, y + 8, 4, 3, color)
    }
}

func draw_disclosure(renderer: std.sdl.Renderer, x: i64, y: i64, expanded: bool, color: u32) {
    set_color(renderer, color)
    if expanded {
        renderer.draw_line((x + 3) as float, (y + 6) as float, (x + 8) as float, (y + 11) as float)
        renderer.draw_line((x + 8) as float, (y + 11) as float, (x + 13) as float, (y + 6) as float)
    } else {
        renderer.draw_line((x + 5) as float, (y + 4) as float, (x + 10) as float, (y + 9) as float)
        renderer.draw_line((x + 10) as float, (y + 9) as float, (x + 5) as float, (y + 14) as float)
    }
}

// Lightweight placeholder text renderer. Each character is represented as
// a small vertical mark, enough to make labels visible without SDL_ttf.
func draw_placeholder_text(renderer: std.sdl.Renderer, x: i64, y: i64, text: string, color: u32) {
    set_color(renderer, color)
    let i: i64 = 0
    while text[i] != 0 {
        let code: i64 = text[i] as i64
        if code != 32 {
            let h: i64 = 10 + (code % 5)
            let rect: SDL_Rect = new SDL_Rect((x + i * 7) as i32, y as i32, 5, h as i32)
            renderer.fill_rect(rect)
        }
        i = i + 1
    }
}

func draw_text(renderer: std.sdl.Renderer, font: TTF_Font*, x: i64, y: i64, text: string, color: u32) {
    if font == null {
        draw_placeholder_text(renderer, x, y, text, color)
        return
    }

    let len: i64 = text_len(text)
    if len == 0 {
        return
    }

    let w: i32 = 0
    let h: i32 = 0
    let fg: SDL_Color = new SDL_Color(color_r(color), color_g(color), color_b(color), color_a(color))
    if !std.sdl.TTF_GetStringSize(font, text, len as u64, &w, &h) {
        draw_placeholder_text(renderer, x, y, text, color)
        return
    }

    let surface: SDL_Surface* = std.sdl.TTF_RenderText_Blended(font, text, len as u64, fg)
    if surface == null {
        draw_placeholder_text(renderer, x, y, text, color)
        return
    }

    let texture: SDL_Texture* = std.sdl.SDL_CreateTextureFromSurface(renderer.get_handle(), surface)
    std.sdl.SDL_DestroySurface(surface)
    if texture == null {
        draw_placeholder_text(renderer, x, y, text, color)
        return
    }

    let dst: SDL_FRect = new SDL_FRect(x as float, y as float, w as float, h as float)
    std.sdl.SDL_RenderTexture(renderer.get_handle(), texture, null, &dst)
    std.sdl.SDL_DestroyTexture(texture)
}

func draw_text_box(renderer: std.sdl.Renderer, font: TTF_Font*, x: i64, y: i64, w: i64, h: i64, text: string, color: u32) {
    let left: i64 = x + 10
    let top: i64 = y

    if font == null {
        let marker_h: i64 = 14
        if h > marker_h {
            top = y + (h - marker_h) / 2
        }
        draw_placeholder_text(renderer, left, top, text, color)
        return
    }

    let len: i64 = text_len(text)
    if len == 0 {
        return
    }

    let text_w: i32 = 0
    let text_h: i32 = 0
    if std.sdl.TTF_GetStringSize(font, text, len as u64, &text_w, &text_h) {
        if h > text_h as i64 {
            top = y + (h - text_h as i64) / 2
        }
    }

    draw_text(renderer, font, left, top, text, color)
}

func count_list_items(items: string) -> i64 {
    let count: i64 = 0
    let i: i64 = 0
    if text_len(items) == 0 {
        return 0
    }
    while items[i] != 0 {
        if items[i] == '\n' {
            count = count + 1
        }
        i = i + 1
    }
    return count + 1
}

func get_list_item_at(items: string, index: i64) -> string {
    let current: i64 = 0
    let start: i64 = 0
    let i: i64 = 0
    let len: i64 = text_len(items)

    while i <= len {
        if i == len || items[i] == '\n' {
            if current == index {
                let buf: char* = malloc(256) as char*
                let j: i64 = 0
                while start + j < i && j < 255 {
                    buf[j] = items[start + j]
                    j = j + 1
                }
                buf[j] = 0
                return buf as string
            }
            current = current + 1
            start = i + 1
        }
        i = i + 1
    }
    return "" as string
}

class CanvasCommand {
    let op: i64
    let x1: i64
    let y1: i64
    let x2: i64
    let y2: i64
    let color: u32
    let next: CanvasCommand

    constructor(op: i64, x1: i64, y1: i64, x2: i64, y2: i64, color: u32) {
        self.op = op
        self.x1 = x1
        self.y1 = y1
        self.x2 = x2
        self.y2 = y2
        self.color = color
        self.next = null
    }
}

class ListItem {
    let text: string
    let icon: i64
    let next: ListItem

    constructor(text: string, icon: i64) {
        self.text = text
        self.icon = icon
        self.next = null
    }
}

class TreeItem {
    let text: string
    let indent: i64
    let is_folder: bool
    let expanded: bool
    let next: TreeItem

    constructor(text: string, indent: i64, is_folder: bool) {
        self.text = text
        self.indent = indent
        self.is_folder = is_folder
        self.expanded = true
        self.next = null
    }
}

class Widget {
    let kind: string
    let kind_id: i64
    let title: string
    let text: string
    let x: i64
    let y: i64
    let width: i64
    let height: i64
    let width_percent: i64
    let height_percent: i64
    let min_width: i64
    let min_height: i64
    let max_width: i64
    let max_height: i64
    let margin: i64
    let margin_left: i64
    let margin_right: i64
    let margin_top: i64
    let margin_bottom: i64
    let flex_grow: i64
    let layout_width_owned: bool
    let layout_height_owned: bool
    let padding: i64
    let spacing: i64
    let preferred_height: i64
    let layout: i64
    let background: u32
    let hover_background: u32
    let foreground: u32
    let hover_foreground: u32
    let border: u32
    let hover_border: u32
    let accent: u32
    let track: u32
    let selection: u32
    let value: i64
    let min_value: i64
    let max_value: i64
    let checked: bool
    let focused: bool
    let caret_index: i64
    let combo_open: bool
    let menu_open: bool
    let icon: i64
    let message: string
    let button_mode: i64
    let result: i64
    let visible: bool
    let placeholder: string
    let selectable: bool
    let selecting: bool
    let selection_start: i64
    let selection_end: i64
    let hovered: bool
    let hover_amount: i64
    let first_child: Widget
    let next_sibling: Widget
    let onClick: () -> void
    let has_onClick: bool
    let onHover: () -> void
    let has_onHover: bool
    let onHoverEnd: () -> void
    let has_onHoverEnd: bool
    let items_text: string
    let selected_index: i64
    let item_height: i64
    let scroll_offset: i64
    let first_list_item: ListItem
    let last_list_item: ListItem
    let first_tree_item: TreeItem
    let last_tree_item: TreeItem
    let canvas_background: u32
    let canvas_stroke: u32
    let canvas_fill: u32
    let first_canvas_command: CanvasCommand
    let last_canvas_command: CanvasCommand
    let image_path: string
    let image_texture: SDL_Texture*
    let image_loaded: bool
    let image_failed: bool
    let terminal_prompt: string

    constructor(kind: string) {
        self.kind = kind
        self.kind_id = WIDGET_GENERIC
        self.title = ""
        self.text = ""
        self.x = 0
        self.y = 0
        self.width = 0
        self.height = 0
        self.width_percent = 0
        self.height_percent = 0
        self.min_width = 0
        self.min_height = 0
        self.max_width = 0
        self.max_height = 0
        self.margin = 0
        self.margin_left = 0
        self.margin_right = 0
        self.margin_top = 0
        self.margin_bottom = 0
        self.flex_grow = 0
        self.layout_width_owned = false
        self.layout_height_owned = false
        self.padding = 12
        self.spacing = 8
        self.preferred_height = 32
        self.layout = LAYOUT_NONE
        self.background = 0xFFE8ECF3 as u32
        self.hover_background = self.background
        self.foreground = 0xFF151A22 as u32
        self.hover_foreground = self.foreground
        self.border = 0xFF7B8493 as u32
        self.hover_border = self.border
        self.accent = 0xFF2F7CF6 as u32
        self.track = LIGHT_TRACK
        self.selection = LIGHT_SELECTION
        self.value = 0
        self.min_value = 0
        self.max_value = 100
        self.checked = false
        self.focused = false
        self.caret_index = 0
        self.combo_open = false
        self.menu_open = false
        self.icon = LIST_ICON_NONE
        self.message = ""
        self.button_mode = MSGBOX_BUTTONS_OK
        self.result = MSGBOX_RESULT_NONE
        self.visible = true
        self.placeholder = ""
        self.selectable = false
        self.selecting = false
        self.selection_start = 0
        self.selection_end = 0
        self.hovered = false
        self.hover_amount = 0
        self.first_child = null
        self.next_sibling = null
        self.has_onClick = false
        self.has_onHover = false
        self.has_onHoverEnd = false
        self.items_text = ""
        self.selected_index = 0
        self.item_height = 24
        self.scroll_offset = 0
        self.first_list_item = null
        self.last_list_item = null
        self.first_tree_item = null
        self.last_tree_item = null
        self.canvas_background = 0xFFFFFFFF as u32
        self.canvas_stroke = 0xFF151A22 as u32
        self.canvas_fill = 0xFF2F7CF6 as u32
        self.first_canvas_command = null
        self.last_canvas_command = null
        self.image_path = ""
        self.image_texture = null
        self.image_loaded = false
        self.image_failed = false
        self.terminal_prompt = "> "
    }

    func add_child(child: Widget) {
        if self.first_child == null {
            rc_retain(child as char*)
            self.first_child = child
            return
        }

        let tail: Widget = self.first_child
        while tail.next_sibling != null {
            tail = tail.next_sibling
        }
        rc_retain(child as char*)
        tail.next_sibling = child
    }

    func contains(px: i64, py: i64) -> bool {
        return px >= self.x && py >= self.y && px < self.x + self.width && py < self.y + self.height
    }

    func value_percent() -> i64 {
        let span: i64 = self.max_value - self.min_value
        if span <= 0 {
            return 0
        }
        let clamped: i64 = clamp_i64(self.value, self.min_value, self.max_value)
        return ((clamped - self.min_value) * 100) / span
    }

    func box_margin_left() -> i64 {
        if self.margin_left > 0 {
            return self.margin_left
        }
        return self.margin
    }

    func box_margin_right() -> i64 {
        if self.margin_right > 0 {
            return self.margin_right
        }
        return self.margin
    }

    func box_margin_top() -> i64 {
        if self.margin_top > 0 {
            return self.margin_top
        }
        return self.margin
    }

    func box_margin_bottom() -> i64 {
        if self.margin_bottom > 0 {
            return self.margin_bottom
        }
        return self.margin
    }

    func constrain_width(value: i64) -> i64 {
        let result: i64 = value
        if result < self.min_width {
            result = self.min_width
        }
        if self.max_width > 0 && result > self.max_width {
            result = self.max_width
        }
        if result < 0 {
            result = 0
        }
        return result
    }

    func constrain_height(value: i64) -> i64 {
        let result: i64 = value
        if result < self.min_height {
            result = self.min_height
        }
        if self.max_height > 0 && result > self.max_height {
            result = self.max_height
        }
        if result < 0 {
            result = 0
        }
        return result
    }

    func text_index_at(px: i64) -> i64 {
        let len: i64 = text_len(self.text)
        let rel: i64 = px - (self.x + 10)
        if rel <= 0 {
            return 0
        }
        return clamp_i64((rel + 3) / 7, 0, len)
    }

    func clamp_caret() {
        self.caret_index = clamp_i64(self.caret_index, 0, text_len(self.text))
    }

    func set_value_from_x(px: i64) {
        let usable: i64 = self.width - self.padding * 2
        if usable <= 0 {
            return
        }
        let rel: i64 = clamp_i64(px - (self.x + self.padding), 0, usable)
        self.value = self.min_value + ((self.max_value - self.min_value) * rel) / usable
    }

    func set_value_from_y(py: i64) {
        let usable: i64 = self.height - self.padding * 2
        if usable <= 0 {
            return
        }
        let rel: i64 = clamp_i64(py - (self.y + self.padding), 0, usable)
        self.value = self.min_value + ((self.max_value - self.min_value) * rel) / usable
    }

    func combo_menu_contains(px: i64, py: i64) -> bool {
        if self.kind_id != WIDGET_COMBOBOX || !self.combo_open {
            return false
        }
        let count: i64 = self.list_item_count()
        return px >= self.x && px < self.x + self.width &&
            py >= self.y && py < self.y + self.height + count * self.item_height
    }

    func menu_label_width() -> i64 {
        return text_len(self.text) * 8 + 26
    }

    func menu_popup_width() -> i64 {
        let result: i64 = self.width
        if result < 160 {
            result = 160
        }
        let child: Widget = self.first_child
        while child != null {
            let label_w: i64 = text_len(child.text) * 8 + 54
            if child.first_child != null {
                label_w = label_w + 18
            }
            if label_w > result {
                result = label_w
            }
            child = child.next_sibling
        }
        return result
    }

    func menu_item_count() -> i64 {
        let count: i64 = 0
        let child: Widget = self.first_child
        while child != null {
            count = count + 1
            child = child.next_sibling
        }
        return count
    }

    func menu_item_at(index: i64) -> Widget {
        let current: i64 = 0
        let child: Widget = self.first_child
        while child != null {
            if current == index {
                return child
            }
            current = current + 1
            child = child.next_sibling
        }
        return null
    }

    func dialog_button_count() -> i64 {
        if self.button_mode == MSGBOX_BUTTONS_OK {
            return 1
        }
        if self.button_mode == MSGBOX_BUTTONS_OK_CANCEL {
            return 2
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO {
            return 2
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO_CANCEL {
            return 3
        }
        return 1
    }

    func dialog_button_label(index: i64) -> string {
        if self.button_mode == MSGBOX_BUTTONS_OK {
            return "OK" as string
        }
        if self.button_mode == MSGBOX_BUTTONS_OK_CANCEL {
            if index == 0 {
                return "OK" as string
            }
            return "Cancel" as string
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO {
            if index == 0 {
                return "Yes" as string
            }
            return "No" as string
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO_CANCEL {
            if index == 0 {
                return "Yes" as string
            }
            if index == 1 {
                return "No" as string
            }
            return "Cancel" as string
        }
        return "OK" as string
    }

    func dialog_button_result(index: i64) -> i64 {
        if self.button_mode == MSGBOX_BUTTONS_OK {
            return MSGBOX_RESULT_OK
        }
        if self.button_mode == MSGBOX_BUTTONS_OK_CANCEL {
            if index == 0 {
                return MSGBOX_RESULT_OK
            }
            return MSGBOX_RESULT_CANCEL
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO {
            if index == 0 {
                return MSGBOX_RESULT_YES
            }
            return MSGBOX_RESULT_NO
        }
        if self.button_mode == MSGBOX_BUTTONS_YES_NO_CANCEL {
            if index == 0 {
                return MSGBOX_RESULT_YES
            }
            if index == 1 {
                return MSGBOX_RESULT_NO
            }
            return MSGBOX_RESULT_CANCEL
        }
        return MSGBOX_RESULT_OK
    }

    func dialog_button_at(px: i64, py: i64) -> i64 {
        let count: i64 = self.dialog_button_count()
        let button_w: i64 = 88
        let button_h: i64 = 32
        let gap: i64 = 10
        let total_w: i64 = count * button_w + (count - 1) * gap
        let start_x: i64 = self.x + self.width - total_w - 20
        let button_y: i64 = self.y + self.height - button_h - 18
        let i: i64 = 0
        while i < count {
            let button_x: i64 = start_x + i * (button_w + gap)
            if px >= button_x && px < button_x + button_w && py >= button_y && py < button_y + button_h {
                return i
            }
            i = i + 1
        }
        return -1
    }

    func dialog_input_contains(px: i64, py: i64) -> bool {
        if self.kind_id != WIDGET_INPUTBOX {
            return false
        }
        let input_x: i64 = self.x + 52
        let input_y: i64 = self.y + 92
        let input_w: i64 = self.width - 72
        let input_h: i64 = 36
        return px >= input_x && px < input_x + input_w && py >= input_y && py < input_y + input_h
    }

    func close_dialog(result: i64) {
        self.result = result
        self.visible = false
        self.focused = false
    }

    func close_menus() {
        if self.kind_id == WIDGET_MENU {
            self.menu_open = false
        }
        let child: Widget = self.first_child
        while child != null {
            child.close_menus()
            child = child.next_sibling
        }
    }

    func menu_popup_contains(px: i64, py: i64) -> bool {
        if self.kind_id != WIDGET_MENU || !self.menu_open {
            return false
        }
        let popup_w: i64 = self.menu_popup_width()
        let popup_h: i64 = self.menu_item_count() * self.item_height
        if px >= self.x && px < self.x + popup_w && py >= self.y + self.height && py < self.y + self.height + popup_h {
            return true
        }
        let item: Widget = self.first_child
        while item != null {
            if item.menu_popup_contains(px, py) {
                return true
            }
            item = item.next_sibling
        }
        return false
    }

    func any_menu_popup_contains(px: i64, py: i64) -> bool {
        if self.menu_popup_contains(px, py) {
            return true
        }
        let child: Widget = self.first_child
        while child != null {
            if child.any_menu_popup_contains(px, py) {
                return true
            }
            child = child.next_sibling
        }
        return false
    }

    func begin_menu_pointer(px: i64, py: i64) -> bool {
        let cursor_x: i64 = self.x + 4
        let child: Widget = self.first_child
        while child != null {
            let item_w: i64 = child.menu_label_width()
            if py >= self.y && py < self.y + self.height && px >= cursor_x && px < cursor_x + item_w {
                self.close_menus()
                child.x = cursor_x
                child.y = self.y
                child.width = item_w
                child.height = self.height
                child.menu_open = true
                return true
            }
            cursor_x = cursor_x + item_w
            child = child.next_sibling
        }

        child = self.first_child
        while child != null {
            if child.begin_menu_popup_pointer(px, py) {
                return true
            }
            child = child.next_sibling
        }
        return false
    }

    func begin_menu_popup_pointer(px: i64, py: i64) -> bool {
        if self.kind_id != WIDGET_MENU || !self.menu_open {
            return false
        }
        let popup_w: i64 = self.menu_popup_width()
        let rel_y: i64 = py - (self.y + self.height)
        if px >= self.x && px < self.x + popup_w && rel_y >= 0 {
            let index: i64 = rel_y / self.item_height
            let item: Widget = self.menu_item_at(index)
            if item != null {
                if item.first_child != null {
                    let sibling: Widget = self.first_child
                    while sibling != null {
                        if sibling != item {
                            sibling.close_menus()
                        }
                        sibling = sibling.next_sibling
                    }
                    item.x = self.x + popup_w
                    item.y = self.y + self.height + index * self.item_height - self.item_height
                    item.width = popup_w
                    item.height = self.item_height
                    item.menu_open = true
                    return true
                }
                if item.has_onClick {
                    let handler: () -> void = item.onClick
                    handler()
                }
                self.close_menus()
                return true
            }
        }

        let child: Widget = self.first_child
        while child != null {
            if child.begin_menu_popup_pointer(px, py) {
                return true
            }
            child = child.next_sibling
        }
        return false
    }

    func clear_interaction_focus() {
        if self.kind_id == WIDGET_TEXTBOX {
            self.focused = false
        }
        if self.kind_id == WIDGET_INPUTBOX {
            self.focused = false
        }
        if self.kind_id == WIDGET_TERMINAL {
            self.focused = false
        }
        if self.kind_id == WIDGET_COMBOBOX {
            self.combo_open = false
        }
        if self.kind_id == WIDGET_MENU {
            self.menu_open = false
        }

        let child: Widget = self.first_child
        while child != null {
            child.clear_interaction_focus()
            child = child.next_sibling
        }
    }

    func clear_text_focus() {
        if self.kind_id == WIDGET_TEXTBOX {
            self.focused = false
        }
        if self.kind_id == WIDGET_INPUTBOX {
            self.focused = false
        }
        if self.kind_id == WIDGET_TERMINAL {
            self.focused = false
        }

        let child: Widget = self.first_child
        while child != null {
            child.clear_text_focus()
            child = child.next_sibling
        }
    }

    func focused_textbox() -> Widget {
        if self.kind_id == WIDGET_TEXTBOX && self.focused {
            return self
        }
        if self.kind_id == WIDGET_INPUTBOX && self.focused {
            return self
        }
        if self.kind_id == WIDGET_TERMINAL && self.focused {
            return self
        }

        let child: Widget = self.first_child
        while child != null {
            let found: Widget = child.focused_textbox()
            if found != null {
                return found
            }
            child = child.next_sibling
        }
        return null
    }

    func append_text(value: string) {
        self.clamp_caret()
        let left_len: i64 = self.caret_index
        let old_len: i64 = text_len(self.text)
        let insert_len: i64 = text_len(value)
        let buf: char* = malloc(old_len + insert_len + 1) as char*
        let i: i64 = 0
        while i < left_len {
            buf[i] = self.text[i]
            i = i + 1
        }
        let j: i64 = 0
        while j < insert_len {
            buf[i + j] = value[j]
            j = j + 1
        }
        let k: i64 = left_len
        while k < old_len {
            buf[insert_len + k] = self.text[k]
            k = k + 1
        }
        buf[old_len + insert_len] = 0
        self.text = buf as string
        self.caret_index = left_len + insert_len
    }

    func backspace_text() {
        let len: i64 = text_len(self.text)
        self.clamp_caret()
        if len <= 0 || self.caret_index <= 0 {
            return
        }
        let buf: char* = malloc(len) as char*
        let i: i64 = 0
        while i < self.caret_index - 1 {
            buf[i] = self.text[i]
            i = i + 1
        }
        let j: i64 = self.caret_index
        while j < len {
            buf[i] = self.text[j]
            i = i + 1
            j = j + 1
        }
        buf[len - 1] = 0
        self.text = buf as string
        self.caret_index = self.caret_index - 1
    }

    func set_caret_from_x(px: i64) {
        self.caret_index = self.text_index_at(px)
    }

    func move_caret_left() {
        self.clamp_caret()
        if self.caret_index > 0 {
            self.caret_index = self.caret_index - 1
        }
    }

    func move_caret_right() {
        self.clamp_caret()
        let len: i64 = text_len(self.text)
        if self.caret_index < len {
            self.caret_index = self.caret_index + 1
        }
    }

    func list_item_count() -> i64 {
        if self.kind_id != WIDGET_LIST && self.kind_id != WIDGET_COMBOBOX {
            return count_list_items(self.items_text)
        }
        let count: i64 = 0
        let item: ListItem = self.first_list_item
        while item != null {
            count = count + 1
            item = item.next
        }
        return count
    }

    func list_item_at(index: i64) -> ListItem {
        let current: i64 = 0
        let item: ListItem = self.first_list_item
        while item != null {
            if current == index {
                return item
            }
            current = current + 1
            item = item.next
        }
        return null
    }

    func tree_item_visible(target: TreeItem) -> bool {
        let hidden_indent: i64 = -1
        let item: TreeItem = self.first_tree_item
        while item != null {
            if hidden_indent >= 0 {
                if item.indent > hidden_indent {
                    if item == target {
                        return false
                    }
                    item = item.next
                    continue
                }
                hidden_indent = -1
            }

            if item == target {
                return true
            }
            if item.is_folder && !item.expanded {
                hidden_indent = item.indent
            }
            item = item.next
        }
        return false
    }

    func tree_visible_count() -> i64 {
        let count: i64 = 0
        let item: TreeItem = self.first_tree_item
        while item != null {
            if self.tree_item_visible(item) {
                count = count + 1
            }
            item = item.next
        }
        return count
    }

    func tree_item_at_visible(index: i64) -> TreeItem {
        let current: i64 = 0
        let item: TreeItem = self.first_tree_item
        while item != null {
            if self.tree_item_visible(item) {
                if current == index {
                    return item
                }
                current = current + 1
            }
            item = item.next
        }
        return null
    }

    func tab_count() -> i64 {
        let count: i64 = 0
        let child: Widget = self.first_child
        while child != null {
            if child.visible && child.kind_id == WIDGET_TABPAGE {
                count = count + 1
            }
            child = child.next_sibling
        }
        return count
    }

    func active_tab_page() -> Widget {
        let index: i64 = 0
        let child: Widget = self.first_child
        while child != null {
            if child.visible && child.kind_id == WIDGET_TABPAGE {
                if index == self.selected_index {
                    return child
                }
                index = index + 1
            }
            child = child.next_sibling
        }
        return null
    }

    func child_active_for_traversal(child: Widget) -> bool {
        if self.kind_id != WIDGET_TABCONTAINER {
            return true
        }
        return child == self.active_tab_page()
    }

    func terminal_append_line(line: string) {
        if text_len(self.items_text) == 0 {
            self.items_text = line
            return
        }
        let old_len: i64 = text_len(self.items_text)
        let line_len: i64 = text_len(line)
        let buf: char* = malloc(old_len + line_len + 2) as char*
        let i: i64 = 0
        while i < old_len {
            buf[i] = self.items_text[i]
            i = i + 1
        }
        buf[i] = '\n'
        i = i + 1
        let j: i64 = 0
        while j < line_len {
            buf[i + j] = line[j]
            j = j + 1
        }
        buf[i + line_len] = 0
        self.items_text = buf as string
    }

    func terminal_clear() {
        self.items_text = ""
        self.text = ""
        self.caret_index = 0
    }

    func terminal_submit() {
        if text_len(self.text) > 0 {
            let old_prompt: string = self.terminal_prompt
            let command: string = self.text
            let total: i64 = text_len(old_prompt) + text_len(command)
            let buf: char* = malloc(total + 1) as char*
            let i: i64 = 0
            while old_prompt[i] != 0 {
                buf[i] = old_prompt[i]
                i = i + 1
            }
            let j: i64 = 0
            while command[j] != 0 {
                buf[i + j] = command[j]
                j = j + 1
            }
            buf[total] = 0
            self.terminal_append_line(buf as string)
            self.text = ""
            self.caret_index = 0
        }
    }

    func begin_pointer(px: i64, py: i64) -> bool {
        if !self.visible {
            return false
        }

        if self.kind_id == WIDGET_MSGBOX || self.kind_id == WIDGET_INPUTBOX {
            if !self.contains(px, py) {
                return false
            }
            if self.dialog_input_contains(px, py) {
                self.focused = true
                let rel: i64 = px - (self.x + 62)
                if rel <= 0 {
                    self.caret_index = 0
                } else {
                    self.caret_index = clamp_i64((rel + 3) / 7, 0, text_len(self.text))
                }
                return true
            }
            self.focused = false
            let button_index: i64 = self.dialog_button_at(px, py)
            if button_index >= 0 {
                self.close_dialog(self.dialog_button_result(button_index))
                return true
            }
            return true
        }

        if self.kind_id == WIDGET_MENUBAR {
            return self.begin_menu_pointer(px, py)
        }

        if self.kind_id == WIDGET_TABCONTAINER {
            if self.contains(px, py) && py >= self.y && py < self.y + self.item_height {
                let rel_x: i64 = px - self.x
                let index: i64 = rel_x / 120
                if index >= 0 && index < self.tab_count() {
                    self.selected_index = index
                    return true
                }
            }
        }

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                if child.begin_pointer(px, py) {
                    return true
                }
            }
            child = child.next_sibling
        }

        if !self.contains(px, py) && !self.combo_menu_contains(px, py) && !self.any_menu_popup_contains(px, py) {
            return false
        }

        if self.kind_id == WIDGET_CHECKBOX {
            self.checked = !self.checked
            return true
        }
        if self.kind_id == WIDGET_TEXTBOX {
            self.focused = true
            self.set_caret_from_x(px)
            return true
        }
        if self.kind_id == WIDGET_TERMINAL {
            self.focused = true
            self.caret_index = text_len(self.text)
            return true
        }
        if self.kind_id == WIDGET_COMBOBOX {
            if self.combo_open && py >= self.y + self.height {
                let option_index: i64 = (py - (self.y + self.height)) / self.item_height
                let selected: ListItem = self.list_item_at(option_index)
                if selected != null {
                    self.selected_index = option_index
                    self.text = selected.text
                    self.combo_open = false
                    return true
                }
            }
            self.combo_open = !self.combo_open
            return true
        }
        if self.kind_id == WIDGET_SLIDER {
            self.selecting = true
            self.set_value_from_x(px)
            return true
        }
        if self.kind_id == WIDGET_SCROLLBAR {
            self.selecting = true
            self.set_value_from_y(py)
            return true
        }
        if self.selectable {
            self.selecting = true
            self.selection_start = self.text_index_at(px)
            self.selection_end = self.selection_start
            return true
        }
        if self.kind_id == WIDGET_LIST {
            let rel_y: i64 = py - (self.y + 4)
            if rel_y >= 0 {
                let item_index: i64 = rel_y / self.item_height + self.scroll_offset
                let item_count: i64 = self.list_item_count()
                if item_index >= 0 && item_index < item_count {
                    self.selected_index = item_index
                    return true
                }
            }
        }
        if self.kind_id == WIDGET_TREEVIEW {
            let rel_tree_y: i64 = py - (self.y + 4)
            if rel_tree_y >= 0 {
                let visible_index: i64 = rel_tree_y / self.item_height + self.scroll_offset
                let tree_item: TreeItem = self.tree_item_at_visible(visible_index)
                if tree_item != null {
                    self.selected_index = visible_index
                    if tree_item.is_folder {
                        tree_item.expanded = !tree_item.expanded
                    }
                    return true
                }
            }
        }
        return false
    }

    func drag_pointer(px: i64, py: i64) {
        if !self.visible {
            return
        }
        if self.selecting {
            if self.kind_id == WIDGET_SLIDER {
                self.set_value_from_x(px)
            } else if self.kind_id == WIDGET_SCROLLBAR {
                self.set_value_from_y(py)
            } else if self.selectable {
                self.selection_end = self.text_index_at(px)
            }
        }

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.drag_pointer(px, py)
            }
            child = child.next_sibling
        }
    }

    func end_pointer(px: i64, py: i64) {
        if !self.visible {
            return
        }
        self.selecting = false

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.end_pointer(px, py)
            }
            child = child.next_sibling
        }
    }

    func apply_light_theme() {
        if self.kind_id == WIDGET_WINDOW {
            self.background = LIGHT_WINDOW_BG
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = 0xFF3B4250 as u32
            self.hover_border = self.border
        } else if self.kind_id == WIDGET_PANEL || self.kind_id == WIDGET_CARD ||
                self.kind_id == WIDGET_GROUPBOX || self.kind_id == WIDGET_MSGBOX || self.kind_id == WIDGET_INPUTBOX ||
                self.kind_id == WIDGET_TABCONTAINER || self.kind_id == WIDGET_TABPAGE {
            self.background = LIGHT_PANEL_BG
            self.hover_background = 0xFFF5F7FC as u32
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
        } else if self.kind_id == WIDGET_BUTTON {
            self.background = LIGHT_BUTTON_BG
            self.hover_background = LIGHT_BUTTON_HOVER_BG
            self.foreground = 0xFFFFFFFF as u32
            self.hover_foreground = self.foreground
            self.border = LIGHT_BUTTON_BORDER
            self.hover_border = LIGHT_BUTTON_HOVER_BORDER
            self.accent = LIGHT_BUTTON_BG
            self.track = LIGHT_TRACK
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_PROGRESS || self.kind_id == WIDGET_SLIDER ||
                self.kind_id == WIDGET_SCROLLBAR || self.kind_id == WIDGET_SPINNER {
            self.background = 0x00FFFFFF as u32
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = LIGHT_BUTTON_HOVER_BORDER
            self.accent = LIGHT_BUTTON_BG
            self.track = LIGHT_TRACK
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_CHECKBOX || self.kind_id == WIDGET_BADGE {
            self.background = 0x00FFFFFF as u32
            self.hover_background = 0x1A2F7CF6 as u32
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = LIGHT_BUTTON_HOVER_BORDER
            self.accent = LIGHT_BUTTON_BG
            self.track = LIGHT_TRACK
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_TEXTBOX || self.kind_id == WIDGET_COMBOBOX {
            self.background = 0xFFFFFFFF as u32
            self.hover_background = 0xFFF5F7FC as u32
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = LIGHT_BUTTON_HOVER_BORDER
            self.accent = LIGHT_BUTTON_BG
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_MENUBAR || self.kind_id == WIDGET_MENU ||
                self.kind_id == WIDGET_MENUITEM || self.kind_id == WIDGET_STATUSBAR {
            self.background = 0xFFFFFFFF as u32
            self.hover_background = 0xFFF5F7FC as u32
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
            self.accent = LIGHT_BUTTON_BG
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_LIST || self.kind_id == WIDGET_TREEVIEW {
            self.background = 0xFFFFFFFF as u32
            self.hover_background = 0xFFF5F7FC as u32
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
            self.accent = LIGHT_BUTTON_BG
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_TEXT {
            self.background = 0x00FFFFFF as u32
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = 0x00FFFFFF as u32
            self.hover_border = self.border
            self.selection = LIGHT_SELECTION
        } else if self.kind_id == WIDGET_CANVAS {
            self.background = 0xFFFFFFFF as u32
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
            self.accent = LIGHT_BUTTON_BG
            self.canvas_background = self.background
            self.canvas_stroke = LIGHT_TEXT
            self.canvas_fill = LIGHT_BUTTON_BG
        } else if self.kind_id == WIDGET_PICTURE {
            self.background = 0xFFFFFFFF as u32
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
            self.accent = LIGHT_BUTTON_BG
        } else if self.kind_id == WIDGET_TERMINAL {
            self.background = 0xFF0F1720 as u32
            self.hover_background = self.background
            self.foreground = 0xFFE6F4EA as u32
            self.hover_foreground = self.foreground
            self.border = LIGHT_BORDER
            self.hover_border = 0xFF99A5B8 as u32
            self.accent = 0xFF26A890 as u32
            self.selection = LIGHT_SELECTION
        } else {
            self.background = 0x00FFFFFF as u32
            self.hover_background = self.background
            self.foreground = LIGHT_TEXT
            self.hover_foreground = self.foreground
            self.border = 0x00FFFFFF as u32
            self.hover_border = self.border
            self.accent = LIGHT_BUTTON_BG
            self.track = LIGHT_TRACK
            self.selection = LIGHT_SELECTION
        }

        let child: Widget = self.first_child
        while child != null {
            child.apply_light_theme()
            child = child.next_sibling
        }
    }

    func apply_dark_theme() {
        if self.kind_id == WIDGET_WINDOW {
            self.background = DARK_WINDOW_BG
            self.hover_background = self.background
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
        } else if self.kind_id == WIDGET_PANEL || self.kind_id == WIDGET_CARD ||
                self.kind_id == WIDGET_GROUPBOX || self.kind_id == WIDGET_MSGBOX || self.kind_id == WIDGET_INPUTBOX ||
                self.kind_id == WIDGET_TABCONTAINER || self.kind_id == WIDGET_TABPAGE {
            self.background = DARK_PANEL_BG
            self.hover_background = DARK_PANEL_HOVER_BG
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
        } else if self.kind_id == WIDGET_BUTTON {
            self.background = DARK_BUTTON_BG
            self.hover_background = DARK_BUTTON_HOVER_BG
            self.foreground = DARK_TEXT
            self.hover_foreground = 0xFFFFFFFF as u32
            self.border = DARK_BUTTON_BORDER
            self.hover_border = DARK_BUTTON_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.track = DARK_TRACK
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_PROGRESS || self.kind_id == WIDGET_SLIDER ||
                self.kind_id == WIDGET_SCROLLBAR || self.kind_id == WIDGET_SPINNER {
            self.background = 0x00000000 as u32
            self.hover_background = self.background
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_BUTTON_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.track = DARK_TRACK
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_CHECKBOX || self.kind_id == WIDGET_BADGE {
            self.background = 0x00000000 as u32
            self.hover_background = 0x1A26A890 as u32
            self.foreground = DARK_TEXT
            self.hover_foreground = 0xFFFFFFFF as u32
            self.border = DARK_BORDER
            self.hover_border = DARK_BUTTON_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.track = DARK_TRACK
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_TEXTBOX || self.kind_id == WIDGET_COMBOBOX {
            self.background = 0xFF151A20 as u32
            self.hover_background = 0xFF1D242D as u32
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_BUTTON_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_MENUBAR || self.kind_id == WIDGET_MENU ||
                self.kind_id == WIDGET_MENUITEM || self.kind_id == WIDGET_STATUSBAR {
            self.background = 0xFF151A20 as u32
            self.hover_background = 0xFF1D242D as u32
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_LIST || self.kind_id == WIDGET_TREEVIEW {
            self.background = 0xFF151A20 as u32
            self.hover_background = 0xFF1D242D as u32
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_TEXT {
            self.background = 0x00000000 as u32
            self.hover_background = self.background
            self.foreground = DARK_MUTED_TEXT
            self.hover_foreground = DARK_TEXT
            self.border = 0x00000000 as u32
            self.hover_border = self.border
            self.selection = DARK_SELECTION
        } else if self.kind_id == WIDGET_CANVAS {
            self.background = 0xFF0F1318 as u32
            self.hover_background = self.background
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
            self.canvas_background = self.background
            self.canvas_stroke = DARK_TEXT
            self.canvas_fill = DARK_BUTTON_BG
        } else if self.kind_id == WIDGET_PICTURE {
            self.background = 0xFF151A20 as u32
            self.hover_background = self.background
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
            self.accent = DARK_BUTTON_BG
        } else if self.kind_id == WIDGET_TERMINAL {
            self.background = 0xFF070B10 as u32
            self.hover_background = self.background
            self.foreground = 0xFFB7F7C5 as u32
            self.hover_foreground = self.foreground
            self.border = DARK_BORDER
            self.hover_border = DARK_HOVER_BORDER
            self.accent = 0xFF26A890 as u32
            self.selection = DARK_SELECTION
        } else {
            self.background = 0x00000000 as u32
            self.hover_background = self.background
            self.foreground = DARK_TEXT
            self.hover_foreground = self.foreground
            self.border = 0x00000000 as u32
            self.hover_border = self.border
            self.accent = DARK_BUTTON_BG
            self.track = DARK_TRACK
            self.selection = DARK_SELECTION
        }

        let child: Widget = self.first_child
        while child != null {
            child.apply_dark_theme()
            child = child.next_sibling
        }
    }

    func update_hover(px: i64, py: i64) {
        if !self.visible {
            self.hovered = false
            return
        }
        let was_hovered: bool = self.hovered
        self.hovered = self.contains(px, py)

        if self.hovered && !was_hovered && self.has_onHover {
            let handler: () -> void = self.onHover
            handler()
        }
        if !self.hovered && was_hovered && self.has_onHoverEnd {
            let end_handler: () -> void = self.onHoverEnd
            end_handler()
        }

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.update_hover(px, py)
            } else {
                child.hovered = false
            }
            child = child.next_sibling
        }
    }

    func animate() {
        if !self.visible {
            return
        }
        let visual_hover: bool = self.hover_background != self.background ||
            self.hover_foreground != self.foreground || self.hover_border != self.border
        if self.hovered && visual_hover {
            if self.hover_amount < 100 {
                self.hover_amount = self.hover_amount + 12
                if self.hover_amount > 100 {
                    self.hover_amount = 100
                }
            }
        } else {
            if self.hover_amount > 0 {
                self.hover_amount = self.hover_amount - 12
                if self.hover_amount < 0 {
                    self.hover_amount = 0
                }
            }
        }

        if self.kind_id == WIDGET_SPINNER {
            self.value = self.value + 1
            if self.value > 7 {
                self.value = 0
            }
        }

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.animate()
            }
            child = child.next_sibling
        }
    }

    func layout_tree() {
        if !self.visible {
            return
        }
        let child: Widget = self.first_child
        if child == null {
            return
        }

        if self.kind_id == WIDGET_TABCONTAINER {
            let page: Widget = self.active_tab_page()
            if page != null {
                page.x = self.x + self.padding
                page.y = self.y + self.item_height + self.padding
                page.width = page.constrain_width(self.width - self.padding * 2)
                page.height = page.constrain_height(self.height - self.item_height - self.padding * 2)
                page.layout_width_owned = true
                page.layout_height_owned = true
                page.layout_tree()
            }
            return
        }

        if self.layout == LAYOUT_COLUMN {
            let cy: i64 = self.y + self.padding
            let content_w: i64 = self.width - self.padding * 2
            let content_h: i64 = self.height - self.padding * 2
            let count: i64 = 0
            let fixed_h: i64 = 0
            let flex_total: i64 = 0
            let scan: Widget = self.first_child
            while scan != null {
                if scan.visible {
                    count = count + 1
                    fixed_h = fixed_h + scan.box_margin_top() + scan.box_margin_bottom()
                    if scan.height_percent > 0 {
                        fixed_h = fixed_h + (content_h * scan.height_percent) / 100
                    } else if scan.flex_grow > 0 {
                        flex_total = flex_total + scan.flex_grow
                    } else if scan.height > 0 && !scan.layout_height_owned {
                        fixed_h = fixed_h + scan.height
                    } else {
                        fixed_h = fixed_h + scan.preferred_height
                    }
                }
                scan = scan.next_sibling
            }
            if count > 1 {
                fixed_h = fixed_h + (count - 1) * self.spacing
            }
            let remaining_h: i64 = content_h - fixed_h
            while child != null {
                if !child.visible {
                    child = child.next_sibling
                    continue
                }
                let ml: i64 = child.box_margin_left()
                let mr: i64 = child.box_margin_right()
                let mt: i64 = child.box_margin_top()
                let mb: i64 = child.box_margin_bottom()
                child.x = self.x + self.padding + ml
                child.y = cy + mt
                if child.width_percent > 0 {
                    child.width = child.constrain_width(((content_w - ml - mr) * child.width_percent) / 100)
                    child.layout_width_owned = true
                } else if child.width == 0 || child.layout_width_owned {
                    child.width = child.constrain_width(content_w - ml - mr)
                    child.layout_width_owned = true
                } else {
                    child.width = child.constrain_width(child.width)
                    child.layout_width_owned = false
                }
                if child.height_percent > 0 {
                    child.height = child.constrain_height((content_h * child.height_percent) / 100)
                    child.layout_height_owned = true
                } else if child.flex_grow > 0 && flex_total > 0 {
                    let extra: i64 = 0
                    if remaining_h > 0 {
                        extra = (remaining_h * child.flex_grow) / flex_total
                    }
                    let base_h: i64 = child.preferred_height
                    child.height = child.constrain_height(base_h + extra)
                    child.layout_height_owned = true
                } else if child.width == 0 {
                    child.height = child.constrain_height(child.preferred_height)
                    child.layout_height_owned = true
                } else if child.height == 0 || child.layout_height_owned {
                    child.height = child.constrain_height(child.preferred_height)
                    child.layout_height_owned = true
                } else {
                    child.height = child.constrain_height(child.height)
                    child.layout_height_owned = false
                }
                child.layout_tree()
                cy = cy + mt + child.height + mb + self.spacing
                child = child.next_sibling
            }
            return
        }

        if self.layout == LAYOUT_ROW {
            let cx: i64 = self.x + self.padding
            let content_w: i64 = self.width - self.padding * 2
            let content_h: i64 = self.height - self.padding * 2
            let count: i64 = 0
            let fixed_w: i64 = 0
            let flex_total: i64 = 0
            let scan: Widget = self.first_child
            while scan != null {
                if scan.visible {
                    count = count + 1
                    fixed_w = fixed_w + scan.box_margin_left() + scan.box_margin_right()
                    if scan.width_percent > 0 {
                        fixed_w = fixed_w + (content_w * scan.width_percent) / 100
                    } else if scan.flex_grow > 0 {
                        flex_total = flex_total + scan.flex_grow
                    } else if scan.width > 0 && !scan.layout_width_owned {
                        fixed_w = fixed_w + scan.width
                    } else {
                        fixed_w = fixed_w + 96
                    }
                }
                scan = scan.next_sibling
            }
            if count > 1 {
                fixed_w = fixed_w + (count - 1) * self.spacing
            }
            let remaining_w: i64 = content_w - fixed_w
            while child != null {
                if !child.visible {
                    child = child.next_sibling
                    continue
                }
                let ml: i64 = child.box_margin_left()
                let mr: i64 = child.box_margin_right()
                let mt: i64 = child.box_margin_top()
                let mb: i64 = child.box_margin_bottom()
                child.x = cx + ml
                child.y = self.y + self.padding + mt
                if child.width_percent > 0 {
                    child.width = child.constrain_width((content_w * child.width_percent) / 100)
                    child.layout_width_owned = true
                } else if child.flex_grow > 0 && flex_total > 0 {
                    let extra: i64 = 0
                    if remaining_w > 0 {
                        extra = (remaining_w * child.flex_grow) / flex_total
                    }
                    let base_w: i64 = 96
                    if child.width > 0 && !child.layout_width_owned {
                        base_w = child.width
                    }
                    child.width = child.constrain_width(base_w + extra)
                    child.layout_width_owned = true
                } else if child.width == 0 {
                    child.width = child.constrain_width(96)
                    child.layout_width_owned = true
                } else {
                    child.width = child.constrain_width(child.width)
                    child.layout_width_owned = false
                }
                if child.height_percent > 0 {
                    child.height = child.constrain_height(((content_h - mt - mb) * child.height_percent) / 100)
                    child.layout_height_owned = true
                } else if child.height == 0 {
                    child.height = child.constrain_height(content_h - mt - mb)
                    child.layout_height_owned = true
                } else if child.layout_height_owned {
                    child.height = child.constrain_height(content_h - mt - mb)
                    child.layout_height_owned = true
                } else {
                    child.height = child.constrain_height(child.height)
                    child.layout_height_owned = false
                }
                child.layout_tree()
                cx = cx + ml + child.width + mr + self.spacing
                child = child.next_sibling
            }
            return
        }

        if self.layout == LAYOUT_WRAP {
            let content_w: i64 = self.width - self.padding * 2
            let content_h: i64 = self.height - self.padding * 2
            let cx: i64 = self.x + self.padding
            let cy: i64 = self.y + self.padding
            let row_h: i64 = 0
            while child != null {
                if !child.visible {
                    child = child.next_sibling
                    continue
                }
                let ml: i64 = child.box_margin_left()
                let mr: i64 = child.box_margin_right()
                let mt: i64 = child.box_margin_top()
                let mb: i64 = child.box_margin_bottom()
                let child_w: i64 = child.width
                if child.width_percent > 0 {
                    child_w = (content_w * child.width_percent) / 100
                    child.layout_width_owned = true
                } else if child_w == 0 || child.layout_width_owned {
                    child_w = child.preferred_height * 2
                    child.layout_width_owned = true
                }
                child_w = child.constrain_width(child_w)
                let child_h: i64 = child.height
                if child.height_percent > 0 {
                    child_h = (content_h * child.height_percent) / 100
                    child.layout_height_owned = true
                } else if child_h == 0 || child.layout_height_owned {
                    child_h = child.preferred_height
                    child.layout_height_owned = true
                }
                child_h = child.constrain_height(child_h)

                if cx > self.x + self.padding && cx + ml + child_w + mr > self.x + self.padding + content_w {
                    cx = self.x + self.padding
                    cy = cy + row_h + self.spacing
                    row_h = 0
                }

                child.x = cx + ml
                child.y = cy + mt
                child.width = child_w
                child.height = child_h
                child.layout_tree()
                let occupied_h: i64 = mt + child_h + mb
                if occupied_h > row_h {
                    row_h = occupied_h
                }
                cx = cx + ml + child_w + mr + self.spacing
                child = child.next_sibling
            }
            return
        }

        while child != null {
            child.layout_tree()
            child = child.next_sibling
        }
    }

    func draw_self(renderer: std.sdl.Renderer, font: TTF_Font*) {
        let visual_hover: bool = self.hover_background != self.background ||
            self.hover_foreground != self.foreground || self.hover_border != self.border
        let bg: u32 = mix_color(self.background, self.hover_background, self.hover_amount)
        let fg: u32 = mix_color(self.foreground, self.hover_foreground, self.hover_amount)
        let bd: u32 = mix_color(self.border, self.hover_border, self.hover_amount)
        let lift: i64 = self.hover_amount / 35
        let draw_y: i64 = self.y - lift

        if self.kind_id == WIDGET_MENUBAR {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y + self.height - 1, self.width, 1, bd)
            let cursor_x: i64 = self.x + 4
            let menu: Widget = self.first_child
            while menu != null {
                let item_w: i64 = menu.menu_label_width()
                menu.x = cursor_x
                menu.y = self.y
                menu.width = item_w
                menu.height = self.height
                if menu.menu_open {
                    draw_rect(renderer, cursor_x, self.y + 3, item_w, self.height - 6, mix_color(bg, self.accent, 22))
                }
                draw_text_box(renderer, font, cursor_x + 4, self.y, item_w - 8, self.height, menu.text, fg)
                cursor_x = cursor_x + item_w
                menu = menu.next_sibling
            }
            return
        }

        if self.kind_id == WIDGET_STATUSBAR {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, 1, bd)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
            let text_x: i64 = self.x + self.padding
            if self.icon != LIST_ICON_NONE {
                draw_widget_icon(renderer, self.icon, self.x + self.padding, self.y + (self.height - 18) / 2, mix_color(fg, bg, 45), bd)
                text_x = text_x + 24
            }
            if text_len(self.text) > 0 {
                draw_text_box(renderer, font, text_x, self.y, self.width - (text_x - self.x) - 32, self.height, self.text, fg)
            }
            let gx: i64 = self.x + self.width - 18
            let gy: i64 = self.y + self.height - 6
            draw_rect(renderer, gx + 10, gy, 5, 1, mix_color(fg, bg, 45))
            draw_rect(renderer, gx + 6, gy - 4, 9, 1, mix_color(fg, bg, 55))
            draw_rect(renderer, gx + 2, gy - 8, 13, 1, mix_color(fg, bg, 65))
            return
        }

        if self.kind_id == WIDGET_TABCONTAINER {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
            let tab_x: i64 = self.x + 4
            let tab_index: i64 = 0
            let page: Widget = self.first_child
            while page != null {
                if page.visible && page.kind_id == WIDGET_TABPAGE {
                    let tab_w: i64 = 120
                    let tab_bg: u32 = mix_color(bg, fg, 8)
                    if tab_index == self.selected_index {
                        tab_bg = mix_color(bg, self.accent, 22)
                    }
                    draw_rect(renderer, tab_x, self.y + 3, tab_w - 4, self.item_height - 3, tab_bg)
                    draw_outline(renderer, tab_x, self.y + 3, tab_w - 4, self.item_height - 3, bd)
                    let label: string = page.title
                    if text_len(label) == 0 {
                        label = page.text
                    }
                    if text_len(label) == 0 {
                        label = "Tab"
                    }
                    draw_text_box(renderer, font, tab_x, self.y + 3, tab_w - 4, self.item_height - 3, label, fg)
                    tab_x = tab_x + tab_w
                    tab_index = tab_index + 1
                }
                page = page.next_sibling
            }
            draw_outline(renderer, self.x + self.padding, self.y + self.item_height + self.padding,
                self.width - self.padding * 2, self.height - self.item_height - self.padding * 2, bd)
            return
        }

        if self.kind_id == WIDGET_PROGRESS {
            let bar_x: i64 = self.x
            let bar_y: i64 = self.y + (self.height - 12) / 2
            let fill_w: i64 = (self.width * self.value_percent()) / 100
            draw_rect(renderer, bar_x, bar_y, self.width, 12, self.track)
            draw_rect(renderer, bar_x, bar_y, fill_w, 12, self.accent)
            draw_outline(renderer, bar_x, bar_y, self.width, 12, bd)
            if text_len(self.text) > 0 {
                draw_text_box(renderer, font, self.x, self.y, self.width, self.height, self.text, fg)
            }
            return
        }

        if self.kind_id == WIDGET_SPINNER {
            let size: i64 = self.width
            if self.height < size {
                size = self.height
            }
            if size < 20 {
                size = 20
            }
            let cx: i64 = self.x + self.width / 2
            let cy: i64 = self.y + self.height / 2
            let r: i64 = size / 2 - 5
            let tick: i64 = size / 8
            if tick < 3 {
                tick = 3
            }
            let active: i64 = self.value % 8
            let i: i64 = 0
            while i < 8 {
                let tone: i64 = 22
                if i == active {
                    tone = 0
                } else if i == (active + 7) % 8 {
                    tone = 20
                } else if i == (active + 6) % 8 {
                    tone = 40
                } else {
                    tone = 66
                }
                let c: u32 = mix_color(self.accent, self.track, tone)
                if i == 0 {
                    draw_rect(renderer, cx - tick / 2, cy - r, tick, tick, c)
                } else if i == 1 {
                    draw_rect(renderer, cx + r / 2, cy - r / 2, tick, tick, c)
                } else if i == 2 {
                    draw_rect(renderer, cx + r, cy - tick / 2, tick, tick, c)
                } else if i == 3 {
                    draw_rect(renderer, cx + r / 2, cy + r / 2, tick, tick, c)
                } else if i == 4 {
                    draw_rect(renderer, cx - tick / 2, cy + r, tick, tick, c)
                } else if i == 5 {
                    draw_rect(renderer, cx - r / 2, cy + r / 2, tick, tick, c)
                } else if i == 6 {
                    draw_rect(renderer, cx - r, cy - tick / 2, tick, tick, c)
                } else {
                    draw_rect(renderer, cx - r / 2, cy - r / 2, tick, tick, c)
                }
                i = i + 1
            }
            if text_len(self.text) > 0 {
                draw_text_box(renderer, font, self.x + size + 6, self.y, self.width - size - 6, self.height, self.text, fg)
            }
            return
        }

        if self.kind_id == WIDGET_SLIDER {
            let track_y: i64 = self.y + self.height / 2 - 3
            let usable: i64 = self.width - self.padding * 2
            let pct: i64 = self.value_percent()
            let fill_w: i64 = (usable * pct) / 100
            let thumb_x: i64 = self.x + self.padding + fill_w - 6
            draw_rect(renderer, self.x + self.padding, track_y, usable, 6, self.track)
            draw_rect(renderer, self.x + self.padding, track_y, fill_w, 6, self.accent)
            draw_rect(renderer, thumb_x, track_y - 5, 12, 16, mix_color(self.accent, self.hover_border, self.hover_amount))
            draw_outline(renderer, thumb_x, track_y - 5, 12, 16, bd)
            return
        }

        if self.kind_id == WIDGET_SCROLLBAR {
            let track_x: i64 = self.x + self.width / 2 - 4
            let usable: i64 = self.height - self.padding * 2
            if usable <= 0 {
                draw_rect(renderer, self.x, self.y, self.width, self.height, self.track)
                draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
                return
            }
            let pct: i64 = self.value_percent()
            let thumb_h: i64 = self.height / 4
            if thumb_h < 24 {
                thumb_h = 24
            }
            if thumb_h > usable {
                thumb_h = usable
            }
            let travel: i64 = usable - thumb_h
            let thumb_y: i64 = self.y + self.padding + (travel * pct) / 100
            draw_rect(renderer, track_x, self.y + self.padding, 8, usable, self.track)
            draw_rect(renderer, track_x, self.y + self.padding, 8, thumb_y - (self.y + self.padding), mix_color(self.track, self.accent, 28))
            draw_rect(renderer, self.x + 2, thumb_y, self.width - 4, thumb_h, mix_color(self.accent, self.hover_border, self.hover_amount))
            draw_outline(renderer, self.x + 2, thumb_y, self.width - 4, thumb_h, bd)
            return
        }

        if self.kind_id == WIDGET_CHECKBOX {
            let box_size: i64 = 18
            let box_y: i64 = self.y + (self.height - box_size) / 2
            draw_rect(renderer, self.x, box_y, box_size, box_size, bg)
            draw_outline(renderer, self.x, box_y, box_size, box_size, bd)
            if self.checked {
                draw_rect(renderer, self.x + 4, box_y + 8, 4, 6, self.accent)
                draw_rect(renderer, self.x + 8, box_y + 5, 8, 4, self.accent)
            }
            if text_len(self.text) > 0 {
                draw_text_box(renderer, font, self.x + 24, self.y, self.width - 24, self.height, self.text, fg)
            }
            return
        }

        if self.kind_id == WIDGET_BADGE {
            draw_rect(renderer, self.x, draw_y + 4, self.width, self.height - 8, bg)
            draw_outline(renderer, self.x, draw_y + 4, self.width, self.height - 8, bd)
            if text_len(self.text) > 0 {
                draw_text_box(renderer, font, self.x, draw_y, self.width, self.height, self.text, fg)
            }
            return
        }

        if self.kind_id == WIDGET_TEXTBOX {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
            if self.focused {
                draw_outline(renderer, self.x + 1, self.y + 1, self.width - 2, self.height - 2, self.accent)
            }
            let display_text: string = self.text
            let display_color: u32 = fg
            if text_len(display_text) == 0 {
                display_text = self.placeholder
                display_color = mix_color(fg, bg, 45)
            }
            draw_text_box(renderer, font, self.x, self.y, self.width, self.height, display_text, display_color)
            if self.focused {
                self.clamp_caret()
                let caret_x: i64 = self.x + 10 + self.caret_index * 7
                draw_rect(renderer, caret_x, self.y + 8, 2, self.height - 16, self.accent)
            }
            return
        }

        if self.kind_id == WIDGET_COMBOBOX {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
            draw_rect(renderer, self.x + self.width - 34, self.y + 1, 33, self.height - 2, mix_color(bg, self.accent, 14))
            draw_disclosure(renderer, self.x + self.width - 26, self.y + (self.height - 18) / 2, true, fg)
            draw_text_box(renderer, font, self.x, self.y, self.width - 34, self.height, self.text, fg)
            return
        }

        if self.kind_id == WIDGET_TERMINAL {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)
            if self.focused {
                draw_outline(renderer, self.x + 1, self.y + 1, self.width - 2, self.height - 2, self.accent)
            }

            let line_h: i64 = 18
            let input_h: i64 = 26
            let area_h: i64 = self.height - self.padding * 2 - input_h
            let visible_lines: i64 = area_h / line_h
            let count: i64 = count_list_items(self.items_text)
            let start: i64 = 0
            if count > visible_lines {
                start = count - visible_lines
            }
            let i: i64 = start
            let y: i64 = self.y + self.padding
            while i < count && y < self.y + self.height - self.padding - input_h {
                draw_text(renderer, font, self.x + self.padding, y, get_list_item_at(self.items_text, i), fg)
                y = y + line_h
                i = i + 1
            }

            let input_y: i64 = self.y + self.height - self.padding - input_h
            draw_rect(renderer, self.x + self.padding, input_y, self.width - self.padding * 2, input_h, mix_color(bg, fg, 7))
            draw_outline(renderer, self.x + self.padding, input_y, self.width - self.padding * 2, input_h, mix_color(bd, self.accent, 25))
            let prompt_len: i64 = text_len(self.terminal_prompt)
            let cmd_len: i64 = text_len(self.text)
            let buf: char* = malloc(prompt_len + cmd_len + 1) as char*
            let p: i64 = 0
            while p < prompt_len {
                buf[p] = self.terminal_prompt[p]
                p = p + 1
            }
            let c: i64 = 0
            while c < cmd_len {
                buf[p + c] = self.text[c]
                c = c + 1
            }
            buf[p + cmd_len] = 0
            draw_text_box(renderer, font, self.x + self.padding, input_y, self.width - self.padding * 2, input_h, buf as string, fg)
            if self.focused {
                self.clamp_caret()
                let caret_x: i64 = self.x + self.padding + 10 + (prompt_len + self.caret_index) * 7
                draw_rect(renderer, caret_x, input_y + 6, 2, input_h - 12, self.accent)
            }
            return
        }

        if self.kind_id == WIDGET_MSGBOX || self.kind_id == WIDGET_INPUTBOX {
            draw_rect(renderer, self.x + 3, self.y + 5, self.width, self.height, 0x44000000 as u32)
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)

            if text_len(self.title) > 0 {
                draw_text_box(renderer, font, self.x + 18, self.y + 12, self.width - 36, 28, self.title, fg)
            }
            draw_msgbox_icon(renderer, self.icon, self.x + 18, self.y + 48, bg, self.accent)
            draw_text_box(renderer, font, self.x + 56, self.y + 46, self.width - 76, 42, self.message, fg)

            if self.kind_id == WIDGET_INPUTBOX {
                let input_x: i64 = self.x + 52
                let input_y: i64 = self.y + 92
                let input_w: i64 = self.width - 72
                let input_h: i64 = 36
                draw_rect(renderer, input_x, input_y, input_w, input_h, mix_color(bg, fg, 6))
                draw_outline(renderer, input_x, input_y, input_w, input_h, bd)
                if self.focused {
                    draw_outline(renderer, input_x + 1, input_y + 1, input_w - 2, input_h - 2, self.accent)
                }
                let input_text: string = self.text
                let input_color: u32 = fg
                if text_len(input_text) == 0 {
                    input_text = self.placeholder
                    input_color = mix_color(fg, bg, 45)
                }
                draw_text_box(renderer, font, input_x, input_y, input_w, input_h, input_text, input_color)
                if self.focused {
                    self.clamp_caret()
                    let caret_x: i64 = input_x + 10 + self.caret_index * 7
                    draw_rect(renderer, caret_x, input_y + 8, 2, input_h - 16, self.accent)
                }
            }

            let count: i64 = self.dialog_button_count()
            let button_w: i64 = 88
            let button_h: i64 = 32
            let gap: i64 = 10
            let total_w: i64 = count * button_w + (count - 1) * gap
            let start_x: i64 = self.x + self.width - total_w - 20
            let button_y: i64 = self.y + self.height - button_h - 18
            let i: i64 = 0
            while i < count {
                let button_x: i64 = start_x + i * (button_w + gap)
                let button_bg: u32 = self.accent
                if i > 0 {
                    button_bg = mix_color(bg, fg, 10)
                }
                draw_rect(renderer, button_x, button_y, button_w, button_h, button_bg)
                draw_outline(renderer, button_x, button_y, button_w, button_h, bd)
                draw_text_box(renderer, font, button_x, button_y, button_w, button_h, self.dialog_button_label(i), fg)
                i = i + 1
            }
            return
        }

        if self.kind_id == WIDGET_GROUPBOX {
            draw_rect(renderer, self.x, self.y + 8, self.width, self.height - 8, bg)
            draw_outline(renderer, self.x, self.y + 8, self.width, self.height - 8, bd)
            if text_len(self.title) > 0 {
                draw_rect(renderer, self.x + 10, self.y, text_len(self.title) * 8 + 16, 20, bg)
                draw_text(renderer, font, self.x + 18, self.y + 1, self.title, fg)
            }
            return
        }

        if self.kind_id == WIDGET_LIST {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)

            let item_y: i64 = self.y + 4
            let item_w: i64 = self.width - 8
            let i: i64 = self.scroll_offset
            let item_count: i64 = self.list_item_count()

            while i < item_count && item_y < self.y + self.height - 4 {
                let list_item: ListItem = self.list_item_at(i)
                let item: string = get_list_item_at(self.items_text, i)
                let icon: i64 = LIST_ICON_NONE
                if list_item != null {
                    item = list_item.text
                    icon = list_item.icon
                }
                let item_bg: u32 = bg
                if i == self.selected_index {
                    item_bg = mix_color(bg, self.accent, 26)
                } else if (i % 2) == 1 {
                    item_bg = mix_color(bg, fg, 5)
                }
                draw_rect(renderer, self.x + 4, item_y, item_w, self.item_height, item_bg)
                if i == self.selected_index {
                    draw_rect(renderer, self.x + 4, item_y, 3, self.item_height, self.accent)
                }
                if icon == LIST_ICON_FOLDER {
                    draw_folder_icon(renderer, self.x + 12, item_y + 3, mix_color(self.accent, bg, 15), bd)
                } else if icon == LIST_ICON_IMAGE {
                    draw_image_icon(renderer, self.x + 12, item_y + 3, mix_color(self.accent, fg, 35), bd)
                } else {
                    draw_file_icon(renderer, self.x + 12, item_y + 3, mix_color(fg, bg, 55), bd)
                }
                draw_text(renderer, font, self.x + 38, item_y + 2, item, fg)
                item_y = item_y + self.item_height
                i = i + 1
            }
            return
        }

        if self.kind_id == WIDGET_TREEVIEW {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)

            let item_y: i64 = self.y + 4
            let item_w: i64 = self.width - 8
            let visible_index: i64 = 0
            let drawn_index: i64 = 0
            let tree_item: TreeItem = self.first_tree_item

            while tree_item != null && item_y < self.y + self.height - 4 {
                if self.tree_item_visible(tree_item) {
                    if visible_index >= self.scroll_offset {
                        let item_bg: u32 = bg
                        if visible_index == self.selected_index {
                            item_bg = mix_color(bg, self.accent, 26)
                        } else if (drawn_index % 2) == 1 {
                            item_bg = mix_color(bg, fg, 5)
                        }
                        draw_rect(renderer, self.x + 4, item_y, item_w, self.item_height, item_bg)
                        if visible_index == self.selected_index {
                            draw_rect(renderer, self.x + 4, item_y, 3, self.item_height, self.accent)
                        }

                        let indent_x: i64 = self.x + 10 + tree_item.indent * 18
                        if tree_item.is_folder {
                            draw_disclosure(renderer, indent_x, item_y + 5, tree_item.expanded, fg)
                            draw_folder_icon(renderer, indent_x + 18, item_y + 3, mix_color(self.accent, bg, 10), bd)
                            draw_text(renderer, font, indent_x + 44, item_y + 2, tree_item.text, fg)
                        } else {
                            draw_file_icon(renderer, indent_x + 18, item_y + 3, mix_color(fg, bg, 55), bd)
                            draw_text(renderer, font, indent_x + 44, item_y + 2, tree_item.text, fg)
                        }
                        item_y = item_y + self.item_height
                        drawn_index = drawn_index + 1
                    }
                    visible_index = visible_index + 1
                }
                tree_item = tree_item.next
            }
            return
        }

        if self.kind_id == WIDGET_CANVAS {
            draw_rect(renderer, self.x, self.y, self.width, self.height, self.canvas_background)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)

            let cmd: CanvasCommand = self.first_canvas_command
            while cmd != null {
                set_color(renderer, cmd.color)
                if cmd.op == CANVAS_OP_POINT {
                    renderer.draw_point((self.x + cmd.x1) as float, (self.y + cmd.y1) as float)
                } else if cmd.op == CANVAS_OP_LINE {
                    renderer.draw_line((self.x + cmd.x1) as float, (self.y + cmd.y1) as float,
                        (self.x + cmd.x2) as float, (self.y + cmd.y2) as float)
                } else if cmd.op == CANVAS_OP_RECT {
                    let rect_cmd: SDL_Rect = new SDL_Rect((self.x + cmd.x1) as i32, (self.y + cmd.y1) as i32,
                        cmd.x2 as i32, cmd.y2 as i32)
                    renderer.draw_rect(rect_cmd)
                } else if cmd.op == CANVAS_OP_FILL_RECT {
                    let fill_cmd: SDL_Rect = new SDL_Rect((self.x + cmd.x1) as i32, (self.y + cmd.y1) as i32,
                        cmd.x2 as i32, cmd.y2 as i32)
                    renderer.fill_rect(fill_cmd)
                } else if cmd.op == CANVAS_OP_CLEAR {
                    draw_rect(renderer, self.x, self.y, self.width, self.height, cmd.color)
                }
                cmd = cmd.next
            }
            return
        }

        if self.kind_id == WIDGET_PICTURE {
            draw_rect(renderer, self.x, self.y, self.width, self.height, bg)
            draw_outline(renderer, self.x, self.y, self.width, self.height, bd)

            if !self.image_loaded && !self.image_failed && text_len(self.image_path) > 0 {
                let surface: SDL_Surface* = std.sdl.SDL_LoadPNG(self.image_path as char*)
                if surface != null {
                    let loaded_texture: SDL_Texture* = std.sdl.SDL_CreateTextureFromSurface(renderer.get_handle(), surface)
                    std.sdl.SDL_DestroySurface(surface)
                    if loaded_texture != null {
                        self.image_texture = loaded_texture
                        self.image_loaded = true
                    } else {
                        self.image_failed = true
                    }
                } else {
                    self.image_failed = true
                }
            }

            if self.image_texture != null {
                let dst: SDL_FRect = new SDL_FRect((self.x + 1) as float, (self.y + 1) as float,
                    (self.width - 2) as float, (self.height - 2) as float)
                std.sdl.SDL_RenderTexture(renderer.get_handle(), self.image_texture, null, &dst)
            } else {
                draw_image_icon(renderer, self.x + self.width / 2 - 10, self.y + self.height / 2 - 10, mix_color(fg, bg, 45), bd)
                if self.image_failed {
                    draw_text_box(renderer, font, self.x, self.y + self.height - 28, self.width, 24, "image failed", mix_color(fg, bg, 30))
                } else if text_len(self.image_path) == 0 {
                    draw_text_box(renderer, font, self.x, self.y + self.height - 28, self.width, 24, "no image", mix_color(fg, bg, 30))
                }
            }
            return
        }

        if visual_hover && self.hover_amount > 0 {
            draw_rect(renderer, self.x + 1, self.y + 2, self.width, self.height, 0x22000000 as u32)
        }
        draw_rect(renderer, self.x, draw_y, self.width, self.height, bg)
        draw_outline(renderer, self.x, draw_y, self.width, self.height, bd)

        if self.selectable && self.selection_start != self.selection_end {
            let start: i64 = self.selection_start
            let end: i64 = self.selection_end
            if end < start {
                let tmp: i64 = start
                start = end
                end = tmp
            }
            let sel_x: i64 = self.x + 10 + start * 7
            let sel_w: i64 = (end - start) * 7
            draw_rect(renderer, sel_x, draw_y + 5, sel_w, self.height - 10, self.selection)
        }

        if self.kind_id != WIDGET_WINDOW && text_len(self.title) > 0 {
            draw_text_box(renderer, font, self.x, draw_y, self.width, self.height, self.title, fg)
        }
        if text_len(self.text) > 0 {
            draw_text_box(renderer, font, self.x, draw_y, self.width, self.height, self.text, fg)
        }
    }

    func draw_combo_popup(renderer: std.sdl.Renderer, font: TTF_Font*) {
        if self.kind_id == WIDGET_COMBOBOX && self.combo_open {
            let bg: u32 = mix_color(self.background, self.hover_background, self.hover_amount)
            let fg: u32 = mix_color(self.foreground, self.hover_foreground, self.hover_amount)
            let bd: u32 = mix_color(self.border, self.hover_border, self.hover_amount)
            if self.combo_open {
                let count: i64 = self.list_item_count()
                let option_y: i64 = self.y + self.height
                let i: i64 = 0
                while i < count {
                    let option: ListItem = self.list_item_at(i)
                    let option_bg: u32 = bg
                    if i == self.selected_index {
                        option_bg = mix_color(bg, self.accent, 26)
                    } else if (i % 2) == 1 {
                        option_bg = mix_color(bg, fg, 5)
                    }
                    draw_rect(renderer, self.x, option_y, self.width, self.item_height, option_bg)
                    draw_outline(renderer, self.x, option_y, self.width, self.item_height, bd)
                    if option != null {
                        draw_text(renderer, font, self.x + 10, option_y + 3, option.text, fg)
                    }
                    option_y = option_y + self.item_height
                    i = i + 1
                }
            }
        }
    }

    func draw_menu_popup(renderer: std.sdl.Renderer, font: TTF_Font*) {
        if self.kind_id == WIDGET_MENU && self.menu_open {
            let bg: u32 = self.background
            let fg: u32 = self.foreground
            let bd: u32 = self.border
            let popup_w: i64 = self.menu_popup_width()
            let popup_h: i64 = self.menu_item_count() * self.item_height
            let popup_x: i64 = self.x
            let popup_y: i64 = self.y + self.height
            draw_rect(renderer, popup_x, popup_y, popup_w, popup_h, bg)
            draw_outline(renderer, popup_x, popup_y, popup_w, popup_h, bd)

            let item_y: i64 = popup_y
            let item: Widget = self.first_child
            while item != null {
                let item_bg: u32 = bg
                if item.menu_open {
                    item_bg = mix_color(bg, self.accent, 22)
                }
                draw_rect(renderer, popup_x + 2, item_y + 1, popup_w - 4, self.item_height - 2, item_bg)
                draw_widget_icon(renderer, item.icon, popup_x + 8, item_y + 4, mix_color(fg, bg, 55), bd)
                draw_text(renderer, font, popup_x + 34, item_y + 3, item.text, fg)
                if item.first_child != null {
                    draw_disclosure(renderer, popup_x + popup_w - 20, item_y + 5, false, fg)
                }
                if item.menu_open && item.first_child != null {
                    item.x = popup_x + popup_w
                    item.y = item_y - self.item_height
                } else {
                    item.x = popup_x
                    item.y = item_y
                }
                item.width = popup_w
                item.height = self.item_height
                item_y = item_y + self.item_height
                item = item.next_sibling
            }
        }

        let child: Widget = self.first_child
        while child != null {
            child.draw_menu_popup(renderer, font)
            child = child.next_sibling
        }
    }

    func render(renderer: std.sdl.Renderer, font: TTF_Font*) {
        if !self.visible {
            return
        }
        self.draw_self(renderer, font)

        if self.kind_id == WIDGET_MENUBAR || self.kind_id == WIDGET_MENU {
            return
        }

        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.render(renderer, font)
            }
            child = child.next_sibling
        }
    }

    func render_popups(renderer: std.sdl.Renderer, font: TTF_Font*) {
        if !self.visible {
            return
        }
        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                child.render_popups(renderer, font)
            }
            child = child.next_sibling
        }
        self.draw_combo_popup(renderer, font)
        self.draw_menu_popup(renderer, font)
    }

    func dispatch_click(px: i64, py: i64) -> bool {
        if !self.visible {
            return false
        }
        let child: Widget = self.first_child
        while child != null {
            if self.child_active_for_traversal(child) {
                if child.dispatch_click(px, py) {
                    return true
                }
            }
            child = child.next_sibling
        }

        if self.contains(px, py) && self.has_onClick {
            let handler: () -> void = self.onClick
            handler()
            return true
        }
        return false
    }
}

