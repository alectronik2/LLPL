// SDL-backed UI runtime for the `ui Name: Root { ... }` DSL.
// The DSL lowers into ordinary constructors, field assignments, and
// add_child() calls against these classes.

import "../sdl/sdl_core.llpl"
import "../sdl/sdl_window.llpl"
import "../sdl/sdl_ttf.llpl"

extern func malloc(size: i64) -> char*

namespace std {
namespace ui {

