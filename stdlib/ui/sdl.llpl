class List : Widget {
    constructor() {
        super("List")
        self.kind_id = WIDGET_LIST
        self.background = 0xFFEDEFF5 as u32
        self.hover_background = 0xFFF5F7FC as u32
        self.border = LIGHT_BORDER
        self.hover_border = 0xFF99A5B8 as u32
        self.foreground = LIGHT_TEXT
        self.hover_foreground = self.foreground
        self.preferred_height = 150
        self.item_height = 24
    }

    func add_item(item: string) {
        if text_len(self.items_text) == 0 {
            self.items_text = item
        } else {
            let buf: char* = malloc(4096) as char*
            let i: i64 = 0
            while self.items_text[i] != 0 && i < 4095 {
                buf[i] = self.items_text[i]
                i = i + 1
            }
            buf[i] = '\n'
            i = i + 1
            let j: i64 = 0
            while item[j] != 0 && i < 4095 {
                buf[i] = item[j]
                i = i + 1
                j = j + 1
            }
            buf[i] = 0
            self.items_text = buf as string
        }
    }

    func get_selected_item() -> string {
        if text_len(self.items_text) == 0 {
            return "" as string
        }
        return get_list_item_at(self.items_text, self.selected_index)
    }
}

class TreeView : Widget {
    constructor() {
        super("TreeView")
        self.kind_id = WIDGET_TREEVIEW
        self.background = 0xFFEDEFF5 as u32
        self.hover_background = 0xFFF5F7FC as u32
        self.border = LIGHT_BORDER
        self.hover_border = 0xFF99A5B8 as u32
        self.foreground = LIGHT_TEXT
        self.hover_foreground = self.foreground
        self.preferred_height = 200
        self.item_height = 24
    }

    func add_item(item: string, indent: i64) {
        let prefix: char[256]
        let i: i64 = 0
        while i < indent && i < 250 {
            prefix[i] = ' '
            prefix[i + 1] = ' '
            i = i + 2
        }
        prefix[i] = 0

        let full_item: char* = malloc(4096) as char*
        let j: i64 = 0
        while prefix[j] != 0 && j < 256 {
            full_item[j] = prefix[j]
            j = j + 1
        }
        let k: i64 = 0
        while item[k] != 0 && j < 4095 {
            full_item[j] = item[k]
            j = j + 1
            k = k + 1
        }
        full_item[j] = 0

        if text_len(self.items_text) == 0 {
            self.items_text = full_item as string
        } else {
            let buf: char* = malloc(8192) as char*
            let idx: i64 = 0
            while self.items_text[idx] != 0 && idx < 8191 {
                buf[idx] = self.items_text[idx]
                idx = idx + 1
            }
            buf[idx] = '\n'
            idx = idx + 1
            let m: i64 = 0
            while full_item[m] != 0 && idx < 8191 {
                buf[idx] = full_item[m]
                idx = idx + 1
                m = m + 1
            }
            buf[idx] = 0
            self.items_text = buf as string
        }
    }

    func get_selected_item() -> string {
        if text_len(self.items_text) == 0 {
            return "" as string
        }
        return get_list_item_at(self.items_text, self.selected_index)
    }
}

class App {
    let window: std.sdl.Window
    let renderer: std.sdl.Renderer
    let events: std.sdl.EventHandler
    let root: Widget
    let font: TTF_Font*
    let mouse_x: i64
    let mouse_y: i64
    let mouse_down: bool
    let running: bool
    let valid: bool
    let ttf_ready: bool

    constructor(title: string, width: i64, height: i64, root: Widget) {
        self.valid = false
        self.ttf_ready = false
        self.font = null
        self.mouse_x = -1
        self.mouse_y = -1
        self.mouse_down = false
        let init_result = std.sdl.SDL.init(std.sdl.SDL_INIT_VIDEO | std.sdl.SDL_INIT_EVENTS)
        if init_result.is_err() {
            puts(init_result.get_err())
        } else {
            self.window = new std.sdl.Window(new String(title), width, height, std.sdl.SDL_WINDOW_RESIZABLE)
            if !self.window.is_valid() {
                puts(std.sdl.SDL_GetError())
            } else {
                self.window.show()
                self.renderer = new std.sdl.Renderer(self.window)
                if !self.renderer.is_valid() {
                    puts(std.sdl.SDL_GetError())
                } else {
                    self.renderer.set_blend_mode(std.sdl.SDL_BLENDMODE_BLEND)
                    if std.sdl.TTF_Init() {
                        self.ttf_ready = true
                        self.font = std.sdl.TTF_OpenFont(DEFAULT_FONT_PATH, 16.0)
                        if self.font == null {
                            self.font = std.sdl.TTF_OpenFont(FALLBACK_FONT_PATH, 16.0)
                        }
                        if self.font == null {
                            self.font = std.sdl.TTF_OpenFont(FALLBACK_FONT_PATH_2, 16.0)
                        }
                        if self.font == null {
                            puts(std.sdl.SDL_GetError())
                        }
                    } else {
                        puts(std.sdl.SDL_GetError())
                    }
                    self.events = new std.sdl.EventHandler()
                    self.root = root
                    self.root.x = 0
                    self.root.y = 0
                    self.root.width = width
                    self.root.height = height
                    self.running = true
                    self.valid = true
                }
            }
        }
    }

    func is_valid() -> bool {
        return self.valid
    }

    func run() {
        if !self.is_valid() {
            return
        }
        while self.running {
            while self.events.poll() {
                if self.events.is_quit() {
                    self.running = false
                }
                if self.events.is_key_down() {
                    let key: SDL_KeyboardEvent* = self.events.get_key_event()
                    if (*key).key == std.sdl.SDLK_ESCAPE {
                        self.running = false
                    }
                }
                if self.events.is_mouse_button_down() {
                    let mouse: SDL_MouseButtonEvent* = self.events.get_mouse_button_event()
                    self.mouse_x = (*mouse).x as i64
                    self.mouse_y = (*mouse).y as i64
                    if (*mouse).button == std.sdl.SDL_BUTTON_LEFT {
                        self.mouse_down = true
                        self.root.begin_pointer(self.mouse_x, self.mouse_y)
                        self.root.dispatch_click((*mouse).x as i64, (*mouse).y as i64)
                    }
                }
                if self.events.is_mouse_button_up() {
                    let up: SDL_MouseButtonEvent* = self.events.get_mouse_button_event()
                    self.mouse_x = (*up).x as i64
                    self.mouse_y = (*up).y as i64
                    if (*up).button == std.sdl.SDL_BUTTON_LEFT {
                        self.mouse_down = false
                        self.root.end_pointer(self.mouse_x, self.mouse_y)
                    }
                }
                if self.events.is_mouse_motion() {
                    let motion: SDL_MouseMotionEvent* = self.events.get_mouse_motion_event()
                    self.mouse_x = (*motion).x as i64
                    self.mouse_y = (*motion).y as i64
                    if self.mouse_down {
                        self.root.drag_pointer(self.mouse_x, self.mouse_y)
                    }
                }
                if self.events.is_window_resized() {
                    let resized: SDL_WindowEvent* = self.events.get_window_event()
                    if (*resized).data1 > 0 && (*resized).data2 > 0 {
                        self.window.width = (*resized).data1 as i64
                        self.window.height = (*resized).data2 as i64
                        self.root.width = self.window.width
                        self.root.height = self.window.height
                    }
                }
            }

            self.root.layout_tree()
            self.root.update_hover(self.mouse_x, self.mouse_y)
            self.root.animate()
            set_color(self.renderer, self.root.background)
            self.renderer.clear()
            self.root.render(self.renderer, self.font)
            self.renderer.present()
            std.sdl.SDL.delay(16)
        }
        if self.font != null {
            std.sdl.TTF_CloseFont(self.font)
            self.font = null
        }
        if self.ttf_ready {
            std.sdl.TTF_Quit()
            self.ttf_ready = false
        }
        std.sdl.SDL.quit()
    }
}

} // namespace ui
} // namespace std
