        self.background = 0xFF0F1720 as u32
        self.hover_background = self.background
        self.foreground = 0xFFE6F4EA as u32
        self.hover_foreground = self.foreground
        self.border = 0xFF2D3748 as u32
        self.hover_border = 0xFF4A5568 as u32
        self.accent = 0xFF26A890 as u32
        self.preferred_height = 220
        self.padding = 10
        self.terminal_prompt = "> "
    }

    func append_line(line: string) {
        self.terminal_append_line(line)
    }

    func clear() {
        self.terminal_clear()
    }

    func submit() {
        self.terminal_submit()
    }

    func set_prompt(prompt: string) {
        self.terminal_prompt = prompt
    }
}

class MsgBox : Widget {
    constructor() {
        super("MsgBox")
        self.kind_id = WIDGET_MSGBOX
        self.background = 0xFFFFFFFF as u32
        self.hover_background = 0xFFF5F7FC as u32
        self.border = LIGHT_BORDER
        self.hover_border = 0xFF99A5B8 as u32
        self.foreground = LIGHT_TEXT
        self.hover_foreground = self.foreground
        self.accent = LIGHT_BUTTON_BG
        self.width = 380
        self.height = 170
        self.preferred_height = 170
        self.padding = 16
        self.button_mode = MSGBOX_BUTTONS_OK
        self.icon = MSGBOX_ICON_INFO
        self.result = MSGBOX_RESULT_NONE
        self.visible = false
    }

    func show(message: string, icon: i64, buttons: i64) {
        self.message = message
        self.icon = icon
        self.button_mode = buttons
        self.result = MSGBOX_RESULT_NONE
        self.visible = true
    }

    func hide() {
        self.visible = false
        self.focused = false
    }

    func accept() {
        self.close_dialog(MSGBOX_RESULT_OK)
    }

    func cancel() {
        self.close_dialog(MSGBOX_RESULT_CANCEL)
    }
}

class InputBox : MsgBox {
    constructor() {
        super()
        self.kind = "InputBox"
        self.kind_id = WIDGET_INPUTBOX
        self.height = 220
        self.preferred_height = 220
        self.placeholder = ""
        self.icon = MSGBOX_ICON_QUESTION
    }

    func ask(message: string, placeholder: string, buttons: i64) {
        self.message = message
        self.placeholder = placeholder
        self.button_mode = buttons
        self.result = MSGBOX_RESULT_NONE
        self.text = ""
        self.caret_index = 0
        self.focused = true
        self.visible = true
    }

    func value() -> string {
        return self.text
    }
}

class App {
    let window: std.sdl.Window
    let renderer: std.sdl.Renderer
    let events: std.sdl.EventHandler
    let root: Widget
    let font: TTF_Font*
    let mouse_x: i64
    let mouse_y: i64
    let mouse_down: bool
    let running: bool
    let valid: bool
    let ttf_ready: bool

    constructor(title: string, width: i64, height: i64, root: Widget) {
        self.valid = false
        self.ttf_ready = false
        self.font = null
        self.mouse_x = -1
        self.mouse_y = -1
        self.mouse_down = false
        let init_result = std.sdl.SDL.init(std.sdl.SDL_INIT_VIDEO | std.sdl.SDL_INIT_EVENTS)
        if init_result.is_err() {
            puts(init_result.get_err())
        } else {
            let window_title: string = title
            if root != null && text_len(root.title) > 0 {
                window_title = root.title
            }
            self.window = new std.sdl.Window(new String(window_title), width, height, std.sdl.SDL_WINDOW_RESIZABLE)
            if !self.window.is_valid() {
                puts(std.sdl.SDL_GetError())
            } else {
                self.window.show()
                self.renderer = new std.sdl.Renderer(self.window)
                if !self.renderer.is_valid() {
                    puts(std.sdl.SDL_GetError())
                } else {
                    self.renderer.set_blend_mode(std.sdl.SDL_BLENDMODE_BLEND)
                    if std.sdl.TTF_Init() {
                        self.ttf_ready = true
                        self.font = std.sdl.TTF_OpenFont(DEFAULT_FONT_PATH, 16.0)
                        if self.font == null {
                            self.font = std.sdl.TTF_OpenFont(FALLBACK_FONT_PATH, 16.0)
                        }
                        if self.font == null {
                            self.font = std.sdl.TTF_OpenFont(FALLBACK_FONT_PATH_2, 16.0)
                        }
                        if self.font == null {
                            puts(std.sdl.SDL_GetError())
                        }
                    } else {
                        puts(std.sdl.SDL_GetError())
                    }
                    self.events = new std.sdl.EventHandler()
                    self.root = root
                    self.root.x = 0
                    self.root.y = 0
                    self.root.width = width
                    self.root.height = height
                    std.sdl.SDL_StartTextInput(self.window.get_handle())
                    self.running = true
                    self.valid = true
                }
            }
        }
    }

    func is_valid() -> bool {
        return self.valid
    }

    func run() {
        if !self.is_valid() {
            return
        }
        while self.running {
            while self.events.poll() {
                if self.events.is_quit() {
                    self.running = false
                }
                if self.events.is_key_down() {
                    let key: SDL_KeyboardEvent* = self.events.get_key_event()
                    if (*key).key == std.sdl.SDLK_ESCAPE {
                        self.running = false
                    }
                    if (*key).key == std.sdl.SDLK_BACKSPACE {
                        let target: Widget = self.root.focused_textbox()
                        if target != null {
                            target.backspace_text()
                        }
                    }
                    if (*key).key == std.sdl.SDLK_LEFT {
                        let target: Widget = self.root.focused_textbox()
                        if target != null {
                            target.move_caret_left()
                        }
                    }
                    if (*key).key == std.sdl.SDLK_RIGHT {
                        let target: Widget = self.root.focused_textbox()
                        if target != null {
                            target.move_caret_right()
                        }
                    }
                    if (*key).key == std.sdl.SDLK_RETURN {
                        let target: Widget = self.root.focused_textbox()
                        if target != null && target.kind_id == WIDGET_TERMINAL {
                            target.terminal_submit()
                        }
                    }
                }
                if self.events.is_text_input() {
                    let text_event: SDL_TextInputEvent* = self.events.get_text_input_event()
                    let target: Widget = self.root.focused_textbox()
                    if target != null && (*text_event).text != null {
                        target.append_text((*text_event).text as string)
                    }
                }
                if self.events.is_mouse_button_down() {
                    let mouse: SDL_MouseButtonEvent* = self.events.get_mouse_button_event()
                    self.mouse_x = (*mouse).x as i64
                    self.mouse_y = (*mouse).y as i64
                    if (*mouse).button == std.sdl.SDL_BUTTON_LEFT {
                        self.mouse_down = true
                        self.root.clear_text_focus()
                        if !self.root.begin_pointer(self.mouse_x, self.mouse_y) {
                            self.root.clear_interaction_focus()
                        }
                        self.root.dispatch_click((*mouse).x as i64, (*mouse).y as i64)
                    }
                }
                if self.events.is_mouse_button_up() {
                    let up: SDL_MouseButtonEvent* = self.events.get_mouse_button_event()
                    self.mouse_x = (*up).x as i64
                    self.mouse_y = (*up).y as i64
                    if (*up).button == std.sdl.SDL_BUTTON_LEFT {
                        self.mouse_down = false
                        self.root.end_pointer(self.mouse_x, self.mouse_y)
                    }
                }
                if self.events.is_mouse_motion() {
                    let motion: SDL_MouseMotionEvent* = self.events.get_mouse_motion_event()
                    self.mouse_x = (*motion).x as i64
                    self.mouse_y = (*motion).y as i64
                    if self.mouse_down {
                        self.root.drag_pointer(self.mouse_x, self.mouse_y)
                    }
                }
                if self.events.is_window_resized() {
                    let resized: SDL_WindowEvent* = self.events.get_window_event()
                    if (*resized).data1 > 0 && (*resized).data2 > 0 {
                        self.window.width = (*resized).data1 as i64
                        self.window.height = (*resized).data2 as i64
                        self.root.width = self.window.width
                        self.root.height = self.window.height
                    }
                }
            }

            self.root.layout_tree()
            if self.root != null && text_len(self.root.title) > 0 {
                self.window.set_title(new String(self.root.title))
            }
            self.root.update_hover(self.mouse_x, self.mouse_y)
            self.root.animate()
            set_color(self.renderer, self.root.background)
            self.renderer.clear()
            self.root.render(self.renderer, self.font)
            self.root.render_popups(self.renderer, self.font)
            self.renderer.present()
            std.sdl.SDL.delay(16)
        }
        if self.font != null {
            std.sdl.TTF_CloseFont(self.font)
            self.font = null
        }
        if self.ttf_ready {
            std.sdl.TTF_Quit()
            self.ttf_ready = false
        }
        std.sdl.SDL_StopTextInput(self.window.get_handle())
        std.sdl.SDL.quit()
    }
}

} // namespace ui
} // namespace std
