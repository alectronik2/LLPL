class ComboBox : Widget {
    constructor() {
        super("ComboBox")
        self.kind_id = WIDGET_COMBOBOX
        self.background = 0xFFFFFFFF as u32
        self.hover_background = 0xFFF5F7FC as u32
        self.border = LIGHT_BORDER
        self.hover_border = LIGHT_BUTTON_HOVER_BORDER
        self.foreground = LIGHT_TEXT
        self.hover_foreground = self.foreground
        self.preferred_height = 38
        self.width = 180
    }

    func add_option(option: string) {
        let entry: ListItem = new ListItem(option, LIST_ICON_NONE)
        if self.first_list_item == null {
            rc_retain(entry as char*)
            self.first_list_item = entry
            self.last_list_item = entry
            self.text = option
        } else {
            rc_retain(entry as char*)
            self.last_list_item.next = entry
            self.last_list_item = entry
        }

        if text_len(self.items_text) == 0 {
            self.items_text = option
        } else {
            let buf: char* = malloc(4096) as char*
            let i: i64 = 0
            while self.items_text[i] != 0 && i < 4095 {
                buf[i] = self.items_text[i]
                i = i + 1
            }
            buf[i] = '\n'
            i = i + 1
            let j: i64 = 0
            while option[j] != 0 && i < 4095 {
                buf[i] = option[j]
                i = i + 1
                j = j + 1
            }
            buf[i] = 0
            self.items_text = buf as string
        }
    }
}

