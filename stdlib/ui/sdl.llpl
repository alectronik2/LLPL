        self.add_item_icon(item, LIST_ICON_FILE)
    }

    func add_folder(item: string) {
        self.add_item_icon(item, LIST_ICON_FOLDER)
    }

    func add_image(item: string) {
        self.add_item_icon(item, LIST_ICON_IMAGE)
    }

    func add_item_icon(item: string, icon: i64) {
        let entry: ListItem = new ListItem(item, icon)
        if self.first_list_item == null {
            rc_retain(entry as char*)
            self.first_list_item = entry
            self.last_list_item = entry
        } else {
            rc_retain(entry as char*)
            self.last_list_item.next = entry
            self.last_list_item = entry
        }

        if text_len(self.items_text) == 0 {
            self.items_text = item
        } else {
            let buf: char* = malloc(4096) as char*
            let i: i64 = 0
            while self.items_text[i] != 0 && i < 4095 {
                buf[i] = self.items_text[i]
                i = i + 1
            }
            buf[i] = '\n'
            i = i + 1
            let j: i64 = 0
            while item[j] != 0 && i < 4095 {
                buf[i] = item[j]
                i = i + 1
                j = j + 1
            }
            buf[i] = 0
            self.items_text = buf as string
        }
    }

    func get_selected_item() -> string {
        let selected: ListItem = self.list_item_at(self.selected_index)
        if selected != null {
            return selected.text
        }
        if text_len(self.items_text) == 0 {
            return "" as string
        }
        return get_list_item_at(self.items_text, self.selected_index)
    }
}

class TreeView : Widget {
    constructor() {
        super("TreeView")
        self.kind_id = WIDGET_TREEVIEW
        self.background = 0xFFEDEFF5 as u32
        self.hover_background = 0xFFF5F7FC as u32
        self.border = LIGHT_BORDER
        self.hover_border = 0xFF99A5B8 as u32
        self.foreground = LIGHT_TEXT
        self.hover_foreground = self.foreground
        self.width = 320
        self.preferred_height = 200
        self.item_height = 24
    }

    func add_item(item: string, indent: i64) {
        self.add_node(item, indent, false)
    }

    func add_folder(item: string, indent: i64) {
        self.add_node(item, indent, true)
    }

    func add_node(item: string, indent: i64, is_folder: bool) {
        let node: TreeItem = new TreeItem(item, indent, is_folder)
        if self.first_tree_item == null {
            rc_retain(node as char*)
            self.first_tree_item = node
            self.last_tree_item = node
        } else {
            rc_retain(node as char*)
            self.last_tree_item.next = node
            self.last_tree_item = node
        }

        let prefix: char[256]
        let i: i64 = 0
        while i < indent && i < 250 {
            prefix[i] = ' '
            prefix[i + 1] = ' '
            i = i + 2
        }
        prefix[i] = 0

        let full_item: char* = malloc(4096) as char*
        let j: i64 = 0
        while prefix[j] != 0 && j < 256 {
            full_item[j] = prefix[j]
            j = j + 1
        }
        let k: i64 = 0
        while item[k] != 0 && j < 4095 {
            full_item[j] = item[k]
            j = j + 1
            k = k + 1
        }
        full_item[j] = 0

        if text_len(self.items_text) == 0 {
            self.items_text = full_item as string
        } else {
            let buf: char* = malloc(8192) as char*
            let idx: i64 = 0
            while self.items_text[idx] != 0 && idx < 8191 {
                buf[idx] = self.items_text[idx]
                idx = idx + 1
            }
            buf[idx] = '\n'
            idx = idx + 1
            let m: i64 = 0
            while full_item[m] != 0 && idx < 8191 {
                buf[idx] = full_item[m]
                idx = idx + 1
                m = m + 1
            }
            buf[idx] = 0
            self.items_text = buf as string
        }
    }

    func get_selected_item() -> string {
        let selected: TreeItem = self.tree_item_at_visible(self.selected_index)
        if selected != null {
            return selected.text
        }
        if text_len(self.items_text) == 0 {
            return "" as string
        }
        return get_list_item_at(self.items_text, self.selected_index)
    }

    func collapse_all() {
        let item: TreeItem = self.first_tree_item
        while item != null {
            if item.is_folder {
                item.expanded = false
            }
            item = item.next
        }
        self.selected_index = 0
    }

    func expand_all() {
        let item: TreeItem = self.first_tree_item
        while item != null {
            if item.is_folder {
                item.expanded = true
            }
            item = item.next
        }
    }
}

class Canvas : Widget {
    constructor() {
        super("Canvas")
        self.kind_id = WIDGET_CANVAS
        self.background = 0xFFFFFFFF as u32
        self.hover_background = self.background
        self.border = LIGHT_BORDER
        self.hover_border = 0xFF99A5B8 as u32
        self.canvas_background = self.background
        self.canvas_stroke = LIGHT_TEXT
        self.canvas_fill = LIGHT_BUTTON_BG
        self.preferred_height = 180
    }

    func append_command(op: i64, x1: i64, y1: i64, x2: i64, y2: i64, color: u32) {
        let cmd: CanvasCommand = new CanvasCommand(op, x1, y1, x2, y2, color)
        if self.first_canvas_command == null {
            rc_retain(cmd as char*)
            self.first_canvas_command = cmd
            self.last_canvas_command = cmd
            return
        }
        rc_retain(cmd as char*)
        self.last_canvas_command.next = cmd
        self.last_canvas_command = cmd
    }

    func clear_commands() {
        self.first_canvas_command = null
        self.last_canvas_command = null
    }

    func clear(color: u32) {
        self.canvas_background = color
        self.append_command(CANVAS_OP_CLEAR, 0, 0, 0, 0, color)
    }

    func set_stroke(color: u32) {
        self.canvas_stroke = color
    }

    func set_fill(color: u32) {
        self.canvas_fill = color
    }

    func point(x: i64, y: i64) {
        self.append_command(CANVAS_OP_POINT, x, y, 0, 0, self.canvas_stroke)
    }

    func line(x1: i64, y1: i64, x2: i64, y2: i64) {
        self.append_command(CANVAS_OP_LINE, x1, y1, x2, y2, self.canvas_stroke)
    }

    func rect(x: i64, y: i64, w: i64, h: i64) {
        self.append_command(CANVAS_OP_RECT, x, y, w, h, self.canvas_stroke)
    }

    func fill_rect(x: i64, y: i64, w: i64, h: i64) {
        self.append_command(CANVAS_OP_FILL_RECT, x, y, w, h, self.canvas_fill)
    }
}

