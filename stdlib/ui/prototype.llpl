// Prototype retained-mode UI tree for the `ui Name: Root { ... }` DSL.
// This hosted version renders a deterministic text tree, which keeps the
// compiler feature testable while leaving real backends free to provide the
// same class/field/add_child surface later.

class UiWidget {
    let kind: string
    let title: string
    let text: string
    let width: i64
    let height: i64
    let spacing: i64
    let first_child: UiWidget
    let next_sibling: UiWidget
    // Event callbacks, mirroring std.ui.sdl's Widget field-for-field so the
    // same `ui` DSL block works against either backend. Each handler has a
    // companion `has_` flag because a closure field has no null state to
    // test - the `ui` desugaring (see desugarUiNode in codegen.d) sets both.
    let onClick: () -> void
    let has_onClick: bool
    let onHover: () -> void
    let has_onHover: bool
    let onHoverEnd: () -> void
    let has_onHoverEnd: bool

    constructor(kind: string) {
        self.kind = kind
        self.title = ""
        self.text = ""
        self.width = 0
        self.height = 0
        self.spacing = 0
        self.first_child = null
        self.next_sibling = null
        self.has_onClick = false
        self.has_onHover = false
        self.has_onHoverEnd = false
    }

    func add_child(child: UiWidget) {
        if self.first_child == null {
            rc_retain(child as char*)
            self.first_child = child
            return
        }

        let tail: UiWidget = self.first_child
        while tail.next_sibling != null {
            tail = tail.next_sibling
        }
        rc_retain(child as char*)
        tail.next_sibling = child
    }

    // Event entry points. The hosted prototype has no real event loop -
    // std.ui.sdl drives these from actual SDL mouse events - so callers
    // invoke them directly to exercise a tree's callbacks deterministically.
    // Each copies the closure into a local before calling it, since
    // `self.onClick()` would parse as a method call on self rather than an
    // invocation of the field's closure value.
    func click() {
        if self.has_onClick {
            let handler: () -> void = self.onClick
            handler()
        }
    }

    func hover_enter() {
        if self.has_onHover {
            let handler: () -> void = self.onHover
            handler()
        }
    }

    func hover_leave() {
        if self.has_onHoverEnd {
            let handler: () -> void = self.onHoverEnd
            handler()
        }
    }

    // Depth-first search for the first widget whose `text` matches, so a
    // caller can reach a specific button without hand-walking first_child/
    // next_sibling. Returns null when nothing matches.
    func find_by_text(needle: string) -> UiWidget {
        if llpl_strcmp(self.text, needle) == 0 {
            return self
        }

        let child: UiWidget = self.first_child
        while child != null {
            let found: UiWidget = child.find_by_text(needle)
            if found != null {
                return found
            }
            child = child.next_sibling
        }
        return null
    }

    func render(depth: i64) {
        let indent: char[64]
        let i: i64 = 0
        while i < depth * 2 && i < 63 {
            indent[i] = 32 as char
            i = i + 1
        }
        indent[i] = 0

        let line: char[256]
        ksnprintf(line as string, 256, "%s%s title=\"%s\" text=\"%s\" width=%d height=%d spacing=%d",
            indent as string, self.kind, self.title, self.text, self.width, self.height, self.spacing)
        puts(line as string)

        let child: UiWidget = self.first_child
        while child != null {
            child.render(depth + 1)
            child = child.next_sibling
        }
    }
}

class Window : UiWidget {
    constructor() {
        super("Window")
    }
}

class Column : UiWidget {
    constructor() {
        super("Column")
    }
}

class Row : UiWidget {
    constructor() {
        super("Row")
    }
}

class Text : UiWidget {
    constructor() {
        super("Text")
    }
}

class Button : UiWidget {
    constructor() {
        super("Button")
    }
}

class App {
    let title: string
    let width: i64
    let height: i64
    let root: UiWidget

    constructor(title: string, width: i64, height: i64, root: UiWidget) {
        self.title = title
        self.width = width
        self.height = height
        self.root = root
    }

    func is_valid() -> bool {
        return self.root != null
    }

    func run() {
        if self.root != null {
            self.root.render(0)
        }
    }

    // Stands in for "user clicked the widget labelled <text>" - the hosted
    // backend has no pointer input of its own. Returns false when no widget
    // carries that text, so a caller can tell "no such widget" apart from
    // "found it, but it had no onClick handler attached".
    func click_text(needle: string) -> bool {
        if self.root == null {
            return false
        }

        let target: UiWidget = self.root.find_by_text(needle)
        if target == null {
            return false
        }
        target.click()
        return true
    }
}
