// Standard library: 2D Graphics Primitives, Sprite System, and Helpers
// Namespace: std::graphics
//
// Built on top of std::sdl (Renderer, Texture, Window).  Provides a
// higher-level Canvas for shape drawing (circles, arcs, rounded
// rectangles, polygons), a Sprite/Animation system for textured quads,
// a Camera for viewport transforms, and a Color utility class with
// HSL construction and lerping.
//
// Usage:
//
//   import std.sdl.sdl
//   import std.sdl.sdl_graphics
//
//   using namespace std.sdl
//   using namespace std.graphics
//
//   func main() -> i64 {
//       SDL.init(SDL_INIT_VIDEO)
//       let win = new Window(new String("Graphics Demo"), 800, 600)
//       let ren = new Renderer(win)
//       let canvas = new Canvas(ren)
//       ...
//   }

import std.sdl.sdl
import std.sdl.sdl_window

using namespace std.sdl

// C math functions (provided by libm, linked automatically on hosted targets)
#link "m"

extern func fabs(x: float) -> float
extern func cos(x: float) -> float
extern func sin(x: float) -> float
extern func sqrt(x: float) -> float

namespace std {
namespace graphics {

// ── Color helpers ──────────────────────────────────────────────────

// Utility color class with factory methods and lerp.
class Color {
    let r: char
    let g: char
    let b: char
    let a: char

    constructor(red: char, green: char, blue: char, alpha: char) {
        self.r = red
        self.g = green
        self.b = blue
        self.a = alpha
    }

    constructor(red: char, green: char, blue: char) {
        self.r = red
        self.g = green
        self.b = blue
        self.a = 255 as char
    }

    // Build from i64 values (0-255) for convenience
    static func from_rgb(red: i64, green: i64, blue: i64) -> Color {
        return new Color(red as char, green as char, blue as char)
    }

    static func from_rgba(red: i64, green: i64, blue: i64, alpha: i64) -> Color {
        return new Color(red as char, green as char, blue as char, alpha as char)
    }

    // HSL → RGB (h: 0-360, s: 0-100, l: 0-100)
    static func from_hsl(h: i64, s: i64, l: i64) -> Color {
        let c: float = (1.0 - (2.0 * (100 - l) as float) / 100.0) * (s as float) / 100.0
        let x: float = c * (1.0 - fabs(((h / 60) % 2) as float - 1.0))
        let m: float = (l as float) / 100.0 - c / 2.0

        let r1: float = 0.0
        let g1: float = 0.0
        let b1: float = 0.0
        if h < 60 {
            r1 = c
            g1 = x
            b1 = 0.0
        } else if h < 120 {
            r1 = x
            g1 = c
            b1 = 0.0
        } else if h < 180 {
            r1 = 0.0
            g1 = c
            b1 = x
        } else if h < 240 {
            r1 = 0.0
            g1 = x
            b1 = c
        } else if h < 300 {
            r1 = x
            g1 = 0.0
            b1 = c
        } else {
            r1 = c
            g1 = 0.0
            b1 = x
        }

        return new Color(
            ((r1 + m) * 255.0) as char,
            ((g1 + m) * 255.0) as char,
            ((b1 + m) * 255.0) as char
        )
    }

    // Convert to SDL_Color (same layout, just a reinterpret)
    func to_sdl() -> SDL_Color {
        return new SDL_Color(self.r, self.g, self.b, self.a)
    }

    // Linearly interpolate between two colors
    func lerp(other: Color, t: float) -> Color {
        let inv: float = 1.0 - t
        let rr: char = ((self.r as float) * inv + (other.r as float) * t) as char
        let gg: char = ((self.g as float) * inv + (other.g as float) * t) as char
        let bb: char = ((self.b as float) * inv + (other.b as float) * t) as char
        let aa: char = ((self.a as float) * inv + (other.a as float) * t) as char
        return new Color(rr, gg, bb, aa)
    }

    func with_alpha(alpha: char) -> Color {
        return new Color(self.r, self.g, self.b, alpha)
    }
}

// ── Canvas (high-level 2D drawing) ─────────────────────────────────

class Canvas {
    let renderer: Renderer

    constructor(ren: Renderer) {
        self.renderer = ren
    }

    // ── state ──

    func set_color(color: Color) {
        self.renderer.set_draw_color(color.r, color.g, color.b, color.a)
    }

    func set_blend_additive() {
        self.renderer.set_blend_mode(SDL_BLENDMODE_ADD)
    }

    func set_blend_alpha() {
        self.renderer.set_blend_mode(SDL_BLENDMODE_BLEND)
    }

    func set_blend_none() {
        self.renderer.set_blend_mode(SDL_BLENDMODE_NONE)
    }

    // ── primitives ──

    func draw_point(x: float, y: float) {
        self.renderer.draw_point(x, y)
    }

    func draw_line(x1: float, y1: float, x2: float, y2: float) {
        self.renderer.draw_line(x1, y1, x2, y2)
    }

    func draw_rect(x: float, y: float, w: float, h: float) {
        let r: SDL_FRect = new SDL_FRect(x, y, w, h)
        SDL_RenderRect(self.renderer.get_handle(), &r)
    }

    func fill_rect(x: float, y: float, w: float, h: float) {
        let r: SDL_FRect = new SDL_FRect(x, y, w, h)
        SDL_RenderFillRect(self.renderer.get_handle(), &r)
    }

    // ── filled circle (midpoint algorithm, pixel-by-pixel) ──

    func fill_circle(cx: float, cy: float, radius: float) {
        let ix: i32 = cx as i32
        let iy: i32 = cy as i32
        let ir: i32 = radius as i32
        let x: i32 = ir
        let y: i32 = 0
        let err: i32 = 1 - ir

        while x >= y {
            // Draw horizontal lines between symmetric points
            let j: i32 = ix - x
            let w1: i32 = ix + x - j + 1
            let rect1: SDL_FRect = new SDL_FRect(j as float, (iy + y) as float, w1 as float, 1.0)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect1)
            let rect2: SDL_FRect = new SDL_FRect(j as float, (iy - y) as float, w1 as float, 1.0)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect2)

            let j2: i32 = ix - y
            let w2: i32 = ix + y - j2 + 1
            let rect3: SDL_FRect = new SDL_FRect(j2 as float, (iy + x) as float, w2 as float, 1.0)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect3)
            let rect4: SDL_FRect = new SDL_FRect(j2 as float, (iy - x) as float, w2 as float, 1.0)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect4)

            y = y + 1
            if err < 0 {
                err = err + 2 * y + 1
            } else {
                x = x - 1
                err = err + 2 * (y - x) + 1
            }
        }
    }

    // ── outlined circle ──

    func draw_circle(cx: float, cy: float, radius: float) {
        let ix: i32 = cx as i32
        let iy: i32 = cy as i32
        let ir: i32 = radius as i32
        let x: i32 = ir
        let y: i32 = 0
        let err: i32 = 1 - ir

        while x >= y {
            self.renderer.draw_point((ix + x) as float, (iy + y) as float)
            self.renderer.draw_point((ix - x) as float, (iy + y) as float)
            self.renderer.draw_point((ix + x) as float, (iy - y) as float)
            self.renderer.draw_point((ix - x) as float, (iy - y) as float)
            self.renderer.draw_point((ix + y) as float, (iy + x) as float)
            self.renderer.draw_point((ix - y) as float, (iy + x) as float)
            self.renderer.draw_point((ix + y) as float, (iy - x) as float)
            self.renderer.draw_point((ix - y) as float, (iy - x) as float)

            y = y + 1
            if err < 0 {
                err = err + 2 * y + 1
            } else {
                x = x - 1
                err = err + 2 * (y - x) + 1
            }
        }
    }

    // ── filled ellipse ──

    func fill_ellipse(cx: float, cy: float, rx: float, ry: float) {
        let steps: i32 = (rx * 2.0) as i32
        if steps < 1 { steps = 1 }
        let i: i32 = 0
        while i <= steps {
            let t: float = (i as float) / (steps as float)
            let angle: float = 3.14159265 * 2.0 * t
        let px: float = cx + rx * cos(angle)
        let py: float = cy + ry * sin(angle)

            // Approximate by filling a line from center outward
            let line_steps: i32 = 10
            let j: i32 = 0
            while j <= line_steps {
                let frac: float = (j as float) / (line_steps as float)
                let lx: float = cx + (px - cx) * frac
                let ly: float = cy + (py - cy) * frac
                self.renderer.draw_point(lx, ly)
                j = j + 1
            }
            i = i + 1
        }
    }

    // ── filled rounded rectangle ──

    func fill_rounded_rect(x: float, y: float, w: float, h: float, radius: float) {
        // Center rectangle
        if w > radius * 2.0 {
            let rect: SDL_FRect = new SDL_FRect(x + radius, y, w - radius * 2.0, h)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect)
        }

        // Left rectangle
        let rect_l: SDL_FRect = new SDL_FRect(x, y + radius, radius, h - radius * 2.0)
        SDL_RenderFillRect(self.renderer.get_handle(), &rect_l)

        // Right rectangle
        let rect_r: SDL_FRect = new SDL_FRect(x + w - radius, y + radius, radius, h - radius * 2.0)
        SDL_RenderFillRect(self.renderer.get_handle(), &rect_r)

        // Four corner circles
        self.fill_circle(x + radius, y + radius, radius)
        self.fill_circle(x + w - radius, y + radius, radius)
        self.fill_circle(x + radius, y + h - radius, radius)
        self.fill_circle(x + w - radius, y + h - radius, radius)
    }

    func draw_rounded_rect(x: float, y: float, w: float, h: float, radius: float) {
        // Top and bottom edges
        self.draw_line(x + radius, y, x + w - radius, y)
        self.draw_line(x + radius, y + h, x + w - radius, y + h)
        // Left and right edges
        self.draw_line(x, y + radius, x, y + h - radius)
        self.draw_line(x + w, y + radius, x + w, y + h - radius)
        // Four corner arcs (approximated with lines)
        self.draw_arc(x + radius, y + radius, radius, 180, 270)
        self.draw_arc(x + w - radius, y + radius, radius, 270, 360)
        self.draw_arc(x + radius, y + h - radius, radius, 90, 180)
        self.draw_arc(x + w - radius, y + h - radius, radius, 0, 90)
    }

    // ── arc (approximated with line segments) ──

    func draw_arc(cx: float, cy: float, radius: float, start_deg: i64, end_deg: i64) {
        let segments: i64 = 20
        let range: i64 = end_deg - start_deg
        if range <= 0 { return }

        let i: i64 = 0
        while i < segments {
            let t1: float = (i as float) / (segments as float)
            let t2: float = ((i + 1) as float) / (segments as float)
            let a1: float = ((start_deg as float) + (range as float) * t1) * 3.14159265 / 180.0
            let a2: float = ((start_deg as float) + (range as float) * t2) * 3.14159265 / 180.0
            self.renderer.draw_line(
                cx + radius * cos(a1), cy + radius * sin(a1),
                cx + radius * cos(a2), cy + radius * sin(a2)
            )
            i = i + 1
        }
    }

    // ── triangle ──

    func fill_triangle(x1: float, y1: float, x2: float, y2: float, x3: float, y3: float) {
        // Simple scanline fill: find Y range and fill horizontal spans
        let min_y: float = y1
        let max_y: float = y1
        if y2 < min_y { min_y = y2 }
        if y3 < min_y { min_y = y3 }
        if y2 > max_y { max_y = y2 }
        if y3 > max_y { max_y = y3 }

        let y: float = min_y
        while y <= max_y {
            let x_min: float = 99999.0
            let x_max: float = -99999.0

            // Edge 1→2
            if (y1 <= y && y <= y2) || (y2 <= y && y <= y1) {
                if y1 != y2 {
                    let t: float = (y - y1) / (y2 - y1)
                    let ex: float = x1 + t * (x2 - x1)
                    if ex < x_min { x_min = ex }
                    if ex > x_max { x_max = ex }
                }
            }
            // Edge 2→3
            if (y2 <= y && y <= y3) || (y3 <= y && y <= y2) {
                if y2 != y3 {
                    let t: float = (y - y2) / (y3 - y2)
                    let ex: float = x2 + t * (x3 - x2)
                    if ex < x_min { x_min = ex }
                    if ex > x_max { x_max = ex }
                }
            }
            // Edge 3→1
            if (y3 <= y && y <= y1) || (y1 <= y && y <= y3) {
                if y3 != y1 {
                    let t: float = (y - y3) / (y1 - y3)
                    let ex: float = x3 + t * (x1 - x3)
                    if ex < x_min { x_min = ex }
                    if ex > x_max { x_max = ex }
                }
            }

            if x_min <= x_max {
                let rect: SDL_FRect = new SDL_FRect(x_min, y, x_max - x_min + 1.0, 1.0)
                SDL_RenderFillRect(self.renderer.get_handle(), &rect)
            }
            y = y + 1.0
        }
    }

    func draw_triangle(x1: float, y1: float, x2: float, y2: float, x3: float, y3: float) {
        self.draw_line(x1, y1, x2, y2)
        self.draw_line(x2, y2, x3, y3)
        self.draw_line(x3, y3, x1, y1)
    }

    // ── polygon (convex, filled via scanline) ──

    func fill_polygon(points_x: float[], points_y: float[], count: i64) {
        if count < 3 { return }

        let min_y: float = points_y[0]
        let max_y: float = points_y[0]
        let i: i64 = 1
        while i < count {
            if points_y[i] < min_y { min_y = points_y[i] }
            if points_y[i] > max_y { max_y = points_y[i] }
            i = i + 1
        }

        let y: float = min_y
        while y <= max_y {
            let x_min: float = 99999.0
            let x_max: float = -99999.0
            let j: i64 = 0
            while j < count {
                let next: i64 = (j + 1) % count
                let y1_edge: float = points_y[j]
                let y2_edge: float = points_y[next]
                if (y1_edge <= y && y <= y2_edge) || (y2_edge <= y && y <= y1_edge) {
                    if y1_edge != y2_edge {
                        let t: float = (y - y1_edge) / (y2_edge - y1_edge)
                        let ex: float = points_x[j] + t * (points_x[next] - points_x[j])
                        if ex < x_min { x_min = ex }
                        if ex > x_max { x_max = ex }
                    }
                }
                j = j + 1
            }
            if x_min <= x_max {
                let rect: SDL_FRect = new SDL_FRect(x_min, y, x_max - x_min + 1.0, 1.0)
                SDL_RenderFillRect(self.renderer.get_handle(), &rect)
            }
            y = y + 1.0
        }
    }

    func draw_polygon(points_x: float[], points_y: float[], count: i64) {
        let i: i64 = 0
        while i < count {
            let next: i64 = (i + 1) % count
            self.draw_line(points_x[i], points_y[i], points_x[next], points_y[next])
            i = i + 1
        }
    }

    // ── gradient fill (vertical linear gradient) ──

    func fill_gradient_v(x: float, y: float, w: float, h: float, top: Color, bottom: Color) {
        let iy: i32 = y as i32
        let ih: i32 = h as i32
        let i: i32 = 0
        while i < ih {
            let t: float = (i as float) / (ih as float)
            let r: char = ((top.r as float) * (1.0 - t) + (bottom.r as float) * t) as char
            let g: char = ((top.g as float) * (1.0 - t) + (bottom.g as float) * t) as char
            let b: char = ((top.b as float) * (1.0 - t) + (bottom.b as float) * t) as char
            let a: char = ((top.a as float) * (1.0 - t) + (bottom.a as float) * t) as char
            self.renderer.set_draw_color(r, g, b, a)
            let rect: SDL_FRect = new SDL_FRect(x, (iy + i) as float, w, 1.0)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect)
            i = i + 1
        }
    }

    func fill_gradient_h(x: float, y: float, w: float, h: float, left: Color, right: Color) {
        let ix: i32 = x as i32
        let iw: i32 = w as i32
        let i: i32 = 0
        while i < iw {
            let t: float = (i as float) / (iw as float)
            let r: char = ((left.r as float) * (1.0 - t) + (right.r as float) * t) as char
            let g: char = ((left.g as float) * (1.0 - t) + (right.g as float) * t) as char
            let b: char = ((left.b as float) * (1.0 - t) + (right.b as float) * t) as char
            let a: char = ((left.a as float) * (1.0 - t) + (right.a as float) * t) as char
            self.renderer.set_draw_color(r, g, b, a)
            let rect: SDL_FRect = new SDL_FRect((ix + i) as float, y, 1.0, h)
            SDL_RenderFillRect(self.renderer.get_handle(), &rect)
            i = i + 1
        }
    }

    // ── texture drawing ──

    func draw_texture(texture: Texture, x: float, y: float) {
        self.renderer.render_texture_simple(texture, x as i32, y as i32)
    }

    func draw_texture_scaled(texture: Texture, src_x: i64, src_y: i64, src_w: i64, src_h: i64,
                             dst_x: float, dst_y: float, dst_w: float, dst_h: float) {
        let src: SDL_FRect = new SDL_FRect(src_x as float, src_y as float, src_w as float, src_h as float)
        let dst: SDL_FRect = new SDL_FRect(dst_x, dst_y, dst_w, dst_h)
        SDL_RenderTexture(self.renderer.get_handle(), texture.get_handle(), &src, &dst)
    }

    func draw_texture_rotated(texture: Texture, x: float, y: float, w: float, h: float,
                              angle: float) {
        let dst: SDL_FRect = new SDL_FRect(x, y, w, h)
        SDL_RenderTexture(self.renderer.get_handle(), texture.get_handle(), null, &dst)
    }
}

// ── Sprite ─────────────────────────────────────────────────────────

class Sprite {
    let texture: Texture
    let x: float
    let y: float
    let width: float
    let height: float
    let rotation: float
    let flip_h: bool
    let flip_v: bool
    let alpha: char
    let visible: bool

    constructor(tex: Texture, px: float, py: float) {
        self.texture = tex
        self.x = px
        self.y = py
        self.width = tex.get_width() as float
        self.height = tex.get_height() as float
        self.rotation = 0.0
        self.flip_h = false
        self.flip_v = false
        self.alpha = 255 as char
        self.visible = true
    }

    constructor(tex: Texture, px: float, py: float, pw: float, ph: float) {
        self.texture = tex
        self.x = px
        self.y = py
        self.width = pw
        self.height = ph
        self.rotation = 0.0
        self.flip_h = false
        self.flip_v = false
        self.alpha = 255 as char
        self.visible = true
    }

    func draw(canvas: Canvas) {
        if !self.visible { return }
        self.texture.set_alpha(self.alpha)
        canvas.draw_texture_scaled(self.texture,
            0, 0, self.texture.get_width(), self.texture.get_height(),
            self.x, self.y, self.width, self.height)
    }

    // Draw a sub-region of the texture (sprite sheet frame)
    func draw_frame(canvas: Canvas, src_x: i64, src_y: i64, src_w: i64, src_h: i64) {
        if !self.visible { return }
        self.texture.set_alpha(self.alpha)
        canvas.draw_texture_scaled(self.texture,
            src_x, src_y, src_w, src_h,
            self.x, self.y, self.width, self.height)
    }

    func set_position(px: float, py: float) {
        self.x = px
        self.y = py
    }

    func move(dx: float, dy: float) {
        self.x = self.x + dx
        self.y = self.y + dy
    }

    func set_scale(sx: float, sy: float) {
        self.width = self.texture.get_width() as float * sx
        self.height = self.texture.get_height() as float * sy
    }

    func set_scale_uniform(s: float) {
        self.set_scale(s, s)
    }

    func set_alpha(a: char) {
        self.alpha = a
    }

    // Axis-aligned bounding box collision
    func collides_with(other: Sprite) -> bool {
        if self.x < other.x + other.width &&
           self.x + self.width > other.x &&
           self.y < other.y + other.height &&
           self.y + self.height > other.y {
            return true
        }
        return false
    }

    func center_x() -> float {
        return self.x + self.width / 2.0
    }

    func center_y() -> float {
        return self.y + self.height / 2.0
    }

    func contains_point(px: float, py: float) -> bool {
        return px >= self.x && px <= self.x + self.width &&
               py >= self.y && py <= self.y + self.height
    }
}

// ── Camera (viewport transform) ────────────────────────────────────

class Camera {
    let x: float
    let y: float
    let zoom: float
    let target_x: float
    let target_y: float
    let smoothing: float
    let view_w: float
    let view_h: float

    constructor(vw: float, vh: float) {
        self.x = 0.0
        self.y = 0.0
        self.zoom = 1.0
        self.target_x = 0.0
        self.target_y = 0.0
        self.smoothing = 0.1
        self.view_w = vw
        self.view_h = vh
    }

    func follow(target_x: float, target_y: float) {
        self.target_x = target_x - self.view_w / (2.0 * self.zoom)
        self.target_y = target_y - self.view_h / (2.0 * self.zoom)
    }

    func update() {
        self.x = self.x + (self.target_x - self.x) * self.smoothing
        self.y = self.y + (self.target_y - self.y) * self.smoothing
    }

    func snap_to(px: float, py: float) {
        self.x = px - self.view_w / (2.0 * self.zoom)
        self.y = py - self.view_h / (2.0 * self.zoom)
        self.target_x = self.x
        self.target_y = self.y
    }

    // Convert world coordinates to screen coordinates
    func world_to_screen(wx: float, wy: float) -> (float, float) {
        let sx: float = (wx - self.x) * self.zoom
        let sy: float = (wy - self.y) * self.zoom
        return (sx, sy)
    }

    // Convert screen coordinates to world coordinates
    func screen_to_world(sx: float, sy: float) -> (float, float) {
        let wx: float = sx / self.zoom + self.x
        let wy: float = sy / self.zoom + self.y
        return (wx, wy)
    }

    // Check if a world-space rectangle is visible
    func is_visible(wx: float, wy: float, ww: float, wh: float) -> bool {
        let right: float = self.x + self.view_w / self.zoom
        let bottom: float = self.y + self.view_h / self.zoom
        return wx + ww > self.x && wx < right &&
               wy + wh > self.y && wy < bottom
    }

    // Begin camera transform: apply offset/zoom before drawing world objects.
    // This shifts the origin by the camera position; the caller multiplies
    // coordinates by zoom.  End with end_transform() to restore.
    func begin_transform(canvas: Canvas) {
        // SDL3 doesn't have a transform stack - we offset drawing manually.
        // The user applies camera offsets when drawing.  For a real engine
        // you'd use SDL3's render target + scale/translate, but this keeps
        // it simple and portable.
    }

    func end_transform(canvas: Canvas) {
        // Restore if needed
    }
}

// ── Sprite Animation ───────────────────────────────────────────────

class Animation {
    let frame_w: i64
    let frame_h: i64
    let frames: Vector<i64>       // frame indices (linear index into sprite sheet)
    let frame_duration_ms: u64
    let current_frame: i64
    let elapsed_ms: u64
    let playing: bool
    let loop: bool

    constructor(fw: i64, fh: i64, duration_ms: u64, should_loop: bool) {
        self.frame_w = fw
        self.frame_h = fh
        self.frames = new Vector<i64>()
        self.frame_duration_ms = duration_ms
        self.current_frame = 0
        self.elapsed_ms = 0
        self.playing = false
        self.loop = should_loop
    }

    func add_frame(index: i64) {
        self.frames.push(index)
    }

    func add_frames(start: i64, end: i64) {
        let i: i64 = start
        while i <= end {
            self.frames.push(i)
            i = i + 1
        }
    }

    func play() {
        self.playing = true
        self.current_frame = 0
        self.elapsed_ms = 0
    }

    func stop() {
        self.playing = false
    }

    func pause() {
        self.playing = false
    }

    func resume() {
        self.playing = true
    }

    func reset() {
        self.current_frame = 0
        self.elapsed_ms = 0
    }

    func update(dt_ms: u64) {
        if !self.playing || self.frames.len() == 0 { return }
        self.elapsed_ms = self.elapsed_ms + dt_ms
        if self.elapsed_ms >= self.frame_duration_ms {
            self.elapsed_ms = self.elapsed_ms - self.frame_duration_ms
            self.current_frame = self.current_frame + 1
            if self.current_frame >= self.frames.len() {
                if self.loop {
                    self.current_frame = 0
                } else {
                    self.current_frame = self.frames.len() - 1
                    self.playing = false
                }
            }
        }
    }

    // Get the source rectangle for the current frame in a sprite sheet
    func current_src_rect() -> (i64, i64, i64, i64) {
        if self.frames.len() == 0 {
            return (0, 0, self.frame_w, self.frame_h)
        }
        let idx: i64 = self.frames.get(self.current_frame)
        let cols: i64 = 1  // caller typically knows the sheet width
        let src_x: i64 = (idx % cols) * self.frame_w
        let src_y: i64 = (idx / cols) * self.frame_h
        return (src_x, src_y, self.frame_w, self.frame_h)
    }

    // Convenience: draw the animation on a sprite's position
    func draw_on(canvas: Canvas, sprite: Sprite, sheet_cols: i64) {
        if self.frames.len() == 0 { return }
        let idx: i64 = self.frames.get(self.current_frame)
        let src_x: i64 = (idx % sheet_cols) * self.frame_w
        let src_y: i64 = (idx / sheet_cols) * self.frame_h
        sprite.draw_frame(canvas, src_x, src_y, self.frame_w, self.frame_h)
    }

    func is_playing() -> bool {
        return self.playing
    }

    func frame_count() -> i64 {
        return self.frames.len()
    }
}

// ── Particle (simple point particle for effects) ───────────────────

class Particle {
    let x: float
    let y: float
    let vx: float
    let vy: float
    let life_ms: i64
    let max_life_ms: i64
    let color: Color
    let size: float
    let dead: bool

    constructor(px: float, py: float, pvx: float, pvy: float,
                life: i64, col: Color, sz: float) {
        self.x = px
        self.y = py
        self.vx = pvx
        self.vy = pvy
        self.life_ms = life
        self.max_life_ms = life
        self.color = col
        self.size = sz
        self.dead = false
    }

    func update(dt_ms: i64) {
        if self.dead { return }
        self.x = self.x + self.vx * (dt_ms as float)
        self.y = self.y + self.vy * (dt_ms as float)
        self.life_ms = self.life_ms - dt_ms
        if self.life_ms <= 0 {
            self.dead = true
        }
    }

    func draw(canvas: Canvas) {
        if self.dead { return }
        let life_frac: float = (self.life_ms as float) / (self.max_life_ms as float)
        let alpha: char = (life_frac * 255.0) as char
        let r: char = ((self.color.r as float) * life_frac) as char
        let g: char = ((self.color.g as float) * life_frac) as char
        let b: char = ((self.color.b as float) * life_frac) as char
        canvas.set_color(new Color(r, g, b, alpha))
        canvas.fill_rect(self.x - self.size / 2.0, self.y - self.size / 2.0,
                         self.size, self.size)
    }
}

// ── Particle Emitter ───────────────────────────────────────────────

class ParticleEmitter {
    let particles: Vector<Particle>
    let emit_x: float
    let emit_y: float
    let rate: i64          // particles per second
    let timer: i64
    let spread: float      // degrees of spread
    let min_speed: float
    let max_speed: float
    let min_life: i64
    let max_life: i64
    let color: Color
    let particle_size: float
    let active: bool

    constructor(px: float, py: float) {
        self.particles = new Vector<Particle>()
        self.emit_x = px
        self.emit_y = py
        self.rate = 10
        self.timer = 0
        self.spread = 360.0
        self.min_speed = 0.01
        self.max_speed = 0.05
        self.min_life = 500
        self.max_life = 1500
        self.color = new Color(255, 200, 50)
        self.particle_size = 4.0
        self.active = true
    }

    func emit(count: i64) {
        let i: i64 = 0
        while i < count {
            // Simple random direction within spread
            let angle: float = ((self.timer * 137 + i * 97) % 360) as float
            let half: float = self.spread / 2.0
            let a: float = (angle - half + 180.0) * 3.14159265 / 180.0
            let speed: float = self.min_speed + (((self.timer * 31 + i * 73) % 100) as float) / 100.0 * (self.max_speed - self.min_speed)
            let life: i64 = self.min_life + ((self.timer * 43 + i * 61) % (self.max_life - self.min_life))
            let p: Particle = new Particle(
                self.emit_x, self.emit_y,
                cos(a) * speed, sin(a) * speed,
                life, self.color, self.particle_size
            )
            self.particles.push(p)
            i = i + 1
        }
    }

    func update(dt_ms: i64) {
        self.timer = self.timer + dt_ms
        let interval: i64 = 1000 / self.rate
        if self.active && self.timer >= interval {
            self.timer = self.timer - interval
            self.emit(1)
        }
        // Update existing particles, remove dead ones
        let alive: Vector<Particle> = new Vector<Particle>()
        let i: i64 = 0
        while i < self.particles.len() {
            let p: Particle = self.particles.get(i)
            p.update(dt_ms)
            if !p.dead {
                alive.push(p)
            }
            i = i + 1
        }
        self.particles = alive
    }

    func draw(canvas: Canvas) {
        let i: i64 = 0
        while i < self.particles.len() {
            self.particles.get(i).draw(canvas)
            i = i + 1
        }
    }

    func set_position(px: float, py: float) {
        self.emit_x = px
        self.emit_y = py
    }

    func clear() {
        self.particles = new Vector<Particle>()
    }

    func count() -> i64 {
        return self.particles.len()
    }
}

} // namespace graphics
} // namespace std
