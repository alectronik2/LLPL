// Standard library: Advanced String Functions
// Namespace: std::text

namespace std {
namespace text {

// For stringstream's operator>> (text extraction) below - same "declare
// just enough of the real signature to call it" stance
// stdlib/io/file.llpl's own atoll/strtod bindings already take
// (re-declaring an identical extern is harmless, so no risk in both
// files doing it). operator<<(f64) needs no such binding anymore -
// ksnprintf grew real %f support (see runtime.c's kfmt_putfloat), so it
// uses that like every other overload below.
extern func atoll(s: char*) -> i64
extern func strtod(s: char*, endptr: char**) -> f64

// Helper function to create a string from a single character
func char_to_string(c: char) -> String {
    let buf: char* = llpl_alloc(2)
    buf[0] = c
    buf[1] = 0
    let result: String = new String(buf)
    llpl_free(buf)
    return result
}

// String manipulation utilities
class StringUtils {
    // Split string by delimiter
    static func split(s: String, delimiter: char) -> Vector<String> {
        let result: Vector<String> = new Vector<String>()
        let current: String = new String("")
        let len: i64 = s.len()

        for let i: i64 = 0; i < len; i = i + 1 {
            let c: char = s[i]
            if c == delimiter {
                if current.len() > 0 {
                    result.push(current)
                    current = new String("")
                }
            } else {
                current = current + char_to_string(c).c_str()
            }
        }

        if current.len() > 0 {
            result.push(current)
        }

        return result
    }

    // Split by string delimiter
    static func split_str(s: String, delimiter: String) -> Vector<String> {
        let result: Vector<String> = new Vector<String>()
        let len: i64 = s.len()
        let delim_len: i64 = delimiter.len()

        if delim_len == 0 {
            result.push(s)
            return result
        }

        let start: i64 = 0
        let i: i64 = 0

        for i = 0; i <= len - delim_len; i = i + 1 {
            let is_match: bool =1
            for let j: i64 = 0; j < delim_len; j = j + 1 {
                if s[i + j] != delimiter[j] {
                    is_match = 0
                    break
                }
            }

            if is_match {
                let substr: String = s.substring(start, i)
                result.push(substr)
                start = i + delim_len
                i = i + delim_len - 1
            }
        }

        let final_substr: String = s.substring(start, len)
        result.push(final_substr)

        return result
    }

    // Join strings with delimiter
    static func join(strings: Vector<String>, delimiter: String) -> String {
        let result: String = new String("")
        let size: i64 = strings.len()

        for let i: i64 = 0; i < size; i = i + 1 {
            result = result + strings.get(i).c_str()
            if i < size - 1 {
                result = result + delimiter.c_str()
            }
        }

        return result
    }

    // Trim whitespace from start
    static func trim_start(s: String) -> String {
        let len: i64 = s.len()
        let start: i64 = 0

        for start = 0; start < len; start = start + 1 {
            let c: char = s[start]
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break
            }
        }

        return s.substring(start, len)
    }

    // Trim whitespace from end
    static func trim_end(s: String) -> String {
        let len: i64 = s.len()
        let end: i64 = len

        for end = len; end > 0; end = end - 1 {
            let c: char = s[end - 1]
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break
            }
        }

        return s.substring(0, end)
    }

    // Trim whitespace from both ends
    static func trim(s: String) -> String {
        return StringUtils.trim_end(StringUtils.trim_start(s))
    }

    // Convert to uppercase
    static func to_upper(s: String) -> String {
        let result: String = new String("")
        let len: i64 = s.len()

        for let i: i64 = 0; i < len; i = i + 1 {
            let c: char = s[i]
            if c >= 97 && c <= 122 {
                c = c - 32
            }
            result = result + char_to_string(c).c_str()
        }

        return result
    }

    // Convert to lowercase
    static func to_lower(s: String) -> String {
        let result: String = new String("")
        let len: i64 = s.len()

        for let i: i64 = 0; i < len; i = i + 1 {
            let c: char = s[i]
            if c >= 65 && c <= 90 {
                c = c + 32
            }
            result = result + char_to_string(c).c_str()
        }

        return result
    }

    // Check if string starts with prefix
    static func starts_with(s: String, prefix: String) -> bool {
        let s_len: i64 = s.len()
        let p_len: i64 = prefix.len()

        if p_len > s_len {
            return 0
        }

        for let i: i64 = 0; i < p_len; i = i + 1 {
            if s[i] != prefix[i] {
                return 0
            }
        }

        return 1
    }

    // Check if string ends with suffix
    static func ends_with(s: String, suffix: String) -> bool {
        let s_len: i64 = s.len()
        let suf_len: i64 = suffix.len()

        if suf_len > s_len {
            return 0
        }

        let offset: i64 = s_len - suf_len

        for let i: i64 = 0; i < suf_len; i = i + 1 {
            if s[offset + i] != suffix[i] {
                return 0
            }
        }

        return 1
    }

    // Check if string contains substring
    static func contains(s: String, substr: String) -> bool {
        return StringUtils.index_of(s, substr) >= 0
    }

    // Find first occurrence of substring
    static func index_of(s: String, substr: String) -> i64 {
        let s_len: i64 = s.len()
        let sub_len: i64 = substr.len()

        if sub_len > s_len {
            return -1
        }

        for let i: i64 = 0; i <= s_len - sub_len; i = i + 1 {
            let is_match: bool =1
            for let j: i64 = 0; j < sub_len; j = j + 1 {
                if s[i + j] != substr[j] {
                    is_match = 0
                    break
                }
            }
            if is_match {
                return i
            }
        }

        return -1
    }

    // Find last occurrence of substring
    static func last_index_of(s: String, substr: String) -> i64 {
        let s_len: i64 = s.len()
        let sub_len: i64 = substr.len()

        if sub_len > s_len {
            return -1
        }

        for let i: i64 = s_len - sub_len; i >= 0; i = i - 1 {
            let is_match: bool =1
            for let j: i64 = 0; j < sub_len; j = j + 1 {
                if s[i + j] != substr[j] {
                    is_match = 0
                    break
                }
            }
            if is_match {
                return i
            }
        }

        return -1
    }

    // Replace all occurrences
    static func replace_all(s: String, old_substr: String, new_substr: String) -> String {
        let result: String = new String("")
        let len: i64 = s.len()
        let old_len: i64 = old_substr.len()

        if old_len == 0 {
            return s
        }

        let i: i64 = 0
        for i = 0; i < len; i = i + 1 {
            let is_match: bool =1

            if i <= len - old_len {
                for let j: i64 = 0; j < old_len; j = j + 1 {
                    if s[i + j] != old_substr[j] {
                        is_match = 0
                        break
                    }
                }
            } else {
                is_match = 0
            }

            if is_match {
                result = result + new_substr.c_str()
                i = i + old_len - 1
            } else {
                let c: char = s[i]
                result = result + char_to_string(c).c_str()
            }
        }

        return result
    }

    // Replace first occurrence
    static func replace_first(s: String, old_substr: String, new_substr: String) -> String {
        let idx: i64 = StringUtils.index_of(s, old_substr)
        if idx < 0 {
            return s
        }

        let before: String = s.substring(0, idx)
        let after: String = s.substring(idx + old_substr.len(), s.len())

        return before + new_substr.c_str() + after.c_str()
    }

    // Pad string to length with character
    static func pad_left(s: String, length: i64, pad_char: char) -> String {
        let current_len: i64 = s.len()
        if current_len >= length {
            return s
        }

        let result: String = new String("")
        let padding_needed: i64 = length - current_len

        for let i: i64 = 0; i < padding_needed; i = i + 1 {
            result = result + char_to_string(pad_char).c_str()
        }

        result = result + s.c_str()
        return result
    }

    static func pad_right(s: String, length: i64, pad_char: char) -> String {
        let current_len: i64 = s.len()
        if current_len >= length {
            return s
        }

        let result: String = s
        let padding_needed: i64 = length - current_len

        for let i: i64 = 0; i < padding_needed; i = i + 1 {
            result = result + char_to_string(pad_char).c_str()
        }

        return result
    }

    // Reverse string
    static func reverse(s: String) -> String {
        let len: i64 = s.len()
        let result: String = new String("")

        for let i: i64 = len - 1; i >= 0; i = i - 1 {
            let c: char = s[i]
            result = result + char_to_string(c).c_str()
        }

        return result
    }

    // Repeat string n times
    static func repeat(s: String, times: i64) -> String {
        let result: String = new String("")

        for let i: i64 = 0; i < times; i = i + 1 {
            result = result + s.c_str()
        }

        return result
    }

    // Check if string is empty or whitespace
    static func is_whitespace(s: String) -> bool {
        let len: i64 = s.len()

        if len == 0 {
            return 1
        }

        for let i: i64 = 0; i < len; i = i + 1 {
            let c: char = s[i]
            if c != 32 && c != 9 && c != 10 && c != 13 {
                return 0
            }
        }

        return 1
    }
}

// String builder for efficient concatenation
class StringBuilder {
    let parts: Vector<String>
    let total_length: i64

    constructor() {
        self.parts = new Vector<String>()
        self.total_length = 0
    }

    func append(s: String) {
        self.parts.push(s)
        self.total_length = self.total_length + s.len()
    }

    func append(s: char*) {
        self.append(new String(s))
    }

    func append(c: char) {
        self.append(char_to_string(c))
    }

    func append(value: i64) {
        // Convert i64 to string
        let is_negative: bool = value < 0
        if is_negative {
            value = -value
        }

        let digits: Vector<char> = new Vector<char>()

        if value == 0 {
            digits.push(48)
        } else {
            while value > 0 {
                let digit: char = (48 + (value % 10)) as char
                digits.push(digit)
                value = value / 10
            }
        }

        if is_negative {
            self.append('-')
        }

        // Reverse digits
        let size: i64 = digits.len()
        for let i: i64 = size - 1; i >= 0; i = i - 1 {
            self.append(digits.get(i))
        }
    }

    func append(value: int) {
        self.append(value as i64)
    }

    func append(value: u64) {
        let digits: Vector<char> = new Vector<char>()

        if value == 0 {
            digits.push(48)
        } else {
            while value > 0 {
                let digit: char = (48 + (value % 10)) as char
                digits.push(digit)
                value = value / 10
            }
        }

        let size: i64 = digits.len()
        for let i: i64 = size - 1; i >= 0; i = i - 1 {
            self.append(digits.get(i))
        }
    }

    func append(value: uint) {
        self.append(value as u64)
    }

    func append(value: f64) {
        let b: char[64]
        ksnprintf(b as char*, 64, "%f", value)
        self.append(b as char*)
    }

    func append(value: f32) {
        self.append(value as f64)
    }

    func append(value: bool) {
        if value {
            self.append("true" as char*)
        } else {
            self.append("false" as char*)
        }
    }

    func append_char(c: char) {
        self.append(c)
    }

    func append_int(value: i64) {
        self.append(value)
    }

    func to_string() -> String {
        return StringUtils.join(self.parts, new String(""))
    }

    func clear() {
        self.parts = new Vector<String>()
        self.total_length = 0
    }

    func length() -> i64 {
        return self.total_length
    }
}

// C++ `std::stringstream` - an in-memory buffer usable both as an
// insertion target (operator<<, like ofstream) and an extraction source
// (operator>>, like ifstream), same idea as those two but backed by a
// growable byte buffer instead of a file descriptor. A single shared
// position (read_pos) walks forward as operator>> consumes tokens;
// operator<< only ever appends, so building with << then immediately
// extracting with >> reads back exactly what was just written, in order -
// the same "one buffer, one cursor" shape a real stringstream has.
class stringstream {
    let buf: Vector<u8>
    let read_pos: u64
    let had_error: bool
    // Backs as_string() below - a real field, not a fresh llpl_alloc
    // returned straight from a throwaway temporary, so the pointer stays
    // valid for as long as this stringstream itself does (matching what
    // an implicit conversion's caller actually needs: `puts(ss)` keeps
    // `ss` alive for the whole call, but nothing guarantees a temporary
    // String's own backing buffer would be).
    let cached_cstr: char*

    constructor() {
        self.buf = new Vector<u8>()
        self.read_pos = 0
        self.had_error = false
        self.cached_cstr = null
    }

    // Preloads content - the usual way to build a stringstream you only
    // ever intend to extract from (`new stringstream("42 3.5 hi")`).
    constructor(initial: char*) {
        self.buf = new Vector<u8>()
        self.read_pos = 0
        self.had_error = false
        self.cached_cstr = null
        let n: u64 = llpl_strlen(initial)
        let i: u64 = 0
        while i < n {
            self.buf.push_back(initial[i] as u8)
            i = i + 1
        }
    }

    destructor() {
        if self.cached_cstr != null {
            llpl_free(self.cached_cstr)
        }
    }

    // Materializes the buffer's current contents - C++ stringstream's own
    // str().
    func str() -> String {
        let n: i64 = self.buf.size()
        let tmp: char* = llpl_alloc((n + 1) as u64)
        let i: i64 = 0
        while i < n {
            tmp[i] = self.buf[i] as char
            i = i + 1
        }
        tmp[n] = 0
        let s: String = new String(tmp)
        llpl_free(tmp)
        return s
    }

    // What lets `puts(ss)` work directly, without spelling out
    // `ss.str().c_str()` - the compiler calls this automatically for any
    // class value used where a `char*` is expected (see codegen.d's
    // insertImplicitConversionCastIfNeeded), the same convention
    // as_int()/as_float()/as_bool() already follow for their own target
    // types.
    func as_string() -> char* {
        if self.cached_cstr != null {
            llpl_free(self.cached_cstr)
        }
        let n: i64 = self.buf.size()
        self.cached_cstr = llpl_alloc((n + 1) as u64)
        let i: i64 = 0
        while i < n {
            self.cached_cstr[i] = self.buf[i] as char
            i = i + 1
        }
        self.cached_cstr[n] = 0
        return self.cached_cstr
    }

    func eof() -> bool {
        return self.read_pos >= (self.buf.size() as u64)
    }

    func fail() -> bool {
        return self.had_error
    }

    func good() -> bool {
        return !self.had_error
    }

    func as_bool() -> bool {
        return self.good()
    }

    func clear() {
        self.buf = new Vector<u8>()
        self.read_pos = 0
        self.had_error = false
    }

    func append_cstr(s: char*) {
        let n: u64 = llpl_strlen(s)
        let i: u64 = 0
        while i < n {
            self.buf.push_back(s[i] as u8)
            i = i + 1
        }
    }

    // Same tokenizing rule as ifstream's own extract_token (stdlib/io/
    // file.llpl) - skip leading whitespace, read to the next whitespace/
    // end-of-buffer or max_size - 1 bytes, whichever comes first.
    func extract_token(tok: char*, max_size: u64) -> u64 {
        while self.read_pos < (self.buf.size() as u64) {
            let c: u8 = self.buf[self.read_pos as i64]
            if c != 32 && c != 9 && c != 10 && c != 13 {
                break
            }
            self.read_pos = self.read_pos + 1
        }

        let i: u64 = 0
        while self.read_pos < (self.buf.size() as u64) && i < max_size - 1 {
            let c: u8 = self.buf[self.read_pos as i64]
            if c == 32 || c == 9 || c == 10 || c == 13 {
                break
            }
            tok[i] = c as char
            i = i + 1
            self.read_pos = self.read_pos + 1
        }
        tok[i] = 0
        return i
    }

    func operator<<(value: i64) -> stringstream {
        let b: char[24]
        ksnprintf(b as char*, 24, "%d", value)
        self.append_cstr(b as char*)
        return self
    }

    func operator<<(value: int) -> stringstream {
        return self << (value as i64)
    }

    func operator<<(value: u64) -> stringstream {
        let b: char[24]
        ksnprintf(b as char*, 24, "%u", value)
        self.append_cstr(b as char*)
        return self
    }

    func operator<<(value: uint) -> stringstream {
        return self << (value as u64)
    }

    func operator<<(value: f64) -> stringstream {
        let b: char[64]
        ksnprintf(b as char*, 64, "%f", value)
        self.append_cstr(b as char*)
        return self
    }

    func operator<<(value: char*) -> stringstream {
        self.append_cstr(value)
        return self
    }

    func operator<<(value: char) -> stringstream {
        let b: char[2]
        b[0] = value
        b[1] = 0
        self.append_cstr(b as char*)
        return self
    }

    func operator<<(value: bool) -> stringstream {
        if value {
            self.append_cstr("true" as char*)
        } else {
            self.append_cstr("false" as char*)
        }
        return self
    }

    func operator>>(out: i64*) -> stringstream {
        let tok: char[32]
        let n: u64 = self.extract_token(tok as char*, 32)
        if n == 0 {
            self.had_error = true
        }
        *out = atoll(tok as char*)
        return self
    }

    func operator>>(out: f64*) -> stringstream {
        let tok: char[32]
        let n: u64 = self.extract_token(tok as char*, 32)
        if n == 0 {
            self.had_error = true
        }
        *out = strtod(tok as char*, null)
        return self
    }
}

// Format string with placeholders
class Format {
    static func format(template: String, args: Vector<String>) -> String {
        let result: StringBuilder = new StringBuilder()
        let len: i64 = template.len()
        let arg_idx: i64 = 0
        let args_size: i64 = args.len()

        let i: i64 = 0
        for i = 0; i < len; i = i + 1 {
            let c: char = template[i]

            if c == 123 && i + 1 < len && template[i + 1] == 125 {
                if arg_idx < args_size {
                    result.append(args.get(arg_idx))
                    arg_idx = arg_idx + 1
                }
                i = i + 1  // Skip the '}'
            } else {
                result.append_char(c)
            }
        }

        return result.to_string()
    }
}

// Character utilities
class CharUtils {
    static func is_alpha(c: char) -> bool {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
    }

    static func is_digit(c: char) -> bool {
        return c >= 48 && c <= 57
    }

    static func is_alphanumeric(c: char) -> bool {
        return CharUtils.is_alpha(c) || CharUtils.is_digit(c)
    }

    static func is_whitespace(c: char) -> bool {
        return c == 32 || c == 9 || c == 10 || c == 13
    }

    static func is_upper(c: char) -> bool {
        return c >= 65 && c <= 90
    }

    static func is_lower(c: char) -> bool {
        return c >= 97 && c <= 122
    }

    static func to_upper(c: char) -> char {
        if CharUtils.is_lower(c) {
            return c - 32
        }
        return c
    }

    static func to_lower(c: char) -> char {
        if CharUtils.is_upper(c) {
            return c + 32
        }
        return c
    }
}

} // namespace text
} // namespace std
