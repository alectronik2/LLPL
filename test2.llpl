import std.text.string_utils
import std.io.file

import "cimport.h" as C

using namespace std.text
using namespace std.io

func putty(x: string) -> string {
    return x
}

class Klass {
    constructor() {
        puts("Klass::constructor()")
    }

    destructor() {
        puts("Klass::destructor()")
    }
    
    func to_string() -> string {
        return "A KLASS"
    }

    func hello( s: string ) {
        puts( "Hello with: \(s)")
    }
    
    func operator++() -> Klass {
        puts("PLUS PLUS")
        return self
    }
}

let pub: Klass

func throwing() {
    throw "Error"
}

func typed<T>( arg: T ) -> T {
    return arg
}

func something( k: Klass ) {
    puts("Something called")
}

func main() {
    let x = 128

    match x {
        case 1..10, 100 => {
            puts("gotcha")
        }
        case 128 => {
            puts("yeah, got it")
        }
        case _ => {
            puts("default")
        }
    }

    let ss = new stringstream()
    ss << "Hello" << " World"

    let ss = new stringstream("")
    ss << "42 3.14 7"

    let a: i64 = 0
    let b: f64 = 0.0
    let c: i64 = 0
    ss >> &a >> &b >> &c

    puts("b is \(b), ss is \(ss)")

    "hello" |> putty() |> puts() if true
    "not shown" |> puts() unless true

    let k = new Klass()
    let kc = new Rc<Klass>(k)
    let pub = kc.clone()
    
    puts("Autoconvert: \(k)")

    defer { puts("Defer") }

    let o = new ofstream("FILE.txt")
    o << "foo bar baz"

    let i = new ifstream("FILE.txt")
    let s1: string
    i >> &s1
    puts( s1 )

    try {
        throwing()
    } catch e: string  {
        puts("Got an error: \(e)")
    }

    ">> Hello world from C \n" |> C.printf

    let rec: C.s = { .foo = 7, .bar = 5 }

    (k++).hello("stre")

    let r = typed<i64>(128)
    puts("Typed: \(r)")

    for i in 1..5 {
        puts("loop: \(i)")
    }

    something(k)
    //delete k

    let h = new hello()
    h.get_var = 212
    let p = h.get_var

    puts("GOT \(p)")

    let f: func() = some_function
    f()
}

func some_function() {
    puts("some_function was called")
}

class hello {
    var: int = 0

    property get_var() -> int {
        var
    }

    property get_var( x: uint ) {
        puts("SET PROPERRTY")
        self.var = x
    }
}
