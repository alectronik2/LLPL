// Real SDL-backed UI DSL demo. ESC or the window close button exits.

import stdlib.ui.sdl
import stdlib.io.filesystem

using namespace std.ui
using namespace std.fs

let clicks: i64 = 0
let selected_file: string = ""

ui DemoWindow: Window {
    title: "LLPL UI"
    width: 800
    height: 600
    padding: 24
    spacing: 14

    Text {
        text: "LLPL UI DSL"
        preferred_height: 32
    }

    Row {
        spacing: 12
        preferred_height: 300

        Column {
            spacing: 10
            padding: 0
            preferred_height: 300

            Text {
                text: "Items List"
                preferred_height: 24
            }

            List {
                preferred_height: 250
            }
        }

        Column {
            spacing: 10
            padding: 0
            preferred_height: 300

            Text {
                text: "Tree View"
                preferred_height: 24
            }

            TreeView {
                preferred_height: 250
            }
        }
    }

    Panel {
        spacing: 10
        padding: 16
        preferred_height: 120

        Text {
            text: "Controls"
            preferred_height: 28
        }

        Button {
            text: "Click me"
            width: 120
            onClick: {
                clicks = clicks + 1
                puts("button clicked")
            }
        }
    }
}

func main() -> i64 {
    let root: Window = DemoWindow.build()
    root.apply_dark_theme()

    let list: List = null
    let tree: TreeView = null

    let child: Widget = root.first_child
    while child != null {
        if child.kind_id == WIDGET_ROW {
            let col: Widget = child.first_child
            while col != null {
                if col.kind_id == WIDGET_COLUMN {
                    let item: Widget = col.first_child
                    while item != null {
                        if item.kind_id == WIDGET_LIST {
                            list = item as List
                        }
                        if item.kind_id == WIDGET_TREEVIEW {
                            tree = item as TreeView
                        }
                        item = item.next_sibling
                    }
                }
                col = col.next_sibling
            }
        }
        child = child.next_sibling
    }

    if list != null {
        list.add_item("Apple")
        list.add_item("Banana")
        list.add_item("Cherry")
        list.add_item("Date")
        list.add_item("Elderberry")
    }

    if tree != null {
        tree.add_item("Documents", 0)
        tree.add_item("file1.txt", 1)
        tree.add_item("file2.txt", 1)
        tree.add_item("Downloads", 0)
        tree.add_item("app.exe", 1)
        tree.add_item("library.dll", 1)
        tree.add_item("Pictures", 0)
        tree.add_item("photo.png", 1)
    }

    let app: App = new App("LLPL UI DSL", 800, 600, root)
    if !app.is_valid() {
        return 1
    }
    app.run()
    return 0
}
