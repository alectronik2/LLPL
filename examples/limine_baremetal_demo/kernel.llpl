// Minimal Limine bare-metal demo in LLPL.
//
// Limine enters this kernel already in 64-bit mode with paging enabled.
// We request framebuffer, memory-map, and HHDM data using Limine's
// request/response protocol, then write diagnostics to COM1 serial and draw
// a simple visualization directly into the framebuffer returned by the
// bootloader.

import hal
import mm
import terminal
import lib
import kern

// Strong freestanding runtime hooks: the default runtime panic hooks are
// intentionally silent, so route assertion failures through COM1.
func llpl_panic_putc(c: char) {
    hs.write_char(c)
}

func llpl_panic_halt() {
    while true {
        HAL.halt()
    }
}

@section(".limine_requests_start") @used
let limine_requests_start_marker: u64[4] = limine_start_marker_id

@section(".limine_requests") @used
let framebuffer_request: LimineFramebufferRequest = LimineFramebufferRequest {
    id: limine_framebuffer_request_id,
    revision: 0,
    response: 0
}

@section(".limine_requests") @used
let memmap_request: LimineMemmapRequest = LimineMemmapRequest {
    id: limine_memmap_request_id,
    revision: 0,
    response: 0
}

@section(".limine_requests") @used
let hhdm_request: LimineHhdmRequest = LimineHhdmRequest {
    id: limine_hhdm_request_id,
    revision: 0,
    response: 0
}

@section(".limine_requests") @used
let module_request: LimineModuleRequest = LimineModuleRequest {
    id: limine_module_request_id,
    revision: 0,
    response: 0,
    internal_module_count: 0,
    internal_modules: 0
}

@section(".limine_requests_end") @used
let limine_requests_end_marker: u64[2] = limine_end_marker_id

func limine_get_framebuffer() -> LimineFramebuffer* {
    if framebuffer_request.response == 0 {
        return null
    }
    let response: LimineFramebufferResponse* = framebuffer_request.response
    let framebuffers = response.framebuffers 
    return framebuffers[0] as LimineFramebuffer*
}

func limine_get_memmap() -> LimineMemmapResponse* {
    return memmap_request.response
}

func limine_get_hhdm() -> LimineHhdmResponse* {
    return hhdm_request.response
}

func limine_get_modules() -> LimineModuleResponse* {
    return module_request.response
}

func memmap_type_name(t: u64) -> string {
    match t {
        case MemMapType.Usable =>                { return "usable" }
        case MemMapType.Reserved =>              { return "reserved" }
        case MemMapType.AcpiReclaimable =>       { return "acpi-reclaimable" }
        case MemMapType.AcpiNvs =>               { return "acpi-nvs" }
        case MemMapType.BadMemory =>             { return "bad-memory" }
        case MemMapType.BootloaderReclaimable => { return "bootloader-reclaimable" }
        case MemMapType.ExecutableAndModules =>  { return "kernel/modules" }
        case MemMapType.Framebuffer =>           { return "framebuffer" }
        case MemMapType.ReservedMapped =>        { return "reserved-mapped" }
        case _ =>                                { return "unknown" }
    }
}

func memmap_type_color(t: u64) -> u32 {
    match t {
        case MemMapType.Usable =>                { return 0x1fbf75 }
        case MemMapType.Reserved =>              { return 0x777777 }
        case MemMapType.AcpiReclaimable =>       { return 0x44b5ff }
        case MemMapType.AcpiNvs =>               { return 0xffc857 }
        case MemMapType.BadMemory =>             { return 0xff2020 }
        case MemMapType.BootloaderReclaimable => { return 0x44b5ff }
        case MemMapType.ExecutableAndModules =>  { return 0xffc857 }
        case MemMapType.Framebuffer =>           { return 0xff4f8b }
        case MemMapType.ReservedMapped =>        { return 0x777777 }
        case _ =>                                { return 0x777777 }
    }
}

func put_pixel(fb: LimineFramebuffer*, x: u64, y: u64, rgb: u32) {
    if fb.bpp != 32 as u16 {
        return
    }
    let row = (fb.address + y * fb.pitch) as string
    let p = (row + x * 4) as u32*
    p[0] = rgb
}

func fill_rect(fb: LimineFramebuffer*, x0: u64, y0: u64, w: u64, h: u64, rgb: u32) {
    let y = 0
    while y < h {
        let x = 0
        while x < w {
            if x0 + x < fb.width && y0 + y < fb.height {
                put_pixel(fb, x0 + x, y0 + y, rgb)
            }
            x = x + 1
        }
        y = y + 1
    }
}

func draw_demo(fb: LimineFramebuffer*) {
    let max_y = fb.height
    if max_y > 240 {
        max_y = 240
    }
    let max_x = fb.width
    if max_x > 320 {
        max_x = 320
    }

    let y = 0
    while y < max_y {
        let x = 0
        while x < max_x {
            let r = ((x * 255 / max_x) & 255) as u32
            let g = ((y * 255 / max_y) & 255) as u32
            let b = 0x80
            put_pixel(fb, x, y, (r << 16) | (g << 8) | b)
            x = x + 1
        }
        y = y + 1
    }
}

func draw_memmap(fb: LimineFramebuffer*, memmap: LimineMemmapResponse*) {
    let entries = memmap.entries as u64*
    let max_end = 0
    let i = 0
    while i < memmap.entry_count {
        let entry = entries[i] as LimineMemmapEntry*
        let end_addr: u64 = entry.base + entry.length
        if end_addr > max_end {
            max_end = end_addr
        }
        i = i + 1
    }
    if max_end == 0 {
        return
    }

    let plot_x = 16
    let plot_y = 260
    let plot_w = fb.width
    if plot_w > 640 {
        plot_w = 640
    }
    if plot_w > 32 {
        plot_w = plot_w - 32
    }

    fb |> fill_rect(plot_x, plot_y - 2, plot_w, 16, 0x202020 as u32)

    i = 0
    while i < memmap.entry_count {
        let entry = entries[i] as LimineMemmapEntry*
        let x0 = plot_x + (entry.base * plot_w) / max_end
        let x1 = plot_x + ((entry.base + entry.length) * plot_w) / max_end
        let w = x1 - x0
        if w == 0 {
            w = 1
        }
        fb |> fill_rect(x0, plot_y, w, 12, memmap_type_color(entry.type))
        i++
    }

    let legend_y = plot_y + 24
    fb |> fill_rect(plot_x, legend_y, 18, 10, memmap_type_color(MemMapType.Usable))
    fb |> fill_rect(plot_x + 26, legend_y, 18, 10, memmap_type_color(MemMapType.Reserved))
    fb |> fill_rect(plot_x + 52, legend_y, 18, 10, memmap_type_color(MemMapType.BootloaderReclaimable))
    fb |> fill_rect(plot_x + 78, legend_y, 18, 10, memmap_type_color(MemMapType.ExecutableAndModules))
    fb |> fill_rect(plot_x + 104, legend_y, 18, 10, memmap_type_color(MemMapType.Framebuffer))
}

func demo_hhdm(memmap: LimineMemmapResponse*, hhdm: LimineHhdmResponse*) {
    "Limine HHDM offset: \(hhdm.offset:hex)\n" |> hs.write

    let entries= memmap.entries as u64*
    let probe_phys = 0
    let found = false
    let i = 0
    while i < memmap.entry_count && !found {
        let entry = entries[i] as LimineMemmapEntry*
        if entry.type == MemMapType.Usable && entry.length > 0 {
            probe_phys = entry.base
            if probe_phys < 0x1000 && entry.length > 0x1000 {
                probe_phys = 0x1000
            }
            if probe_phys < entry.base + entry.length {
                found = true
            }
        }
        i = i + 1
    }

    if found {
        let probe_virt = hhdm.offset + probe_phys
        let p = probe_virt as u8*
        let value = p[0] as u64
        "HHDM probe phys \(probe_phys:hex) -> virt \(probe_virt:hex) byte=\(value & 255:hex)\n" |> hs.write
    } else {
        "No usable memory region available for HHDM probe\n" |> hsw
    }
}

func kernel_main() {
    HAL.disable_interrupts()
    hs.init()
    "LLPL Limine bare-metal demo booting\n" |> hsw

    let fb      = limine_get_framebuffer()
    let memmap  = limine_get_memmap()
    let hhdm    = limine_get_hhdm()

    assert( memmap != null, "No Limine memory map response" )
    assert( hhdm != null, "No Limine HHDM response" )
    assert( fb != null, "No Limine framebuffer response" )

    // Mark the framebuffer's physical range Write-Combining before
    // anything (including Terminal.init below) ever writes to it - the
    // range must not already be cached under a conflicting type when the
    // MTRR is programmed. fb.address may already be HHDM/virtual, so the
    // physical base/length come from the memmap's own Framebuffer-typed
    // entry instead (memmap entries are always physical).
    {
        let entries = memmap.entries as u64*
        let i = 0
        while i < memmap.entry_count {
            let entry = entries[i] as LimineMemmapEntry*
            if entry.type == MemMapType.Framebuffer {
                HAL.MTRR.set_write_combining(entry.base, entry.length)
                break
            }
            i = i + 1
        }
    }

    HAL.GDT.init()
    HAL.IDT.init()
    HAL.Syscall.init()
    HAL.PIC.init()
    Timer.init()
    HAL.PIT.init()

    MM.init( memmap, hhdm )
    MM.aspace_init()
    HAL.percpu_init()

    // Additive alongside HAL.PIC - keyboard/mouse/PIT stay PIC-routed
    // exactly as before. Needs MM.p2v (hhdm_offset), hence after MM.init.
    HAL.LAPIC.init()
    HAL.IOAPIC.init()

    Kern.proc_init()
    Kern.thread_init()
    Kern.shm_init()

    Kern.device_init()
    Kern.keyboard_init()

    Kern.blockdevice_init()
    Kern.ahci_init()

    Terminal.init( fb )
    // mouse_init() must run after Terminal.init() - it reads
    // Terminal.width()/height() to place the initial cursor and window
    // position, which return 0 until active_console is set.
    let mouse_ok = Kern.mouse_init()
    "Welcome to DimensionOS!\n" |> Terminal.write
    // Terminal.write only draws to the framebuffer (unlike ConsoleDevice's
    // write(), used by user-mode SYS_WRITE, which also goes to serial) -
    // this print also needs to reach serial directly to be visible in a
    // headless (-display none) boot log for automated verification.
    if mouse_ok {
        "Mouse init self-test: PASS\n" |> Terminal.write
        "Mouse init self-test: PASS\n" |> HAL.Serial.write
    } else {
        "Mouse init self-test: FAIL\n" |> Terminal.write
        "Mouse init self-test: FAIL\n" |> HAL.Serial.write
    }

    Kern.install_console_fds()

    VFS.init(limine_get_modules())
    "Spawning init <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/init")
    "Init spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/sh")
    "User shell spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_shm_demo()
    "shm demo spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/apc_target")
    Kern.spawn_elf("/bin/apc_sender")
    "apc demo spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/seh_demo")
    "seh demo spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/wait_target")
    Kern.spawn_elf("/bin/wait_demo")
    "wait demo spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/iocp_demo")
    "iocp demo spawned <green>ok</>\n" |> Terminal.write
    Kern.spawn_elf("/bin/sync_handle_demo")
    "sync handle demo spawned <green>ok</>\n" |> Terminal.write
    // pipe_pipeline_demo/pipe_simple_demo (user/*.c) are diagnostic repros
    // for the pipe write-end refcounting investigation - not auto-spawned
    // since a reader blocked on EOF still hangs in some scenarios even
    // after the confirmed leak fix in hal/syscall.llpl (DescriptorTable.get()
    // returning a retained reference that went unreleased at 14 call
    // sites). Root cause of the remaining hang wasn't fully pinned down;
    // build/run manually to continue the investigation.
    // mouse_demo (user/mouse_demo.c) prints dx/dy/buttons on every packet
    // via SYS_WRITE, which now also renders to the framebuffer console -
    // that constant scrolling text painted over the cursor/window sprites
    // drawn directly by kern/mouse.llpl. Left available to build and run
    // manually (e.g. from the shell) but no longer auto-spawned, since
    // the cursor + draggable window are now the visual proof mouse input
    // works.

    //demo_hhdm( memmap, hhdm )

    alias tw = Terminal.write

    //draw_demo(fb)
    //draw_memmap(fb, memmap)
    tw( "<bright-green>DimensionOS kernel booting</>: TrueType + <cyan>ANSI</>\n" )
    tw( "Limine framebuffer: \(fb.address:hex) \(fb.width)x\(fb.height) pitch=\(fb.pitch) bpp=\(fb.bpp) <green>ok</>\n" )
    tw( "Limine memory map: <magenta>\(memmap.entry_count)</> entries <green>ok</>\n" )
    tw( "Running on CPU \(HAL.cpu_id()) <green>ok</>\n" )

    "Kernel initialization complete. Halting.\n" |> hsw

    // Runs as its own kernel thread, not inline here - see
    // Kern.ahci_start_self_test's own comment for why. Created here,
    // alongside every other Kern.spawn_elf call above, rather than after
    // HAL.enable_interrupts() below - every other thread/process creation
    // in this kernel has always happened with interrupts still disabled;
    // creating one with interrupts already live was the one combination
    // never previously exercised.
    Kern.ahci_start_self_test()

    HAL.enable_interrupts()

    while true {
        HAL.halt()
    }
}
