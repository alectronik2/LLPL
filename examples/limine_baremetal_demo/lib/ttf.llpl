// Simplified TrueType font renderer for baremetal
// Supports basic TTF parsing and glyph rasterization
// Focused on simple, clear rendering without complex hinting

// TTF table tags (big-endian)
const TAG_HEAD: u32 = 0x68656164  // 'head'
const TAG_CMAP: u32 = 0x636D6170  // 'cmap'
const TAG_GLYF: u32 = 0x676C7966  // 'glyf'
const TAG_LOCA: u32 = 0x6C6F6361  // 'loca'
const TAG_HHEA: u32 = 0x68686561  // 'hhea'
const TAG_HMTX: u32 = 0x686D7478  // 'hmtx'
const TAG_MAXP: u32 = 0x6D617870  // 'maxp'

// Glyph outline flags
const ON_CURVE: u8 = 0x01
const X_SHORT: u8 = 0x02
const Y_SHORT: u8 = 0x04
const REPEAT: u8 = 0x08
const X_SAME_OR_POSITIVE: u8 = 0x10
const Y_SAME_OR_POSITIVE: u8 = 0x20

struct TtfTable {
    let tag: u32
    let checksum: u32
    let offset: u32
    let length: u32
}

struct TtfFont {
    let data: u8*
    let num_glyphs: u16
    let units_per_em: u16
    let index_to_loc_format: i16
    let head_offset: u32
    let cmap_offset: u32
    let glyf_offset: u32
    let loca_offset: u32
    let hhea_offset: u32
    let hmtx_offset: u32
    let num_hmetrics: u16
}

struct GlyphMetrics {
    let advance_width: i16
    let left_side_bearing: i16
    let x_min: i16
    let y_min: i16
    let x_max: i16
    let y_max: i16
}

struct Point {
    let x: i16
    let y: i16
    let on_curve: bool
}

struct TtfEdge {
    let x0: i16
    let y0: i16
    let x1: i16
    let y1: i16
}

// Read big-endian u16
func read_u16_be(data: u8*, offset: u32) -> u16 {
    let b0: u16 = data[offset] as u16
    let b1: u16 = data[offset + 1] as u16
    return (b0 << 8) | b1
}

// Read big-endian i16
func read_i16_be(data: u8*, offset: u32) -> i16 {
    let val: u16 = read_u16_be(data, offset)
    return val as i16
}

// Read big-endian u32
func read_u32_be(data: u8*, offset: u32) -> u32 {
    let b0: u32 = data[offset] as u32
    let b1: u32 = data[offset + 1] as u32
    let b2: u32 = data[offset + 2] as u32
    let b3: u32 = data[offset + 3] as u32
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// Find a table in the TTF file
func find_table(data: u8*, tag: u32) -> u32 {
    let num_tables: u16 = read_u16_be(data, 4)
    let i: u16 = 0
    while i < num_tables {
        let table_offset: u32 = 12 + (i as u32) * 16
        let table_tag: u32 = read_u32_be(data, table_offset)
        if table_tag == tag {
            return read_u32_be(data, table_offset + 8)
        }
        i = i + 1
    }
    return 0
}

// Initialize a TrueType font from data
func ttf_init(data: u8*) -> TtfFont {
    let font: TtfFont
    font.data = data

    // Find required tables
    font.head_offset = find_table(data, TAG_HEAD)
    font.cmap_offset = find_table(data, TAG_CMAP)
    font.glyf_offset = find_table(data, TAG_GLYF)
    font.loca_offset = find_table(data, TAG_LOCA)
    font.hhea_offset = find_table(data, TAG_HHEA)
    font.hmtx_offset = find_table(data, TAG_HMTX)

    // Read head table
    if font.head_offset != 0 {
        font.units_per_em = read_u16_be(data, font.head_offset + 18)
        font.index_to_loc_format = read_i16_be(data, font.head_offset + 50)
    }
    if font.hhea_offset != 0 {
        font.num_hmetrics = read_u16_be(data, font.hhea_offset + 34)
    }

    // Read maxp table for number of glyphs
    let maxp_offset: u32 = find_table(data, TAG_MAXP)
    if maxp_offset != 0 {
        font.num_glyphs = read_u16_be(data, maxp_offset + 4)
    }

    return font
}

// Get glyph index for a Unicode character
func ttf_get_glyph_index(font: TtfFont, codepoint: u32) -> u16 {
    if font.cmap_offset == 0 {
        return 0
    }

    let cmap: u8* = font.data + font.cmap_offset
    let num_tables: u16 = read_u16_be(cmap, 2)

    // Look for a Unicode cmap (platform 0 or platform 3)
    let i: u16 = 0
    while i < num_tables {
        let encoding_offset: u32 = 4 + (i as u32) * 8
        let platform_id: u16 = read_u16_be(cmap, encoding_offset)
        let encoding_id: u16 = read_u16_be(cmap, encoding_offset + 2)
        let subtable_offset: u32 = read_u32_be(cmap, encoding_offset + 4)

        // Format 4 subtable (most common for Unicode)
        if (platform_id == 3 && encoding_id == 1) || platform_id == 0 {
            let subtable: u8* = cmap + subtable_offset
            let format: u16 = read_u16_be(subtable, 0)

            if format == 4 {
                let seg_count: u16 = read_u16_be(subtable, 6) / 2
                let j: u16 = 0
                while j < seg_count {
                    let end_code: u16 = read_u16_be(subtable, 14 + j * 2)
                    let start_code: u16 = read_u16_be(subtable, 16 + seg_count * 2 + j * 2)

                    if codepoint >= (start_code as u32) && codepoint <= (end_code as u32) {
                        let id_delta: i16 = read_i16_be(subtable, 16 + seg_count * 4 + j * 2)
                        let id_range_offset: u16 = read_u16_be(subtable, 16 + seg_count * 6 + j * 2)

                        if id_range_offset == 0 {
                            return ((codepoint as i16) + id_delta) as u16
                        }

                        // idRangeOffset is measured from the offset word
                        // itself. Resolve the glyph index from that table,
                        // then apply idDelta as required by TrueType cmap 4.
                        let glyph_addr = (16 + seg_count * 6 + j * 2) + id_range_offset + (codepoint - start_code) * 2
                        let glyph = read_u16_be(subtable, glyph_addr)
                        if glyph != 0 {
                            return (glyph + id_delta as u16) as u16
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }

    return 0
}

// Get glyph offset in glyf table
func ttf_get_glyph_offset(font: TtfFont, glyph_index: u16) -> u32 {
    if font.loca_offset == 0 || glyph_index >= font.num_glyphs {
        return 0
    }

    let loca: u8* = font.data + font.loca_offset
    let offset: u32 = 0

    if font.index_to_loc_format == 0 {
        // Short format (offset / 2)
        offset = (read_u16_be(loca, (glyph_index as u32) * 2) as u32) * 2
    } else {
        // Long format
        offset = read_u32_be(loca, (glyph_index as u32) * 4)
    }

    return font.glyf_offset + offset
}

// Get glyph metrics
func ttf_get_glyph_metrics(font: TtfFont, glyph_index: u16) -> GlyphMetrics {
    let metrics: GlyphMetrics
    metrics.advance_width = 0
    metrics.left_side_bearing = 0
    metrics.x_min = 0
    metrics.y_min = 0
    metrics.x_max = 0
    metrics.y_max = 0

    // Get horizontal metrics
    if font.hmtx_offset != 0 {
        let hmtx: u8* = font.data + font.hmtx_offset
        let metric_index = glyph_index
        if metric_index >= font.num_hmetrics {
            metric_index = font.num_hmetrics - 1
        }
        metrics.advance_width = read_i16_be(hmtx, (metric_index as u32) * 4)
        metrics.left_side_bearing = read_i16_be(hmtx, (font.num_hmetrics as u32) * 4 + (glyph_index - font.num_hmetrics) * 2)
    }

    // Get bounding box from glyph data
    let glyph_offset: u32 = ttf_get_glyph_offset(font, glyph_index)
    if glyph_offset != 0 {
        let glyph_data: u8* = font.data + glyph_offset
        let num_contours: i16 = read_i16_be(glyph_data, 0)

        if num_contours >= 0 {
            metrics.x_min = read_i16_be(glyph_data, 2)
            metrics.y_min = read_i16_be(glyph_data, 4)
            metrics.x_max = read_i16_be(glyph_data, 6)
            metrics.y_max = read_i16_be(glyph_data, 8)
        }
    }

    return metrics
}

func ttf_add_edge(edges: TtfEdge*, count: u16*, x0: i16, y0: i16, x1: i16, y1: i16) {
    if *count >= 1024 || (y0 == y1) {
        return
    }
    edges[*count].x0 = x0
    edges[*count].y0 = y0
    edges[*count].x1 = x1
    edges[*count].y1 = y1
    *count = *count + 1
}

func ttf_scale_coord(value: i16, size: i16, units: u16) -> i16 {
    // Preserve six fractional bits through outline construction. Rounding
    // here to whole pixels made later antialiasing largely ineffective.
    (((value as i64) * (size as i64) * 64) / (units as i64)) as i16
}

func ttf_add_quadratic(edges: TtfEdge*, count: u16*, x0: i16, y0: i16,
                       cx: i16, cy: i16, x1: i16, y1: i16) {
    let px = x0
    let py = y0
    let step: i16 = 1
    while step <= 4 {
        let t: i64 = step
        let u: i64 = 4 - t
        let x = (u * u * x0 + 2 * u * t * cx + t * t * x1) / 16
        let y = (u * u * y0 + 2 * u * t * cy + t * t * y1) / 16
        ttf_add_edge(edges, count, px, py, x as i16, y as i16)
        px = x as i16
        py = y as i16
        step = step + 1
    }
}

func ttf_rasterize_edges(edges: TtfEdge*, edge_count: u16, buffer: u8*, buf_w: i16, buf_h: i16) {
    let y: i16 = 0
    while y < buf_h {
        // Four scanlines with four horizontal samples each provide 16
        // coverage levels per pixel. Coordinates are kept in quarter-pixel
        // fixed point so this remains usable before floating point is set up.
        let sy: i16 = 0
        while sy < 4 {
            let intersections: i16[128]
            let num: u16 = 0
            let sample_y = y * 64 + sy * 16 + 8
            let i: u16 = 0
            while i < edge_count && num < 128 {
                let edge = edges[i]
                let ey0 = edge.y0
                let ey1 = edge.y1
                if (ey0 <= sample_y && sample_y < ey1) || (ey1 <= sample_y && sample_y < ey0) {
                    let dy = ey1 - ey0
                    intersections[num] = edge.x0 + ((sample_y - ey0) * (edge.x1 - edge.x0) / dy)
                    num = num + 1
                }
                i = i + 1
            }

            let swapped = true
            while swapped {
                swapped = false
                let j: u16 = 0
                while j + 1 < num {
                    if intersections[j] > intersections[j + 1] {
                        let tmp = intersections[j]
                        intersections[j] = intersections[j + 1]
                        intersections[j + 1] = tmp
                        swapped = true
                    }
                    j = j + 1
                }
            }

            let j: u16 = 0
            while j + 1 < num {
                let x: i16 = 0
                while x < buf_w {
                    let sx: i16 = 0
                    while sx < 4 {
                        let sample_x = x * 64 + sx * 16 + 8
                        if sample_x >= intersections[j] && sample_x < intersections[j + 1] {
                            let at = (y as u32) * (buf_w as u32) + (x as u32)
                            let coverage = (buffer[at] as u16) + 16
                            if coverage > 255 { buffer[at] = 255 }
                            else { buffer[at] = coverage as u8 }
                        }
                        sx = sx + 1
                    }
                    x = x + 1
                }
                j = j + 2
            }
            sy = sy + 1
        }
        y = y + 1
    }
}

// Parse a simple TrueType glyph and rasterize its outline. Composite glyphs
// are intentionally skipped; the console falls back to '?' for those cases.
func ttf_render_glyph(font: TtfFont, glyph_index: u16, size: i16,
                      buffer: u8*, buf_w: i16, buf_h: i16) -> bool {
    let glyph_offset: u32 = ttf_get_glyph_offset(font, glyph_index)
    if glyph_offset == 0 {
        return false
    }

    let glyph_data: u8* = font.data + glyph_offset
    let num_contours: i16 = read_i16_be(glyph_data, 0)

    if num_contours < 0 {
        // Composite glyph - not implemented yet
        return false
    }

    if num_contours == 0 {
        // Empty glyph (space character)
        return true
    }

    let contour_ends: u16[32]
    if num_contours > 32 {
        return false
    }
    let i: u16 = 0
    while i < num_contours {
        contour_ends[i] = read_u16_be(glyph_data, 10 + i * 2)
        i = i + 1
    }
    let point_count: u16 = contour_ends[num_contours - 1] + 1
    if point_count == 0 || point_count > 512 {
        return false
    }

    let instruction_length = read_u16_be(glyph_data, 10 + num_contours * 2)
    let pos: u32 = 12 + num_contours * 2 + instruction_length
    let flags: u8[512]
    let points: Point[512]
    let raw_pos: u32 = pos
    let point_pos: u16 = 0
    while point_pos < point_count {
        let f = font.data[glyph_offset + raw_pos]
        raw_pos = raw_pos + 1
        flags[point_pos] = f
        point_pos = point_pos + 1
        if (f & REPEAT) != 0 {
            let repeats = font.data[glyph_offset + raw_pos] as u16
            raw_pos = raw_pos + 1
            let repeat_pos: u16 = 0
            while repeat_pos < repeats && point_pos < point_count {
                flags[point_pos] = f
                point_pos = point_pos + 1
                repeat_pos = repeat_pos + 1
            }
        }
    }

    let x_pos: u32 = raw_pos
    let x: i16 = 0
    let y: i16 = 0
    let r: u16 = 0
    while r < point_count {
        let f = flags[r]
        if (f & X_SHORT) != 0 {
            let dx = font.data[glyph_offset + x_pos] as i16
            x_pos = x_pos + 1
            if (f & X_SAME_OR_POSITIVE) != 0 { x = x + dx } else { x = x - dx }
        } else if (f & X_SAME_OR_POSITIVE) == 0 {
            x = x + read_i16_be(font.data + glyph_offset, x_pos)
            x_pos = x_pos + 2
        }
        points[r].x = x
        points[r].on_curve = (f & ON_CURVE) != 0
        r = r + 1
    }

    let y_pos: u32 = x_pos
    y = 0
    let s: u16 = 0
    while s < point_count {
        let f = flags[s]
        if (f & Y_SHORT) != 0 {
            let dy = font.data[glyph_offset + y_pos] as i16
            y_pos = y_pos + 1
            if (f & Y_SAME_OR_POSITIVE) != 0 { y = y + dy } else { y = y - dy }
        } else if (f & Y_SAME_OR_POSITIVE) == 0 {
            y = y + read_i16_be(font.data + glyph_offset, y_pos)
            y_pos = y_pos + 2
        }
        points[s].y = y
        s = s + 1
    }

    let edges: TtfEdge[1024]
    let edge_count: u16 = 0
    let baseline: i16 = size * 64
    let scale_num: i64 = size
    let scale_den: i64 = font.units_per_em
    let contour_start: u16 = 0
    let c: u16 = 0
    while c < num_contours {
        let end = contour_ends[c]
        let first = contour_start
        let last = end
        let current_x: i16
        let current_y: i16
        let next: u16
        if (points[first]).on_curve {
            current_x = ttf_scale_coord((points[first]).x, size, font.units_per_em)
            current_y = baseline - ttf_scale_coord((points[first]).y, size, font.units_per_em)
            next = first + 1
        } else if (points[last]).on_curve {
            current_x = ttf_scale_coord((points[last]).x, size, font.units_per_em)
            current_y = baseline - ttf_scale_coord((points[last]).y, size, font.units_per_em)
            next = first
        } else {
            current_x = ttf_scale_coord(((points[first]).x + (points[last]).x) / 2, size, font.units_per_em)
            current_y = baseline - ttf_scale_coord(((points[first]).y + (points[last]).y) / 2, size, font.units_per_em)
            next = first
        }

        let px = current_x
        let py = current_y
        let idx = next
        while idx <= end {
            let point = points[idx]
            if point.on_curve {
                let tx = ttf_scale_coord(point.x, size, font.units_per_em)
                let ty = baseline - ttf_scale_coord(point.y, size, font.units_per_em)
                ttf_add_edge(edges as TtfEdge*, &edge_count, px, py, tx, ty)
                px = tx
                py = ty
                idx = idx + 1
            } else {
                let ni = first
                if idx < end {
                    ni = idx + 1
                }
                let target = points[ni]
                let cx = ttf_scale_coord(point.x, size, font.units_per_em)
                let cy = baseline - ttf_scale_coord(point.y, size, font.units_per_em)
                let tx = ttf_scale_coord(target.x, size, font.units_per_em)
                let ty = baseline - ttf_scale_coord(target.y, size, font.units_per_em)
                if !target.on_curve {
                    tx = ttf_scale_coord((point.x + target.x) / 2, size, font.units_per_em)
                    ty = baseline - ttf_scale_coord((point.y + target.y) / 2, size, font.units_per_em)
                }
                ttf_add_quadratic(edges as TtfEdge*, &edge_count, px, py, cx, cy, tx, ty)
                px = tx
                py = ty
                if ni == first { break }
                if target.on_curve {
                    idx = ni + 1
                } else {
                    idx = idx + 1
                }
            }
        }
        ttf_add_edge(edges as TtfEdge*, &edge_count, px, py, current_x, current_y)
        contour_start = end + 1
        c = c + 1
    }

    ttf_rasterize_edges(edges as TtfEdge*, edge_count, buffer, buf_w, buf_h)
    return true
}

// Calculate text width
func ttf_measure_text(font: TtfFont, text: char*, size: i16) -> i16 {
    let width: i16 = 0
    let i: i64 = 0

    while text[i] != 0 {
        let codepoint: u32 = text[i] as u32
        let glyph_index: u16 = ttf_get_glyph_index(font, codepoint)
        let metrics: GlyphMetrics = ttf_get_glyph_metrics(font, glyph_index)

        let scale: i16 = (size * 64) / (font.units_per_em as i16)
        let advance: i16 = (metrics.advance_width * scale) / 64

        width = width + advance
        i = i + 1
    }

    return width
}
