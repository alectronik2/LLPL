import hal
import lib

import std.collections.linked_list

using namespace std.collections

namespace Kern {
    let devices: DoublyLinkedList<Device>

    // Base class for pluggable character devices, mirroring VFS.Filesystem's
    // virtual-method shape (kern/vfs.llpl) but for live, non-file-backed
    // streams (see FileDescriptor's `device` case, kern/handle.llpl) rather
    // than filesystem content.
    class Device : Object {
        virtual func name() -> String {
            return null
        }

        virtual func read(buf: char*, size: uint) -> int {
            return EINVAL
        }

        virtual func write(buf: char*, size: uint) -> int {
            return EINVAL
        }
    }

    func device_init() {
        devices = new DoublyLinkedList<Device>()
    }

    func register_device(dev: Device) -> bool {
        if dev == null {
            return false
        }
        devices.push_back(dev)
        return true
    }

    func find_device(name: String) -> Device {
        if name == null {
            return null
        }
        let node = devices.head
        while node != null {
            let dev = (*node).value
            if dev != null && dev.name() == name {
                return dev
            }
            node = (*node).next
        }
        return null
    }
}
