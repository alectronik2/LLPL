import hal
import lib
import mm

namespace Kern {
    const ELF_PT_LOAD = 1
    const ELF_ET_EXEC = 2
    const ELF_EM_X86_64 = 62
    const ELF_PF_W = 2
    const USER_STACK_TOP = 0x7000_0000
    const USER_STACK_SIZE = 16_384

    // Keep the initial process and thread alive after spawn_elf returns.
    let init_proc: Process
    let init_thread: Thread

    func user_entry_placeholder(arg: void*) {
        // User threads replace RIP/RSP after construction and never invoke
        // this kernel-side entry point.
    }

    packed struct Elf64Header {
        ident: u8[16]
        elf_type: u16
        machine: u16
        version: u32
        entry: u64
        phoff: u64
        shoff: u64
        flags: u32
        ehsize: u16
        phentsize: u16
        phnum: u16
        shentsize: u16
        shnum: u16
        shstrndx: u16
    }

    packed struct Elf64ProgramHeader {
        type: u32
        flags: u32
        offset: u64
        vaddr: u64
        paddr: u64
        filesz: u64
        memsz: u64
        align: u64
    }

    func elf_valid(file: char*, size: u64) -> bool {
        return false if file == null || size < sizeof(Elf64Header)
        let hdr = file as Elf64Header*
        return false if hdr.ident[0] != 0x7F || hdr.ident[1] != 'E' || hdr.ident[2] != 'L' || hdr.ident[3] != 'F'
        return false if hdr.ident[4] != 2 || hdr.ident[5] != 1
        return false if hdr.elf_type != ELF_ET_EXEC || hdr.machine != ELF_EM_X86_64
        return false if hdr.phentsize != sizeof(Elf64ProgramHeader) as u16 || hdr.phnum == 0
        return false if hdr.phoff > size
        let table_size = (hdr.phnum as u64) * sizeof(Elf64ProgramHeader)
        return false if table_size / sizeof(Elf64ProgramHeader) != hdr.phnum as u64
        return table_size <= size - hdr.phoff
    }

    func reserve_user_range(proc: Process, start: uint, end: uint) -> bool {
        return false if start >= end || start < 0x1000 || end > USER_MMAP_END
        holding proc.aspace.lock {
            return false if proc.aspace.overlaps(start, end)
            let vma = new MM.VmArea(start, end)
            return false if vma == null
            vma.flags = MM.MAP_USER
            // VMA names are optional. Keep loader mappings unnamed so page
            // table construction cannot depend on further string allocation.
            MM.rb_insert(proc.aspace, vma)
        }
        return true
    }

    func map_elf_segment(proc: Process, file: char*, size: u64, ph: Elf64ProgramHeader*) -> bool {
        return true if ph.memsz == 0
        return false if ph.filesz > ph.memsz
        return false if ph.offset > size || ph.filesz > size - ph.offset
        return false if ph.vaddr < 0x1000 || ph.vaddr >= USER_MMAP_END
        return false if ph.memsz > USER_MMAP_END - ph.vaddr

        let first = ph.vaddr & ~(MM.PAGE_SIZE - 1)
        let end_raw = ph.vaddr + ph.memsz
        let end = (end_raw + MM.PAGE_SIZE - 1) & ~(MM.PAGE_SIZE - 1)
        return false if end < end_raw || !reserve_user_range(proc, first, end)

        let page_flags = MM.PG_USER
        if (ph.flags & ELF_PF_W) != 0 {
            page_flags |= MM.PG_WRITABLE
        }

        for let addr = first; addr < end; addr += MM.PAGE_SIZE {
            let pf = MM.alloc_pageframe(MM.FrameType.Other)
            let paddr = MM.pf2p(pf)
            memset(MM.p2v(paddr) as void*, 0, MM.PAGE_SIZE)
            return false if !MM.map_page(proc.pml4, addr, paddr, page_flags)
        }

        let copied: u64 = 0
        while copied < ph.filesz {
            let user_addr = ph.vaddr + copied
            let (mapped, paddr) = user_v2p(proc.pml4, user_addr)
            return false if !mapped
            let page_left = MM.PAGE_SIZE - (user_addr & (MM.PAGE_SIZE - 1))
            let chunk = ph.filesz - copied
            if chunk > page_left {
                chunk = page_left
            }
            memcpy(MM.p2v(paddr) as void*, (file + ph.offset + copied) as void*, chunk)
            copied += chunk
        }
        return true
    }

    func map_user_stack(proc: Process) -> bool {
        let bottom = USER_STACK_TOP - USER_STACK_SIZE
        return false if !reserve_user_range(proc, bottom, USER_STACK_TOP)
        for let addr = bottom; addr < USER_STACK_TOP; addr += MM.PAGE_SIZE {
            map_user_zero_page(proc, addr, true)
        }
        return true
    }

    const MAX_ARGS = 32
    const MAX_ARG_SLOTS = 33 // MAX_ARGS + 1, for the trailing NULL argv slot

    // Writes `size` bytes from kernel memory `src` into `proc`'s user
    // address space starting at `dest`, a page at a time - mirrors
    // map_elf_segment's own copy loop, just for an arbitrary buffer
    // instead of ELF segment data. hal/syscall.llpl's copy_to_user can't
    // be reused here: it copies into the *current* process
    // (HAL.read_cr3()), but `proc` isn't scheduled yet at this point in
    // load_elf_process.
    func write_user_bytes(proc: Process, dest: uint, src: char*, size: u64) -> bool {
        let copied: u64 = 0
        while copied < size {
            let user_addr = dest + copied
            let (mapped, paddr) = user_v2p(proc.pml4, user_addr)
            return false if !mapped
            let page_left = (MM.PAGE_SIZE - (user_addr & (MM.PAGE_SIZE - 1))) as u64
            let chunk = size - copied
            if page_left < chunk {
                chunk = page_left
            }
            memcpy(MM.p2v(paddr) as void*, (src + copied) as void*, chunk)
            copied += chunk
        }
        return true
    }

    // Builds a real argv block at the top of proc's already-mapped user
    // stack - argv[0] = the program's own invocation path, argv[1..] =
    // command_line split on spaces - and points rdi/rsi/rsp at it, so a
    // `func _start(args: string[])` entry (see source/codegen.d's
    // isMainArgsFunction/generateMainWrapper) receives real argc/argv:
    // the same SysV register pair a hosted `main(argc, argv)` gets from
    // the C runtime, just supplied by this loader instead. argv[0] always
    // exists, so argc is never 0.
    func setup_user_args(proc: Process, thread: Thread, path: String, command_line: String) -> bool {
        let starts: u64[MAX_ARG_SLOTS]
        let lens: u64[MAX_ARG_SLOTS]
        let argc: u64 = 1 // argv[0] = path, always present

        if command_line != null {
            let cmd = command_line.c_str()
            let cmd_len = command_line.byte_len() as u64
            let i: u64 = 0
            while i < cmd_len && argc < MAX_ARGS {
                while i < cmd_len && cmd[i] == ' ' { i++ }
                if i >= cmd_len { break }
                let start = i
                while i < cmd_len && cmd[i] != ' ' { i++ }
                starts[argc] = start
                lens[argc] = i - start
                argc++
            }
        }

        let path_len = path.byte_len() as u64
        let strings_bytes: u64 = path_len + 1
        for let a: u64 = 1; a < argc; a++ {
            strings_bytes += lens[a] + 1
        }
        let ptr_bytes = (argc + 1) * 8
        let total: u64 = ptr_bytes + strings_bytes
        while (USER_STACK_TOP - total) % 16 != 8 {
            total++
        }

        let dest = MM.malloc<char>(total)
        return false if dest == null

        let block_addr = USER_STACK_TOP - total
        let argv_slots = dest as u64*
        let write_off = ptr_bytes

        let path_str = path.c_str()
        argv_slots[0] = (block_addr + write_off) as u64
        for let k: u64 = 0; k < path_len; k++ {
            dest[write_off + k] = path_str[k]
        }
        dest[write_off + path_len] = 0 as char
        write_off += path_len + 1

        if command_line != null {
            let cmd = command_line.c_str()
            for let a: u64 = 1; a < argc; a++ {
                argv_slots[a] = (block_addr + write_off) as u64
                let off = starts[a]
                let len = lens[a]
                for let k: u64 = 0; k < len; k++ {
                    dest[write_off + k] = cmd[off + k]
                }
                dest[write_off + len] = 0 as char
                write_off += len + 1
            }
        }
        argv_slots[argc] = 0

        let ok = write_user_bytes(proc, block_addr, dest, total)
        MM.free(dest)
        return false if !ok

        thread.ctx.rdi = argc
        thread.ctx.rsi = block_addr as u64
        thread.ctx.rsp = block_addr as u64
        return true
    }

    func load_elf_process(path: String, parent: Process, command_line: String = null) -> Process {
        let (file, size) = VFS.read_binary(path)
        if !elf_valid(file, size) {
            "ELF: invalid or missing image " |> HAL.Serial.write
            path.c_str() |> HAL.Serial.write
            "\n" |> HAL.Serial.write
            return null
        }

        let hdr = file as Elf64Header*
        let proc = new Process(path, parent, command_line)
        if parent != null {
            // Field reassignment doesn't auto-release the old value - this
            // real delete is what actually frees the constructor's own
            // fresh fd table before replacing it with the inherited one.
            delete proc.fds
            proc.fds = parent.fds.clone_for_exec()
        }
        init_user_pml4(proc)

        for let i: u64 = 0; i < hdr.phnum as u64; i++ {
            let ph = (file + hdr.phoff + i * sizeof(Elf64ProgramHeader)) as Elf64ProgramHeader*
            if ph.type == ELF_PT_LOAD && !map_elf_segment(proc, file, size, ph) {
                "ELF: failed to map load segment\n" |> HAL.Serial.write
                return null
            }
        }

        if !map_user_stack(proc) {
            "ELF: failed to map user stack\n" |> HAL.Serial.write
            return null
        }

        // Reuse the process name rather than allocating after page-table work.
        let thread = new Thread(proc, user_entry_placeholder, null, proc.name, THREAD_USER)
        thread.ctx.rip = hdr.entry
        if !setup_user_args(proc, thread, path, command_line) {
            "ELF: failed to set up argv\n" |> HAL.Serial.write
            return null
        }
        thread |> mark_thread_ready

        return proc
    }

    func spawn_user_process(path: String, parent: Process, command_line: String = null) -> int {
        let proc = load_elf_process(path, parent, command_line)
        return ENOENT if proc == null
        return proc.pid as int
    }

    func spawn_elf(path: String) -> bool {
        init_proc = load_elf_process(path, kproc)
        if init_proc == null { return false }
        holding init_proc.lock {
            let first = init_proc.threads.front()
            if first.is_ok() { init_thread = first.get_ok() }
        }

        // path ownership has moved into the process/thread by this point.
        "ELF: started /bin/init\n" |> HAL.Serial.write
        return true
    }

}
