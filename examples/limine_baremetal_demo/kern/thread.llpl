import mm
import hal
import lib
import kern.timer
import terminal

using namespace std.collections

extern func Kern_await_timer_tick_from_async_frame_size() -> uint
extern func Kern_await_timer_tick_from_async_start_into(frame: void*, start: uint, delay: uint)
extern func Kern_await_timer_tick_from_async_poll_erased(frame: void*, out: void*) -> int

const THREAD_KERNEL = 0x1
const THREAD_USER   = 0x2

enum ThreadState {
    New,
    Ready,
    Running,
    Sleeping,
    Zombie
}

const MAX_PRIORITY  = 32

func current_thread() -> Kern.Thread {
    return HAL.current().thread
}

namespace Kern {
    alias fun = func(void*)

    let lock: SpinLock
    let runq: DoublyLinkedList<Thread>[MAX_PRIORITY]
    let ready_summary: uint

    class Thread : Object {
        stack: char*
        stack_size: u64
        flags: uint
        name: String
        proc: Process

        ptr: fun
        arg: void*
        ctx: HAL.IDT.Context*
        state: uint
        priority: uint

        curdir: String

        constructor( proc: Process, ptr_: fun, arg: void*, name: String, flags: uint = 0, priority: uint = 16, stack_size: u64 = MM.PAGE_SIZE * 4 ) {
            self.stack_size = stack_size
            self.stack      = MM.malloc<char>( stack_size )
            self.name       = name
            self.ptr        = ptr_
            self.proc       = proc
            self.arg        = arg
            self.state      = ThreadState.New
            self.priority   = priority

            let top = ((self.stack as uint) + self.stack_size) & ~0xF
            let frame_addr = top - sizeof(HAL.IDT.Context)
            self.ctx = frame_addr as HAL.IDT.Context*
            memset( self.ctx as void*, 0, sizeof(HAL.IDT.Context) )
            self.ctx.rip = thread_trampoline as u64
            self.ctx.cs = 0x08
            self.ctx.rflags = 0x202
            self.ctx.rsp = top
            self.ctx.ss = 0x10

            if proc != null {
                holding proc.lock {
                    proc.threads.push_back( self )
                }
            }

            "Stack allocated for thread \(name) at \(self.stack:hex)\n" |> HAL.Serial.write
        }
        
        destructor() {
            "Thread destructor\n" |> HAL.Serial.write
            if self.proc != null {
                self.proc.threads.remove( self )
            }
            MM.free( self.stack )
            self.curdir.put() if self.curdir != null
        }
    }

    func thread_init() {
        for i in 0..MAX_PRIORITY {
            runq[i] = new DoublyLinkedList<Thread>()
        }

        let t = new Thread( kproc, func() {
            "Hello from Thread!!" |> HAL.Serial.write
        }, null, "Init" )

        t |> mark_thread_ready

        switch_context( null, t )
    }

    func thread_trampoline() {
        let thread: Thread = HAL.current().thread
        if thread != null {
            thread.ptr( thread.arg )
        }

        if thread != null {
            thread.state = ThreadState.Zombie
        }

        while true {
            HAL.halt()
        }
    }

    func init_thread_context( thread: Thread ) {
        return if !thread

        let top = ((thread.stack as uint) + thread.stack_size) & ~0xF
        let frame_addr = top - sizeof(HAL.IDT.Context)
        let ctx = frame_addr as HAL.IDT.Context*

        memset( ctx as void*, 0, sizeof(HAL.IDT.Context) )
        ctx.rip = thread_trampoline as u64
        ctx.cs = 0x08
        ctx.rflags = 0x202
        ctx.rsp = top
        ctx.ss = 0x10

        thread.ctx = ctx
    }

    func mark_thread_ready( thread: Thread ) {
        return if !thread
        return if thread.state == ThreadState.Zombie

        thread.state = ThreadState.Ready
        holding lock {
            runq[thread.priority].push_back( thread )
            ready_summary |= 1 << thread.priority
        }
    }

    inline func current_thread() -> Thread {
        return HAL.current().thread
    }

    func switch_context( ctx: HAL.IDT.Context*, next: Thread ) -> HAL.IDT.Context* {
        if next == null || next.state == ThreadState.Zombie || next.ctx == null {
            //return ctx
        }
        
        if next == null || next.state == ThreadState.Zombie || next.ctx == null {
            return ctx
        }
        
        let current = current_thread()
        if current != null && ctx != null {
            current.ctx = ctx
        }

        if current == next {
            return ctx
        }

        holding lock {
            if current != null {
                if current.state == ThreadState.Running {
                    current.state = ThreadState.Ready
                    runq[current.priority].push_back( current )
                    ready_summary |= 1 << current.priority
                }
            }

            runq[next.priority].remove( next )
            if runq[next.priority].is_empty() {
                ready_summary &= ~(1 << next.priority)
            }

            next.state = ThreadState.Running
            HAL.current().thread = next
            HAL.GDT.set_tss_rsp0( ((next.stack as uint) + next.stack_size) & ~0xF )
        }

        let next_ctx = next.ctx
        asm("mov %0, %%rsp\n\t"
            "pop %%r15\n\t"
            "pop %%r14\n\t"
            "pop %%r13\n\t"
            "pop %%r12\n\t"
            "pop %%r11\n\t"
            "pop %%r10\n\t"
            "pop %%r9\n\t"
            "pop %%r8\n\t"
            "pop %%rdi\n\t"
            "pop %%rsi\n\t"
            "pop %%rbp\n\t"
            "pop %%rbx\n\t"
            "pop %%rdx\n\t"
            "pop %%rcx\n\t"
            "pop %%rax\n\t"
            "add $16, %%rsp\n\t"
            "iretq"
            : : "r"(next_ctx) : "memory")

        return next_ctx
    }
}
