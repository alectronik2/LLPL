import hal
import lib
import terminal

namespace Kern {
    // Same 8042 controller ports the keyboard driver already polls
    // (kern/keyboard.llpl) - the mouse is the controller's "second PS/2
    // port" (aka the auxiliary device), reached through the same two
    // ports, not a separate I/O range.
    const PS2_DATA_PORT = 0x60
    const PS2_STATUS_PORT = 0x64
    const PS2_CMD_PORT = 0x64
    const PS2_OUTPUT_FULL = 0x1  // status bit 0: a byte is waiting to be read from 0x60
    const PS2_INPUT_FULL = 0x2   // status bit 1: the controller hasn't consumed the last byte written to 0x60/0x64 yet

    const PS2_CMD_ENABLE_AUX = 0xA8
    const PS2_CMD_READ_CONFIG = 0x20
    const PS2_CMD_WRITE_CONFIG = 0x60
    const PS2_CMD_WRITE_AUX = 0xD4  // "the next byte written to 0x60 is for the second (mouse) port"

    const PS2_CONFIG_ENABLE_AUX_IRQ = 0x02  // bit 1: enable IRQ12 on mouse activity
    const PS2_CONFIG_DISABLE_AUX_CLOCK = 0x20 // bit 5: mouse port clock disabled - must be clear

    const MOUSE_CMD_SET_DEFAULTS = 0xF6
    const MOUSE_CMD_ENABLE_REPORTING = 0xF4
    const MOUSE_ACK = 0xFA

    const MOUSE_PACKET_ALWAYS_ONE = 0x08 // byte0 bit 3 - always set on a real mouse packet, used to resync

    const MOUSE_BUFFER_SIZE = 3 * 256 // 256 packets, 3 bytes each

    // Bounded retry count for polling the controller's status bits - a
    // real (or QEMU-emulated) 8042 responds within a handful of
    // iterations; looping forever here would hang boot if the controller
    // never comes up, the exact failure mode this session has repeatedly
    // had to hunt down elsewhere.
    const PS2_POLL_LIMIT = 100_000

    // Fallback shape, used only if load_cursor_sprite() below never
    // succeeds (asset missing/corrupt - VFS isn't even mounted yet this
    // early in boot, so mouse_init() always starts with this): a small
    // fixed 8x8 arrow, one row-bitmask per byte (bit 7 = leftmost pixel),
    // classic 1-bit cursor sprite - no anti-aliasing/hotspot sophistication.
    const CURSOR_COLOR = 0x00FFFFFF as u32
    let cursor_shape: u8[8]

    // Real cursor size once a sprite is loaded - CURSOR_W/H default to the
    // 8x8 fallback bitmap's size and change to match load_cursor_sprite's
    // asset. Not compile-time constants (unlike the bitmap above) because
    // the sprite's dimensions aren't known until that file is read.
    let CURSOR_W: uint = 8
    let CURSOR_H: uint = 8

    // Loaded once load_cursor_sprite() succeeds; null means "use
    // cursor_shape instead". Each pixel is 0xAARRGGBB - blended via
    // Terminal.blend_pixel rather than put_pixel so the sprite's
    // anti-aliased edges and soft drop shadow composite correctly over
    // whatever is already on screen (text, wallpaper, or both).
    let cursor_pixels: u32* = null
    const CURSOR_MAGIC: u32 = 0x53525543

    func init_cursor_shape() {
        cursor_shape[0] = 0x80 as u8
        cursor_shape[1] = 0xC0 as u8
        cursor_shape[2] = 0xE0 as u8
        cursor_shape[3] = 0xF0 as u8
        cursor_shape[4] = 0xF8 as u8
        cursor_shape[5] = 0xE0 as u8
        cursor_shape[6] = 0x30 as u8
        cursor_shape[7] = 0x18 as u8
    }

    // Reallocates cursor_saved (the erase/restore snapshot buffer) to
    // match the current CURSOR_W/H - called once at mouse_init() for the
    // 8x8 fallback size, and again from load_cursor_sprite() if a larger
    // sprite loads successfully.
    func alloc_cursor_saved() {
        if cursor_saved != null {
            llpl_free(cursor_saved as char*)
        }
        cursor_saved = llpl_alloc((CURSOR_W as u64) * (CURSOR_H as u64) * sizeof(u32)) as u32*
    }

    // Called from kernel.llpl after VFS.init() (mouse_init() itself runs
    // too early in boot for the initrd to be mounted yet - same ordering
    // constraint draw_wallpaper works around). File format matches
    // tools/make_cursor.py's output: a 16-byte header (magic, width,
    // height, reserved) then width*height 0xAARRGGBB pixels. Cosmetic
    // only - leaves the 8x8 fallback bitmap in place on any mismatch
    // (missing file, bad magic, truncated data) rather than failing boot.
    func load_cursor_sprite(path: string) -> bool {
        let (data, size) = VFS.read_binary(new String(path))
        if data == null || size < 16 {
            return false
        }
        let header = data as u32*
        if header[0] != CURSOR_MAGIC {
            return false
        }
        let width = header[1]
        let height = header[2]
        let expected = 16 + (width as u64) * (height as u64) * 4
        if size < expected {
            return false
        }
        holding gui_lock {
            cursor_pixels = (data + 16) as u32*
            CURSOR_W = width
            CURSOR_H = height
            alloc_cursor_saved()
            cursor_drawn = false
        }
        return true
    }

    // Absolute on-screen position (signed - dx/dy are signed deltas, and
    // clamping needs to compare against 0 before ever casting to uint).
    let cursor_x: int = 0
    let cursor_y: int = 0
    // Where the sprite was last actually drawn (may lag cursor_x/y - the
    // deferred worker, not the IRQ handler, is what moves this) and what
    // was under it, so it can be restored before drawing at a new spot.
    let cursor_drawn: bool = false
    let cursor_drawn_x: uint = 0
    let cursor_drawn_y: uint = 0
    // Sized (and resized, via alloc_cursor_saved) to match CURSOR_W*CURSOR_H
    // - no longer a fixed array now that the cursor's size depends on the
    // loaded sprite rather than being a compile-time constant.
    let cursor_saved: u32* = null

    // Scratch space for moving the cursor without the erase-then-redraw
    // flicker that direct-to-VRAM put_pixel/blend_pixel calls used to
    // cause - see cursor_capture_new_background/cursor_flush_move below,
    // the same "compose off-screen, blit once" fix as mu_gl_tick's window
    // move. The cursor moves on nearly every tick during any interaction
    // (dragging a window, hovering a button), so this ran far more often
    // than the window-move case and was the more visible source of
    // "windows still flicker" reports even after that fix. Fixed-size
    // rather than sized off CURSOR_W/H (not compile-time constants once a
    // sprite is loaded) - comfortably covers this cursor plus a generous
    // per-tick movement margin; a jump too big to fit falls back to the
    // old direct path for that one tick.
    const CURSOR_MOVE_MAX_W = 96
    const CURSOR_MOVE_MAX_H = 96
    let cursor_move_temp: u32[CURSOR_MOVE_MAX_W * CURSOR_MOVE_MAX_H]
    let cursor_move_compose: u32[CURSOR_MOVE_MAX_W * CURSOR_MOVE_MAX_H]

    func cursor_move_fits(old_x: uint, old_y: uint, new_x: uint, new_y: uint) -> bool {
        let union_x = old_x
        if new_x < union_x { union_x = new_x }
        let union_y = old_y
        if new_y < union_y { union_y = new_y }
        let union_r = old_x + CURSOR_W
        if new_x + CURSOR_W > union_r { union_r = new_x + CURSOR_W }
        let union_b = old_y + CURSOR_H
        if new_y + CURSOR_H > union_b { union_b = new_y + CURSOR_H }
        return (union_r - union_x) <= CURSOR_MOVE_MAX_W && (union_b - union_y) <= CURSOR_MOVE_MAX_H
    }

    // Mirrors mu_gl_capture_new_background: works out the cursor's new-
    // position background without touching the real screen, reading the
    // old rect's own saved background (cursor_saved, still valid here)
    // for any cell that falls inside the not-yet-erased old rect instead
    // of the real screen, which would still show the stale cursor pixels
    // there. Leaves the result in cursor_move_temp.
    func cursor_capture_new_background(new_x: uint, new_y: uint, old_x: uint, old_y: uint) {
        let row: uint = 0
        while row < CURSOR_H {
            let col: uint = 0
            while col < CURSOR_W {
                let px = new_x + col
                let py = new_y + row
                let val: u32
                if px >= old_x && px < old_x + CURSOR_W && py >= old_y && py < old_y + CURSOR_H {
                    val = cursor_saved[((py - old_y) * CURSOR_W) + (px - old_x)]
                } else {
                    val = Terminal.get_pixel(px, py)
                }
                cursor_move_temp[(row * CURSOR_W) + col] = val
                col = col + 1
            }
            row = row + 1
        }
    }

    // Alpha-blends directly into cursor_move_compose - blend_pixel
    // (lib/terminal.llpl) blends against the real screen, but by the time
    // this runs the correct background for every cell here (baseline or
    // erased-old) is already sitting in cursor_move_compose itself, not
    // the real framebuffer.
    func cursor_blend_into_compose(idx: uint, color: u32, alpha: u32) {
        if alpha == 0 { return }
        if alpha >= 255 {
            cursor_move_compose[idx] = color
            return
        }
        let under = cursor_move_compose[idx]
        let inv = 255 - alpha
        let r = ((((color >> 16) & 255) * alpha) + (((under >> 16) & 255) * inv) + 127) / 255
        let g = ((((color >> 8) & 255) * alpha) + (((under >> 8) & 255) * inv) + 127) / 255
        let b = (((color & 255) * alpha) + ((under & 255) * inv) + 127) / 255
        cursor_move_compose[idx] = (r << 16) | (g << 8) | b
    }

    // Mirrors mu_gl_flush_move: composes the erased old rect and the
    // newly drawn cursor into cursor_move_compose and flushes the whole
    // union with one blit_rect() call. Must run after
    // cursor_capture_new_background (still reads the old cursor_saved).
    // Finalizes cursor_saved to cursor_move_temp's contents.
    func cursor_flush_move(new_x: uint, new_y: uint, old_x: uint, old_y: uint) {
        let union_x = old_x
        if new_x < union_x { union_x = new_x }
        let union_y = old_y
        if new_y < union_y { union_y = new_y }
        let union_r = old_x + CURSOR_W
        if new_x + CURSOR_W > union_r { union_r = new_x + CURSOR_W }
        let union_b = old_y + CURSOR_H
        if new_y + CURSOR_H > union_b { union_b = new_y + CURSOR_H }
        let union_w = union_r - union_x
        let union_h = union_b - union_y

        let row: uint = 0
        while row < union_h {
            let col: uint = 0
            while col < union_w {
                cursor_move_compose[(row * union_w) + col] = Terminal.get_pixel(union_x + col, union_y + row)
                col = col + 1
            }
            row = row + 1
        }

        row = 0
        while row < CURSOR_H {
            let col: uint = 0
            while col < CURSOR_W {
                let dst = ((old_y - union_y + row) * union_w) + (old_x - union_x + col)
                cursor_move_compose[dst] = cursor_saved[(row * CURSOR_W) + col]
                col = col + 1
            }
            row = row + 1
        }

        memcpy(cursor_saved as void*, cursor_move_temp as void*, (CURSOR_W * CURSOR_H * 4) as uint)

        if cursor_pixels != null {
            row = 0
            while row < CURSOR_H {
                let col: uint = 0
                while col < CURSOR_W {
                    let p = cursor_pixels[(row * CURSOR_W) + col]
                    let a = (p >> 24) & 0xFF
                    if a != 0 {
                        let dst = ((new_y - union_y + row) * union_w) + (new_x - union_x + col)
                        cursor_blend_into_compose(dst, p & 0x00FF_FFFF, a)
                    }
                    col = col + 1
                }
                row = row + 1
            }
        } else {
            row = 0
            while row < CURSOR_H {
                let bits = cursor_shape[row]
                let col: uint = 0
                while col < CURSOR_W {
                    if (bits & (0x80 as u8 >> col)) != 0 {
                        let dst = ((new_y - union_y + row) * union_w) + (new_x - union_x + col)
                        cursor_move_compose[dst] = CURSOR_COLOR
                    }
                    col = col + 1
                }
                row = row + 1
            }
        }

        Terminal.blit_rect(union_x, union_y, union_w, union_h, cursor_move_compose as u32*, union_w)
    }

    // Edge-detected (not level-triggered), so a held-down button while
    // already dragging something (kern/mu_demo.llpl's microui overlay)
    // doesn't repeat a one-shot action every single packet. mu_demo.llpl
    // reads this directly each tick to feed Mu.input_mousedown/mouseup.
    let left_button_down: bool = false

    // Z-order for the three independent microui overlay windows (see
    // kern/mu_demo.llpl, kern/mu_term.llpl, kern/mu_gl.llpl) - each one
    // ticks/draws itself with no idea the others exist, so without this
    // there is no "which window is on top" at all: mu_demo_tick/
    // mu_term_tick/mu_gl_tick used to always run in that fixed order,
    // which means whichever ran last (mu_gl, the TinyGL window) always
    // painted over the other two and could never appear to go behind
    // them. Index 0 is back-most, index 2 is front-most/topmost -
    // run_window_ticks() below ticks (and therefore paints) back-to-front
    // every cycle, and a left-click inside a window's last-known bounds
    // (checked front-to-back, so an overlapping click resolves to
    // whichever window is actually visible there) brings it to the front
    // for the next cycle.
    const WINDOW_DEMO: u8 = 0
    const WINDOW_TERM: u8 = 1
    const WINDOW_GL: u8 = 2
    const WINDOW_NONE: u8 = 255
    let window_z_order: u8[3]

    // Set by run_window_ticks right before each window's _tick function
    // runs, telling it whether it's this tick's input target - see
    // compute_input_target for why this exists.
    let window_wants_input: bool = false

    func init_window_z_order() {
        window_z_order[0] = WINDOW_DEMO
        window_z_order[1] = WINDOW_TERM
        window_z_order[2] = WINDOW_GL
    }

    func bring_window_to_front(id: u8) {
        if window_z_order[2] == id { return }
        let at: int = -1
        let i: uint = 0
        while i < 3 {
            if window_z_order[i] == id { at = i as int }
            i = i + 1
        }
        if at < 0 { return }
        let j = at as uint
        while j < 2 {
            window_z_order[j] = window_z_order[j + 1]
            j = j + 1
        }
        window_z_order[2] = id
    }

    // Hit-test against each window's last-drawn rect (updated once per
    // tick by that window's own _tick function) - close enough for click-
    // to-front purposes, and avoids needing any of the three windows to
    // expose more than what mouse_pre_scroll already reaches into them
    // for (their _drawn/_drawn_x/_drawn_y/_drawn_w/_drawn_h fields).
    func window_contains(id: u8, x: int, y: int) -> bool {
        if id == WINDOW_DEMO {
            return mu_demo_drawn && x >= (mu_demo_drawn_x as int) &&
                x < (mu_demo_drawn_x as int) + (mu_demo_drawn_w as int) &&
                y >= (mu_demo_drawn_y as int) && y < (mu_demo_drawn_y as int) + (mu_demo_drawn_h as int)
        } else if id == WINDOW_TERM {
            return mu_term_drawn && x >= (mu_term_drawn_x as int) &&
                x < (mu_term_drawn_x as int) + (mu_term_drawn_w as int) &&
                y >= (mu_term_drawn_y as int) && y < (mu_term_drawn_y as int) + (mu_term_drawn_h as int)
        } else {
            return mu_gl_drawn && x >= (mu_gl_drawn_x as int) &&
                x < (mu_gl_drawn_x as int) + (mu_gl_drawn_w as int) &&
                y >= (mu_gl_drawn_y as int) && y < (mu_gl_drawn_y as int) + (mu_gl_drawn_h as int)
        }
    }

    // Front-to-back hit test - which window (if any) is actually visible
    // at (x, y) right now, given the current z-order.
    func topmost_window_at(x: int, y: int) -> u8 {
        let i: int = 2
        while i >= 0 {
            let id = window_z_order[i as uint]
            if window_contains(id, x, y) {
                return id
            }
            i = i - 1
        }
        return WINDOW_NONE
    }

    // Which window should receive mouse input *this* tick, checked by
    // each of mu_demo_tick/mu_term_tick/mu_gl_tick before feeding
    // Mu.input_mousemove/mousedown/mouseup into their own independent
    // microui cycle. Z-order alone (window_z_order/bring_window_to_front
    // above) only ever decided paint order - every window still fed
    // itself the same raw mouse position/buttons unconditionally, so
    // whichever window's *rect* the cursor happened to be over grabbed
    // and kept its own internal Mu.focus regardless of whether another
    // window was now actually drawn on top of it there. That's what made
    // TinyGL "always in focus": once it had focus, painting something
    // else over it visually did nothing to stop it answering clicks.
    //
    // input_owner locks the target to whichever window was topmost at
    // the moment of a fresh press, and keeps it there for the rest of
    // that press (so a fast drag that slips outside the window's rect
    // mid-move doesn't lose its target, and so the eventual release goes
    // to the same window that got the press - a window whose last
    // in_left_down was left stuck true because it got a down but never
    // the matching up would misinterpret its next real click as already
    // in progress). Released back to "recompute by hover" the instant
    // the button comes up.
    // 255, not WINDOW_NONE - a global's static initializer can't reference
    // another typed const across the generated translation units (tcc
    // rejects it: "initializer element is not constant"). Must match
    // WINDOW_NONE's value above.
    let input_owner: u8 = 255
    let input_last_left_down: bool = false

    func compute_input_target() -> u8 {
        let down = left_button_down
        if down && !input_last_left_down {
            let target = topmost_window_at(cursor_x, cursor_y)
            input_owner = target
            if target != WINDOW_NONE {
                bring_window_to_front(target)
            }
        } else if !down {
            input_owner = WINDOW_NONE
        }
        input_last_left_down = down

        if input_owner != WINDOW_NONE {
            return input_owner
        }
        return topmost_window_at(cursor_x, cursor_y)
    }

    // Single entry point for ticking all three overlay windows in the
    // current z-order - replaces calling mu_demo_tick/mu_term_tick/
    // mu_gl_tick directly (hal/pit.llpl, mouse_post_scroll below) so
    // there is exactly one place deciding paint order *and* input
    // routing.
    func run_window_ticks(arg: void*) {
        let target = compute_input_target()
        let i: uint = 0
        while i < 3 {
            let id = window_z_order[i]
            if id == WINDOW_DEMO {
                window_wants_input = target == WINDOW_DEMO
                mu_demo_tick(null)
            } else if id == WINDOW_TERM {
                window_wants_input = target == WINDOW_TERM
                mu_term_tick(null)
            } else {
                window_wants_input = target == WINDOW_GL
                mu_gl_tick(null)
            }
            i = i + 1
        }
    }

    class MouseDevice : Device {
        buffer: char[MOUSE_BUFFER_SIZE]
        read_at: uint
        write_at: uint
        count: uint
        lock: SpinLock
        read_waiters: WaitQueue
        device_name: String

        constructor() {
            self.read_at = 0
            self.write_at = 0
            self.count = 0
            self.read_waiters = new WaitQueue()
            // A bare string literal isn't a real String object (no
            // vtable/refcount header) - constructing one here, once, is
            // the same fix KeyboardDevice's constructor needed (kern/
            // keyboard.llpl) for find_device's name() == name comparison.
            self.device_name = new String("mouse")
        }

        func name() -> String {
            return self.device_name
        }

        // Pushes one complete, already-aligned 3-byte packet atomically -
        // a reader can never observe a partial or misaligned packet.
        func push3(b0: char, b1: char, b2: char) {
            holding self.lock {
                if self.count + 3 <= MOUSE_BUFFER_SIZE {
                    self.buffer[self.write_at] = b0
                    self.write_at = (self.write_at + 1) % MOUSE_BUFFER_SIZE
                    self.buffer[self.write_at] = b1
                    self.write_at = (self.write_at + 1) % MOUSE_BUFFER_SIZE
                    self.buffer[self.write_at] = b2
                    self.write_at = (self.write_at + 1) % MOUSE_BUFFER_SIZE
                    self.count += 3
                }
            }
            wake_all(self.read_waiters)
        }

        func read(buf: char*, size: uint) -> int {
            while true {
                let prepared = false
                holding self.lock {
                    if self.count != 0 {
                        let amount = size
                        if amount > self.count { amount = self.count }
                        for i in 0..amount {
                            buf[i] = self.buffer[self.read_at]
                            self.read_at = (self.read_at + 1) % MOUSE_BUFFER_SIZE
                        }
                        self.count -= amount
                        return amount as int
                    }
                    prepared = prepare_block_current(self.read_waiters)
                }
                return EINVAL if !prepared
                scheduler_yield()
            }
            return EINVAL
        }
    }

    let mouse_device: MouseDevice = null
    let mouse_interrupt: HAL.Interrupt = null
    let mouse_packet: u8[3]
    let mouse_packet_index: uint = 0

    // Guards every read/write of the cursor sprite state (cursor_x/y,
    // cursor_drawn*). Two independent callers now touch it: the Deferred
    // worker thread (periodic redraw, per-packet redraw) and, since
    // Terminal.write() can run on whatever thread any process happens to
    // call it from, mouse_pre_scroll/mouse_post_scroll running
    // synchronously and directly on *that* thread. Without this, a scroll
    // on one thread and a redraw on the worker thread could interleave
    // mid-update, corrupting the saved-pixel bookkeeping - a SpinLock (not
    // a blocking Mutex) is safe here since nothing under it blocks or
    // touches I/O. kern/mu_demo.llpl's microui overlay shares this same
    // lock for its own analogous save/restore state.
    let gui_lock: SpinLock

    // Set by kern/mu_demo.llpl right after it repaints its window (queued
    // on the same PIT tick, always *before* compose_frame_work - see
    // hal/pit.llpl) whenever the cursor sprite might have just been
    // painted over: that overlay redraws its whole window rect every
    // active tick regardless of whether anything in it actually changed,
    // which the "anything_changed" check below has no way to know about
    // on its own. Consumed (cleared) the same tick it's read.
    let mu_overlay_dirty: bool = false

    func mouse_wait_output_full() -> bool {
        for i in 0..PS2_POLL_LIMIT {
            if (HAL.inb(PS2_STATUS_PORT) & PS2_OUTPUT_FULL as u8) != 0 { return true }
        }
        return false
    }

    func mouse_wait_input_clear() -> bool {
        for i in 0..PS2_POLL_LIMIT {
            if (HAL.inb(PS2_STATUS_PORT) & PS2_INPUT_FULL as u8) == 0 { return true }
        }
        return false
    }

    // Sends one byte to the mouse itself (not the controller) - every
    // write needs the 0xD4 prefix telling the 8042 controller to route
    // the following data byte to the second PS/2 port.
    func mouse_write(value: u8) -> bool {
        return false if !mouse_wait_input_clear()
        HAL.outb(PS2_CMD_PORT, PS2_CMD_WRITE_AUX)
        return false if !mouse_wait_input_clear()
        HAL.outb(PS2_DATA_PORT, value)
        return true
    }

    func mouse_read_ack() -> bool {
        return false if !mouse_wait_output_full()
        return HAL.inb(PS2_DATA_PORT) == MOUSE_ACK as u8
    }

    // Runs on Kern.Deferred's own worker thread, never in IRQ context -
    // it writes into the same framebuffer memory Terminal.write's own
    // render()/scroll() write into from whatever thread called it, and
    // neither side takes a lock around that memory. Doing this inline in
    // mouse_irq_handler would add a second, unsynchronized writer racing
    // the first; queuing it here (kern/deferred.llpl, already running -
    // Deferred.init() is called from Kern.thread_init()) keeps it off the
    // IRQ path without needing a new lock around the framebuffer itself.
    // Reads cursor_x/y fresh each time it runs, so a burst of queued
    // redraws from fast mouse movement just collapses to drawing at
    // whatever the latest position is by the time each one runs.
    //
    // Scrolling (Terminal.scroll(), lib/terminal.llpl) is handled
    // separately, synchronously, via mouse_pre_scroll/mouse_post_scroll
    // below - registered as Terminal's scroll hooks - rather than by
    // computing how far the sprite drifted after the fact: erasing right
    // before the pixel shift and redrawing right after leaves no window
    // where a scroll can happen without this module knowing about it.
    func compose_frame_work(arg: void*) {
      holding gui_lock {
        let cx = cursor_x as uint
        let cy = cursor_y as uint

        // Flicker fix: the ~33Hz periodic redraw (hal/pit.llpl) calls this
        // unconditionally so the cursor survives console text scrolling,
        // but that means most calls happen while nothing has actually
        // moved - erasing and immediately redrawing the same pixels at
        // the same spot, 33 times a second, is what was visible as
        // flicker. Bail out before touching any pixels unless something
        // genuinely needs repainting.
        let anything_changed = !cursor_drawn || cursor_drawn_x != cx || cursor_drawn_y != cy || mu_overlay_dirty
        mu_overlay_dirty = false
        return if !anything_changed

        if cursor_drawn && cursor_move_fits(cursor_drawn_x, cursor_drawn_y, cx, cy) {
            // Compose the erase-old + draw-new into cursor_move_compose
            // off-screen and flush it as one blit_rect() below, instead
            // of the erase/capture/draw steps below each hitting the real
            // screen separately - see this file's cursor_move_compose
            // field for why.
            cursor_capture_new_background(cx, cy, cursor_drawn_x, cursor_drawn_y)
            cursor_flush_move(cx, cy, cursor_drawn_x, cursor_drawn_y)
        } else {
            // First-ever draw (nothing to erase yet), or a jump too big
            // for cursor_move_compose - fall back to the direct path.

            // 1. Erase the cursor from its old spot.
            if cursor_drawn {
                for row in 0..CURSOR_H {
                    for col in 0..CURSOR_W {
                        Terminal.put_pixel(cursor_drawn_x + col, cursor_drawn_y + row, cursor_saved[row * CURSOR_W + col])
                    }
                }
            }

            // 2. Capture what's under the cursor's new spot.
            for row in 0..CURSOR_H {
                for col in 0..CURSOR_W {
                    cursor_saved[row * CURSOR_W + col] = Terminal.get_pixel(cx + col, cy + row)
                }
            }

            // 3. Draw the cursor on top.
            if cursor_pixels != null {
                for row in 0..CURSOR_H {
                    for col in 0..CURSOR_W {
                        let p = cursor_pixels[(row * CURSOR_W) + col]
                        let a = (p >> 24) & 0xFF
                        if a != 0 {
                            Terminal.blend_pixel(cx + col, cy + row, p & 0x00FF_FFFF, a as u8)
                        }
                    }
                }
            } else {
                for row in 0..CURSOR_H {
                    let bits = cursor_shape[row]
                    for col in 0..CURSOR_W {
                        if (bits & (0x80 as u8 >> col)) != 0 {
                            Terminal.put_pixel(cx + col, cy + row, CURSOR_COLOR)
                        }
                    }
                }
            }
        }

        cursor_drawn_x = cx
        cursor_drawn_y = cy
        cursor_drawn = true
      }
    }

    // Registered as Terminal's pre-scroll hook (Terminal.set_scroll_hooks,
    // lib/terminal.llpl) - runs synchronously right before scroll() shifts
    // every pixel in the framebuffer, so the cursor sprite gets erased
    // back to its true current background *before* that shift can drag it
    // (and its own saved-background snapshot) out from under it. Marks it
    // not-drawn afterward so the ordinary compose_frame_work machinery
    // just treats it as needing a fresh draw.
    func mouse_pre_scroll(arg: void*) {
      holding gui_lock {
        // The microui overlays (kern/mu_demo.llpl, kern/mu_term.llpl,
        // kern/mu_gl.llpl) are just as exposed to this shift as the
        // cursor sprite below - they're drawn to this same framebuffer
        // at a fixed logical (x, y) they have no way to know just moved.
        // Erase them back to their saved backgrounds the same way, and
        // leave them marked not-drawn so the next active tick treats
        // each as a fresh window instead of a ghost.
        mu_demo_restore_rect()
        mu_term_restore_rect()
        mu_gl_restore_rect()
        if cursor_drawn {
            for row in 0..CURSOR_H {
                for col in 0..CURSOR_W {
                    Terminal.put_pixel(cursor_drawn_x + col, cursor_drawn_y + row, cursor_saved[row * CURSOR_W + col])
                }
            }
            cursor_drawn = false
        }
      }
    }

    // Registered as Terminal's post-scroll hook - runs immediately after
    // the shift, while nothing is drawn (mouse_pre_scroll just erased
    // everything), so this is just an ordinary fresh-draw pass.
    func mouse_post_scroll(arg: void*) {
        if mu_demo_active {
            run_window_ticks(null)
        }
        compose_frame_work(null)
    }

    func mouse_irq_handler(arg: void*) {
        let value = HAL.inb(PS2_DATA_PORT)

        if mouse_packet_index == 0 && (value & MOUSE_PACKET_ALWAYS_ONE as u8) == 0 {
            // Not aligned to a packet boundary - drop the stray byte and
            // wait for a real byte0 (bit 3 always set) to resync.
            return
        }

        mouse_packet[mouse_packet_index] = value
        mouse_packet_index++

        if mouse_packet_index == 3 {
            mouse_packet_index = 0
            mouse_device.push3(mouse_packet[0] as char, mouse_packet[1] as char, mouse_packet[2] as char)

            // 9-bit signed deltas: sign bit from byte0, magnitude from
            // byte1/2 - the same simplified decode as user/mouse_demo.c
            // (ignores the rare overflow bits).
            let flags = mouse_packet[0]
            let dx = mouse_packet[1] as int
            if (flags & 0x10 as u8) != 0 { dx -= 256 }
            let dy = mouse_packet[2] as int
            if (flags & 0x20 as u8) != 0 { dy -= 256 }

            // PS/2's Y axis is inverted relative to screen space: a
            // positive raw delta means the mouse moved away from the
            // user (up), which must *decrease* on-screen Y.
            cursor_x += dx
            cursor_y -= dy
            if cursor_x < 0 { cursor_x = 0 }
            if cursor_y < 0 { cursor_y = 0 }
            let max_x = (Terminal.width() as int) - CURSOR_W
            let max_y = (Terminal.height() as int) - CURSOR_H
            if cursor_x > max_x { cursor_x = max_x }
            if cursor_y > max_y { cursor_y = max_y }

            left_button_down = (flags & 0x01 as u8) != 0

            Deferred.queue(compose_frame_work)
        }
    }

    func mouse_init() -> bool {
        HAL.outb(PS2_CMD_PORT, PS2_CMD_ENABLE_AUX)

        HAL.outb(PS2_CMD_PORT, PS2_CMD_READ_CONFIG)
        return false if !mouse_wait_output_full()
        let config = HAL.inb(PS2_DATA_PORT)
        let new_config = (config | PS2_CONFIG_ENABLE_AUX_IRQ as u8) & ~(PS2_CONFIG_DISABLE_AUX_CLOCK as u8)

        return false if !mouse_wait_input_clear()
        HAL.outb(PS2_CMD_PORT, PS2_CMD_WRITE_CONFIG)
        return false if !mouse_wait_input_clear()
        HAL.outb(PS2_DATA_PORT, new_config)

        return false if !mouse_write(MOUSE_CMD_SET_DEFAULTS) || !mouse_read_ack()
        return false if !mouse_write(MOUSE_CMD_ENABLE_REPORTING) || !mouse_read_ack()

        mouse_packet_index = 0
        mouse_device = new MouseDevice()
        register_device(mouse_device)

        init_cursor_shape()
        alloc_cursor_saved()
        init_window_z_order()
        // Terminal.init() already ran (kernel.llpl calls it before
        // mouse_init()), so width()/height() are valid here.
        cursor_x = (Terminal.width() as int) / 2
        cursor_y = (Terminal.height() as int) / 2
        Terminal.set_scroll_hooks(mouse_pre_scroll, mouse_post_scroll)
        Deferred.queue(compose_frame_work)

        // Must be a module-level global, not a local - HAL.Interrupt is
        // stored into HAL.interrupts[vector] as a raw, non-owning pointer
        // (see HAL.Interrupt.register, hal/idt.llpl). A local here would
        // be the only owning reference, freed the moment mouse_init()
        // returns, leaving a dangling pointer the first time IRQ12 fires -
        // the exact bug keyboard_init()'s own kbd_interrupt global (kern/
        // keyboard.llpl) and PIT's timer_interrupt (hal/pit.llpl) both
        // already had to work around.
        mouse_interrupt = new HAL.Interrupt()
        let handler: HAL.proc = mouse_irq_handler
        mouse_interrupt.register(0x2C, handler) // IRQ12 = vector 32+12
        HAL.PIC.enable_irq(12)

        "Kern.mouse_init()\n" |> HAL.Serial.write
        return true
    }
}
