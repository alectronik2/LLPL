import hal
import lib

alias hs = HAL.Serial

namespace MM {
    const PAGE_SIZE = 4096

    let max_phys_addr: uint
    let available_mem: uint

    let num_frames:    uint
    let pfdb:          PageFrame*
    let pfdb_end:      PageFrame*
    let pfdb_bytes:    uint

    let hhdm_offset:   uint
    let kernel_pml4:   uint
    let kernel_reserve_start: uint

    let free_list:     PageFrame*

    let limine_memmap: LimineMemmapResponse*
    let lock:          SpinLock

    enum FrameType : u8 {
        Other,
        Reserved,
        Kernel,
        PFDB,
        Malloc,
        HugeMalloc,
        HandleTab,
        File,
        Free
    }

    packed struct PageFrame {
        tag:      u8
        refcount: u32

        union {
            size:     uint
            next:     PageFrame*
        }

        func acquire() {
            self.refcount++
        }

        func release() {
            self.refcount--

            if self.refcount == 0 {
                free_pageframe(self)
            }
        }
    }

    const VMM_PAGE_MASK  = 4095
    const VMM_PAGE_SHIFT = 12

    const PG_PRESENT  = 1 << 0
    const PG_WRITABLE = 1 << 1
    const PG_USER     = 1 << 2
    const PG_PWT      = 1 << 3 // write through
    const PG_PCD      = 1 << 4 // cache disable (for MMIO)
    const PG_GLOBAL   = 1 << 8
    const PG_NOEXEC   = 1 << 63

    const PADDR_4K_MASK = 0x000F_FFFF_FFFF_F000
    const PADDR_2M_MASK = 0x000F_FFFF_FFE0_0000
    const PADDR_1G_MASK = 0x000F_FFFF_C000_0000
    const GIB           = 1 << 30

    packed struct PteStruct {
        present  : u8:1
        rw       : u8:1
        user     : u8:1
        pwt      : u8:1 // write through
        pcd      : u8:1 // cache disable (for MMIO)
        accessed : u8:1
        dirty    : u8:1
        ps       : u8:1 // page size
        global   : u8:1
        avail    : u8:3
    }

    packed union Pte {
        let pte: PteStruct
        let raw: uint

        property func paddr() -> uint {
            self.raw & PADDR_4K_MASK
        }

        property func pfn() -> uint {
            self.raw >> VMM_PAGE_SHIFT
        }
    }

    struct PageFrameIndexer {
        addr: uint

        constructor( @addr: uint ) {}

        inline property l4() -> uint {
            (self.addr >> 39) & 0x1FF
        }

        inline property l3() -> uint {
            (self.addr >> 30) & 0x1FF
        }
        
        inline property l2() -> uint {
            (self.addr >> 21) & 0x1FF
        }

        inline property l1() -> uint {
            (self.addr >> 12) & 0x1FF
        }
    }

    const PAGE_SHIFT = 12

    inline func pages_num( v: uint ) -> uint {
        roundup( v, MM.PAGE_SIZE ) >> MM.PAGE_SHIFT
    }

    func v2p( pgdir: uint, vaddr: uint ) -> uint {
        let idx = PageFrameIndexer( vaddr ) 
        let l4 = pgdir as Pte*

        //hs.write("v2p: vaddr=\(vaddr:hex) - l4=\(idx.l4) l3=\(idx.l3) l2=\(idx.l2) l1=\(idx.l1)\n")

        if !l4[idx.l4].pte.present {
            return 0
        }

        let l3 = l4[idx.l4].paddr as Pte*
        if !l3[idx.l3].pte.present {
            return 0
        }

        if l3[idx.l3].pte.ps {
            "v2p: 1G page at \(vaddr:hex) - l4=\(idx.l4) l3=\(idx.l3) l2=\(idx.l2) l1=\(idx.l1)\n" |> hs.write
            return l3[idx.l3].paddr | (vaddr & GIB - 1)
        }

        let l2 = l3[idx.l3].paddr as Pte*
        if !l2[idx.l2].pte.present {
            return 0
        }

        if l2[idx.l2].pte.ps {
            "v2p: 2M page at \(vaddr:hex) - l4=\(idx.l4) l3=\(idx.l3) l2=\(idx.l2) l1=\(idx.l1)\n" |> hs.write
            return l2[idx.l2].paddr + (vaddr & ((1 << 21) - 1))
        }

        let l1 = l2[idx.l2].paddr as Pte*
        if !l1[idx.l1].pte.present {
            return 0
        }

        l1[idx.l1].paddr
    }

    func pf2v( pf: PageFrame* ) -> uint {
        let idx = ((pf as uint) - (pfdb as uint)) / sizeof(PageFrame)
        MM.p2v( idx << MM.PAGE_SHIFT )
    }

    func v2pf( vaddr: void* ) -> PageFrame* {
        let addr = vaddr as uint
        let paddr: uint

        // HHDM addresses can be translated arithmetically. Allocations in
        // other virtual regions, such as kas.map()'s HugeMalloc range, must
        // be resolved through the active page tables instead.
        if addr >= hhdm_offset && addr - hhdm_offset < max_phys_addr {
            paddr = addr - hhdm_offset
        } else {
            paddr = v2p( kernel_pml4, addr )
        }

        assert( paddr != 0, "v2pf: virtual address is not mapped" )
        (pfdb as uint + (paddr >> MM.PAGE_SHIFT) * sizeof(PageFrame)) as PageFrame*
    }

    inline func p2v( paddr: uint ) -> uint {
        // The HHDM covers physical addresses outside the usable PFDB range too,
        // including the kernel's page tables and bootloader-owned regions.
        hhdm_offset + paddr
    }

    func pf2p( pf: PageFrame* ) -> uint {
        (((pf as uint) - (pfdb as uint)) / sizeof(PageFrame)) << MM.PAGE_SHIFT
    }

    func boot_alloc( size: uint, alignment: uint = PAGE_SIZE ) -> uint {
        size = roundup( size, PAGE_SIZE )

        holding lock {
            let entries = limine_memmap.entries as u64*
            for i in 0..limine_memmap.entry_count {
                let entry = entries[i] as LimineMemmapEntry*

                if entry.type == MemMapType.Usable {
                    let region_end = entry.base + entry.length
                    let base = roundup(entry.base, alignment)
                    let length = region_end - base

                    if length < size {
                        continue
                    }

                    entry.base = base + size
                    entry.length = region_end - entry.base
                    return base
                }
            }
        }

        assert( false, "boot_alloc: out of memory" )
    }

    func mark_range_free( base: uint, end: uint ) {
        assert( base < end, "mark_range_free: base \(base:hex) >= end \(end:hex)" )
        assert( end <= max_phys_addr, "mark_range_free: end \(end:hex) > max_phys_addr \(max_phys_addr:hex)" )

        let start_frame = base >> PAGE_SHIFT
        let end_frame = end >> PAGE_SHIFT

        for i in start_frame..end_frame {
            continue if (i << PAGE_SHIFT) >= kernel_reserve_start
            with frame = (pfdb as uint + i * sizeof(PageFrame)) as PageFrame* {
                .tag = FrameType.Free
                .refcount = 0
                .next = free_list
            }

            free_list = frame
        }
    }

    func alloc_pageframe( type: FrameType ) -> PageFrame* {
        assert( free_list != 0, "alloc_pageframe: out of memory" )

        holding lock {
            let frame = free_list
            free_list = frame.next
            frame.tag = type
            frame.refcount = 1

            return frame
        }
    }

    func free_pageframe( frame: PageFrame* ) {
        check( frame.tag != FrameType.Free, "free_pageframe: frame is already free" )
        assert( frame.refcount == 0, "free_pageframe: frame refcount is not zero" )

        holding lock {
            frame.tag = FrameType.Free
            frame.next = free_list
            free_list = frame
        }
    }

    func map_page( pgdir: uint, vaddr: uint, paddr: uint, flags: uint ) -> bool {
        let idx = PageFrameIndexer( vaddr )
        let pml4 = p2v( pgdir ) as Pte*

        if !pml4[idx.l4].pte.present {
            let new_page = MM.alloc_page( MM.FrameType.Other )
            let new_paddr = new_page << MM.PAGE_SHIFT
            memset( p2v(new_paddr) as void*, 0, PAGE_SIZE )
            pml4[idx.l4].raw = new_paddr | flags | PG_PRESENT
        } else {
            pml4[idx.l4].raw = pml4[idx.l4].raw | flags | PG_PRESENT
        }

        let pdpt = p2v( pml4[idx.l4].paddr ) as Pte*
        if !pdpt[idx.l3].pte.present {
            let new_page = MM.alloc_page( MM.FrameType.Other )
            let new_paddr = new_page << MM.PAGE_SHIFT
            memset( p2v(new_paddr) as void*, 0, PAGE_SIZE )
            pdpt[idx.l3].raw = new_paddr | flags | PG_PRESENT
        } else {
            pdpt[idx.l3].raw = pdpt[idx.l3].raw | flags | PG_PRESENT
        }
        if pdpt[idx.l3].pte.ps {
            "map_page: 1G page at \(vaddr:hex) - l4=\(idx.l4) l3=\(idx.l3) l2=\(idx.l2) l1=\(idx.l1)\n" |> hs.write
            return false
        }

        let pd = p2v( pdpt[idx.l3].paddr ) as Pte*
        if !pd[idx.l2].pte.present {
            let new_page = MM.alloc_page( MM.FrameType.Other )
            let new_paddr = new_page << MM.PAGE_SHIFT
            memset( p2v(new_paddr) as void*, 0, PAGE_SIZE )
            pd[idx.l2].raw = new_paddr | flags | PG_PRESENT
        } else {
            pd[idx.l2].raw = pd[idx.l2].raw | flags | PG_PRESENT
        }

        if pd[idx.l2].pte.ps {
            "map_page: 2M page at \(vaddr:hex) - l4=\(idx.l4) l3=\(idx.l3) l2=\(idx.l2) l1=\(idx.l1)\n" |> hs.write
            return false
        }

        let pt = p2v( pd[idx.l2].paddr ) as Pte*
        pt[idx.l1].raw = paddr | flags | PG_PRESENT

        return true
    }

    // Alocates a page and returns the index of the page frame in the PFDB. 
    func alloc_page( type: FrameType ) -> uint {
        let frame = alloc_pageframe( type )
        ((frame as uint) - (pfdb as uint)) / sizeof(PageFrame)
    }

    func kmalloc_wrapper( size: u64 ) -> char* {
        MM.malloc<void>( size )
    }

    func kfree_wrapper( ptr: char* ) {
        MM.free( ptr as void* )
    }

    func init( memmap: LimineMemmapResponse*, hhdm: LimineHhdmResponse* ) {
        "VMM init: Limine HHDM offset: \(hhdm.offset:hex), entries: \(memmap.entry_count)\n" |> hs.write
        limine_memmap = memmap

        hhdm_offset = hhdm.offset
        "Limine HHDM offset: \(hhdm_offset:hex)\n" |> hs.write

        kernel_pml4 = HAL.read_cr3() & PADDR_4K_MASK
        "Kernel PML4 = \(kernel_pml4:hex)\n" |> hs.write
        kernel_reserve_start = v2p( kernel_pml4, MM.buckets as uint ) - 0x300000

        for let i = 0, let entries = memmap.entries as u64*; i < memmap.entry_count; i++ {
            let e = entries[i] as LimineMemmapEntry*
            "PFDB init: entry: base \(e.base:hex), length \(e.length:hex), type \(e.type)\n" |> hs.write

            if e.type == MemMapType.Usable {
                if e.base + e.length > max_phys_addr {
                    max_phys_addr = e.base + e.length
                }

                available_mem += e.length
            }
        }

        num_frames = pages_num( max_phys_addr )
        pfdb_bytes = num_frames * sizeof(PageFrame)
        "PFDB init: max_phys_addr \(max_phys_addr:hex) = \(max_phys_addr / 1024 / 1024)M, num_frames = \(num_frames), pfdb_bytes = \(pfdb_bytes), available_mem = \(MM.available_mem / 1024 / 1024)M\n" |> hs.write

        pfdb = (p2v(boot_alloc(pfdb_bytes, PAGE_SIZE)) as PageFrame*)
        memset( pfdb, 0, pfdb_bytes )
        "PFDB init: pfdb = \(pfdb:hex)\n" |> hs.write

        let entries = memmap.entries as u64*
        for i in 0..memmap.entry_count {
            let e = entries[i] as LimineMemmapEntry*
            continue if e.type != MemMapType.Usable
            
            let rbase = e.base
            let rend = e.base + e.length

            break if rbase >= max_phys_addr 
            rend = max_phys_addr if rend > max_phys_addr

            mark_range_free( rbase, rend )
        }

        let alloc_fn: (u64) -> char* = MM.kmalloc_wrapper
        let free_fn: (char*) -> void = MM.kfree_wrapper
        llpl_set_allocator(alloc_fn, free_fn)

        let kas = new AddressSpace( 0xffff900000000000, 0xffffa00000000000 )
    }
}

unittest {
    let p = VMM.PageFrameIndexer( 0x2000 )
    assert(p.addr == 0x2000)

    puts("index l4 = \(p.l4) - l3 = \(p.l3) - l2 = \(p.l2) - l1 = \(p.l1)")
    puts("self.addr=\(p.addr)")

    let r = roundup(8, 10)
    assert(r == 16)
    puts("Succeeded.")
    puts("\(r)")
}
