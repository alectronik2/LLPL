struct Bucket {
    mem:   void*
    elems: uint
    pages: uint
    size:  uint
}

const PAGE_SIZE = 4096
const PAGE_SHIFT = 12

let buckets: Bucket[12]

func kmalloc<T>(size: int = sizeof(T)) -> T* {
    let addr = 0

    return 0 as T* if size == 0

    let bucket = bucketLog2[size - 1]
    let b = &buckets[bucket]

    if b.mem == null {
        
    }

    return 0 as T*
}
