import hal

alias hs = HAL.Serial

namespace PFDB {
    const PAGE_SIZE = 4096
    const PAGE_SHIFT = 12


    struct PageFrame {
        tag:      u8
        refcount: u32

        union {
            size: uint
            next: PageFrame*
        }
    }

    func init( memmap: LimineMemmapResponse*, hhdm: LimineHhdmResponse* ) {
        hs.write("PFDB init: Limine HHDM offset: \(hhdm.offset:hex), entries: \(memmap.entry_count)\n")

        for let i = 0, let entries = memmap.entries as u64*; i < memmap.entry_count; i++ {
            let e = entries[i] as LimineMemmapEntry*
            hs.write("PFDB init: entry: base \(e.base:hex), length \(e.length:hex), type \(e.entry_type)\n")
        }
    }
}
