import hal
import lib

alias hs = HAL.Serial

namespace MM {
    enum RbColor {
        Red,
        Black
    }

    const MAP_FIXED = 1 << 0
    const MAP_USER  = 1 << 1
    const MAP_FILE  = 1 << 2
    const MAP_SHARED = 1 << 3
    const MAP_WRITE = 1 << 4

    let kas: AddressSpace*

    func page_table_empty(table: Pte*) -> bool {
        for i in 0..512 {
            if table[i].pte.present { return false }
        }
        return true
    }

    func release_paddr_frame(paddr: uint) {
        let frame = (pfdb as uint + (paddr >> PAGE_SHIFT) * sizeof(PageFrame)) as PageFrame*
        frame.release()
    }

    func vm_drop_memory(pgdir: uint, addr: uint, end: uint) {
        return if pgdir == 0 || end <= addr
        let start = addr & ~(PAGE_SIZE - 1)
        let limit = (end + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)
        let active = (HAL.read_cr3() & PADDR_4K_MASK) == (pgdir & PADDR_4K_MASK)
        let pml4 = p2v(pgdir & PADDR_4K_MASK) as Pte*

        for let page = start; page < limit; page += PAGE_SIZE {
            let idx = PageFrameIndexer(page)
            if pml4[idx.l4].pte.present && !pml4[idx.l4].pte.ps {
                let pdpt = p2v(pml4[idx.l4].paddr) as Pte*
                if pdpt[idx.l3].pte.present && !pdpt[idx.l3].pte.ps {
                    let pd = p2v(pdpt[idx.l3].paddr) as Pte*
                    if pd[idx.l2].pte.present && !pd[idx.l2].pte.ps {
                        let pt_paddr = pd[idx.l2].paddr
                        let pt = p2v(pt_paddr) as Pte*
                        if pt[idx.l1].pte.present {
                            let mapped_paddr = pt[idx.l1].paddr
                            pt[idx.l1].raw = 0
                            if active { asm("invlpg (%0)" : : "r"(page) : "memory") }
                            release_paddr_frame(mapped_paddr)
                        }

                        if page_table_empty(pt) {
                            pd[idx.l2].raw = 0
                            release_paddr_frame(pt_paddr)
                            if page_table_empty(pd) {
                                let pd_paddr = pdpt[idx.l3].paddr
                                pdpt[idx.l3].raw = 0
                                release_paddr_frame(pd_paddr)
                                if page_table_empty(pdpt) {
                                    let pdpt_paddr = pml4[idx.l4].paddr
                                    pml4[idx.l4].raw = 0
                                    release_paddr_frame(pdpt_paddr)
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    class VmArea : Object {
        start: uint
        end:   uint

        flags: uint

        left:  VmArea*
        right: VmArea*
        parent: VmArea*
        color: RbColor

        name: String
        backing: void*
        file_offset: uint
        file_length: uint

        constructor( @start: uint, @end: uint ) {
            self.flags = 0
            self.left = null
            self.right = null
            self.parent = null
            self.color = RbColor.Black
            self.name = null
            self.backing = null
            self.file_offset = 0
            self.file_length = 0
        }

        destructor() {
            // name is released automatically (String is a statically-typed
            // field, so the compiler already handles it).
            //
            // backing is void* - type-erased (it can be a FileDescriptor
            // for a file mapping or a Kern.SharedMemorySegment for a
            // shared-memory one), so the compiler can't auto-manage it the
            // same way. Object.get()/.put() (prelude.llpl) don't fix this:
            // they touch a separate, unrelated `Object.refcount` field
            // that the real ARC (the header-level ref_count driving
            // `delete` and automatic local-variable release) never
            // consults - so a `.get()` here never actually kept anything
            // alive, and `.put()` never actually freed anything. Deleting
            // through a cast to Object instead dispatches polymorphically,
            // through the object's own vtable, to whichever concrete
            // destructor is correct - the same mechanism Object.put()
            // itself relies on for its own (also broken, for the same
            // reason) `delete self`.
            if backing != null { delete (backing as Object) }
        }
    }

    class AddressSpace : Object {
        root: VmArea*
        pml4: uint

        start: uint
        end:   uint

        num_areas: uint

        lock: SpinLock

        constructor( start: uint, end: uint ) {
            self.start = start
            self.end   = end
            self.root = null
            self.pml4 = 0
        }

        func destroy_user_memory() {
            return if self.pml4 == 0
            assert((HAL.read_cr3() & PADDR_4K_MASK) != (self.pml4 & PADDR_4K_MASK), "cannot destroy the active address space")
            let detached_root: void* = null
            holding self.lock {
                detached_root = self.root as void*
                self.root = null
                self.num_areas = 0
            }
            destroy_vma_tree(detached_root, self.pml4)
        }

        func find( addr: uint ) -> VmArea* {
            holding self.lock {
                let curr = self.root

                while curr != null {
                    if addr >= curr.start && addr < curr.end {
                        return curr
                    } 
                    if addr < curr.start {
                        curr = curr.left
                    } else {
                        curr = curr.right
                    }
                }
                return null
            }
        }

        func overlaps( start: uint, end: uint ) -> bool {
            let curr = self.root

            while curr != null {
                if !(end <= curr.start || start >= curr.end) {
                    return true
                }
                if start < curr.start {
                    curr = curr.left
                } else {
                    curr = curr.right
                }
            }
            return false
        }

        func find_free( length: uint ) -> uint {
            let addr = self.start
            let curr = self.root

            return addr if curr == null

            // Find the leftmost node
            while curr.left {
                curr = curr.left
            }
            
            // Try before first VMA
            if curr.start - self.start >= length {
                return self.start
            }
            
            // Try gap between nodes
            while curr != null {
                let next = curr

                // Find successor
                if next.right {
                    next = next.right
                    while next.left {
                        next = next.left
                    }
                } else {
                    let p = next.parent
                    while p != null && next == p.right {
                        next = p
                        p = p.parent
                    }
                    next = p
                }

                if !next {
                    // Try afer rhe last VMA
                    if self.end - curr.end >= length {
                        return curr.end
                    }
                    break
                }

                if next.start - curr.end >= length {
                    return curr.end
                }
                
                curr = next
            }

            // no space found
            return 0
        }

        func map( addr: uint, length: uint, name: String = null, flags: uint = 0 ) -> uint {
            if !length {
                throw EINVAL
            }

            let start: uint
            let end: uint

            // Align length to page boundaries (assuming 4K pages).
            length = (length + 0xFFF) & ~0xFFF

            holding self.lock {
                if flags & MAP_FIXED {
                    start = addr
                    if start < self.start || start + length > self.end {
                        throw EINVAL
                    }
                    if self.overlaps(start, start + length) {
                        throw EEXIST
                    }
                } else if addr != 0 {
                    start = addr
                    if start < self.start || start + length > self.end || self.overlaps(start, start + length) {
                        start = self.find_free(length)
                    }
                    if start == 0 {
                        throw ENOMEM
                    }
                } else {
                    start = self.find_free(length)
                    if start == 0 {
                        throw ENOMEM
                    }
                }

                end = start + length
                let vma = new VmArea(start, end)

                // An unnamed VMA needs no heap-backed label. Besides avoiding
                // needless allocation, this keeps map() usable during early
                // heap bootstrap.
                if name {
                    // Field assignment already retains - no explicit call
                    // needed.
                    vma.name = name
                }

                rb_insert(self, vma)
                return start
            }
        }

        func unmap(addr: uint, length: uint) -> int {
            if !length {
                return EINVAL
            }

            length = (length + 0xFFF) & ~0xFFF
            let unmap_start = addr
            let unmap_end = addr + length

            let stack = MM.malloc<MM.VmArea*>(64 * sizeof(MM.VmArea*))
            let to_process = MM.malloc<MM.VmArea*>(64 * sizeof(MM.VmArea*))
            let process_count = 0

            if stack == null || to_process == null {
                panic("[VM] unmap: out of memory")
            }

            defer MM.free(stack as void*)
            defer MM.free(to_process as void*)

            let stack_ptr = 0
            let stack_limit = 64
            let process_limit = 64
            let curr = self.root

            holding self.lock {
                while curr != null || stack_ptr > 0 {
                    while curr != null {
                        if stack_ptr == stack_limit - 1 {
                            stack = MM.realloc<MM.VmArea*>(stack, (stack_limit + 64) * sizeof(MM.VmArea*))
                            if stack == null {
                                panic("[VM] unmap: out of memory")
                            }
                            stack_limit = stack_limit + 64
                        }

                        stack[stack_ptr] = curr
                        stack_ptr = stack_ptr + 1
                        curr = curr.left
                    }

                    stack_ptr = stack_ptr - 1
                    curr = stack[stack_ptr]

                    if process_count == process_limit - 1 {
                        to_process = MM.realloc<MM.VmArea*>(to_process, (process_limit + 64) * sizeof(MM.VmArea*))
                        if to_process == null {
                            panic("[VM] unmap: out of memory")
                        }
                        process_limit = process_limit + 64
                    }

                    if !(curr.end <= unmap_start || curr.start >= unmap_end) {
                        to_process[process_count] = curr
                        process_count = process_count + 1
                    }

                    curr = curr.right
                }

                if !process_count {
                    return ENOENT
                }

                for i in 0..process_count {
                    let vma = to_process[i]

                    if unmap_start <= vma.start && unmap_end >= vma.end {
                        MM.rb_delete(self, vma)
                        delete vma
                    } else if unmap_start > vma.start && unmap_end < vma.end {
                        let right_vma = new MM.VmArea(unmap_end, vma.end)
                        if !right_vma {
                            return ENOMEM
                        }

                        right_vma.name = null
                        right_vma.flags = vma.flags
                        right_vma.backing = vma.backing
                        // Real retain, not Object.get() - see VmArea's own
                        // destructor comment. Both vma and right_vma now
                        // reference the same backing object independently,
                        // and each will release it (via its own
                        // destructor) when it's torn down.
                        if right_vma.backing != null { rc_retain(right_vma.backing as char*) }
                        right_vma.file_offset = vma.file_offset + (unmap_end - vma.start)
                        right_vma.file_length = vma.file_length - (unmap_end - vma.start)

                        vma.file_length = unmap_start - vma.start
                        vma.end = unmap_start
                        MM.rb_insert(self, right_vma)
                    } else if unmap_start <= vma.start && unmap_end < vma.end {
                        let removed = unmap_end - vma.start
                        vma.start = unmap_end
                        vma.file_offset += removed
                        vma.file_length -= removed
                    } else if unmap_start > vma.start && unmap_end >= vma.end {
                        vma.file_length = unmap_start - vma.start
                        vma.end = unmap_start
                    }
                }
            }
            MM.vm_drop_memory(self.pml4, addr, addr + length)

            return EOK
        }
    }

    func destroy_vma_tree(raw_area: void*, pgdir: uint) {
        return if raw_area == null
        let left = (raw_area as VmArea).left as void*
        let right = (raw_area as VmArea).right as void*
        destroy_vma_tree(left, pgdir)
        destroy_vma_tree(right, pgdir)
        vm_drop_memory(pgdir, (raw_area as VmArea).start, (raw_area as VmArea).end)
        (raw_area as VmArea).left = null
        (raw_area as VmArea).right = null
        (raw_area as VmArea).parent = null
        delete (raw_area as VmArea)
    }

    func clone_vma_tree(raw_area: void*, source_pgdir: uint, target: AddressSpace*) {
        return if raw_area == null

        "clone_vma_tree: raw_area=\(raw_area:hex) source_pgdir=\(source_pgdir:hex) target.pml4=\(target.pml4:hex)\n" |> hs.write
        "  source->left=\((raw_area as VmArea).left:hex) source->right=\((raw_area as VmArea).right:hex) source->start=\((raw_area as VmArea).start:hex) source->end=\((raw_area as VmArea).end:hex)\n" |> hs.write

        clone_vma_tree((raw_area as VmArea).left as void*, source_pgdir, target)

        let source = raw_area as VmArea
        let copy = new VmArea(source.start, source.end)
        copy.flags = source.flags
        copy.name = null
        copy.backing = source.backing
        // Real retain, not Object.get() - see VmArea's own destructor
        // comment. The COW-cloned child VMA now independently references
        // the same backing object as the parent's.
        if copy.backing != null { rc_retain(copy.backing as char*) }
        copy.file_offset = source.file_offset
        copy.file_length = source.file_length
        rb_insert(target, copy)

        for let page = source.start; page < source.end; page += PAGE_SIZE {
            let source_pte = leaf_pte(source_pgdir, page)
            if source_pte != null && source_pte.pte.present {
                let paddr = source_pte.paddr
                let flags = source_pte.raw & ~PADDR_4K_MASK
                if (source.flags & MAP_SHARED) == 0 &&
                    (source_pte.pte.rw || (source_pte.raw & PG_COW) != 0) {
                    flags = (flags & ~PG_WRITABLE) | PG_COW
                    source_pte.raw = paddr | flags | PG_PRESENT
                    asm("invlpg (%0)" : : "r"(page) : "memory")
                }
                let frame = (pfdb as uint + (paddr >> PAGE_SHIFT) * sizeof(PageFrame)) as PageFrame*
                frame.acquire()
                if !map_page(target.pml4, page, paddr, flags) {
                    frame.release()
                    panic("clone_vma_tree: cannot map shared page")
                }
            }
        }

        clone_vma_tree((raw_area as VmArea).right as void*, source_pgdir, target)
    }

    func rb_grandparent( area: VmArea* ) -> VmArea* {
        if area != null && area.parent != null {
            return area.parent.parent
        }

        return null
    }

    func rb_uncle( area: VmArea* ) -> VmArea* {
        let g = rb_grandparent( area )

        if !g {
            return null
        }

        if area.parent == g.left {
            return g.right
        }

        return g.left
    }

    func rb_rotate_left( space: AddressSpace*, n: VmArea* ) {
        let r = n.right
        n.right = r.left

        if r.left {
            r.left.parent = n
        }
        r.parent = n.parent

        if !n.parent {
            space.root = r
        } else if n == n.parent.left {
            n.parent.left = r
        } else {
            n.parent.right = r
        }

        r.left = n
        n.parent = r
    }

    func rb_rotate_right( space: AddressSpace*, n: VmArea* ) {
        let l = n.left
        n.left = l.right

        if l.right {
            l.right.parent = n
        }
        l.parent = n.parent

        if !n.parent {
            space.root = l
        } else if n == n.parent.right {
            n.parent.right = l
        } else {
            n.parent.left = l
        }

        l.right = n
        n.parent = l
    }

    func rb_insert_fixup( space: AddressSpace*, n: VmArea* ) {
        while n.parent && n.parent.color == RbColor.Red {
            let u = rb_uncle( n )
            let g = rb_grandparent( n )

            if u && u.color == RbColor.Red {
                n.parent.color = RbColor.Black
                u.color = RbColor.Black
                g.color = RbColor.Red
                n = g
            } else {
                if n.parent == g.left {
                    if n == n.parent.right {
                        n = n.parent
                        rb_rotate_left( space, n )
                    }
                    n.parent.color = RbColor.Black
                    g.color = RbColor.Red
                    rb_rotate_right( space, g )
                } else {
                    if n == n.parent.left {
                        n = n.parent
                        rb_rotate_right( space, n )
                    }
                    n.parent.color = RbColor.Black
                    g.color = RbColor.Red
                    rb_rotate_left( space, g )
                }
            }
        }

        space.root.color = RbColor.Black
    }

    func rb_insert( space: AddressSpace*, vma: VmArea* ) {
        // Tree links are raw pointers, so retain one reference for tree
        // ownership independently of the caller's temporary.
        rc_retain(vma as char*)
        let parent: VmArea* = null
        let curr = space.root

        while curr {
            parent = curr
            if vma.start < curr.start {
                curr = curr.left
            } else {
                curr = curr.right
            }
        }

        vma.parent = parent
        vma.color = RbColor.Red

        if !parent {
            space.root = vma
        } else if vma.start < parent.start {
            parent.left = vma
        } else {
            parent.right = vma
        }

        rb_insert_fixup( space, vma )
        space.num_areas++
    }

    func rb_minimum( n: VmArea* ) -> VmArea* {
        while n && n.left {
            n = n.left
        }

        return n
    }

    func rb_transplant( space: AddressSpace*, u: VmArea*, v: VmArea* ) {
        if !u.parent {
            space.root = v
        } else if u == u.parent.left {
            u.parent.left = v
        } else {
            u.parent.right = v
        }

        if v {
            v.parent = u.parent
        }
    }

    func rb_delete_fixup( space: AddressSpace*, n: VmArea*, parent: VmArea* ) {
        while n != space.root && (!n || n.color == RbColor.Black) {
            if n == parent.left {
                let w = parent.right
                if w && w.color == RbColor.Red {
                    w.color = RbColor.Black
                    parent.color = RbColor.Red
                    rb_rotate_left( space, parent )
                    w = parent.right
                }
                if w && (!w.left || w.left.color == RbColor.Black) && (!w.right || w.right.color == RbColor.Black) {
                    w.color = RbColor.Red
                    n = parent
                    parent = n.parent
                } else {
                    if w && (!w.right || w.right.color == RbColor.Black) {
                        if w.left {
                            w.left.color = RbColor.Black
                        }
                        w.color = RbColor.Red
                        rb_rotate_right( space, w )
                        w = parent.right
                    }
                    if w {
                        w.color = parent.color
                        if w.right {
                            w.right.color = RbColor.Black
                        }
                    }
                    parent.color = RbColor.Black
                    rb_rotate_left( space, parent )
                    n = space.root
                }
            } else {
                let w = parent.left
                if w && w.color == RbColor.Red {
                    w.color = RbColor.Black
                    parent.color = RbColor.Red
                    rb_rotate_right( space, parent )
                    w = parent.left
                }
                if w && (!w.right || w.right.color == RbColor.Black) && (!w.left || w.left.color == RbColor.Black) {
                    w.color = RbColor.Red
                    n = parent
                    parent = n.parent
                } else {
                    if w && (!w.left || w.left.color == RbColor.Black) {
                        if w.right {
                            w.right.color = RbColor.Black
                        }
                        w.color = RbColor.Red
                        rb_rotate_left( space, w )
                        w = parent.left
                    }
                    if w {
                        w.color = parent.color
                        if w.left {
                            w.left.color = RbColor.Black
                        }
                    }
                    parent.color = RbColor.Black
                    rb_rotate_right( space, parent )
                    n = space.root
                }
            }
        }

        if n {
            n.color = RbColor.Black
        }
    }

    func rb_delete( space: AddressSpace*, vma: VmArea* ) {
        let y = vma
        let x: VmArea*
        let x_parent: VmArea*
        let orig_color = y.color

        if !vma.left {
            x = vma.right
            x_parent = vma.parent
            rb_transplant( space, vma, vma.right )
        } else if !vma.right {
            x = vma.left
            x_parent = vma.parent
            rb_transplant( space, vma, vma.left )
        } else {
            y = rb_minimum( vma.right )
            orig_color = y.color
            x = y.right
            if y.parent == vma {
                x_parent = y
                if x {
                    x.parent = y
                }
            } else {
                x_parent = y.parent
                rb_transplant( space, y, y.right )
                y.right = vma.right
                y.right.parent = y
            }
            rb_transplant( space, vma, y )
            y.left = vma.left
            y.left.parent = y
            y.color = vma.color
        }

        if orig_color == RbColor.Black {
            rb_delete_fixup( space, x, x_parent )
        }

        space.num_areas--
    }

    func aspace_init() {
        // Keep kernel allocations outside the HHDM range. The HHDM already
        // contains bootloader-installed large-page mappings and must not be
        // reused as a virtual allocation arena.
        kas = new AddressSpace(0xFFFF900000000000, 0xFFFFA00000000000)
    }
}
