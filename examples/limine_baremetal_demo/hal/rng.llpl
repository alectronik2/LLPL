import kern

// Kernel-side random byte source, exposed to userland via SYS_RAND_BYTES
// (hal/syscall.llpl). Prefers the RDRAND hardware instruction; QEMU's
// default CPU model under -accel kvm does not always expose it, so there is
// a fallback path below - callers relying on real cryptographic randomness
// (e.g. user/tls.llpl's ECDHE keys and nonces) get materially weaker
// security if fallback ever activates. This is a known, accepted limitation
// for the minimal/no-cert-validation TLS client this feeds.
namespace HAL {
    namespace RNG {
        // NOT cryptographically secure. Only used when HAL.has_rdrand() is
        // false. Mixes boot-relative timing jitter (RDTSC, PIT ticks)
        // through a splitmix64-style avalanche step so callers still get
        // *some* unpredictability instead of a hard failure or a fixed
        // stream. Re-mixed with a fresh RDTSC sample on every call so
        // repeated fill() calls don't repeat output even though the seed
        // itself is low-entropy.
        let fallback_state: u64 = 0
        let fallback_seeded: bool = false

        func fallback_seed() {
            fallback_state = HAL.rdtsc() ^ ((Timer.current_tick() as u64) * 0x9E3779B97F4A7C15)
            fallback_seeded = true
        }

        func fallback_next() -> u64 {
            if !fallback_seeded { fallback_seed() }
            fallback_state += 0x9E3779B97F4A7C15
            let z = fallback_state
            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
            z = (z ^ (z >> 27)) * 0x94D049BB133111EB
            z = z ^ (z >> 31)
            return z ^ HAL.rdtsc()
        }

        func fill(buf: u8*, len: uint) {
            let hardware = HAL.has_rdrand()
            let offset: uint = 0
            while offset < len {
                let value: u64 = 0
                let have_value = false
                if hardware {
                    let (ok, v) = HAL.rdrand64()
                    if ok {
                        value = v
                        have_value = true
                    } else {
                        // Treat repeated RDRAND failure as "unsupported for
                        // the rest of this call" rather than retrying
                        // forever across the whole buffer.
                        hardware = false
                    }
                }
                if !have_value {
                    value = fallback_next()
                }
                let chunk = len - offset
                if chunk > 8 { chunk = 8 }
                let i: uint = 0
                while i < chunk {
                    buf[offset + i] = (value >> (i * 8)) as u8
                    i++
                }
                offset += chunk
            }
        }
    }
}
