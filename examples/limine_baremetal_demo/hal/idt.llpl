import hal
import lib
import kern

alias hs = HAL.Serial

comptime for i in 0..256 {
    extern func isr$i()
}

namespace HAL {
    alias proc = func(void*)
    const NUM_VECTORS = 256

    let interrupts: Interrupt[256]
    let lock: SpinLock

    class Interrupt {
        next:    Interrupt*
        flags:   int
        intrno:  int
        handler: proc
        arg:     void*

        func register( vector: int, f: proc, arg: void* = null) {
            assert( vector < NUM_VECTORS )

            holding lock {
                with self {
                    .handler = f
                    .arg = arg
                    .intrno = vector
                    .flags = 0
                    .next = interrupts[vector]
                }
                interrupts[vector] = self
            }
        }

        func unregister() {
            let vector = self.intrno
            assert( vector < NUM_VECTORS )

            holding lock {
                let prev = null as Interrupt*
                let curr = interrupts[vector]

                while curr != null {
                    if curr == self {
                        if prev == null {
                            interrupts[vector] = curr.next
                        } else {
                            prev.next = curr.next
                        }
                        return
                    }
                    prev = curr
                    curr = curr.next
                }
            }
        }
    }

    namespace IDT {
        packed struct Entry {
            offset_low : u16
            selector:    u16
            ist:         u8
            type_attr:   u8
            offset_mid:  u16
            offset_high: u32
            zero:        u32
        }

        struct Context {
            r15:    u64
            r14:    u64
            r13:    u64
            r12:    u64
            r11:    u64
            r10:    u64
            r9:     u64
            r8:     u64
            rdi:    u64
            rsi:    u64
            rbp:    u64
            rbx:    u64
            rdx:    u64
            rcx:    u64
            rax:    u64

            vector: u64
            err:    u64

            rip:    u64
            cs:     u64
            rflags: u64
            rsp:    u64
            ss:     u64
        }

        packed struct Pointer {
            limit: u16
            base:  u64
        }

        let entries:    Entry[256]
        let pointer:    Pointer
        let interrupts: Interrupt[256]

        // flags: 0x8E = present, ring 0, 64-bit interrupt gate.
        func set_gate(vector: int, handler_addr: int, selector: int, flags: u8, ist: u8) {
            assert( vector < NUM_VECTORS )

            // Keep casts out of the with block. The parser otherwise treats
            // the following field assignment as part of the cast expression.
            let offset_low: u16 = (handler_addr & 0xFFFF) as u16
            let offset_mid: u16 = ((handler_addr >> 16) & 0xFFFF) as u16
            let offset_high: u32 = ((handler_addr >> 32) & 0xFFFF_FFFF) as u32
            let gate_selector: u16 = selector as u16

            with entries[vector] {
                .offset_low  = offset_low
                .selector    = gate_selector
                .ist         = ist
                .type_attr   = flags
                .offset_mid  = offset_mid
                .offset_high = offset_high
                .zero        = 0
            }
        }
        
        func init() {
            comptime for i in 0..NUM_VECTORS {
                set_gate( i, isr$i as int, 0x08, 0x8E, 0 )
            }

            // Double faults use the dedicated IST1 stack configured in the
            // TSS so stack exhaustion cannot recursively fault.
            set_gate( 8, isr8 as int, 0x08, 0x8E, 1 )

            pointer.limit = (sizeof(Entry) * NUM_VECTORS) - 1
            pointer.base = entries as u64

            asm( "lidt (%0)" : : "r"(&pointer) )
        }
    }
}

func isr_handler( ctx: HAL.IDT.Context* ) -> HAL.IDT.Context* {
    if ctx.vector >= 32 && ctx.vector < 48 {
        let irq = (ctx.vector - 32) as uint
        let intr = HAL.interrupts[ctx.vector]
        while intr != null {
            intr.handler( intr.arg )
            intr = intr.next
        }

        if ctx.vector == 32 {
            ctx = Kern.schedule_from_interrupt( ctx )
        }

        HAL.PIC.eoi( irq )
        return ctx
    }

    match ctx.vector {
        0  => hs.write( "\x1b[1;31mDIVIDE BY ZERO:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" ) 
        6  => hs.write( "\x1b[1;31mINVALID OPCODE:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" ) 
        13 => hs.write( "\x1b[1;31mGENERAL PROTECTION FAULT:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
        14 => hs.write( "\x1b[1;31mPAGE FAULT:\x1b[0m err=\(ctx.err:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
        _  => hs.write( "\x1b[1;31mEXCEPTION:\x1b[0m vector=\(ctx.vector:hex) err=\(ctx.err:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
    }

    if ctx.vector == 8 {
        double_fault_handler(ctx)
        return
    }

    llpl_panic_backtrace_from_frame( ctx.rbp )
    // Linked from hal/isr.m64. Dispatching through HAL.interrupts can be
    // filled in once the interrupt context layout is consumed on the LLPL side.

    while true {
        HAL.halt()
    }

    return ctx
}

func double_fault_handler( ctx: HAL.IDT.Context* ) {
    hs.write( "\x1b[1;31mDOUBLE FAULT:\x1b[0m err=\(ctx.err:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
    llpl_panic_backtrace_from_frame( ctx.rbp )
    while true {
        HAL.halt()
    }
}
