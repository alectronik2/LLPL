import hal
import lib
import kern

alias hs = HAL.Serial

comptime for i in 0..256 {
    extern func isr$i()
}

namespace HAL {
    alias proc = func(void*)
    const NUM_VECTORS = 256

    let interrupts: Interrupt[256]
    let lock: SpinLock

    class Interrupt {
        next:    Interrupt*
        flags:   int
        intrno:  int
        handler: proc
        arg:     void*

        func register( vector: int, f: proc, arg: void* = null) {
            assert( vector < NUM_VECTORS )

            holding lock {
                with self {
                    .handler = f
                    .arg = arg
                    .intrno = vector
                    .flags = 0
                    .next = interrupts[vector]
                }
                interrupts[vector] = self
            }
        }

        func unregister() {
            let vector = self.intrno
            assert( vector < NUM_VECTORS )

            holding lock {
                let prev = null as Interrupt*
                let curr = interrupts[vector]

                while curr != null {
                    if curr == self {
                        if prev == null {
                            interrupts[vector] = curr.next
                        } else {
                            prev.next = curr.next
                        }
                        return
                    }
                    prev = curr
                    curr = curr.next
                }
            }
        }
    }

    namespace IDT {
        packed struct Entry {
            offset_low : u16
            selector:    u16
            ist:         u8
            type_attr:   u8
            offset_mid:  u16
            offset_high: u32
            zero:        u32
        }

        struct Context {
            r15:    u64
            r14:    u64
            r13:    u64
            r12:    u64
            r11:    u64
            r10:    u64
            r9:     u64
            r8:     u64
            rdi:    u64
            rsi:    u64
            rbp:    u64
            rbx:    u64
            rdx:    u64
            rcx:    u64
            rax:    u64

            vector: u64
            err:    u64

            rip:    u64
            cs:     u64
            rflags: u64
            rsp:    u64
            ss:     u64
        }

        packed struct Pointer {
            limit: u16
            base:  u64
        }

        let entries:    Entry[256]
        let pointer:    Pointer
        let interrupts: Interrupt[256]

        // flags: 0x8E = present, ring 0, 64-bit interrupt gate.
        func set_gate(vector: int, handler_addr: int, selector: int, flags: u8, ist: u8) {
            assert( vector < NUM_VECTORS )

            // Keep casts out of the with block. The parser otherwise treats
            // the following field assignment as part of the cast expression.
            let offset_low: u16 = (handler_addr & 0xFFFF) as u16
            let offset_mid: u16 = ((handler_addr >> 16) & 0xFFFF) as u16
            let offset_high: u32 = ((handler_addr >> 32) & 0xFFFF_FFFF) as u32
            let gate_selector: u16 = selector as u16

            with entries[vector] {
                .offset_low  = offset_low
                .selector    = gate_selector
                .ist         = ist
                .type_attr   = flags
                .offset_mid  = offset_mid
                .offset_high = offset_high
                .zero        = 0
            }
        }
        
        func init() {
            comptime for i in 0..NUM_VECTORS {
                set_gate( i, isr$i as int, 0x08, 0x8E, 0 )
            }

            // Double faults use the dedicated IST1 stack configured in the
            // TSS so stack exhaustion cannot recursively fault.
            set_gate( 8, isr8 as int, 0x08, 0x8E, 1 )
            // Software-yield gate. DPL=3 also permits a future userspace
            // yield wrapper; the handler runs on the current TSS.RSP0.
            set_gate( 0x80, isr128 as int, 0x08, 0xEE, 0 )

            pointer.limit = (sizeof(Entry) * NUM_VECTORS) - 1
            pointer.base = entries as u64

            asm( "lidt (%0)" : : "r"(&pointer) )
        }
    }
}

// Thin wrapper around the real handler: every return-to-ring-3 path needs
// a pending-APC check (see Kern.maybe_deliver_apc, kern/thread.llpl), and
// isr_handler_inner has several early-return branches - wrapping the one
// symbol hal/isr.m64 actually calls covers all of them uniformly instead
// of auditing each one.
func isr_handler( ctx: HAL.IDT.Context* ) -> HAL.IDT.Context* {
    return Kern.maybe_deliver_apc( isr_handler_inner( ctx ), SYS_APC_RETURN )
}

func isr_handler_inner( ctx: HAL.IDT.Context* ) -> HAL.IDT.Context* {
    if ctx.vector == 0x80 {
        return Kern.schedule_from_interrupt( ctx )
    }

    if ctx.vector >= 32 && ctx.vector < 48 {
        llpl_irq_enter()
        let irq = (ctx.vector - 32) as uint
        if irq == 1 {
            //Kern.signal_io_event( Kern.IO_EVENT_KEYBOARD_IRQ )
        } else if irq == 4 {
            //Kern.signal_io_event( Kern.IO_EVENT_SERIAL_RX )
        }

        let intr = HAL.interrupts[ctx.vector]
        while intr != null {
            intr.handler( intr.arg )
            intr = intr.next
        }

        if ctx.vector == 32 && HAL.PIT.take_schedule_request() {
            HAL.PIC.eoi( irq )
            llpl_irq_exit()
            return Kern.schedule_from_interrupt( ctx )
        }

        HAL.PIC.eoi( irq )
        llpl_irq_exit()
        return ctx
    }

    match ctx.vector {
        0  => hs.write( "\x1b[1;31mDIVIDE BY ZERO:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" ) 
        6  => hs.write( "\x1b[1;31mINVALID OPCODE:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" ) 
        13 => hs.write( "\x1b[1;31mGENERAL PROTECTION FAULT:\x1b[0m rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
        14 => {
            let next_ctx = page_fault_handler(ctx)
            if next_ctx == null {
                return ctx
            }
            if next_ctx != ctx {
                return next_ctx
            }
        }
        _  => hs.write( "\x1b[1;31mEXCEPTION:\x1b[0m vector=\(ctx.vector:hex) err=\(ctx.err:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
    }

    if ctx.vector == 8 {
        double_fault_handler(ctx)
        return
    }

    llpl_panic_backtrace_from_frame( ctx.rbp )
    // Linked from hal/isr.m64. Dispatching through HAL.interrupts can be
    // filled in once the interrupt context layout is consumed on the LLPL side.

    while true {
        HAL.halt()
    }

    return ctx
}

func page_fault_bit(err: u64, bit: u64) -> string {
    return "1" if (err & (1 << bit)) != 0
    return "0"
}

func page_fault_reason(err: u64) -> string {
    return "protection violation" if (err & 1) != 0
    return "non-present page"
}

func page_fault_access(err: u64) -> string {
    return "write" if (err & 2) != 0
    return "read"
}

func page_fault_mode(err: u64) -> string {
    return "user" if (err & 4) != 0
    return "supervisor"
}

func thread_state_name(state: uint) -> string {
    match state {
        case ThreadState.New =>      { return "new" }
        case ThreadState.Ready =>    { return "ready" }
        case ThreadState.Running =>  { return "running" }
        case ThreadState.Sleeping => { return "sleeping" }
        case ThreadState.Zombie =>   { return "zombie" }
        case _ =>                    { return "unknown" }
    }
}

func page_fault_print_context() {
    let gs_base = HAL.read_gs_base()
    if gs_base == 0 {
        "  cpu/thread: GS base not initialized\n" |> hs.write
        return
    }

    let pcpu = gs_base as HAL.PerCpu*
    let thread = pcpu.thread
    "  cpu=\(pcpu.cpuid) thread=\(thread as uint:hex)" |> hs.write

    if thread == null {
        " <none>\n" |> hs.write
        return
    }

    " name=" |> hs.write
    if thread.name != null {
        thread.name.c_str() |> hs.write
    } else {
        "<unnamed>" |> hs.write
    }
    " state=" |> hs.write
    thread_state_name(thread.state) |> hs.write
    " priority=\(thread.priority) cr3=\(Kern.thread_cr3(thread):hex)\n" |> hs.write

    if thread.proc != null {
        "  process=\(thread.proc as uint:hex) name=" |> hs.write
        if thread.proc.name != null {
            thread.proc.name.c_str() |> hs.write
        } else {
            "<unnamed>" |> hs.write
        }
        " pml4=\(thread.proc.pml4:hex)\n" |> hs.write
    } else {
        "  process=<none>\n" |> hs.write
    }
}

func page_fault_handler(ctx: HAL.IDT.Context*) -> HAL.IDT.Context* {
    let fault_addr = HAL.read_cr2()
    let active_cr3 = HAL.read_cr3()

    if (ctx.err & 4) != 0 || (ctx.cs & 3) == 3 {
        let thread: Kern.Thread = HAL.current().thread
        if thread != null && Kern.resolve_user_page_fault(thread.proc, fault_addr, ctx.err) {
            // Null is the internal "fault resolved, retry this context"
            // sentinel; ctx itself continues to mean an unhandled fault.
            return null
        }
    }

    "\x1b[1;31mPAGE FAULT:\x1b[0m \(page_fault_reason(ctx.err)) during \(page_fault_access(ctx.err)) in \(page_fault_mode(ctx.err)) mode\n" |> hs.write
    "  fault_addr=\(fault_addr:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex) rbp=\(ctx.rbp:hex)\n" |> hs.write
    "  err=\(ctx.err:hex) bits P=\(page_fault_bit(ctx.err, 0)) W/R=\(page_fault_bit(ctx.err, 1)) U/S=\(page_fault_bit(ctx.err, 2)) RSVD=\(page_fault_bit(ctx.err, 3)) I/D=\(page_fault_bit(ctx.err, 4)) PK=\(page_fault_bit(ctx.err, 5)) SS=\(page_fault_bit(ctx.err, 6)) SGX=\(page_fault_bit(ctx.err, 15))\n" |> hs.write
    "  cs=\(ctx.cs:hex) ss=\(ctx.ss:hex) rflags=\(ctx.rflags:hex) active_cr3=\(active_cr3:hex)\n" |> hs.write
    page_fault_print_context()

    if (ctx.err & 4) != 0 || (ctx.cs & 3) == 3 {
        "  action=kill-user-thread\n" |> hs.write
        return Kern.kill_current_thread_from_interrupt( ctx, 0xFFFF_FFFF_FFFF_FFF2 )
    }

    return ctx
}

func double_fault_handler( ctx: HAL.IDT.Context* ) {
    hs.write( "\x1b[1;31mDOUBLE FAULT:\x1b[0m err=\(ctx.err:hex) rip=\(ctx.rip:hex) rsp=\(ctx.rsp:hex)\n" )
    llpl_panic_backtrace_from_frame( ctx.rbp )
    while true {
        HAL.halt()
    }
}
