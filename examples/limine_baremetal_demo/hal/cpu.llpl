import kern

namespace HAL { 
    func outb(port: u64, value: u8) {
        asm("outb %0, %w1" : : "a"(value), "Nd"(port))
    }

    func inb(port: u64) -> u8 {
        let value: u8 = 0
        asm("inb %w1, %0" : "=a"(value) : "Nd"(port))
        value
    }

    func outl(port: u64, value: u32) {
        asm("outl %0, %w1" : : "a"(value), "Nd"(port))
    }

    func inl(port: u64) -> u32 {
        let value: u32 = 0
        asm("inl %w1, %0" : "=a"(value) : "Nd"(port))
        value
    }

    func halt() {
        asm("hlt")
    }

    func disable_interrupts() {
        asm("cli")
    }

    func enable_interrupts() {
        asm("sti")
    }

    func interrupts_enabled() -> bool {
        let flags: u64
        asm("pushfq\n\tpop %0" : "=r"(flags))
        return (flags & (1 << 9)) != 0
    }

    func interrupt_save() -> bool {
        let enabled = interrupts_enabled()
        disable_interrupts()
        return enabled
    }

    func interrupt_restore(enabled: bool) {
        if enabled {
            enable_interrupts()
        }
    }

    func read_cr3() -> u64 {
        let cr3: u64
        asm("mov %%cr3, %0" : "=r"(cr3))
        cr3
    }

    func read_cr2() -> u64 {
        let cr2: u64
        asm("mov %%cr2, %0" : "=r"(cr2))
        cr2
    }

    func write_cr3(cr3: u64) {
        asm("mov %0, %%cr3" : : "r"(cr3) : "memory")
    }

    func read_cr0() -> u64 {
        let cr0: u64
        asm("mov %%cr0, %0" : "=r"(cr0))
        cr0
    }

    func write_cr0(cr0: u64) {
        asm("mov %0, %%cr0" : : "r"(cr0) : "memory")
    }

    func read_cr4() -> u64 {
        let cr4: u64
        asm("mov %%cr4, %0" : "=r"(cr4))
        cr4
    }

    func write_cr4(cr4: u64) {
        asm("mov %0, %%cr4" : : "r"(cr4) : "memory")
    }

    func wbinvd() {
        asm("wbinvd" : : : "memory")
    }

    // General form of cpu_id()/cpuid_num() below, which only ever return
    // ebx from leaf 1 - MTRR setup (hal/mtrr.llpl) needs edx from leaf 1
    // and eax from leaf 0x80000008.
    func cpuid(leaf: u32) -> (u32, u32, u32, u32) {
        let eax = leaf
        let ebx: u32
        let ecx: u32
        let edx: u32
        asm("cpuid" : "+a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx))
        (eax, ebx, ecx, edx)
    }

    // CPUID leaf 1, ECX bit 30 - RDRAND support (Intel SDM Vol 2A, Table
    // 3-11). Not every CPU model QEMU can boot exposes this (the default
    // "qemu64" model under -accel kvm with no explicit -cpu override does
    // not), so callers must have a fallback path - see HAL.RNG.fill.
    func has_rdrand() -> bool {
        let (eax, ebx, ecx, edx) = cpuid(1)
        return (ecx & (1 << 30)) != 0
    }

    // Returns (success, value). Per Intel's guidance (SDM Vol 1 7.3.17),
    // retry a bounded number of times - RDRAND can legitimately report "not
    // ready" under heavy contention - rather than looping forever.
    func rdrand64() -> (bool, u64) {
        let attempt: uint = 0
        while attempt < 10 {
            let value: u64 = 0
            let ok: u8 = 0
            // `rdrand %rax` encoded as raw bytes (REX.W 0F C7 /6) - this
            // toolchain's tcc-based assembler doesn't recognize the
            // `rdrand` mnemonic, and RDRAND (Ivy Bridge-era) is new enough
            // that older assemblers commonly lack it. "=a" pins the output
            // to RAX to match the hardcoded destination register.
            asm(".byte 0x48, 0x0f, 0xc7, 0xf0\n\tsetc %1" : "=a"(value), "=qm"(ok))
            if ok != 0 {
                return (true, value)
            }
            attempt++
        }
        return (false, 0)
    }

    func rdtsc() -> u64 {
        let lo: u32 = 0
        let hi: u32 = 0
        asm("rdtsc" : "=a"(lo), "=d"(hi))
        return ((hi as u64) << 32) | lo as u64
    }

    func write_msr(msr: u32, value: uint) {
        let low = value as u32
        let high = (value >> 32) as u32
        asm("wrmsr" : : "c"(msr), "a"(low), "d"(high))
    }

    func read_msr(msr: u32) -> uint {
        let low: u32
        let high: u32
        asm("rdmsr" : "=a"(low), "=d"(high) : "c"(msr))
        ((high as uint) << 32) | (low as uint)
    }

    // CPUID leaf 1 exposes the processor's initial local APIC ID. It is a
    // stable owner token for kernel locks until a real per-CPU subsystem is
    // installed.
    func cpu_id() -> uint {
        let eax: u32 = 1
        let ebx: u32
        asm("cpuid" : "+a"(eax), "=b"(ebx) : : "ecx", "edx")
        (ebx >> 24) as uint
    }

    struct PerCpu {
        this:   PerCpu*
        cpuid:  uint
        thread: Kern.Thread
    }

    let percpu: PerCpu[16]  

    func cpuid_num() -> uint {
        let ebx: u32

        asm( "mov $1, %%eax\n"
             "cpuid\n"
             "mov %%ebx, %0\n"
             : "=r"(ebx)
             :
             : "eax", "ecx", "edx")
        (ebx >> 24) as uint
    }

    func set_gs_base( base: uint ) {
        write_msr( 0xC000_0101, base )
    }

    func read_gs_base() -> uint {
        read_msr( 0xC000_0101 )
    }

    func percpu_init() {
        let cpu = cpuid_num()

        percpu[cpu].this = &percpu[cpu]
        percpu[cpu].cpuid = cpu

        set_gs_base( (&percpu[cpu]) as uint )
    }

    func current() -> PerCpu* {
        let base: u64
        asm( "mov %%gs:0, %0" : "=r"(base) )
        base as PerCpu*
    }
}
