namespace HAL { 
    func outb(port: u64, value: u8) {
        asm("outb %0, %w1" : : "a"(value), "Nd"(port))
    }

    func inb(port: u64) -> u8 {
        let value: u8 = 0
        asm("inb %w1, %0" : "=a"(value) : "Nd"(port))
        value
    }

    func halt() {
        asm("hlt")
    }

    func disable_interrupts() {
        asm("cli")
    }

    func enable_interrupts() {
        asm("sti")
    }

    func read_cr3() -> u64 {
        let cr3: u64
        asm("mov %%cr3, %0" : "=r"(cr3))
        cr3
    }
}