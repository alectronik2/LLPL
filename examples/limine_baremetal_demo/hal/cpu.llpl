import kern

namespace HAL { 
    func outb(port: u64, value: u8) {
        asm("outb %0, %w1" : : "a"(value), "Nd"(port))
    }

    func inb(port: u64) -> u8 {
        let value: u8 = 0
        asm("inb %w1, %0" : "=a"(value) : "Nd"(port))
        value
    }

    func halt() {
        asm("hlt")
    }

    func disable_interrupts() {
        asm("cli")
    }

    func enable_interrupts() {
        asm("sti")
    }

    func interrupts_enabled() -> bool {
        let flags: u64
        asm("pushfq\n\tpop %0" : "=r"(flags))
        return (flags & (1 << 9)) != 0
    }

    func interrupt_save() -> bool {
        let enabled = interrupts_enabled()
        disable_interrupts()
        return enabled
    }

    func interrupt_restore(enabled: bool) {
        if enabled {
            enable_interrupts()
        }
    }

    func read_cr3() -> u64 {
        let cr3: u64
        asm("mov %%cr3, %0" : "=r"(cr3))
        cr3
    }

    func read_cr2() -> u64 {
        let cr2: u64
        asm("mov %%cr2, %0" : "=r"(cr2))
        cr2
    }

    func write_cr3(cr3: u64) {
        asm("mov %0, %%cr3" : : "r"(cr3) : "memory")
    }

    func write_msr(msr: u32, value: uint) {
        let low = value as u32
        let high = (value >> 32) as u32
        asm("wrmsr" : : "c"(msr), "a"(low), "d"(high))
    }

    func read_msr(msr: u32) -> uint {
        let low: u32
        let high: u32
        asm("rdmsr" : "=a"(low), "=d"(high) : "c"(msr))
        ((high as uint) << 32) | (low as uint)
    }

    // CPUID leaf 1 exposes the processor's initial local APIC ID. It is a
    // stable owner token for kernel locks until a real per-CPU subsystem is
    // installed.
    func cpu_id() -> uint {
        let eax: u32 = 1
        let ebx: u32
        asm("cpuid" : "+a"(eax), "=b"(ebx) : : "ecx", "edx")
        (ebx >> 24) as uint
    }

    struct PerCpu {
        this:   PerCpu*
        cpuid:  uint
        thread: Kern.Thread
    }

    let percpu: PerCpu[16]  

    func cpuid_num() -> uint {
        let ebx: u32

        asm( "mov $1, %%eax\n"
             "cpuid\n"
             "mov %%ebx, %0\n"
             : "=r"(ebx)
             :
             : "eax", "ecx", "edx")
        (ebx >> 24) as uint
    }

    func set_gs_base( base: uint ) {
        write_msr( 0xC000_0101, base )
    }

    func read_gs_base() -> uint {
        read_msr( 0xC000_0101 )
    }

    func percpu_init() {
        let cpu = cpuid_num()

        percpu[cpu].this = &percpu[cpu]
        percpu[cpu].cpuid = cpu

        set_gs_base( (&percpu[cpu]) as uint )
    }

    func current() -> PerCpu* {
        let base: u64
        asm( "mov %%gs:0, %0" : "=r"(base) )
        base as PerCpu*
    }
}
