// Local APIC + I/O APIC support, additive alongside the existing 8259 PIC
// (hal/pic.llpl) - keyboard/mouse/PIT stay exactly as they are, all still
// PIC-routed on vectors 0x20-0x2F. This exists purely to give a new PCI
// device (AHCI) a real interrupt path: its GSI gets routed through the
// IOAPIC to a vector outside the PIC's range (see HAL.IDT's second
// dispatch branch, hal/idt.llpl), acknowledged via the LAPIC's own EOI
// register instead of HAL.PIC.eoi().
//
// The IOAPIC's MMIO base has no MSR/CPUID discovery path - it's normally
// found via the ACPI MADT table, which this kernel doesn't parse (no ACPI
// support exists at all yet - a bigger, separate undertaking). 0xFEC00000
// is hardcoded instead: it's both QEMU's fixed default (i440fx and q35
// alike) and the de-facto standard PC address predating strict ACPI
// requirements. Full hardware portability would need real MADT parsing;
// this kernel already targets QEMU specifically (`-accel kvm` is already
// in build.yaml's run.args).

import mm

namespace HAL {
    namespace LAPIC {
        const IA32_APIC_BASE_MSR = 0x1B
        const REG_ID = 0x020
        const REG_EOI = 0x0B0
        const REG_SVR = 0x0F0
        const SVR_ENABLE = 1 << 8
        const SPURIOUS_VECTOR = 0xFF

        // Recomputed on every access rather than cached in a module-level
        // variable set once by init() - avoids a compiler miscompilation
        // (confirmed reproducible only at this kernel's full multi-file
        // scale, not in isolation: a bare reference/assignment to a
        // module-level `let` here silently emitted the unqualified C name
        // instead of the mangled global, which the C compiler then
        // rejected as undeclared). rdmsr is cheap and this is a low-
        // frequency driver path, so recomputing costs nothing real.
        func base() -> uint {
            let msr_value = HAL.read_msr(IA32_APIC_BASE_MSR)
            let phys_base = msr_value & ~0xFFF as uint
            return MM.p2v(phys_base)
        }

        func reg(offset: uint) -> u32* {
            let addr = base() + offset
            return addr as u32*
        }

        func init() {
            *reg(REG_SVR) = (SVR_ENABLE | SPURIOUS_VECTOR) as u32
        }

        func eoi() {
            *reg(REG_EOI) = 0
        }
    }

    namespace IOAPIC {
        const MMIO_BASE = 0xFEC00000
        const IOREGSEL = 0x00
        const IOWIN = 0x10

        const REDTBL_DELIVERY_FIXED = 0 << 8
        const REDTBL_DEST_PHYSICAL = 0 << 11
        const REDTBL_POLARITY_LOW = 1 << 13
        const REDTBL_TRIGGER_LEVEL = 1 << 15
        const REDTBL_MASKED = 1 << 16

        // See HAL.LAPIC.base's own comment - recomputed rather than
        // cached, for the same reason. MMIO_BASE is a fixed constant, so
        // this is just an add (hhdm_offset + MMIO_BASE), not a real
        // recomputation cost.
        func base() -> uint {
            return MM.p2v(MMIO_BASE)
        }

        func write_reg(index: u32, value: u32) {
            *((base() + IOREGSEL) as u32*) = index
            *((base() + IOWIN) as u32*) = value
        }

        func read_reg(index: u32) -> u32 {
            *((base() + IOREGSEL) as u32*) = index
            return *((base() + IOWIN) as u32*)
        }

        func init() {
        }

        // Routes GSI `gsi` (== the legacy ISA IRQ number for the identity-
        // mapped lines 0-15, which is all this kernel ever deals with - no
        // ACPI Interrupt Source Override parsing, matching the rest of
        // this file's scope) to `vector`, targeting the boot CPU (APIC ID
        // 0 - this kernel has no SMP support). Level-triggered/active-low,
        // the standard PCI INTx convention (as opposed to ISA's edge/
        // active-high default) - the AHCI driver's own IRQ handler must
        // clear the device's interrupt-status bits itself, exactly the
        // same de-assertion a level-triggered line always needs.
        func set_irq(gsi: u32, vector: u32) {
            let low = vector | REDTBL_DELIVERY_FIXED | REDTBL_DEST_PHYSICAL |
                REDTBL_POLARITY_LOW | REDTBL_TRIGGER_LEVEL
            let redtbl_index = 0x10 + gsi * 2
            write_reg(redtbl_index, low)
            write_reg(redtbl_index + 1, 0)
        }
    }
}
