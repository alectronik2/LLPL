extern isr_handler

// GDT/TSS helpers consumed by hal/gdt.llpl =========================================================

section .bss
alignb 16
tss:
    resb 104
kernel_stack_bottom:
    resb 16384
kernel_stack_top:

// Interrupt handlers generated by macro ============================================================

macro GenISR(num) {
global isr$num
isr$num:
    push 0
    push $num
    jmp isr_common
}

macro GenISRerr(num) {
global isr$num
isr$num:
    push $num
    jmp isr_common
}

// Boilerplate ======================================================================================

section .text
align 16

global get_tss
get_tss:
    mov rax, tss
    ret

global get_kernel_stack_top
get_kernel_stack_top:
    mov rax, kernel_stack_top
    ret

global load_tss
load_tss:
    ltr di
    ret

for num in 0..7 {
    GenISR($num)
}

GenISRerr(8)
GenISR(9)
for num in 10..14 {
    GenISRerr($num)
}

GenISR(15)
GenISR(16)
GenISRerr(17)
for num in 18..20 {
    GenISR($num)
}

GenISRerr(21)
for num in 22..28 {
    GenISR($num)
}
GenISRerr(29)
GenISRerr(30)
GenISR(31)

for num in 32..255 {
    GenISR($num)
}

// Naked ISR stub: no generated frame setup or return. =============================================
naked func isr_common {
    // Save general-purpose registers before calling into the handler.
    push RAX
    push RCX
    push RDX
    push RBX
    push RBP
    push RSI
    push RDI
    push R8
    push R9
    push R10
    push R11
    push R12
    push R13
    push R14
    push R15

    // RDI = pointer to Context (first arg per SysV ABI).
    mov RDI, RSP
    call isr_handler

    // Restore registers in reverse order.
    pop R15
    pop R14
    pop R13
    pop R12
    pop R11
    pop R10
    pop R9
    pop R8
    pop RDI
    pop RSI
    pop RBP
    pop RBX
    pop RDX
    pop RCX
    pop RAX

    // Drop interrupt number and error code, then return with iretq in real stubs.
    add RSP, 16

    iretq
}
