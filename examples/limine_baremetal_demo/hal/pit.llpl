import kern
import kern.timer

namespace HAL {
    namespace PIT {
        const TMR_CTRL         = 0x43
        const TMR_CNT0         = 0x40
        const TMR_BOTH         = 0x30
        const TMR_CH0          = 0x00
        const TMR_MD3          = 0x6

        const TIMER_FREQ       = 100
        const USECS_PER_TICK   = 10_000
        const MSECS_PER_TICK   = 10

        const PIT_CLOCK        = 1_193_180

        const CLOCKS_PER_SEC   = 1000
        const CLOCKS_PER_TICK  = 10

        struct timeval {
            sec:  uint
            usec: uint
        }

        let ticks              = 0
        let clocks             = 0
        let systemclock: timeval
        let timer_interrupt: HAL.Interrupt = null
        let schedule_requested = false

        func deferred_tick_report(arg: void*) {
            "Deferred work: PIT tick \(HAL.PIT.ticks)\n" |> HAL.Serial.write
        }

        func timer_handler( arg: void* ) {
            clocks += CLOCKS_PER_TICK
            ticks += 1
            let now = Timer.on_pit_tick()
            Kern.account_current_runtime_tick()
            Kern.wake_sleepers(now)
            llpl_async_advance_ms( MSECS_PER_TICK )

            systemclock.usec += USECS_PER_TICK
            while systemclock.usec >= 1_000_000 {
                systemclock.sec++
                systemclock.usec -= 1_000_000
            }

            run_timer_list()

            // Demonstrate that IRQ handlers can request work which is unsafe
            // to perform in interrupt context (serial formatting/output here).
            if ticks % TIMER_FREQ == 0 {
                Kern.Deferred.queue(deferred_tick_report)
            }

            // The mouse cursor/window sprites (kern/mouse.llpl) only
            // repaint themselves on mouse packets, but any console text
            // write - from any thread, at any time - scrolls the same
            // framebuffer and erases them until the next packet. A small,
            // steady redraw here (~33Hz) keeps them visibly on top
            // without needing Terminal to know anything about the mouse
            // (which would require importing kern from lib/terminal.llpl,
            // a real circular import given kern/mouse.llpl already does
            // `import terminal`).
            if ticks % 3 == 0 {
                // Kern.run_window_ticks queued first so the cursor sprite
                // (Kern.compose_frame_work) always ends up drawn on top of
                // whatever the microui overlays just painted this tick -
                // run_window_ticks itself decides which of the three
                // windows paints last (i.e. on top of the other two) based
                // on their current z-order, rather than the fixed
                // mu_demo/mu_term/mu_gl order this used to queue directly.
                if Kern.mu_demo_active {
                    Kern.Deferred.queue(Kern.run_window_ticks)
                }
                Kern.Deferred.queue(Kern.compose_frame_work)
            }

            schedule_requested = true
        }

        func take_schedule_request() -> bool {
            let requested = schedule_requested
            schedule_requested = false
            return requested
        }

        func run_timer_list() {

        }

        func init() {
            let cnt = PIT_CLOCK / TIMER_FREQ
            HAL.outb( TMR_CTRL, TMR_CH0 + TMR_BOTH + TMR_MD3 )
            HAL.outb( TMR_CNT0, (cnt & 0xFF) as u8 )
            HAL.outb( TMR_CNT0, (cnt >> 8) as u8)

            timer_interrupt = new HAL.Interrupt()
            let handler: HAL.proc = timer_handler

            timer_interrupt.register( 0x20, handler )
            HAL.PIC.enable_irq( 0 )
        }
    }
}
