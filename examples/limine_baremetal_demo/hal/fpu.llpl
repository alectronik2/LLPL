import hal

namespace HAL.FPU {
    const STATE_SIZE = 512
    let initial_storage: u8[STATE_SIZE + 16]
    let initial_state: void*

    // The kernel remains compiled without FP instructions. User x87/SSE
    // state is switched explicitly alongside its owning thread.
    func init() {
        const CR0_MP = 1 << 1
        const CR0_EM = 1 << 2
        const CR0_TS = 1 << 3
        const CR4_OSFXSR = 1 << 9
        const CR4_OSXMMEXCPT = 1 << 10

        HAL.write_cr0((HAL.read_cr0() | CR0_MP) & ~(CR0_EM | CR0_TS))
        HAL.write_cr4(HAL.read_cr4() | CR4_OSFXSR | CR4_OSXMMEXCPT)

        initial_state = ((&initial_storage[0] as uint + 15) & ~0xF) as void*
        let mxcsr: u32 = 0x1F80
        asm("fninit\n\tldmxcsr (%0)\n\tfxsave (%1)" : :
            "r"(&mxcsr), "r"(initial_state) : "memory")
    }

    func copy_initial(dest: void*) {
        memcpy(dest, initial_state, STATE_SIZE)
    }

    func save(state: void*) {
        asm("fxsave (%0)" : : "r"(state) : "memory")
    }

    func restore(state: void*) {
        asm("fxrstor (%0)" : : "r"(state) : "memory")
    }
}
