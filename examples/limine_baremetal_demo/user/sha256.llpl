// SHA-256 (FIPS 180-4), HMAC-SHA256 (RFC 2104), and the TLS 1.2 PRF
// (RFC 5246 5) built on top of it. Used by tls.llpl for the handshake
// transcript hash, key derivation, and Finished message verify_data.
namespace Sha256 {
    const BLOCK_SIZE: uint = 64
    const DIGEST_SIZE: uint = 32

    struct Context {
        state: u32[8]
        buffer: u8[64]
        buffer_len: uint
        total_len: u64
    }

    let K: u32[64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]

    func rotr(x: u32, n: u32) -> u32 {
        return (x >> n) | (x << (32 - n))
    }

    func be32_load(data: u8*, at: uint) -> u32 {
        return ((data[at] as u32) << 24) | ((data[at + 1] as u32) << 16) |
            ((data[at + 2] as u32) << 8) | (data[at + 3] as u32)
    }

    func be32_store(data: u8*, at: uint, value: u32) {
        data[at] = (value >> 24) as u8
        data[at + 1] = (value >> 16) as u8
        data[at + 2] = (value >> 8) as u8
        data[at + 3] = value as u8
    }

    func be64_store(data: u8*, at: uint, value: u64) {
        let i: uint = 0
        while i < 8 {
            data[at + i] = (value >> ((7 - i) * 8)) as u8
            i++
        }
    }

    func compress(state: u32*, block: u8*) {
        let w: u32[64]
        let i: uint = 0
        while i < 16 {
            w[i] = be32_load(block, i * 4)
            i++
        }
        while i < 64 {
            let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
            let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
            w[i] = w[i - 16] + s0 + w[i - 7] + s1
            i++
        }

        let a = state[0]
        let b = state[1]
        let c = state[2]
        let d = state[3]
        let e = state[4]
        let f = state[5]
        let g = state[6]
        let h = state[7]

        i = 0
        while i < 64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((~e) & g)
            let temp1 = h + s1 + ch + K[i] + w[i]
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = s0 + maj

            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            i++
        }

        state[0] += a
        state[1] += b
        state[2] += c
        state[3] += d
        state[4] += e
        state[5] += f
        state[6] += g
        state[7] += h
    }

    func init(ctx: Context*) {
        ctx.state[0] = 0x6a09e667
        ctx.state[1] = 0xbb67ae85
        ctx.state[2] = 0x3c6ef372
        ctx.state[3] = 0xa54ff53a
        ctx.state[4] = 0x510e527f
        ctx.state[5] = 0x9b05688c
        ctx.state[6] = 0x1f83d9ab
        ctx.state[7] = 0x5be0cd19
        ctx.buffer_len = 0
        ctx.total_len = 0
    }

    func update(ctx: Context*, data: u8*, len: uint) {
        ctx.total_len += len as u64
        let offset: uint = 0
        while offset < len {
            let space = BLOCK_SIZE - ctx.buffer_len
            let take = len - offset
            if take > space { take = space }
            let i: uint = 0
            while i < take {
                ctx.buffer[ctx.buffer_len + i] = data[offset + i]
                i++
            }
            ctx.buffer_len += take
            offset += take
            if ctx.buffer_len == BLOCK_SIZE {
                compress(&ctx.state[0], &ctx.buffer[0])
                ctx.buffer_len = 0
            }
        }
    }

    func final(ctx: Context*, out: u8*) {
        let bit_len = ctx.total_len * 8
        let pad_byte: u8 = 0x80
        update(ctx, &pad_byte, 1)
        let zero: u8 = 0
        while ctx.buffer_len != 56 {
            update(ctx, &zero, 1)
        }
        let len_bytes: u8[8]
        be64_store(&len_bytes[0], 0, bit_len)
        update(ctx, &len_bytes[0], 8)

        let i: uint = 0
        while i < 8 {
            be32_store(out, i * 4, ctx.state[i])
            i++
        }
    }

    func hash(data: u8*, len: uint, out: u8*) {
        let ctx: Context
        init(&ctx)
        update(&ctx, data, len)
        final(&ctx, out)
    }

    func hmac(key: u8*, key_len: uint, data: u8*, data_len: uint, out: u8*) {
        let block_key: u8[64]
        let i: uint = 0
        if key_len > BLOCK_SIZE {
            let digest: u8[32]
            hash(key, key_len, &digest[0])
            while i < DIGEST_SIZE {
                block_key[i] = digest[i]
                i++
            }
        } else {
            while i < key_len {
                block_key[i] = key[i]
                i++
            }
        }
        while i < BLOCK_SIZE {
            block_key[i] = 0
            i++
        }

        let ipad: u8[64]
        let opad: u8[64]
        i = 0
        while i < BLOCK_SIZE {
            ipad[i] = block_key[i] ^ 0x36
            opad[i] = block_key[i] ^ 0x5c
            i++
        }

        let inner_ctx: Context
        init(&inner_ctx)
        update(&inner_ctx, &ipad[0], BLOCK_SIZE)
        update(&inner_ctx, data, data_len)
        let inner_digest: u8[32]
        final(&inner_ctx, &inner_digest[0])

        let outer_ctx: Context
        init(&outer_ctx)
        update(&outer_ctx, &opad[0], BLOCK_SIZE)
        update(&outer_ctx, &inner_digest[0], DIGEST_SIZE)
        final(&outer_ctx, out)
    }

    // TLS 1.2 PRF (RFC 5246 5): P_hash(secret, seed) via HMAC-SHA256,
    // truncated/concatenated to out_len bytes. `seed` is the label already
    // concatenated with the actual seed bytes by the caller (labels are
    // short ASCII constants, e.g. "master secret" + client_random +
    // server_random) - capped at MAX_SEED_LEN, generous for every TLS 1.2
    // seed this client constructs (largest is ~77 bytes).
    const MAX_SEED_LEN: uint = 192

    func prf(secret: u8*, secret_len: uint, seed: u8*, seed_len: uint, out: u8*, out_len: uint) {
        let a: u8[32]
        hmac(secret, secret_len, seed, seed_len, &a[0])

        let produced: uint = 0
        while produced < out_len {
            let buf: u8[32 + MAX_SEED_LEN]
            let i: uint = 0
            while i < 32 {
                buf[i] = a[i]
                i++
            }
            i = 0
            while i < seed_len {
                buf[32 + i] = seed[i]
                i++
            }

            let chunk: u8[32]
            hmac(secret, secret_len, &buf[0], 32 + seed_len, &chunk[0])

            let take = out_len - produced
            if take > 32 { take = 32 }
            i = 0
            while i < take {
                out[produced + i] = chunk[i]
                i++
            }
            produced += take

            let next_a: u8[32]
            hmac(secret, secret_len, &a[0], 32, &next_a[0])
            i = 0
            while i < 32 {
                a[i] = next_a[i]
                i++
            }
        }
    }
}
