class Grid {
    let data: f64[16]
    let width: i64

    constructor(width: i64) {
        self.width = width
        let i: i64 = 0
        while i < 16 {
            self.data[i] = 0.0
            i = i + 1
        }
    }

    func operator[](index: i64) -> f64 {
        return self.data[index]
    }

    func operator[](index: i64, value: f64) {
        self.data[index] = value
    }
}

func main() -> i64 {
    let g: Grid = new Grid(4)
    g[5] = 42.5
    let v: f64 = g[5]
    if v != 42.5 {
        puts("index setter mismatch")
        return 1
    }
    // getter still works standalone too
    g[0] = 1.0
    g[1] = 2.0
    if g[0] + g[1] != 3.0 {
        puts("getter mismatch")
        return 1
    }
    puts("index operator overload ok")
    return 0
}