func level() {
    let sarr = ["hello", "world"]
    let x = sarr[2]
    puts("x equals tp \(x)")
}

func main( args: string[] ) {
    puts("Hello, world")

    let ary = [1,2,3]
    puts( "\(1 in ary)" )

    let sarr = ["hello", "world"]
    puts( "\("hello" in sarr)" )

    for s in sarr {
        puts( "# \(s)")
    }

    let str = new String("TEST STR")
    puts("testing class print: \(str)")

    let f = func() { puts("Func called") }
    f()

    level()
}
