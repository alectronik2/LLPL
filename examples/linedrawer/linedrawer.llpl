func main( args: string[] ) {
    puts("Hello, world")

    let ary: int[] = [1,2,3]
    puts( "\(1 in ary)" )

    let sarr: string[] = ["hello", "world"]
    puts( "\("hello" in sarr)" )

    for s in sarr {
        puts( "# \(s)")
    }

    let f = func() { puts("Func called") }
    f()
}
