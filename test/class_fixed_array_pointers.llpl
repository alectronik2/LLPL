extern func puts(s: char*) -> i64

func print_int(label: char*, value: i64) {
    let buf: char[64]
    ksnprintf(buf as char*, 64, "%s = %d", label, value)
    puts(buf as char*)
}

class Box : Object {
    value: i64

    constructor(@value: i64) {}
}

let global_boxes: Box[2]

func sum_boxes(boxes: Box[2]) -> i64 {
    return boxes[0].value + boxes[1].value
}

func main() -> i64 {
    global_boxes[0] = new Box(7)
    global_boxes[1] = new Box(8)
    print_int("global sum", sum_boxes(global_boxes))

    let local_boxes: Box[2]
    local_boxes[0] = new Box(20)
    local_boxes[1] = new Box(22)
    print_int("local sum", sum_boxes(local_boxes))

    delete global_boxes[0]
    delete global_boxes[1]
    delete local_boxes[0]
    delete local_boxes[1]

    return 0
}
