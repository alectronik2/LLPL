extern func puts(s: char*) -> i64

func print_int(label: char*, value: i64) {
    let buf: char[64]
    ksnprintf(buf as char*, 64, "%s = %d", label, value)
    puts(buf as char*)
}

const LEN = 4
const HALF = 2

func main() -> i64 {
    let arr: i64[LEN] = [10, 20, 30, 40]
    print_int("arr-last", arr[LEN - 1])

    let grid: i64[HALF][1 << HALF] = [[1, 2, 3, 4], [5, 6, 7, 8]]
    print_int("grid", grid[1][(1 << HALF) - 1])

    return 0
}
