// Regression test: a function whose *entire* body (or whose last
// statement) is a block-form `if cond { a } else { b }` must return that
// branch's value, exactly like `func f() -> int { return if cond {a} else
// {b}... }` would. This used to silently compile to two discarded
// expression statements with no `return` at all - the function fell off
// the end and returned whatever garbage was in the return register. Only
// caught once lib/microui.llpl's imin/imax/iclamp (this exact shape) were
// actually exercised end to end.

extern func puts(s: char*) -> i64

func print_int(label: char*, value: i64) {
    let buf: char[64]
    ksnprintf(buf as char*, 64, "%s = %d", label, value)
    puts(buf as char*)
}

// Sole statement in the body, both orderings of which branch should win.
func imax(a: int, b: int) -> int { if a > b { a } else { b } }

// Preceded by another statement.
func imax_with_prelude(a: int, b: int) -> int {
    let unused = 1
    if a > b { a } else { b }
}

// else-if chain - every arm needs its own return.
func classify(n: int) -> int {
    if n < 0 {
        -1
    } else if n == 0 {
        0
    } else {
        1
    }
}

func main() -> i64 {
    print_int("imax(5, 6)", imax(5, 6) as i64)
    print_int("imax(6, 5)", imax(6, 5) as i64)
    print_int("imax_with_prelude(5, 6)", imax_with_prelude(5, 6) as i64)
    print_int("classify(-5)", classify(-5) as i64)
    print_int("classify(0)", classify(0) as i64)
    print_int("classify(5)", classify(5) as i64)
    return 0
}
