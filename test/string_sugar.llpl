extern func puts(s: string) -> i64

func print_int(label: string, value: i64) {
    let buf: char[64]
    ksnprintf(buf as string, 64, "%s = %d", label, value)
    puts(buf as string)
}

func print_char(label: string, value: char) {
    let buf: char[64]
    ksnprintf(buf as string, 64, "%s = %c", label, value)
    puts(buf as string)
}

func main() -> int {
    let a: String = new String("same")
    let b: String = new String("same")
    let c: String = new String("tail")

    if a == b {
        puts("same content")
    }
    if a != c {
        puts("different content")
    }
    if a < c {
        puts("lexicographic lt")
    }
    if c >= b {
        puts("lexicographic ge")
    }

    print_int("len", a.byte_len())
    print_char("char", a.byte_at(1))

    let map: HashMap<string, i64> = new HashMap<string, i64>()
    map.insert(a.c_str(), 1)
    map.insert(b.c_str(), 2)
    map.insert(c.c_str(), 3)

    print_int("map len", map.len())
    print_int("same key", map.get(a.c_str()).get())
    print_int("tail key", map.get(c.c_str()).get())

    return 0
}
