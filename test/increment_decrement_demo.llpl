// `i++`/`i--` still lower to `i = i + 1`/`i = i - 1` on plain values,
// and `++i`/`--i` use the native C prefix form. Types can also overload
// `operator++`/`operator--` now, and the same syntax dispatches to those
// methods when present.

extern func puts(s: char*) -> i64
func print_int(label: char*, value: i64) {
    let buf: char[64]
    ksnprintf(buf as char*, 64, "%s = %d", label, value)
    puts(buf as char*)
}

class Counter {
    let n: i64
    constructor() { self.n = 0 }
    destructor() {}
}

func main() -> i64 {
    let i: i64 = 0
    i++
    i++
    i++
    print_int("i", i)

    let j: i64 = 10
    j--
    print_int("j", j)

    // Works through an index/field target too, same as compound
    // assignment already does.
    let arr: i64[3]
    arr[0] = 100
    arr[0]++
    print_int("arr[0]", arr[0])

    let c: Counter = new Counter()
    c.n++
    c.n++
    print_int("c.n", c.n)

    // The classic C-style for-loop increment clause.
    for let k: i64 = 0; k < 3; k++ {
        print_int("k", k)
    }

    for let a: i64 = 0, let b: i64 = 10; a < 3; a++ {
        print_int("multi for", a + b)
        b++
    }

    return 0
}
