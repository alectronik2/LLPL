extern func puts(s: char*) -> i64

func print_int(label: char*, value: i64) {
    let buf: char[64]
    ksnprintf(buf as char*, 64, "%s = %d", label, value)
    puts(buf as char*)
}

alias replacement = [10, 20, 30]

func main() -> i64 {
    let arr: i64[3] = [1, 2, 3]
    arr = [4, 5, 6]
    print_int("arr0", arr[0])
    print_int("arr2", arr[2])

    arr = replacement
    print_int("alias1", arr[1])

    let inferred = [11, 22, 33]
    print_int("inferred1", inferred[1])

    let words = ["str", "ing"]
    puts(words[0])
    puts(words[1])

    let grid: i64[2][2] = [[1, 2], [3, 4]]
    grid = [[7, 8], [9, 10]]
    print_int("grid00", grid[0][0])
    print_int("grid11", grid[1][1])

    return 0
}
