func combine(a: int, b: int) -> int {
    return (a * 10) + b
}

async func mixed(n: int) -> int {
    let total = 0

    if await async_ready(true) {
        {
            total = total + combine(await async_ready(2), await async_ready(3))
        }
    }

    let i = 0
    while await async_ready(i < n) {
        total = total + await async_ready(i)
        i = i + 1
    }

    return (await async_ready(total)) + await async_ready(4)
}

func main() -> int {
    let value = async_run(mixed(3))
    let ignored = puts("\(value)")
    return 0
}
