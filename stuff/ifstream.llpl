using namespace std.io
extern func puts(s: char*) -> i64

func main() -> i64 {
    write_file("/tmp/llpl_ifstream_test.txt", new String("line one\nline two\nabc"))

    let stream: ifstream = new ifstream("/tmp/llpl_ifstream_test.txt")
    if !stream.is_open() {
        puts("ifstream failed to open")
        return 1
    }
    if !stream.good() {
        puts("ifstream not good() right after open")
        return 1
    }

    let line1: char[64]
    let r1: Result<i64, char*> = stream.getline(line1 as char*, 64)
    if !r1.is_ok() {
        puts("getline #1 failed")
        return 1
    }
    if !(line1 as string).equals(new String("line one")) {
        puts("getline #1 wrong content")
        return 1
    }

    let line2: char[64]
    stream.getline(line2 as char*, 64)
    if !(line2 as string).equals(new String("line two")) {
        puts("getline #2 wrong content")
        return 1
    }

    let b: Result<u8, char*> = stream.get()
    if !b.is_ok() || b.unwrap() != 97 { // 'a'
        puts("get() wrong byte")
        return 1
    }
    if stream.gcount() != 1 {
        puts("gcount() wrong after get()")
        return 1
    }

    let rest: char[16]
    let r3: Result<i64, char*> = stream.read(rest as char*, 10)
    if r3.unwrap() != 2 {
        puts("final read() should only get 2 remaining bytes ('bc')")
        return 1
    }
    if !stream.eof() {
        puts("eof() should be true after reading past end")
        return 1
    }
    if stream.good() {
        puts("good() should be false at eof")
        return 1
    }

    stream.seekg(0)
    if !stream.good() {
        puts("good() should be true again after seekg(0)")
        return 1
    }

    stream.close()
    if stream.is_open() {
        puts("close() did not close stream")
        return 1
    }

    puts("ifstream ok")
    return 0
}