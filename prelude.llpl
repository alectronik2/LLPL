// LLPL prelude.
//
// Always implicitly compiled in, ahead of everything else, regardless of
// whether the entry file (or anything it imports) ever mentions this file
// - see modules.d's resolveWithPrelude, which every entry point (the
// `llpl` CLI, `llpl --lsp-symbols`) goes through.
//
// Keep this small and universally safe: everything here compiles into
// *every* program, freestanding kernel or hosted alike, so nothing here
// should assume a particular target (no VGA/HAL-specific stuff - that
// belongs in a program's own modules, e.g. examples/baremetal_demo/hal.llpl).

// A byte string. LLPL's type system has no way to write "pointer to const
// data" (only whole-variable `const`), so this is just `char*` - a
// readability alias, not a distinct type.
alias string = char*

const EOK = 0
const EINVAL = -1
const EEXIST = -2
const ENOMEM = -3
const ENOENT = -4
const ENAMETOOLONG = -5

// Minimal printf-style formatter, always available without an `extern
// func` declaration of your own. Backed by runtime/runtime.c; see that
// file's header comment (runtime.h) for the exact contract - supported
// specifiers, width/zero-pad, and why the parameter types are what they
// are (they're chosen to exactly match what this declaration generates).
extern func ksnprintf(buf: char*, size: u64, fmt: char*, ...) -> i64
// The real libc puts, always available without an `extern func`
// declaration of your own - every program in this codebase that prints a
// line already redeclares this identically itself, so having it here
// once removes that boilerplate. A file that still declares its own
// identical copy (nothing here requires updating existing code) compiles
// fine too - C tolerates repeating an *identical* extern declaration,
// unlike ksnprintf/the SDL bindings above, which use a real header's own
// (differently-shaped) prototype and would conflict.
extern func puts(s: char*) -> i64
// Used by grammar-generated parser classes (see codegen.d's grammar
// desugaring) to report a malformed-input syntax error - a `grammar { }`
// block's generated parser is backtrack-free (predictive, not PEG-style),
// so an input that doesn't match at a point the analysis already proved
// unambiguous is a genuine error in the *input*, not the grammar; reported
// this way rather than via Result<T,E> threading through every generated
// call site, matching how many of this codebase's other "this should be
// unreachable in valid input" cases already fail loudly instead.
extern func llpl_panic(msg: char*)
extern func llpl_panic_at(msg: char*, file: char*, line: i64)
// Builtin panic: the compiler supplies the source file and line of this call.
extern func panic(msg: char*)
// Prints "CHECK FAILED: <msg>\n" and continues execution.
extern func llpl_check(msg: char*)

// Heap-allocation and raw-buffer primitives String is built on - see
// runtime.h's comment on why these are separate wrappers rather than
// `extern func` redeclarations of libc-shaped strlen/strcmp/rc_alloc
// themselves (same "conflicting types" trap as ksnprintf above).
extern func llpl_strlen(s: char*) -> u64
extern func llpl_strcmp(a: char*, b: char*) -> i64
extern func llpl_utf8_valid(s: char*) -> bool
extern func llpl_utf8_len(s: char*) -> u64
extern func llpl_utf8_byte_offset(s: char*, char_index: u64) -> u64
extern func llpl_utf8_char_index(s: char*, byte_offset: u64) -> u64
extern func llpl_utf8_codepoint_at(s: char*, char_index: u64) -> u64
extern func llpl_regex_match(pattern: char*, text: char*) -> bool
extern func llpl_regex_group_count(pattern: char*) -> u64
extern func llpl_regex_capture_bounds(pattern: char*, text: char*, group: u64, start: i64*, end: i64*) -> bool
extern func llpl_regex_capture(pattern: char*, text: char*, group: u64) -> char*
extern func llpl_reflect_type(name: char*) -> char*
extern func llpl_reflect_type_name(type: char*) -> char*
extern func llpl_reflect_type_kind(type: char*) -> char*
extern func llpl_reflect_type_size(type: char*) -> u64
extern func llpl_reflect_field_count(type: char*) -> u64
extern func llpl_reflect_field(type: char*, index: u64) -> char*
extern func llpl_reflect_field_name(field: char*) -> char*
extern func llpl_reflect_field_type_name(field: char*) -> char*
extern func llpl_reflect_field_offset(field: char*) -> u64
extern func llpl_reflect_field_size(field: char*) -> u64
extern func llpl_alloc(size: u64) -> char*
extern func llpl_free(ptr: char*)
extern func llpl_memcpy(dest: char*, src: char*, count: u64)
extern func llpl_async_create(frame_size: u64, poll_fn: void*) -> char*
extern func llpl_async_frame(task: char*) -> char*
extern func llpl_async_poll(task: char*, out: char*) -> i64
extern func llpl_async_block_on(task: char*, out: char*) -> i64
extern func llpl_async_block_on_timeout(task: char*, out: char*, timeout_ms: u64) -> i64
extern func llpl_async_cancel(task: char*) -> i64
extern func llpl_async_is_cancelled(task: char*) -> i64
extern func llpl_async_destroy(task: char*)
extern func llpl_async_now_ms() -> u64
extern func llpl_async_set_now_ms(now_ms: u64)
extern func llpl_async_advance_ms(delta_ms: u64) -> u64
extern func llpl_async_executor_create() -> char*
extern func llpl_async_executor_destroy(executor: char*)
extern func llpl_async_executor_spawn(executor: char*, task: char*) -> i64
extern func llpl_async_executor_poll(executor: char*) -> i64
extern func llpl_async_executor_run_all(executor: char*) -> i64
extern func llpl_async_executor_run_all_timeout(executor: char*, timeout_ms: u64) -> i64
extern func llpl_async_executor_cancel_all(executor: char*) -> i64
extern func llpl_irq_enter()
extern func llpl_irq_exit()
extern func llpl_in_irq() -> i64
extern func llpl_mutex_lock(state: i64*)
extern func llpl_mutex_try_lock(state: i64*) -> i64
extern func llpl_mutex_unlock(state: i64*)
extern func llpl_rwlock_read_lock(state: i64*)
extern func llpl_rwlock_try_read_lock(state: i64*) -> i64
extern func llpl_rwlock_read_unlock(state: i64*)
extern func llpl_rwlock_write_lock(state: i64*)
extern func llpl_rwlock_try_write_lock(state: i64*) -> i64
extern func llpl_rwlock_write_unlock(state: i64*)
extern func llpl_tls_alloc() -> i64
extern func llpl_tls_set_i64(key: i64, value: i64)
extern func llpl_tls_get_i64(key: i64) -> i64
extern func llpl_tls_set_u64(key: i64, value: u64)
extern func llpl_tls_get_u64(key: i64) -> u64
extern func llpl_thread_spawn(entry: () -> void) -> char*
extern func llpl_thread_join(thread: char*) -> i64
extern func llpl_thread_detach(thread: char*) -> i64
extern func llpl_thread_current_id() -> u64
extern func llpl_thread_yield()
extern func llpl_thread_sleep_ms(ms: u64)
extern func llpl_set_allocator(alloc_fn: (u64) -> char*, free_fn: (char*) -> void)
extern func llpl_reset_allocator()

const TASK_PENDING = 0
const TASK_RUNNING = 1
const TASK_DONE = 2
const TASK_CANCELLED = 3

struct AsyncFuture<T> {
    state: int
    value: T
}

struct SleepFuture {
    state: int
    value: int
    deadline_ms: u64
}

func async_ready<T>(value: T) -> AsyncFuture<T> {
    return AsyncFuture<T> { state: 1, value: value }
}

func async_pending<T>(value: T) -> AsyncFuture<T> {
    return AsyncFuture<T> { state: 0, value: value }
}

func async_sleep_until(deadline_ms: u64) -> SleepFuture {
    return SleepFuture { state: 0, value: 0, deadline_ms: deadline_ms }
}

func sleep_ms(ms: u64) -> SleepFuture {
    return async_sleep_until(llpl_async_now_ms() + ms)
}

func timeout_ms(ms: u64) -> SleepFuture {
    return sleep_ms(ms)
}

func timeout_expired(deadline_ms: u64) -> AsyncFuture<bool> {
    return async_ready(llpl_async_now_ms() >= deadline_ms)
}

func async_join(task: char*) -> i64 {
    let status = llpl_async_block_on(task, null)
    llpl_async_destroy(task)
    return status
}

class AsyncTask<T> {
    let handle: char*
    let done: bool
    let cancelled: bool
    let started: bool
    let value: T

    constructor(handle: char*) {
        self.handle = handle
        self.done = false
        self.cancelled = false
        self.started = false
    }

    destructor() {
        if self.handle != null {
            llpl_async_destroy(self.handle)
        }
    }

    func poll() -> bool {
        if self.done {
            return true
        }
        self.started = true
        let state = llpl_async_poll(self.handle, (&self.value) as char*)
        if state == -2 {
            llpl_async_destroy(self.handle)
            self.handle = null
            self.done = true
            self.cancelled = true
            return true
        }
        if state == 1 {
            llpl_async_destroy(self.handle)
            self.handle = null
            self.done = true
            return true
        }
        return false
    }

    func join() -> T {
        if self.cancelled {
            llpl_panic("cannot join cancelled async task")
        }
        if !self.done {
            self.started = true
            let state = llpl_async_block_on(self.handle, (&self.value) as char*)
            if state == -2 {
                self.cancelled = true
                self.done = true
                llpl_async_destroy(self.handle)
                self.handle = null
                llpl_panic("cannot join cancelled async task")
            }
            llpl_async_destroy(self.handle)
            self.handle = null
            self.done = true
        }
        return self.value
    }

    func join_timeout(timeout_ms: u64, out: T*) -> bool {
        if self.done {
            if !self.cancelled {
                out[0] = self.value
                return true
            }
            return false
        }

        let state = llpl_async_block_on_timeout(self.handle, (&self.value) as char*, timeout_ms)
        self.started = true
        if state == 1 {
            llpl_async_destroy(self.handle)
            self.handle = null
            self.done = true
            out[0] = self.value
            return true
        }
        if state == -2 {
            llpl_async_destroy(self.handle)
            self.handle = null
            self.done = true
            self.cancelled = true
        }
        return false
    }

    func cancel() -> bool {
        if self.done || self.handle == null {
            return false
        }
        llpl_async_cancel(self.handle)
        llpl_async_destroy(self.handle)
        self.handle = null
        self.done = true
        self.cancelled = true
        return true
    }

    func is_done() -> bool {
        return self.done
    }

    func is_cancelled() -> bool {
        return self.cancelled
    }

    func status() -> int {
        if self.cancelled {
            return TASK_CANCELLED
        }
        if self.done {
            return TASK_DONE
        }
        if self.started {
            return TASK_RUNNING
        }
        return TASK_PENDING
    }
}

class AsyncExecutor {
    let handle: char*

    constructor() {
        self.handle = llpl_async_executor_create()
    }

    destructor() {
        llpl_async_executor_destroy(self.handle)
    }

    func spawn(task: char*) -> i64 {
        return llpl_async_executor_spawn(self.handle, task)
    }

    func poll() -> i64 {
        return llpl_async_executor_poll(self.handle)
    }

    func run_all() -> i64 {
        return llpl_async_executor_run_all(self.handle)
    }

    func run_all_timeout(timeout_ms: u64) -> i64 {
        return llpl_async_executor_run_all_timeout(self.handle, timeout_ms)
    }

    func cancel_all() -> i64 {
        return llpl_async_executor_cancel_all(self.handle)
    }
}

class AsyncChannel<T> {
    let data: T[]
    let capacity: i64
    let head: i64
    let tail: i64
    let count: i64
    let closed: bool

    constructor(capacity: i64 = 16) {
        if capacity <= 0 {
            llpl_panic("AsyncChannel capacity must be positive")
        }
        self.capacity = capacity
        self.data = llpl_alloc((capacity as u64) * sizeof(T)) as T[]
        self.head = 0
        self.tail = 0
        self.count = 0
        self.closed = false
    }

    destructor() {
        llpl_free(self.data as char*)
    }

    func close() {
        self.closed = true
    }

    func is_closed() -> bool {
        return self.closed
    }

    func len() -> i64 {
        return self.count
    }

    func is_empty() -> bool {
        return self.count == 0
    }

    func is_full() -> bool {
        return self.count >= self.capacity
    }

    func try_send(value: T) -> bool {
        if self.closed || self.is_full() {
            return false
        }
        self.data[self.tail] = value
        self.tail = (self.tail + 1) % self.capacity
        self.count = self.count + 1
        return true
    }

    func try_recv(out: T*) -> bool {
        if self.count == 0 {
            return false
        }
        out[0] = self.data[self.head]
        self.head = (self.head + 1) % self.capacity
        self.count = self.count - 1
        return true
    }

    func send(value: T) -> AsyncFuture<bool> {
        return async_ready(self.try_send(value))
    }

    func recv(out: T*) -> AsyncFuture<bool> {
        return async_ready(self.try_recv(out))
    }
}

// load/store/exchange/fetch_add/compare_exchange are compiler intrinsics
// (see codegen.d's isAtomicBuiltinCall), not extern-declared functions -
// they type-infer T from the pointer argument and work on any of
// i8/i16/i32/i64/u8/u16/u32/u64/bool. AtomicI64/AtomicU64/AtomicBool keep
// their existing API for backward compatibility; Atomic<T> below covers
// every other width without six near-duplicate wrapper classes.
class AtomicI64 {
    let value: i64

    constructor(value: i64 = 0) {
        self.value = value
    }

    func load() -> i64 {
        return atomic_load(&self.value)
    }

    func store(value: i64) {
        atomic_store(&self.value, value)
    }

    func exchange(value: i64) -> i64 {
        return atomic_exchange(&self.value, value)
    }

    func fetch_add(delta: i64) -> i64 {
        return atomic_fetch_add(&self.value, delta)
    }

    func compare_exchange(expected: i64*, desired: i64) -> bool {
        return atomic_compare_exchange(&self.value, expected, desired)
    }
}

class AtomicU64 {
    let value: u64

    constructor(value: u64 = 0) {
        self.value = value
    }

    func load() -> u64 {
        return atomic_load(&self.value)
    }

    func store(value: u64) {
        atomic_store(&self.value, value)
    }

    func exchange(value: u64) -> u64 {
        return atomic_exchange(&self.value, value)
    }

    func fetch_add(delta: u64) -> u64 {
        return atomic_fetch_add(&self.value, delta)
    }

    func compare_exchange(expected: u64*, desired: u64) -> bool {
        return atomic_compare_exchange(&self.value, expected, desired)
    }
}

class AtomicBool {
    let value: bool

    constructor(value: bool = false) {
        self.value = value
    }

    func load() -> bool {
        return atomic_load(&self.value)
    }

    func store(value: bool) {
        atomic_store(&self.value, value)
    }

    func exchange(value: bool) -> bool {
        return atomic_exchange(&self.value, value)
    }

    func compare_exchange(expected: bool*, desired: bool) -> bool {
        return atomic_compare_exchange(&self.value, expected, desired)
    }
}

// Covers every width AtomicI64/AtomicU64/AtomicBool don't (i8/i16/i32/u8/
// u16/u32): Atomic<i32>, Atomic<u8>, etc.
class Atomic<T> {
    let value: T

    constructor(value: T) {
        self.value = value
    }

    func load() -> T {
        return atomic_load(&self.value)
    }

    func store(value: T) {
        atomic_store(&self.value, value)
    }

    func exchange(value: T) -> T {
        return atomic_exchange(&self.value, value)
    }

    func fetch_add(delta: T) -> T {
        return atomic_fetch_add(&self.value, delta)
    }

    func compare_exchange(expected: T*, desired: T) -> bool {
        return atomic_compare_exchange(&self.value, expected, desired)
    }
}

class Mutex {
    let state: i64

    constructor() {
        self.state = 0
    }

    func lock() {
        llpl_mutex_lock(&self.state)
    }

    func acquire() {
        self.lock()
    }

    func try_lock() -> bool {
        return llpl_mutex_try_lock(&self.state) != 0
    }

    func unlock() {
        llpl_mutex_unlock(&self.state)
    }

    func release() {
        self.unlock()
    }
}

class RwLock {
    let state: i64

    constructor() {
        self.state = 0
    }

    func read_lock() {
        llpl_rwlock_read_lock(&self.state)
    }

    func try_read_lock() -> bool {
        return llpl_rwlock_try_read_lock(&self.state) != 0
    }

    func read_unlock() {
        llpl_rwlock_read_unlock(&self.state)
    }

    func write_lock() {
        llpl_rwlock_write_lock(&self.state)
    }

    func try_write_lock() -> bool {
        return llpl_rwlock_try_write_lock(&self.state) != 0
    }

    func write_unlock() {
        llpl_rwlock_write_unlock(&self.state)
    }
}

class TaskLocalI64 {
    let key: i64

    constructor(initial: i64 = 0) {
        self.key = llpl_tls_alloc()
        self.set(initial)
    }

    func set(value: i64) {
        llpl_tls_set_i64(self.key, value)
    }

    func get() -> i64 {
        return llpl_tls_get_i64(self.key)
    }
}

class TaskLocalU64 {
    let key: i64

    constructor(initial: u64 = 0) {
        self.key = llpl_tls_alloc()
        self.set(initial)
    }

    func set(value: u64) {
        llpl_tls_set_u64(self.key, value)
    }

    func get() -> u64 {
        return llpl_tls_get_u64(self.key)
    }
}

func thread_yield() {
    llpl_thread_yield()
}

func thread_sleep_ms(ms: u64) {
    llpl_thread_sleep_ms(ms)
}

func thread_current_id() -> u64 {
    return llpl_thread_current_id()
}

class ThreadStart<T> {
    let entry: () -> T
    let value: T

    constructor(entry: () -> T) {
        self.entry = entry
    }

    func run() {
        self.value = self.entry()
    }

    func result() -> T {
        return self.value
    }
}

class Thread<T> {
    let handle: char*
    let start: ThreadStart<T>
    let joined: bool
    let detached: bool

    constructor(entry: () -> T) {
        self.start = new ThreadStart<T>(entry)
        self.handle = llpl_thread_spawn(func[self]() -> void {
            self.start.run()
        })
        if self.handle == null {
            llpl_panic("failed to spawn thread")
        }
        self.joined = false
        self.detached = false
    }

    destructor() {
        if self.handle != null && !self.joined && !self.detached {
            llpl_thread_detach(self.handle)
            self.handle = null
            self.detached = true
        }
        if self.joined && self.start != null {
            delete self.start
            self.start = null
        }
    }

    func join() -> T {
        if self.joined {
            llpl_panic("cannot join thread twice")
        }
        if self.detached {
            llpl_panic("cannot join detached thread")
        }
        if llpl_thread_join(self.handle) <= 0 {
            llpl_panic("thread join failed")
        }
        self.handle = null
        self.joined = true
        return self.start.result()
    }

    func detach() -> bool {
        if self.joined || self.detached || self.handle == null {
            return false
        }
        if llpl_thread_detach(self.handle) <= 0 {
            return false
        }
        self.handle = null
        self.detached = true
        return true
    }

    func is_joined() -> bool {
        return self.joined
    }

    func is_detached() -> bool {
        return self.detached
    }
}

// Allocator is the common interface for user-provided allocation policies.
// Trait dispatch is static/monomorphized; ClosureAllocator is the adapter for
// installing closure-backed policies into the runtime's global allocator.
trait Allocator {
    func allocate(size: u64) -> char*
    func deallocate(ptr: char*)
}

class ClosureAllocator {
    let alloc_fn: (u64) -> char*
    let free_fn: (char*) -> void

    constructor(alloc_fn: (u64) -> char*, free_fn: (char*) -> void) {
        self.alloc_fn = alloc_fn
        self.free_fn = free_fn
    }

    func install() {
        llpl_set_allocator(self.alloc_fn, self.free_fn)
    }

    func reset() {
        llpl_reset_allocator()
    }
}

impl Allocator for ClosureAllocator {
    func allocate(size: u64) -> char* {
        self.alloc_fn(size)
    }

    func deallocate(ptr: char*) {
        self.free_fn(ptr)
    }
}
// Weak<T>'s own building blocks - see runtime.h/runtime.c's own comments
// on RefCount.weak_count. `ptr` is always a class instance's own address
// (its RefCount header is its first field), cast to char* the same way
// every other raw-pointer runtime call in this file already does.
extern func rc_retain(ptr: char*)
extern func rc_weak_retain(ptr: char*)
extern func rc_weak_release(ptr: char*)
extern func rc_is_alive(ptr: char*) -> bool
extern func rc_use_count(ptr: char*) -> i64
// Symbolized panic backtraces - see runtime.h's own comment. `addr` is a
// raw instruction-pointer value (as already used throughout
// examples/baremetal_demo/backtrace.llpl), not necessarily a function's
// exact start - llpl_resolve_symbol finds whichever compiled
// function/method/constructor contains it.
extern func llpl_resolve_symbol(addr: u64) -> char*
extern func llpl_symbol_name(symbol: char*) -> char*
extern func llpl_symbol_file(symbol: char*) -> char*
extern func llpl_symbol_line(symbol: char*) -> i64
extern func llpl_panic_backtrace()
extern func llpl_panic_backtrace_from_frame(frame: u64)

// Prints "PANIC: <msg>\n" and halts - stderr+abort() on a hosted target,
// or (freestanding) whatever a kernel/port wired up via
// llpl_set_panic_handler/the weak llpl_panic_putc+llpl_panic_halt hooks
// (see runtime.c's own comment on all three - examples/baremetal_demo's
// kernel.llpl overrides the weak hooks so a panic is never silent there).
// Used below by Slice<T>/Vector<T>'s bounds checks.
extern func llpl_panic(msg: char*)
extern func __llpl_check_index(arr: void*, idx: i64, size: i64, elem_size: u64, file: char*, line: i64) -> void*

struct EmbeddedFile {
    let data: char*
    let len: u64
}

// Reflection classes moved to stdlib/reflection.llpl to reduce prelude compilation time

class RegexMatch {
    let matched: bool
    let pattern: char*
    let text: char*
    let base_offset: i64

    constructor(pattern: string, text: string, base_offset: i64 = 0) {
        let pattern_len: i64 = llpl_strlen(pattern) as i64
        self.pattern = llpl_alloc((pattern_len + 1) as u64)
        llpl_memcpy(self.pattern, pattern, (pattern_len + 1) as u64)

        let text_len: i64 = llpl_strlen(text) as i64
        self.text = llpl_alloc((text_len + 1) as u64)
        llpl_memcpy(self.text, text, (text_len + 1) as u64)

        self.base_offset = base_offset
        self.matched = llpl_regex_match(self.pattern, self.text)
    }

    destructor() {
        llpl_free(self.pattern)
        llpl_free(self.text)
    }

    func is_match() -> bool {
        return self.matched
    }

    func group_count() -> i64 {
        return llpl_regex_group_count(self.pattern) as i64
    }

    func has_group(index: i64) -> bool {
        if index < 0 {
            return false
        }
        let start: i64 = 0
        let end: i64 = 0
        return llpl_regex_capture_bounds(self.pattern, self.text, index as u64, &start, &end)
    }

    func group_start(index: i64) -> i64 {
        if index < 0 {
            return -1
        }
        let start: i64 = 0
        let end: i64 = 0
        if llpl_regex_capture_bounds(self.pattern, self.text, index as u64, &start, &end) {
            return start + self.base_offset
        }
        return -1
    }

    func group_end(index: i64) -> i64 {
        if index < 0 {
            return -1
        }
        let start: i64 = 0
        let end: i64 = 0
        if llpl_regex_capture_bounds(self.pattern, self.text, index as u64, &start, &end) {
            return end + self.base_offset
        }
        return -1
    }

    func group(index: i64) -> String {
        if index < 0 {
            return new String("")
        }
        let raw: char* = llpl_regex_capture(self.pattern, self.text, index as u64)
        let out: String = new String(raw)
        llpl_free(raw)
        return out
    }

    func expand(template: string) -> String {
        let ts: String = new String(template)
        let result: String = new String("")
        let len: i64 = ts.byte_len()
        let lit_start: i64 = 0
        let i: i64 = 0
        while i < len {
            if ts.byte_at(i) == 36 && i + 1 < len {
                if i > lit_start {
                    result = result + ts.byte_substring(lit_start, i - lit_start).c_str()
                }
                let next: char = ts.byte_at(i + 1)
                if next == 36 {
                    result = result + "$"
                    i = i + 2
                } else if next >= 48 && next <= 57 {
                    let group_index: i64 = (next as i64) - 48
                    let j: i64 = i + 2
                    while j < len && ts.byte_at(j) >= 48 && ts.byte_at(j) <= 57 {
                        group_index = group_index * 10 + ((ts.byte_at(j) as i64) - 48)
                        j = j + 1
                    }
                    if self.has_group(group_index) {
                        result = result + self.group(group_index).c_str()
                    }
                    i = j
                } else {
                    result = result + "$"
                    i = i + 1
                }
                lit_start = i
            } else {
                i = i + 1
            }
        }
        if len > lit_start {
            result = result + ts.byte_substring(lit_start, len - lit_start).c_str()
        }
        return result
    }

    func to_string() -> string {
        return self.group(0).c_str()
    }
}

class RegexMatchIterator {
    let pattern: char*
    let text: char*
    let text_len: i64
    let pos: i64
    let current: RegexMatch
    let has_current: bool
    let done: bool

    constructor(pattern: string, text: string) {
        let pattern_len: i64 = llpl_strlen(pattern) as i64
        self.pattern = llpl_alloc((pattern_len + 1) as u64)
        llpl_memcpy(self.pattern, pattern, (pattern_len + 1) as u64)

        self.text_len = llpl_strlen(text) as i64
        self.text = llpl_alloc((self.text_len + 1) as u64)
        llpl_memcpy(self.text, text, (self.text_len + 1) as u64)

        self.pos = 0
        self.current = null
        self.has_current = false
        self.done = false
    }

    destructor() {
        llpl_free(self.pattern)
        llpl_free(self.text)
    }

    func advance() -> bool {
        if self.done || self.pos > self.text_len {
            self.done = true
            return false
        }
        let m: RegexMatch = new RegexMatch(self.pattern, self.text + self.pos, self.pos)
        if !m.is_match() {
            self.done = true
            return false
        }
        if self.current != null {
            delete self.current
        }
        rc_retain(m as char*)
        self.current = m
        let end_in_suffix: i64 = m.group_end(0) - self.pos
        let start_in_suffix: i64 = m.group_start(0) - self.pos
        if end_in_suffix == start_in_suffix {
            self.pos = self.pos + end_in_suffix + 1
        } else {
            self.pos = self.pos + end_in_suffix
        }
        return true
    }

    func iter_has_next() -> bool {
        if self.has_current {
            return true
        }
        self.has_current = self.advance()
        return self.has_current
    }

    func iter_next() -> RegexMatch {
        if !self.has_current {
            self.advance()
        }
        self.has_current = false
        return self.current
    }
}

class Regex {
    let pattern: char*

    constructor(pattern: string) {
        let len: i64 = llpl_strlen(pattern) as i64
        self.pattern = llpl_alloc((len + 1) as u64)
        llpl_memcpy(self.pattern, pattern, (len + 1) as u64)
    }

    destructor() {
        llpl_free(self.pattern)
    }

    func match(text: string) -> bool {
        return llpl_regex_match(self.pattern, text)
    }

    func captures(text: string) -> RegexMatch {
        return new RegexMatch(self.pattern, text)
    }

    func find_all(text: string) -> RegexMatchIterator {
        return new RegexMatchIterator(self.pattern, text)
    }

    func replace(text: string, replacement: string) -> String {
        let m: RegexMatch = self.captures(text)
        if !m.is_match() {
            return new String(text)
        }
        let ts: String = new String(text)
        let start: i64 = m.group_start(0)
        let end: i64 = m.group_end(0)
        let result: String = ts.byte_substring(0, start)
        result = result + m.expand(replacement).c_str()
        result = result + ts.byte_substring(end, ts.byte_len() - end).c_str()
        return result
    }

    func replace_all(text: string, replacement: string) -> String {
        let ts: String = new String(text)
        let result: String = new String("")
        let it: RegexMatchIterator = self.find_all(text)
        let last_end: i64 = 0
        while it.iter_has_next() {
            let m: RegexMatch = it.iter_next()
            let start: i64 = m.group_start(0)
            let end: i64 = m.group_end(0)
            if start > last_end {
                result = result + ts.byte_substring(last_end, start - last_end).c_str()
            }
            result = result + m.expand(replacement).c_str()
            last_end = end
        }
        if last_end < ts.byte_len() {
            result = result + ts.byte_substring(last_end, ts.byte_len() - last_end).c_str()
        }
        return result
    }

    func source() -> string {
        return self.pattern
    }
}

// An owned, heap-allocated, NUL-terminated byte string - unlike `string`
// (a bare `char*` alias with no ownership of its own), a String copies its
// data in on construction and frees it on destruction, so it's safe to
// build, pass around, and let go out of scope independent of whatever
// buffer it was constructed from.
//
// Demonstrates LLPL's operator overloading (`func operator+(...)`, see
// ast.operatorMethodName) end to end: `+` concatenates, `==`/`!=`/`<`/`>`
// compare lexicographically by UTF-8 byte order (via llpl_strcmp), and
// `[]` reads a Unicode codepoint by character index. Byte-level APIs
// (`byte_len`, `byte_at`, `byte_set`, `byte_substring`, `byte_find`) remain
// available for code that needs raw UTF-8 storage. It also implements the
// `foreach` iterator protocol (iter_has_next/iter_next/iter_reset - see
// codegen.d's ITER_HAS_NEXT et al.), so `for c in s { ... }` walks
// Unicode codepoints.
//
class String : Object {
    let buf: char*
    let length: i64
    let iter_pos: i64 // foreach cursor - see iter_has_next/iter_next/iter_reset

    constructor(s: string) {
        self.length = llpl_strlen(s) as i64
        self.buf = llpl_alloc((self.length + 1) as u64)
        llpl_memcpy(self.buf, s, (self.length + 1) as u64)
        self.iter_pos = 0
    }

    destructor() {
        llpl_free(self.buf)
    }

    func byte_len() -> i64 {
        return self.length
    }

    func len() -> i64 {
        return llpl_utf8_len(self.buf) as i64
    }

    func is_utf8() -> bool {
        return llpl_utf8_valid(self.buf)
    }

    func byte_index(char_index: i64) -> i64 {
        if char_index < 0 {
            return 0
        }
        return llpl_utf8_byte_offset(self.buf, char_index as u64) as i64
    }

    func char_index(byte_offset: i64) -> i64 {
        if byte_offset < 0 {
            return 0
        }
        return llpl_utf8_char_index(self.buf, byte_offset as u64) as i64
    }

    func codepoint_at(char_index: i64) -> u64 {
        if char_index < 0 {
            return 0
        }
        return llpl_utf8_codepoint_at(self.buf, char_index as u64)
    }

    // The owned buffer as a plain `char*` - for passing a String to
    // anything (print(), another String's methods, ...) that expects
    // `string` rather than a String instance.
    func c_str() -> string {
        return self.buf
    }

    func as_string() -> string {
        return self.c_str()
    }

    func byte_at(index: i64) -> char {
        return self.buf[index]
    }

    func operator[](index: i64) -> u64 {
        return self.codepoint_at(index)
    }

    // iter_reset is optional in the protocol, but String defines it so
    // `foreach` over the same instance twice (or a loop re-entered after
    // an earlier one ran to completion) starts from the beginning both
    // times rather than seeing an already-exhausted cursor.
    func iter_reset() {
        self.iter_pos = 0
    }

    func iter_has_next() -> bool {
        return self.iter_pos < self.len()
    }

    func iter_next() -> u64 {
        let c: u64 = self.codepoint_at(self.iter_pos)
        self.iter_pos = self.iter_pos + 1
        return c
    }

    func byte_set(index: i64, value: char) {
        self.buf[index] = value
    }

    func operator==(other: string) -> bool {
        return llpl_strcmp(self.buf, other) == 0
    }

    func operator!=(other: string) -> bool {
        return !(self == other)
    }

    func operator<(other: string) -> bool {
        return llpl_strcmp(self.buf, other) < 0
    }

    func operator>(other: string) -> bool {
        return llpl_strcmp(self.buf, other) > 0
    }

    // String == String et al. - without these, `a == b` between two
    // String *instances* still compiles (this class has no other
    // exact-matching `operator==` overload to reject it against), but
    // silently compares the two heap pointers instead of their content,
    // since a bare `==` with no matching operator overload falls back to
    // that. Delegating to the `string` (char*) overloads just above via
    // c_str() gives the same content comparison those already do.
    func operator==(other: String) -> bool {
        return self == other.c_str()
    }

    func operator!=(other: String) -> bool {
        return self != other.c_str()
    }

    func operator<(other: String) -> bool {
        return self < other.c_str()
    }

    func operator>(other: String) -> bool {
        return self > other.c_str()
    }

    // Concatenation always allocates a fresh String (values, not shared
    // mutable buffers) - `other`'s bytes are copied into a temporary
    // buffer alongside `self`'s before handing it to `new String(...)`,
    // which copies it again into its own owned storage. Two copies for
    // one `+` is the price of String's single-argument constructor; simple
    // and correct beats a second constructor form LLPL doesn't have.
    func operator+(other: string) -> String {
        let other_len: i64 = llpl_strlen(other) as i64
        let total: i64 = self.length + other_len
        let joined: char* = llpl_alloc((total + 1) as u64)
        llpl_memcpy(joined, self.buf, self.length as u64)
        llpl_memcpy(joined + self.length, other, (other_len + 1) as u64)
        // `joined` is a raw buffer, not reference-counted storage - the
        // constructor copied it into the String's own `buf`, so nothing
        // else will ever free this one. Releasing it here is what keeps a
        // concat loop (`s = s + "x"`) flat instead of leaking the whole
        // intermediate string every iteration.
        let result: String = new String(joined)
        llpl_free(joined)
        return result
    }

    // Clamps byte `start`/`count` into range rather than faulting on an
    // out-of-bounds request. Prefer substring() for character-indexed text.
    func byte_substring(start: i64, count: i64) -> String {
        if start < 0 {
            start = 0
        }
        if start > self.length {
            start = self.length
        }
        let max_count: i64 = self.length - start
        if count > max_count {
            count = max_count
        }
        if count < 0 {
            count = 0
        }

        let piece: char* = llpl_alloc((count + 1) as u64)
        llpl_memcpy(piece, self.buf + start, count as u64)
        piece[count] = 0
        // See operator+ above - the constructor copies, so this scratch
        // buffer is ours to free.
        let result: String = new String(piece)
        llpl_free(piece)
        return result
    }

    func substring(start: i64, count: i64) -> String {
        if start < 0 {
            start = 0
        }
        let total_chars: i64 = self.len()
        if start > total_chars {
            start = total_chars
        }
        let max_count: i64 = total_chars - start
        if count > max_count {
            count = max_count
        }
        if count < 0 {
            count = 0
        }

        let byte_start: i64 = self.byte_index(start)
        let byte_end: i64 = self.byte_index(start + count)
        return self.byte_substring(byte_start, byte_end - byte_start)
    }

    func utf8_substring(start: i64, count: i64) -> String {
        return self.substring(start, count)
    }

    // First byte index of `needle`, or -1 if it doesn't occur.
    func byte_find(needle: string) -> i64 {
        let needle_len: i64 = llpl_strlen(needle) as i64
        if needle_len == 0 {
            return 0
        }
        let i: i64 = 0
        while i <= self.length - needle_len {
            let j: i64 = 0
            let matched: bool = true
            while j < needle_len && matched {
                if self.buf[i + j] != needle[j] {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // First character index of `needle`, or -1 if it doesn't occur. An
    // empty needle matches at 0, mirroring most languages' find()/indexOf().
    func find(needle: string) -> i64 {
        let byte_pos: i64 = self.byte_find(needle)
        if byte_pos < 0 {
            return -1
        }
        return self.char_index(byte_pos)
    }

    func contains(needle: string) -> bool {
        return self.find(needle) >= 0
    }

    func starts_with(prefix: string) -> bool {
        let prefix_len: i64 = llpl_strlen(prefix) as i64
        if prefix_len > self.length {
            return false
        }
        let i: i64 = 0
        while i < prefix_len {
            if self.buf[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    func ends_with(suffix: string) -> bool {
        let suffix_len: i64 = llpl_strlen(suffix) as i64
        if suffix_len > self.length {
            return false
        }
        let offset: i64 = self.length - suffix_len
        let i: i64 = 0
        while i < suffix_len {
            if self.buf[offset + i] != suffix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    func to_upper() -> String {
        let out: char* = llpl_alloc((self.length + 1) as u64)
        let i: i64 = 0
        while i < self.length {
            let c: char = self.buf[i]
            if c >= 97 && c <= 122 {
                out[i] = ((c as i64) - 32) as char
            } else {
                out[i] = c
            }
            i = i + 1
        }
        out[self.length] = 0
        // See operator+ above - the constructor copies, so free the scratch.
        let result: String = new String(out)
        llpl_free(out)
        return result
    }

    func to_lower() -> String {
        let out: char* = llpl_alloc((self.length + 1) as u64)
        let i: i64 = 0
        while i < self.length {
            let c: char = self.buf[i]
            if c >= 65 && c <= 90 {
                out[i] = ((c as i64) + 32) as char
            } else {
                out[i] = c
            }
            i = i + 1
        }
        out[self.length] = 0
        // See operator+ above - the constructor copies, so free the scratch.
        let result: String = new String(out)
        llpl_free(out)
        return result
    }

    // Strips leading/trailing space, tab, '\n', and '\r'.
    func trim() -> String {
        let start: i64 = 0
        while start < self.length && (self.buf[start] == 32 || self.buf[start] == 9 ||
                self.buf[start] == 10 || self.buf[start] == 13) {
            start = start + 1
        }
        let end: i64 = self.length
        while end > start && (self.buf[end - 1] == 32 || self.buf[end - 1] == 9 ||
                self.buf[end - 1] == 10 || self.buf[end - 1] == 13) {
            end = end - 1
        }
        return self.byte_substring(start, end - start)
    }
}

// A bounds-checked *view* into memory someone else owns - a plain
// {ptr, len} value type (like Pair<A, B>, not an owning container: no
// constructor/destructor, nothing to allocate or free) that turns a raw
// `T*` + a separately-tracked count - passed around together purely by
// convention, with nothing stopping them from drifting out of sync or an
// index from running off the end - into one value slice_get/slice_set
// can actually validate before ever touching memory. Build one directly
// with a struct literal (`Slice<i64> { ptr: buf, len: 10 }`) over a fixed
// array, a raw `llpl_alloc`'d buffer, or see Vector<T>.as_slice() below.
struct Slice<T> {
    // `T[]`, not `T*` - see Vector<T>.data's own comment (typeToC's
    // isDynamicArray) for why: identical C type for a value-type T
    // (`i64*` either way), but correctly `String**` rather than a
    // collapsed single `String*` for a class-type T, matching what
    // Vector<String>.as_slice() actually hands this struct's `ptr` field.
    let ptr: T[]
    let len: u64
}

// Panics (see llpl_panic above) rather than reading/writing past `len` -
// the entire reason this exists instead of plain `ptr[index]`.
func slice_get<T>(s: Slice<T>, index: u64) -> T {
    if index >= s.len {
        llpl_panic("Slice.get: index out of bounds")
    }
    return s.ptr[index]
}

func slice_set<T>(s: Slice<T>, index: u64, value: T) {
    if index >= s.len {
        llpl_panic("Slice.set: index out of bounds")
    }
    s.ptr[index] = value
}

// Defer-friendly owner for a raw heap byte buffer. Use:
//
//   let buf: OwnedBuffer = new OwnedBuffer(128)
//   defer buf.free()
//
// `free()` is idempotent, so explicit early release and deferred cleanup are
// safe together. `take()` transfers the raw pointer out and disables cleanup.
class OwnedBuffer {
    let ptr: char*
    let length: u64

    constructor(size: u64) {
        self.ptr = llpl_alloc(size)
        self.length = size
    }

    destructor() {
        self.free()
    }

    func free() {
        if self.ptr != null {
            llpl_free(self.ptr)
            self.ptr = null
            self.length = 0
        }
    }

    func data() -> char* {
        return self.ptr
    }

    func len() -> u64 {
        return self.length
    }

    func is_null() -> bool {
        return self.ptr == null
    }

    func byte_at(index: u64) -> char {
        if index >= self.length {
            llpl_panic("OwnedBuffer.byte_at: index out of bounds")
        }
        return self.ptr[index as i64]
    }

    func set(index: u64, value: char) {
        if index >= self.length {
            llpl_panic("OwnedBuffer.set: index out of bounds")
        }
        self.ptr[index as i64] = value
    }

    func as_slice() -> Slice<char> {
        let s: Slice<char>
        s.ptr = self.ptr
        s.len = self.length
        return s
    }

    func take() -> char* {
        let out: char* = self.ptr
        self.ptr = null
        self.length = 0
        return out
    }
}

// Defer-friendly owner for one heap-allocated T value. This avoids the
// common pattern of manually pairing `llpl_alloc(sizeof(T)) as T*` with a
// later `llpl_free(ptr as char*)`.
class Owned<T> {
    let ptr: T*

    constructor() {
        self.ptr = llpl_alloc(sizeof(T)) as T*
    }

    destructor() {
        self.free()
    }

    func free() {
        if self.ptr != null {
            llpl_free(self.ptr as char*)
            self.ptr = null
        }
    }

    func as_ptr() -> T* {
        return self.ptr
    }

    func is_null() -> bool {
        return self.ptr == null
    }

    func get() -> T {
        if self.ptr == null {
            llpl_panic("Owned.get: null owner")
        }
        return self.ptr[0]
    }

    func set(value: T) {
        if self.ptr == null {
            llpl_panic("Owned.set: null owner")
        }
        self.ptr[0] = value
    }

    func take() -> T* {
        let out: T* = self.ptr
        self.ptr = null
        return out
    }
}

// A non-owning reference to a class instance - it never keeps its target
// alive (unlike an ordinary class-typed field, which the owning class's
// auto-generated destructor releases when *it* is destroyed), and safely
// reports whether the target is still alive instead of leaving a dangling
// pointer once it isn't. The main use is breaking a reference cycle
// between two classes that hold each other (a parent/child or doubly-
// linked pair): make one direction `Weak<T>` and only the other an
// ordinary owning field, so destroying the owner doesn't try to cascade
// back through an already-destroyed instance.
//
// `target: T*` - an explicit pointer, not a bare `T` - is what makes this
// safe: a plain class-typed field is exactly what the owning class's
// destructor auto-releases (see generateDestructor's own comment, and
// typeToC's identical `!field.type.isPointer` check) - writing the
// pointer star here excludes this field from that cascade, the same
// trick Owned<T>'s `ptr: T*` field already relies on to manage its own
// memory by hand instead of through rc_alloc/rc_release.
class Weak<T> {
    let target: T*

    constructor(t: T) {
        self.target = t
        if self.target != null {
            rc_weak_retain(self.target as char*)
        }
    }

    destructor() {
        if self.target != null {
            rc_weak_release(self.target as char*)
        }
    }

    // The target if it's still alive - a real, retained reference the
    // caller now owns, exactly like any other `new`-obtained one - or
    // `null` if it's already been destroyed.
    func upgrade() -> T {
        if self.target != null && rc_is_alive(self.target as char*) {
            rc_retain(self.target as char*)
            return self.target
        }
        return null
    }

    func is_alive() -> bool {
        return self.target != null && rc_is_alive(self.target as char*)
    }
}

// Explicit shared ownership over a class instance, on top of the same
// refcounted runtime Weak<T> already relies on (see Weak<T>'s own comment
// for the underlying model). A plain class-typed field only ever holds
// one implicit owner - the enclosing instance - and releases it once,
// unconditionally, when that owner is destroyed; Rc<T> is for the case
// where a single instance genuinely needs more than one independent
// owner (say, two different collections that must each keep a shared
// node alive), by retaining on construction/clone and releasing on
// destruction, so the instance survives until every Rc<T> pointing at it
// is gone rather than just the first one.
//
// The constructor retains its OWN reference on top of whatever ownership
// `t` already carries in from `new` - it does not consume/take over that
// one. To hand full ownership to Rc<T> (so the instance lives exactly as
// long as its Rc<T>s do, no longer), `delete` the raw value right after
// wrapping it:
//   let raw: Node = new Node(...)
//   let owner: Rc<Node> = new Rc<Node>(raw)
//   delete raw   // cancels the `new`'s own implicit ownership; owner's
//                // retain above keeps the instance alive regardless
class Rc<T> {
    let target: T*

    constructor(t: T) {
        self.target = t
        if self.target != null {
            rc_retain(self.target as char*)
        }
    }

    destructor() {
        if self.target != null {
            delete self.target
        }
    }

    // A second, independently-owning Rc<T> over the same instance - the
    // intended way to hand out shared ownership instead of passing the
    // raw target around and calling rc_retain by hand.
    func clone() -> Rc<T> {
        return new Rc<T>(self.target)
    }

    func get() -> T {
        return self.target
    }

    func is_null() -> bool {
        return self.target == null
    }

    // How many Rc<T>/owning references currently exist for this target -
    // 0 once dropped to nothing (never observed through a live Rc<T>,
    // since this instance itself is one of the counted owners).
    func use_count() -> i64 {
        if self.target == null {
            return 0
        }
        return rc_use_count(self.target as char*)
    }
}

// A dynamic, growable array - the generic analogue of manually managing an
// `llpl_alloc`'d buffer + length + capacity by hand. `sizeof(T)` (see
// codegen.d's SizeofExpr handling) is what makes this possible without any
// element-type-specific code: since a generic class is monomorphized (a
// real, fully-typed C copy generated per concrete T - see codegen.d's
// instantiateGenericTypeArgs), `sizeof(T)` is a real compile-time constant
// in every instantiation, exactly as if this had been hand-written per type.
//
// T may be a primitive (i64, char, ...) or a class (Vector<SomeClass> just
// stores references, like any other class field) - but NOT itself an
// explicit pointer type (Vector<char*>, Vector<i64*>, and so `Vector<string>`
// since `string` is `char*`): this class's own `data: T*` field would need
// a genuine pointer-to-pointer C type in that case, which ast.Type's
// single `isPointer` flag has no way to represent (the same limitation
// documented on resolveType's alias-merge logic). Wrap a pointer element
// in a one-field struct if you need this (see HashBucket's use of exactly
// that trick for HashMap's own bucket array).
class Vector<T> {
    // `T[]` (no fixed size), not `T*` - a dynamic/growable array, unlike
    // an ordinary explicit pointer (see typeToC's own isDynamicArray
    // comment for the full reasoning): for a value-type T this compiles
    // the same either way (`i64*`), but for a class-type T (Vector<String>)
    // it correctly gives `String**` - a real array of separately
    // heap-allocated String instances - instead of collapsing onto
    // String's own single implicit pointer star and trying to store
    // String *values* inline, which every method below (`sizeof`-based
    // allocation, `self.data[i] = item` where `item` is itself always a
    // pointer for a class) already assumes doesn't happen.
    let data: T[]
    let length: i64
    let capacity: i64
    let iter_pos: i64 // foreach cursor - see iter_has_next/iter_next/iter_reset

    constructor() {
        self.length = 0
        self.capacity = 4
        self.data = llpl_alloc((self.capacity as u64) * sizeof(T)) as T[]
        self.iter_pos = 0
    }

    // C++ `std::vector<T> v(count, value)` - count copies of value,
    // ready to use immediately (no push_back loop needed). Same
    // "resize/reserve can't guess a default T" reasoning as resize(n,
    // value) below - value is required, not optional, since there's no
    // generic "construct a default T" this compiler can call for an
    // arbitrary class-type T.
    constructor(count: i64, value: T) {
        if count > 0 {
            self.length = count
            self.capacity = count
        } else {
            self.length = 0
            self.capacity = 4
        }
        self.data = llpl_alloc((self.capacity as u64) * sizeof(T)) as T[]
        self.iter_pos = 0
        let i: i64 = 0
        while i < self.length {
            self.data[i] = value
            i = i + 1
        }
    }

    destructor() {
        // Frees the backing buffer only - a Vector<SomeClass> does not
        // release its elements, the same "raw storage, no cascading
        // ownership" behavior a plain T* array already has everywhere
        // else in the language.
        llpl_free(self.data as char*)
    }

    func push(item: T) {
        if self.length >= self.capacity {
            self.grow()
        }
        self.data[self.length] = item
        self.length = self.length + 1
    }

    func grow() {
        let new_capacity: i64 = self.capacity * 2
        let new_data: T[] = llpl_alloc((new_capacity as u64) * sizeof(T)) as T[]
        llpl_memcpy(new_data as char*, self.data as char*, (self.length as u64) * sizeof(T))
        llpl_free(self.data as char*)
        self.data = new_data
        self.capacity = new_capacity
    }

    func get(index: i64) -> T {
        if index < 0 || index >= self.length {
            llpl_panic("Vector.get: index out of bounds")
        }
        return self.data[index]
    }

    func set(index: i64, item: T) {
        if index < 0 || index >= self.length {
            llpl_panic("Vector.set: index out of bounds")
        }
        self.data[index] = item
    }

    func pop() -> T {
        self.length = self.length - 1
        return self.data[self.length]
    }

    func len() -> i64 {
        return self.length
    }

    func is_empty() -> bool {
        return self.length == 0
    }

    // C++ `std::vector`-style names for everything above (push_back/
    // pop_back/size/empty), plus what it doesn't already have:
    // reserve/clear/front/back/at, data()/capacity() (a field and a
    // method may share one name in this language - bare `self.data`/`v.data`
    // is still the plain field, `v.data()` calls this method, disambiguated
    // by the call parens the same way any method name would be), and
    // operator[]/[]= (bounds-checked, via get/set - `std::vector::operator[]`
    // itself doesn't bounds-check, .at() does; this class only ever offers
    // the checked behavior, under both names, matching this language's
    // general "fail loudly on a bug rather than silently read garbage"
    // stance elsewhere).
    func push_back(item: T) {
        self.push(item)
    }

    func pop_back() -> T {
        return self.pop()
    }

    func size() -> i64 {
        return self.length
    }

    func empty() -> bool {
        return self.length == 0
    }

    // Drops every element (length -> 0) without releasing the backing
    // buffer - capacity is unchanged, same as C++'s own clear().
    func clear() {
        self.length = 0
    }

    // Grows the backing buffer to at least `n` elements without changing
    // length - C++'s own reserve(). A no-op if already at or past `n`;
    // unlike grow() (which always doubles), this reallocates to exactly
    // `n` so a caller that knows its final size up front pays for one
    // allocation, not O(log n) doublings.
    func reserve(n: i64) {
        if n <= self.capacity {
            return
        }
        let new_data: T[] = llpl_alloc((n as u64) * sizeof(T)) as T[]
        llpl_memcpy(new_data as char*, self.data as char*, (self.length as u64) * sizeof(T))
        llpl_free(self.data as char*)
        self.data = new_data
        self.capacity = n
    }

    // Grows or shrinks to exactly `n` elements. Only the two-argument
    // form is offered (`value` fills every newly-added slot) - unlike
    // C++'s own resize(n), which value-initializes new elements from T's
    // default constructor, there's no generic "construct a default T"
    // this compiler can call for an arbitrary class-type T, so this asks
    // the caller for that value explicitly instead of guessing "zero" is
    // always the right one.
    func resize(n: i64, value: T) {
        if n < self.length {
            self.length = n
            return
        }
        self.reserve(n)
        while self.length < n {
            self.data[self.length] = value
            self.length = self.length + 1
        }
    }

    func front() -> T {
        return self.get(0)
    }

    func back() -> T {
        return self.get(self.length - 1)
    }

    func at(index: i64) -> T {
        return self.get(index)
    }

    func operator[](index: i64) -> T {
        return self.get(index)
    }

    func operator[](index: i64, value: T) {
        self.set(index, value)
    }

    // Raw pointer to the backing storage (C++'s own data()) - e.g. to
    // hand off to an `extern func` expecting a plain `T*`/`u8*` buffer,
    // like a file-read destination. Same "invalidated by a resize" caveat
    // as as_slice() below - a push()/reserve()/resize() past capacity may
    // reallocate and move the buffer this pointer refers to.
    func data() -> T* {
        return self.data as T*
    }

    func capacity() -> i64 {
        return self.capacity
    }

    // `foreach`/`for x in vec` protocol (see String's own copy of this
    // exact pattern above) - iter_reset lets the same instance be walked
    // more than once instead of staying exhausted after the first loop.
    func iter_reset() {
        self.iter_pos = 0
    }

    func iter_has_next() -> bool {
        return self.iter_pos < self.length
    }

    func iter_next() -> T {
        let item: T = self.get(self.iter_pos)
        self.iter_pos = self.iter_pos + 1
        return item
    }

    // A bounds-checked view of exactly this Vector's *live* elements
    // (length, not capacity) - valid only until the next push() past
    // capacity, which may grow() and reallocate self.data out from under
    // any slice taken before that (the same "invalidated by a resize"
    // caveat a C++ vector iterator or a Rust &[T] borrow would document,
    // just not compiler-enforced here).
    func as_slice() -> Slice<T> {
        return Slice { ptr: self.data, len: self.length as u64 }
    }
}

// A generic "maybe a value" box. Deliberately a plain class built via
// `new Optional<T>()` + set()/get(), not a generic tagged enum: a
// zero-field variant like "None" can't have its type parameter inferred
// from any argument (there's nothing to infer it from), and this compiler
// only infers a generic function's type parameters from its argument
// types (see resolveGenericFunctionCall) - so `T` has to already be
// concrete before any method runs, which `new Optional<i64>()` gives for
// free.
class Optional<T> {
    let has_value: bool
    let value: T

    constructor() {
        self.has_value = false
    }

    destructor() {}

    func set(v: T) {
        self.has_value = true
        self.value = v
    }

    // Undefined (reads whatever - possibly uninitialized - value happens
    // to be stored) if is_some() is false, same as unwrapping an empty
    // Optional in most other languages - always check is_some()/is_none()
    // first.
    func get() -> T {
        return self.value
    }

    func is_some() -> bool {
        return self.has_value
    }

    func is_none() -> bool {
        return !self.has_value
    }
}

// A generic "value or error" box - the same "plain class, not a tagged
// enum" design as Optional<T> and for the same reason: Ok(value)'s type
// parameter T is inferable from its own argument, but not E (nothing
// mentions it), and vice versa for Err(error) - so both type parameters
// have to already be concrete before any method runs, same as Optional<T>.
//
// The `?` operator (see codegen.d's generatePropagateExpr) unwraps a
// Result<T, E> (or Optional<T>) inline: `let v: i64 = try_something()?`
// evaluates to the T on Ok/Some, or returns early out of the *enclosing*
// function with an equivalent Err/None if there wasn't one - the
// enclosing function must itself return a Result<T, E> (or Optional<T>/
// T?) of a compatible shape for this to type-check.
class Result<T, E> {
    let ok: bool
    let value: T
    let error: E
    let trace: char*

    constructor() {
        self.ok = false
        self.trace = null
    }

    destructor() {}

    func set_ok(v: T) {
        self.ok = true
        self.value = v
    }

    func set_err(e: E) {
        self.ok = false
        self.error = e
        self.trace = null
    }

    // Same as set_err, but also records a location string (e.g. "file:line")
    // so error propagation can reconstruct a call-site trace.
    func set_err_with_trace(e: E, t: string) {
        self.ok = false
        self.error = e
        self.trace = t
    }

    // Undefined (reads whatever - possibly uninitialized - value/error
    // happens to be stored) if is_ok()/is_err() says otherwise - always
    // check first, same as Optional<T>.get().
    func get_ok() -> T {
        return self.value
    }

    // Alias for get_ok() - more idiomatic name
    func unwrap() -> T {
        return self.value
    }

    func get_err() -> E {
        return self.error
    }

    func get_trace() -> char* {
        return self.trace
    }

    func is_ok() -> bool {
        return self.ok
    }

    func is_err() -> bool {
        return !self.ok
    }
}

// One node of the concrete parse tree a `grammar { ... }` block's generated
// parser produces (see codegen.d's grammar-desugaring pass) - every rule
// match and every matched terminal becomes one ParseNode, so this needs to
// be unconditionally available (like String/Vector<T>/Optional<T>/
// Result<T,E> above) rather than living in an importable stdlib file: the
// generated parser class's methods reference it in their own return types
// whether or not the program importing `grammar` ever imports anything else.
// A manual tagged tree (plain fields, not this language's real tagged-enum
// feature) for the same reason Optional<T>/Result<T,E> are plain classes
// above: it's self-referential (children are more ParseNodes).
class ParseNode {
    let rule_name: String
    let text_val: String
    let children: Vector<ParseNode>
    let is_terminal: bool

    constructor() {
        self.rule_name = new String("")
        self.text_val = new String("")
        self.children = new Vector<ParseNode>()
        self.is_terminal = false
    }

    // See Optional<T>/Result<T,E>'s own comment on why every class that
    // might be held/released by another class's generated cleanup needs an
    // explicit destructor, even an empty one.
    destructor() {}

    func name() -> String {
        return self.rule_name
    }

    func text() -> String {
        return self.text_val
    }

    func child(index: i64) -> ParseNode {
        return self.children.get(index)
    }

    func child_count() -> i64 {
        return self.children.len()
    }
}

// One node of a LinkedList<T> - a plain struct (not a class): it's a
// manually `llpl_alloc`/`llpl_free`'d value with no reference-counting
// overhead, the same tradeoff a hand-written singly-linked list already
// makes (see EXAMPLES.md's ListNode).
struct LinkedListNode<T> {
    let value: T
    let next: LinkedListNode<T>*
}

class LinkedList<T> {
    let head: LinkedListNode<T>*
    let count: i64

    constructor() {
        self.head = null
        self.count = 0
    }

    destructor() {
        let current: LinkedListNode<T>* = self.head
        while current != null {
            let next_node: LinkedListNode<T>* = current.next
            llpl_free(current as char*)
            current = next_node
        }
    }

    func push_front(item: T) {
        let node: LinkedListNode<T>* = llpl_alloc(sizeof(LinkedListNode<T>)) as LinkedListNode<T>*
        node.value = item
        node.next = self.head
        self.head = node
        self.count = self.count + 1
    }

    func len() -> i64 {
        return self.count
    }

    func is_empty() -> bool {
        return self.count == 0
    }
}

// One slot of HashMap<K, V>'s bucket array. LLPL's Type model has only a
// single pointer flag (no way to write a real "pointer to pointer" type -
// see resolveType's alias-merge comment for the same limitation
// elsewhere), so the bucket array can't be a raw HashEntry<K, V>** - this
// one-field wrapper struct is the workaround: `buckets: HashBucket<K, V>*`
// is a single pointer to an array of these, each holding one chain's head.
struct HashBucket<K, V> {
    let head: HashEntry<K, V>*
}

// One chained entry of HashMap<K, V> - a plain struct for the same
// "manually allocated value, no refcount overhead" reason as
// LinkedListNode.
struct HashEntry<K, V> {
    let key: K
    let value: V
    let next: HashEntry<K, V>*
}

// Public value yielded by `for entry in map`. It deliberately
// copies key/value out of the internal chain node so callers cannot mutate
// HashMap internals while iterating.
struct HashMapEntry<K, V> {
    let key: K
    let value: V
}

// Documents the method-name convention `for x in instance { ... }` and
// `for x in instance { ... }` dispatches on (see codegen.d's
// ITER_HAS_NEXT/ITER_NEXT/ITER_RESET, and generateForeachStmt/
// generateClassForeach) - a class is foreach-able once it defines
// iter_has_next()/iter_next() with matching arity, whether written
// directly in its own body (like String and HashMap<K, V> below) or via
// an explicit `impl Iterator<T> for ThisClass { ... }` block. iter_reset()
// is optional - called automatically before the loop if present, so an
// object can be foreach-ed more than once without the caller resetting
// iteration state by hand, but it isn't required for a single-use iterator
// that's naturally exhausted after one pass.
trait Iterator<T> {
    func iter_has_next() -> bool
    func iter_next() -> T
}

// A trait a container can implement to opt into `needle in container`.
// The compiler lowers `in` to a normal contains(needle) method call after
// checking built-in arrays, strings, and ranges, so user types can either
// define this method directly or provide it through `impl Contains<T> for
// Type`.
trait Contains<T> {
    func contains(value: T) -> bool
}

// A trait a type implements to provide its own hash/equality for use as a
// HashMap key - see HashMap<K: Hashable, V> below. `Self` inside a trait's
// signatures and inside a matching `impl` block's bodies refers to whatever
// concrete type the `impl` targets; it's resolved by name, not a keyword.
trait Hashable {
    func hash() -> u64
    func equals(other: Self) -> bool
}

impl Hashable for i64 {
    func hash() -> u64 {
        return self as u64
    }
    func equals(other: i64) -> bool {
        return self == other
    }
}

impl Hashable for u64 {
    func hash() -> u64 {
        return self
    }
    func equals(other: u64) -> bool {
        return self == other
    }
}

impl Hashable for u8 {
    func hash() -> u64 {
        return self as u64
    }
    func equals(other: u8) -> bool {
        return self == other
    }
}

// Real content hash/equality for string keys (FNV-1a over the string's
// bytes, via llpl_strlen) - unlike the raw byte-wise hashing HashMap used
// before traits existed, two different `char*` pointers holding the same
// text now hash/compare equal, exactly like a normal string-keyed map.
impl Hashable for char* {
    func hash() -> u64 {
        let len: u64 = llpl_strlen(self)
        let h: u64 = 2166136261
        let i: u64 = 0
        while i < len {
            h = h ^ (self[i] as u64)
            h = h * 16777619
            i = i + 1
        }
        return h
    }
    func equals(other: char*) -> bool {
        return llpl_strcmp(self, other) == 0
    }
}

// Content-aware hashing/equality for the `String` class so HashMap<String, V>
// compares string contents, not pointer identity.
impl Hashable for String {
    func hash() -> u64 {
        let h: u64 = 2166136261
        let i: i64 = 0
        while i < self.length {
            h = h ^ (self.buf[i] as u64)
            h = h * 16777619
            i = i + 1
        }
        return h
    }
    func equals(other: String) -> bool {
        if self.length != other.length {
            return false
        }
        return llpl_strcmp(self.buf, other.buf) == 0
    }
}

// A trait a type implements to provide ordering, for use in a bounded
// generic function (`func f<T: Comparable>(...)`) - see test/traits_demo.llpl.
trait Comparable {
    func compare(other: Self) -> i64
}

impl Comparable for i64 {
    func compare(other: i64) -> i64 {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}

impl Comparable for int {
    func compare(other: int) -> i64 {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}

impl Comparable for u64 {
    func compare(other: u64) -> i64 {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}

impl Comparable for uint {
    func compare(other: uint) -> i64 {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}

impl Comparable for u8 {
    func compare(other: u8) -> i64 {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}

// Operator-overloading traits - `impl Add for TargetType { func operator+
// (other: Self) -> Self { ... } }` is how a struct or class gains a real
// `+` overload (see ast.operatorMethodName for the full operator -> "op_*"
// name table this trait system reuses unchanged - `func operator+` inside
// a trait or impl resolves to the same "op_add" method name a class's own
// inline `func operator+` method already does, so both forms dispatch
// identically at a use site like `a + b`).
//
// Deliberately *not* implemented here for the primitive types (i64/u64/
// char) - the plain `+`/`-`/`*` C operator already works unconditionally
// for those with no trait bound needed at all, and a hypothetical
// `impl Add for i64` would recurse (its own `self + other` body would
// dispatch straight back into that same impl, since operator lookup can't
// tell "the native primitive operator" apart from "this exact impl" once
// one exists). These traits are for user-defined arithmetic types (vectors,
// complex numbers, ...) that have no native operator of their own to begin
// with - see test/traits_demo.llpl for a Vec2 example.
trait Add {
    func operator+(other: Self) -> Self
}

trait Sub {
    func operator-(other: Self) -> Self
}

trait Neg {
    func operator-() -> Self
}

trait Mul {
    func operator*(other: Self) -> Self
}

// A basic hash table using separate chaining. It grows automatically once
// the load factor reaches roughly 75%, and implements the iterator protocol
// so `for entry in map { ... }` yields HashMapEntry<K, V> values.
//
// Keys hash/compare via K's own Hashable impl (key.hash()/key.equals(other))
// rather than raw bytes, so a `char*` key now hashes/compares by string
// *content*, not pointer identity - see `impl Hashable for char*` above.
class HashMap<K: Hashable, V> {
    let buckets: HashBucket<K, V>*
    let bucket_count: i64
    let count: i64
    let iter_bucket: i64
    let iter_entry: HashEntry<K, V>*

    constructor() {
        self.bucket_count = 16
        self.count = 0
        self.iter_bucket = 0
        self.iter_entry = null
        self.buckets = llpl_alloc((self.bucket_count as u64) * sizeof(HashBucket<K, V>)) as HashBucket<K, V>*
        let i: i64 = 0
        while i < self.bucket_count {
            self.buckets[i].head = null
            i = i + 1
        }
    }

    destructor() {
        let i: i64 = 0
        while i < self.bucket_count {
            let entry: HashEntry<K, V>* = self.buckets[i].head
            while entry != null {
                let next_entry: HashEntry<K, V>* = entry.next
                llpl_free(entry as char*)
                entry = next_entry
            }
            i = i + 1
        }
        llpl_free(self.buckets as char*)
    }

    func init_buckets(buckets: HashBucket<K, V>*, bucket_count: i64) {
        let i: i64 = 0
        while i < bucket_count {
            buckets[i].head = null
            i = i + 1
        }
    }

    func resize(new_bucket_count: i64) {
        let old_buckets: HashBucket<K, V>* = self.buckets
        let old_bucket_count: i64 = self.bucket_count

        let new_buckets: HashBucket<K, V>* =
            llpl_alloc((new_bucket_count as u64) * sizeof(HashBucket<K, V>)) as HashBucket<K, V>*
        self.init_buckets(new_buckets, new_bucket_count)

        let i: i64 = 0
        while i < old_bucket_count {
            let entry: HashEntry<K, V>* = old_buckets[i].head
            while entry != null {
                let next_entry: HashEntry<K, V>* = entry.next
                let idx: i64 = (entry.key.hash() % (new_bucket_count as u64)) as i64
                entry.next = new_buckets[idx].head
                new_buckets[idx].head = entry
                entry = next_entry
            }
            i = i + 1
        }

        self.buckets = new_buckets
        self.bucket_count = new_bucket_count
        self.iter_reset()
        llpl_free(old_buckets as char*)
    }

    func ensure_capacity_for_insert() {
        if (self.count + 1) * 4 >= self.bucket_count * 3 {
            self.resize(self.bucket_count * 2)
        }
    }

    func insert(key: K, value: V) {
        let idx: i64 = (key.hash() % (self.bucket_count as u64)) as i64
        let entry: HashEntry<K, V>* = self.buckets[idx].head
        while entry != null {
            if entry.key.equals(key) {
                entry.value = value
                return
            }
            entry = entry.next
        }
        self.ensure_capacity_for_insert()
        let new_idx: i64 = (key.hash() % (self.bucket_count as u64)) as i64
        let new_entry: HashEntry<K, V>* = llpl_alloc(sizeof(HashEntry<K, V>)) as HashEntry<K, V>*
        new_entry.key = key
        new_entry.value = value
        new_entry.next = self.buckets[new_idx].head
        self.buckets[new_idx].head = new_entry
        self.count = self.count + 1
    }

    func get(key: K) -> Optional<V> {
        let idx: i64 = (key.hash() % (self.bucket_count as u64)) as i64
        let entry: HashEntry<K, V>* = self.buckets[idx].head
        let result: Optional<V> = new Optional<V>()
        while entry != null {
            if entry.key.equals(key) {
                result.set(entry.value)
                return result
            }
            entry = entry.next
        }
        return result
    }

    func contains(key: K) -> bool {
        let idx: i64 = (key.hash() % (self.bucket_count as u64)) as i64
        let entry: HashEntry<K, V>* = self.buckets[idx].head
        while entry != null {
            if entry.key.equals(key) {
                return true
            }
            entry = entry.next
        }
        return false
    }

    func remove(key: K) -> bool {
        let idx: i64 = (key.hash() % (self.bucket_count as u64)) as i64
        let entry: HashEntry<K, V>* = self.buckets[idx].head
        let prev: HashEntry<K, V>* = null
        while entry != null {
            if entry.key.equals(key) {
                if prev == null {
                    self.buckets[idx].head = entry.next
                } else {
                    prev.next = entry.next
                }
                llpl_free(entry as char*)
                self.count = self.count - 1
                return true
            }
            prev = entry
            entry = entry.next
        }
        return false
    }

    func len() -> i64 {
        return self.count
    }

    func capacity() -> i64 {
        return self.bucket_count
    }

    func iter_reset() {
        self.iter_bucket = 0
        self.iter_entry = null
    }

    func iter_has_next() -> bool {
        if self.iter_entry != null {
            return true
        }

        while self.iter_bucket < self.bucket_count {
            let entry: HashEntry<K, V>* = self.buckets[self.iter_bucket].head
            self.iter_bucket = self.iter_bucket + 1
            if entry != null {
                self.iter_entry = entry
                return true
            }
        }

        return false
    }

    func iter_next() -> HashMapEntry<K, V> {
        if self.iter_entry == null {
            if !self.iter_has_next() {
                llpl_panic("HashMap.iter_next: iterator exhausted")
            }
        }

        let entry: HashEntry<K, V>* = self.iter_entry
        self.iter_entry = entry.next

        let item: HashMapEntry<K, V>
        item.key = entry.key
        item.value = entry.value
        return item
    }
}

// C++ `std::swap` - exchanges the two values a real *pointer* refers to
// (not the same as C++'s reference-based `T&` version - LLPL has no
// reference type - but the call-site spelling is identical either way:
// `std.swap(&x, &y)` for two plain variables, or `std.swap(&buf[i],
// &buf[j])` for two elements of a raw `T*`/`T[]` buffer). Doesn't work
// directly on a class's own `operator[]` result (e.g. `data[i]` on a
// Vector<T>) - that's a value returned by a function call, not a real C
// lvalue you can take the address of; get the raw buffer first
// (`data.data()`) and index into that instead.
namespace std {
    func swap<T>(a: T*, b: T*) {
        let tmp: T = *a
        *a = *b
        *b = tmp
    }
}

// Compiler-internal tuple representations. `(T, U)` syntax desugars to
// `__LLPL_Tuple2<T, U>`; fields are `_0`, `_1`, etc. These are ordinary
// generic structs so they reuse the normal monomorphization path.
struct __LLPL_Tuple2<A, B> {
    let _0: A
    let _1: B
}

struct __LLPL_Tuple3<A, B, C> {
    let _0: A
    let _1: B
    let _2: C
}

struct __LLPL_Tuple4<A, B, C, D> {
    let _0: A
    let _1: B
    let _2: C
    let _3: D
}

struct __LLPL_Tuple5<A, B, C, D, E> {
    let _0: A
    let _1: B
    let _2: C
    let _3: D
    let _4: E
}

struct __LLPL_Tuple6<A, B, C, D, E, F> {
    let _0: A
    let _1: B
    let _2: C
    let _3: D
    let _4: E
    let _5: F
}

struct __LLPL_Tuple7<A, B, C, D, E, F, G> {
    let _0: A
    let _1: B
    let _2: C
    let _3: D
    let _4: E
    let _5: F
    let _6: G
}

struct __LLPL_Tuple8<A, B, C, D, E, F, G, H> {
    let _0: A
    let _1: B
    let _2: C
    let _3: D
    let _4: E
    let _5: F
    let _6: G
    let _7: H
}

func roundup<T>( val: T, to: T ) -> T {
    return ((val + to - 1) & ~(to - 1))
}

func rounddown<T>( val: T, to: T ) -> T {
    return ((val % to) + to) % to
}

class Object {
    let refcount: uint

    constructor() {
        refcount = 1
    }

    func get() -> void* {
        // The lock prefix gives the increment acquire/release ordering and
        // prevents concurrent references from losing an update.
        asm("lock; incq %0" : "+m"(self.refcount) : : "memory")
        return &self as void*
    }

    func put() {
        // xadd returns the count before subtracting one. Checking that value
        // avoids a separate, racy load after the atomic decrement.
        let previous: uint
        asm("lock; xaddq %0, %1" : "+q"(previous), "+m"(self.refcount) : : "memory")

        delete self if previous == 1
    }
}
