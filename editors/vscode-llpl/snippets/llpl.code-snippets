{
    "Function": {
        "prefix": "func",
        "body": [
            "func ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
            "\t$0",
            "\treturn 0",
            "}"
        ],
        "description": "Function declaration"
    },
    "Generic Function": {
        "prefix": "funcgeneric",
        "body": [
            "func ${1:name}<${2:T}>(${3:param}: ${2:T}) -> ${2:T} {",
            "\t$0",
            "\treturn ${3:param}",
            "}"
        ],
        "description": "Generic function - type parameters are always inferred from arguments"
    },
    "Inline Function": {
        "prefix": "inline",
        "body": [
            "inline func ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
            "\t$0",
            "\treturn 0",
            "}"
        ],
        "description": "Inline function declaration"
    },
    "Unit Test": {
        "prefix": "unittest",
        "body": [
            "unittest {",
            "\t$0",
            "}"
        ],
        "description": "Unit test block compiled and run with --unittest"
    },
    "Property Getter": {
        "prefix": "propertyget",
        "body": [
            "property ${1:name}() -> ${2:int} {",
            "\treturn ${3:value}",
            "}"
        ],
        "description": "Property getter method used as obj.name"
    },
    "Property Setter": {
        "prefix": "propertyset",
        "body": [
            "property ${1:name}(${2:value}: ${3:int}) {",
            "\t$0",
            "}"
        ],
        "description": "Property setter method used as obj.name = value"
    },
    "Class": {
        "prefix": "class",
        "body": [
            "class ${1:Name} {",
            "\tlet ${2:field}: ${3:int}",
            "",
            "\tconstructor(@${2:field}: ${3:int}) {}",
            "",
            "\tdestructor() {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Class with constructor and destructor"
    },
    "Generic Class": {
        "prefix": "classgeneric",
        "body": [
            "class ${1:Name}<${2:T}> {",
            "\tlet ${3:field}: ${2:T}",
            "",
            "\tconstructor(@${3:field}: ${2:T}) {}",
            "",
            "\tdestructor() {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Generic class with constructor and destructor"
    },
    "Inherited Class": {
        "prefix": "classinherit",
        "body": [
            "class ${1:Name} : ${2:Base} {",
            "\tlet ${3:field}: ${4:int}",
            "",
            "\tconstructor(@${3:field}: ${4:int}) {",
            "\t\tsuper()",
            "\t}",
            "",
            "\tvirtual func ${5:method}() {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Class inheriting from a base class, with super() chaining and a virtual method"
    },
    "Namespace": {
        "prefix": "namespace",
        "body": [
            "namespace ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Namespace block"
    },
    "Using Namespace": {
        "prefix": "using",
        "body": "using namespace ${1:Name}",
        "description": "Bring a namespace's declarations into unqualified scope"
    },
    "Enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name}${2::int} {",
            "\t${3:FIRST},",
            "\t${4:SECOND}",
            "}"
        ],
        "description": "Enum declaration"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "\tlet ${2:field}: ${3:int}",
            "}"
        ],
        "description": "Struct (plain value type) declaration"
    },
    "Struct Literal": {
        "prefix": "structlit",
        "body": "${1:Name} { ${2:field}: ${3:value} }",
        "description": "Struct literal - constructs a struct value directly, every field given by name"
    },
    "Anonymous Struct Literal": {
        "prefix": "anonstruct",
        "body": "{ .${1:field} = ${2:value} }",
        "description": "Anonymous struct literal - target type comes from assignment/return context"
    },
    "Union": {
        "prefix": "union",
        "body": [
            "union ${1:Name} {",
            "\tlet ${2:field}: ${3:int}",
            "",
            "\tconstructor(@${2:field}: ${3:int}) {}",
            "}"
        ],
        "description": "Union (C-style, overlapping storage) declaration with a constructor"
    },
    "Trait": {
        "prefix": "trait",
        "body": [
            "trait ${1:Name} {",
            "\tfunc ${2:method}() -> ${3:int}",
            "\t$0",
            "}"
        ],
        "description": "Trait declaration - method signatures only, no bodies"
    },
    "Impl": {
        "prefix": "impl",
        "body": [
            "impl ${1:TraitName} for ${2:TargetType} {",
            "\tfunc ${3:method}() -> ${4:int} {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "impl block - gives a primitive/struct/class a real method body for a trait"
    },
    "Match": {
        "prefix": "match",
        "body": [
            "match ${1:value} {",
            "\tcase ${2:pattern} => {",
            "\t\t$0",
            "\t}",
            "\tdefault => {",
            "\t}",
            "}"
        ],
        "description": "Match statement"
    },
    "Alias": {
        "prefix": "alias",
        "body": "alias ${1:name} = ${2:a.b.c}",
        "description": "Alias declaration"
    },
    "Macro": {
        "prefix": "macro",
        "body": [
            "macro ${1:NAME}(${2:param}) {",
            "\t$0",
            "}"
        ],
        "description": "Macro declaration (expanded inline at each NAME!(args) call site)"
    },
    "Quote/Unquote": {
        "prefix": "quote",
        "body": [
            "quote {",
            "\tunquote(${1:param}) = $0",
            "}"
        ],
        "description": "Macro-body quote block, with an unquote splicing in a call-site argument"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },
    "Unless": {
        "prefix": "unless",
        "body": "${1:statement} unless ${2:condition}",
        "description": "Statement modifier - runs the statement only when the condition is false"
    },
    "If Else": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "If/else statement"
    },
    "While": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "\t$0",
            "}"
        ],
        "description": "While loop"
    },
    "For": {
        "prefix": "for",
        "body": [
            "for let ${1:i}: int = 0, ${1:i} < ${2:count}, ${1:i} = ${1:i} + 1 {",
            "\t$0",
            "}"
        ],
        "description": "For loop"
    },
    "Range For": {
        "prefix": "forin",
        "body": [
            "for ${1:i} in ${2:0}..${3:count} {",
            "\t$0",
            "}"
        ],
        "description": "For loop counting over a range (exclusive of the end)"
    },
    "Foreach": {
        "prefix": "foreach",
        "body": [
            "foreach let ${1:item} in ${2:iterable} {",
            "\t$0",
            "}"
        ],
        "description": "Foreach loop over an iterable"
    },
    "With Block": {
        "prefix": "with",
        "body": [
            "with ${1:target} {",
            "\t.${2:member}",
            "\t$0",
            "}"
        ],
        "description": "With block - leading-dot members are resolved against the target"
    },
    "Defer": {
        "prefix": "defer",
        "body": "defer ${1:statement}",
        "description": "Defer a statement to run at scope exit (LIFO order)"
    },
    "Delete": {
        "prefix": "delete",
        "body": "delete ${1:instance}",
        "description": "Release a reference to a class instance - runs its destructor and frees the memory if this was the last reference"
    },
    "Try/Catch/Finally": {
        "prefix": "try",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:e}: ${3:int}) {",
            "\t$0",
            "} finally {",
            "\t",
            "}"
        ],
        "description": "Try block with typed catch and finally"
    },
    "Lambda": {
        "prefix": "lambda",
        "body": "func[${1:captures}](${2:param}: ${3:int}) -> ${4:int} { $0 }",
        "description": "Lambda literal with an explicit capture list"
    },
    "Nullable Variable": {
        "prefix": "nullable",
        "body": "let ${1:name}: ${2:int}? = ${3:null}",
        "description": "Nullable-sugar variable (T? is Optional<T>)"
    },
    "Result Function": {
        "prefix": "funcresult",
        "body": [
            "func ${1:name}(${2:param}: ${3:int}) -> Result<${4:int}, ${5:char*}> {",
            "\tlet r: Result<${4:int}, ${5:char*}> = new Result<${4:int}, ${5:char*}>()",
            "\tif ${6:condition} {",
            "\t\tr.set_err(${7:\"error\"})",
            "\t\treturn r",
            "\t}",
            "\tr.set_ok($0)",
            "\treturn r",
            "}"
        ],
        "description": "Function returning Result<T, E>, matching prelude.llpl's Result pattern"
    },
    "Extern Function": {
        "prefix": "extern",
        "body": "extern func ${1:name}(${2:param}: ${3:int}) -> ${4:void}",
        "description": "Extern function declaration"
    },
    "Import": {
        "prefix": "import",
        "body": "import \"${1:module}.llpl\"",
        "description": "Import a module"
    },
    "Link Directive": {
        "prefix": "#link",
        "body": "#link \"${1:SDL3}\"",
        "description": "Requests the final binary be linked against a shared/static library (-l<name> in --binary mode)"
    },
    "Flags Directive": {
        "prefix": "#flags",
        "body": "#flags \"${1:-O2}\"",
        "description": "Passes extra flags to the system C compiler in --binary mode"
    },
    "Inline Asm": {
        "prefix": "asm",
        "body": "asm(\"${1:instruction}\" : ${2:\"=r\"(output)} : ${3:\"r\"(input)})",
        "description": "Inline assembly (GCC extended-asm style)"
    },
    "Bitfield": {
        "prefix": "bitfield",
        "body": "let ${1:name}: ${2:uint32} : ${3:1}",
        "description": "Class field with a bit-field width"
    },
    "UI App": {
        "prefix": "uiapp",
        "body": [
            "import std.ui.sdl",
            "",
            "using namespace std.ui",
            "",
            "ui ${1:DemoWindow}: Window {",
            "\ttitle: \"${2:LLPL UI}\"",
            "\twidth: ${3:640}",
            "\theight: ${4:420}",
            "\tpadding: 24",
            "\tspacing: 14",
            "",
            "\tText {",
            "\t\ttext: \"${2:LLPL UI}\"",
            "\t\tpreferred_height: 32",
            "\t}",
            "",
            "\tPanel {",
            "\t\tspacing: 10",
            "\t\tpadding: 16",
            "\t\tpreferred_height: 160",
            "",
            "\t\tButton {",
            "\t\t\ttext: \"${5:Click me}\"",
            "\t\t\tonClick: {",
            "\t\t\t\t$0",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "}",
            "",
            "func main() -> i64 {",
            "\tlet root: Window = ${1:DemoWindow}.build()",
            "\troot.apply_dark_theme()",
            "\tlet app: App = new App(\"${2:LLPL UI}\", ${3:640}, ${4:420}, root)",
            "\tif !app.is_valid() {",
            "\t\treturn 1",
            "\t}",
            "\tapp.run()",
            "\treturn 0",
            "}"
        ],
        "description": "SDL-backed UI DSL app"
    },
    "UI Declaration": {
        "prefix": "ui",
        "body": [
            "ui ${1:DemoWindow}: ${2:Window} {",
            "\ttitle: \"${3:LLPL UI}\"",
            "\twidth: ${4:640}",
            "\theight: ${5:420}",
            "\t$0",
            "}"
        ],
        "description": "Declarative UI tree lowered to Name.build()"
    },
    "UI Button": {
        "prefix": "uibutton",
        "body": [
            "Button {",
            "\ttext: \"${1:Click}\"",
            "\tonClick: {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "UI button with click handler"
    },
    "UI ProgressBar": {
        "prefix": "uiprogress",
        "body": [
            "ProgressBar {",
            "\tvalue: ${1:68}",
            "\tmin_value: ${2:0}",
            "\tmax_value: ${3:100}",
            "\ttext: \"${4:Loading}\"",
            "}"
        ],
        "description": "UI progress bar"
    },
    "UI SelectableText": {
        "prefix": "uiselect",
        "body": [
            "SelectableText {",
            "\ttext: \"${1:Drag to select this text}\"",
            "}"
        ],
        "description": "Selectable UI text"
    },
    "UI Slider": {
        "prefix": "uislider",
        "body": [
            "Slider {",
            "\tvalue: ${1:50}",
            "\tmin_value: ${2:0}",
            "\tmax_value: ${3:100}",
            "}"
        ],
        "description": "Draggable UI slider"
    },
    "UI Checkbox": {
        "prefix": "uicheck",
        "body": [
            "Checkbox {",
            "\ttext: \"${1:Enabled}\"",
            "\tchecked: ${2:true}",
            "}"
        ],
        "description": "UI checkbox"
    },
    "UI TextBox": {
        "prefix": "uitextbox",
        "body": [
            "TextBox {",
            "\tplaceholder: \"${1:Search}\"",
            "\ttext: \"${2}\"",
            "}"
        ],
        "description": "UI text input field"
    },
    "UI ComboBox": {
        "prefix": "uicombo",
        "body": [
            "ComboBox {",
            "\ttext: \"${1:Option}\"",
            "\twidth: ${2:180}",
            "}"
        ],
        "description": "UI combo box selector"
    },
    "UI GroupBox": {
        "prefix": "uigroup",
        "body": [
            "GroupBox {",
            "\ttitle: \"${1:Group}\"",
            "\tspacing: 10",
            "\tpadding: 16",
            "\t$0",
            "}"
        ],
        "description": "Titled UI grouping panel"
    },
    "UI List": {
        "prefix": "uilist",
        "body": [
            "List {",
            "\tpreferred_height: ${1:180}",
            "\t$0",
            "}"
        ],
        "description": "UI list with selectable icon rows"
    },
    "UI TreeView": {
        "prefix": "uitree",
        "body": [
            "TreeView {",
            "\tpreferred_height: ${1:220}",
            "\t$0",
            "}"
        ],
        "description": "UI tree view with expandable folders"
    },
    "UI Canvas": {
        "prefix": "uicanvas",
        "body": [
            "Canvas {",
            "\tpreferred_height: ${1:180}",
            "\t$0",
            "}"
        ],
        "description": "UI canvas drawing surface"
    },
    "UI Hover Handler": {
        "prefix": "uihover",
        "body": [
            "onHover: {",
            "\t$1",
            "}",
            "onHoverEnd: {",
            "\t$0",
            "}"
        ],
        "description": "UI hover enter/leave handlers"
    }
}
