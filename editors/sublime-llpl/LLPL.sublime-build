{
  "selector": "source.llpl",
  "working_dir": "$file_path",
  "cmd": ["llpl", "$file", "-b", "-o", "${file_path}/${file_base_name}"],
  "file_regex": "^(?:\\s*-->\\s*)?(.+?):([0-9]+):([0-9]+)",
  "variants": [
    {
      "name": "Generate C",
      "cmd": ["llpl", "$file", "-o", "${file_path}/${file_base_name}.c"]
    },
    {
      "name": "Build",
      "cmd": ["llpl", "$file", "-b", "-o", "${file_path}/${file_base_name}"]
    },
    {
      "name": "Build and Run",
      "shell_cmd": "llpl \"$file\" -b -o \"$file_path/$file_base_name\" && \"$file_path/$file_base_name\""
    },
    {
      "name": "Keep Intermediate C",
      "cmd": ["llpl", "$file", "-b", "--keep-c", "-o", "${file_path}/${file_base_name}"]
    }
  ]
}
